---
import { db } from "../db/db";
import { Usuarios, Notificaciones } from "../db/schema";
import { eq, desc } from "drizzle-orm";
import { canAccessCrm, canAccessScm } from "../lib/auth";

interface Props {
  title: string;
  activePath?: string;
}

const { title, activePath = "/crm" } = Astro.props;
const currentModule = activePath.startsWith("/scm") ? "scm" : "crm";

const sessionId = Astro.cookies.get("sportenis_session")?.value;
let userName = "Admin";
let userInitial = "A";
let userRolId = 0;
let roleStr = "";

if (sessionId) {
  const user = await db
    .select()
    .from(Usuarios)
    .where(eq(Usuarios.id, Number(sessionId)));
  if (user.length > 0) {
    userName = user[0].nombre?.trim() || "Admin";
    const initials = userName
      .split(/\s+/)
      .filter(Boolean)
      .map((part) => part.charAt(0).toUpperCase())
      .join("")
      .slice(0, 2);
    userInitial = initials || "A";
    userRolId = user[0].id_rol;
    roleStr =
      userRolId === 1
        ? "administrador"
        : userRolId === 2
          ? "vendedor"
          : userRolId === 4
            ? "logistica"
            : "cliente";
  }
}

// Redirect if accessing a module they don't have permission for
if (currentModule === "crm" && !canAccessCrm(roleStr as any)) {
  return Astro.redirect(canAccessScm(roleStr as any) ? "/scm" : "/login");
}
if (currentModule === "scm" && !canAccessScm(roleStr as any)) {
  return Astro.redirect(canAccessCrm(roleStr as any) ? "/crm" : "/login");
}

// Fetch unread notifications for the bell icon
let notificacionesNoLeidas: any[] = [];
try {
  notificacionesNoLeidas = await db
    .select()
    .from(Notificaciones)
    .where(eq(Notificaciones.leida, false))
    .orderBy(desc(Notificaciones.fecha_creacion))
    .limit(10);
} catch (e) {
  // Table might not exist yet
}
const notifCount = notificacionesNoLeidas.length;


let menuCrm = [
  {
    path: "/crm",
    label: "Dashboard",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>',
  },
  {
    path: "/crm/clientes",
    label: "Clientes",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  },
  {
    path: "/crm/interacciones",
    label: "Interacciones",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  },
  {
    path: "/crm/evaluaciones",
    label: "Evaluaciones",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
  },

  {
    path: "/crm/usuarios",
    label: "Usuarios",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  },
  {
    path: "/crm/actividad",
    label: "Mi actividad",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>',
  },
  {
    path: "/crm/configuracion",
    label: "Configuración",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  },
];

let menuScm = [
  {
    path: "/scm",
    label: "Inicio",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  },
  {
    path: "/scm/productos",
    label: "Productos",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16V8l-8-4-8 4v8l8 4 8-4Z"/><polyline points="4 8 12 12 20 8"/><polyline points="12 12 12 20"/></svg>',
  },
  {
    path: "/scm/proveedores",
    label: "Proveedores",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  },
  {
    path: "/scm/inventario",
    label: "Inventario",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>',
  },
  {
    path: "/scm/movimientos",
    label: "Movimientos",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>',
  },
  {
    path: "/scm/pedidos",
    label: "Pedidos",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
  },
  {
    path: "/scm/ventas",
    label: "Ventas",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>',
  },
  {
    path: "/scm/logistica",
    label: "Logística",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>',
  },
  {
    path: "/scm/reportes",
    label: "Reportes",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  },
  {
    path: "/scm/usuarios",
    label: "Usuarios",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  },
  {
    path: "/scm/configuracion",
    label: "Configuración",
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  },
];

if (userRolId !== 1) {
  menuCrm = menuCrm.filter((item) => item.path !== "/crm/configuracion" && item.path !== "/crm/usuarios");
  menuScm = menuScm.filter((item) => item.path !== "/scm/configuracion" && item.path !== "/scm/usuarios");
}

let activeMenu = currentModule === "scm" ? menuScm : menuCrm;
const moduleTitle =
  currentModule === "scm"
    ? "SCM - Cadena de Suministros"
    : "CRM - Administración";
const showModuleSwitcher = userRolId === 1; // Solo admin ve ambas
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | SporTenis {currentModule.toUpperCase()}</title>
  </head>
  <body>
    <div class="crm-app">
      <!-- Sidebar -->
      <aside class="sidebar" data-module={currentModule}>
        <div class="sidebar-header">
          <a class="brand" href={currentModule === "scm" ? "/scm" : "/crm"}>
            <span class="brand-mark">S</span>
            <div
              style="display: flex; flex-direction: column; line-height: 1.1;"
            >
              <span style="font-size: 16px;">Spor<span>Tenis</span></span>
              <span style="font-size: 12px; font-weight: 400; color: #a3a3a3;"
                >{currentModule === "scm" ? "SCM" : "CRM"}</span
              >
            </div>
          </a>
        </div>

        <nav class="sidebar-nav">
          {
            activeMenu.map((item) => (
              <a
                href={item.path}
                class={`nav-item ${activePath === item.path || (item.path !== "/crm" && item.path !== "/scm" && activePath.startsWith(item.path)) ? "active" : ""}`}
              >
                <span class="nav-icon" set:html={item.icon} />
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="sidebar-footer">
          <a href="/" class="nav-item">
            <span class="nav-icon"
              ><svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><line
                  x1="2"
                  y1="12"
                  x2="22"
                  y2="12"></line><path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path></svg
              ></span
            >
            Ver Tienda
          </a>
        </div>
      </aside>

      <!-- Main Content -->
      <div class="main-wrapper">
        <!-- Topbar -->
        <header class="topbar">
          <div class="topbar-search">
            <!-- El buscador global ha sido removido. Cada pestaña tendrá su propio buscador si es necesario. -->
          </div>
          <div class="topbar-actions">
            {
              showModuleSwitcher && (
                <a
                  href={currentModule === "scm" ? "/crm" : "/scm"}
                  class="module-switcher"
                  title={`Cambiar a ${currentModule === "scm" ? "CRM" : "SCM"}`}
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M8 3 4 7l4 4" />
                      <path d="M4 7h16" />
                      <path d="m16 21 4-4-4-4" />
                      <path d="M20 17H4" />
                    </>
                  </svg>
                  <span>
                    Cambiar a {currentModule === "scm" ? "CRM" : "SCM"}
                  </span>
                </a>
              )
            }

            <!-- Botón Buscar Removido -->

            <!-- Botón Notificaciones / Campana con Dropdown -->
            <div class="notif-wrapper" id="notifWrapper">
              <button
                type="button"
                class="icon-btn notif-bell"
                id="notifBellBtn"
                aria-label="Notificaciones"
                title="Ver notificaciones"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"
                ></path><path d="M13.73 21a2 2 0 0 1-3.46 0"
                ></path></svg>
                {notifCount > 0 && (
                  <span class="notif-badge" id="notifBadge">{notifCount}</span>
                )}
              </button>

              <div class="notif-dropdown" id="notifDropdown">
                <div class="notif-dropdown-header">
                  <strong>Notificaciones</strong>
                  {notifCount > 0 && (
                    <button type="button" class="notif-mark-all" id="markAllReadBtn">Marcar todas leídas</button>
                  )}
                </div>
                <div class="notif-dropdown-body" id="notifDropdownBody">
                  {notificacionesNoLeidas.length > 0 ? (
                    notificacionesNoLeidas.map((n) => (
                      <div class={`notif-item ${n.tipo === 'pedido_auto' ? 'notif-auto' : 'notif-alerta'}`} data-id={n.id}>
                        <div class="notif-item-icon">
                          {n.tipo === 'pedido_auto' ? (
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#15803d" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                          ) : (
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d93e2e" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                          )}
                        </div>
                        <div class="notif-item-content">
                          <div class="notif-item-title">{n.titulo}</div>
                          <div class="notif-item-msg">{n.mensaje}</div>
                          <div class="notif-item-time">
                            {new Date(n.fecha_creacion).toLocaleString('es-MX', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}
                          </div>
                          {n.tipo === 'stock_bajo' && (
                            <a href="/scm/pedidos" class="notif-action-btn">Crear Pedido Manual</a>
                          )}
                        </div>
                        <button type="button" class="notif-dismiss" data-notif-id={n.id} title="Marcar como leída">×</button>
                      </div>
                    ))
                  ) : (
                    <div class="notif-empty">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#a3a3a3" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                      <p>No hay notificaciones</p>
                    </div>
                  )}
                </div>
              </div>
            </div>

            <!-- Perfil de Usuario (Cerrar Sesión) -->
            <form method="POST" action="/login" style="margin:0;">
              <input type="hidden" name="action" value="logout" />
              <button
                type="submit"
                class="user-profile"
                title="Cerrar sesión"
                style="background: none; border: none; font-family: inherit; color: inherit; cursor: pointer;"
              >
                <div class="avatar">{userInitial}</div>
                <span>{userName} (Salir)</span>
              </button>
            </form>
          </div>
        </header>

        <!-- Page Content -->
        <main class="content-area">
          <slot />
        </main>
      </div>
    </div>

    <style is:global>
      :root {
        --color-bg: #f6f4ed;
        --color-surface: #ffffff;
        --color-text: #171717;
        --color-text-muted: #716e67;
        --color-primary: #f7d21c;
        --color-danger: #d93e2e;
        --color-danger-light: #fff1ef;
        --color-border: #d8d3c3;
        --color-success: #15803d;
        --color-success-bg: #dcfce7;
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: Arial, sans-serif;
      }

      .crm-app {
        display: flex;
        height: 100vh;
        overflow: hidden;
      }

      /* Sidebar */
      .sidebar {
        width: 260px;
        background: #171717;
        color: white;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
      }

      .sidebar-header {
        padding: 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .brand {
        display: flex;
        align-items: center;
        color: white;
        text-decoration: none;
        font-size: 20px;
        font-weight: 900;
        letter-spacing: -1px;
      }
      .brand span span {
        font-weight: 400;
      }
      .brand-mark {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-primary);
        color: #171717;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        margin-right: 10px;
        font-size: 14px;
      }

      .sidebar-nav {
        flex: 1;
        padding: 20px 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        overflow-y: auto;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: #a3a3a3;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        border-radius: 8px;
        transition: all 0.2s;
      }
      .nav-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: white;
      }
      .nav-item.active {
        background: var(--color-primary);
        color: #171717;
      }
      .nav-icon {
        font-size: 16px;
      }

      .sidebar-footer {
        padding: 20px 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }

      /* Main Wrapper */
      .main-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* Topbar */
      .topbar {
        height: 70px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        flex-shrink: 0;
      }

      .topbar-search input {
        width: 320px;
        padding: 10px 16px;
        border: 1px solid var(--color-border);
        border-radius: 20px;
        background: var(--color-bg);
        font-family: inherit;
        font-size: 13px;
        outline: none;
      }
      .topbar-search input:focus {
        border-color: var(--color-text);
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .module-switcher {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--color-bg);
        color: var(--color-text);
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid var(--color-border);
        transition: all 0.2s;
      }
      .module-switcher:hover {
        background: var(--color-text);
        color: white;
      }

      .icon-btn {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        padding: 8px;
        border-radius: 50%;
      }
      .icon-btn:hover {
        background: var(--color-bg);
      }

      .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        padding-left: 16px;
        border-left: 1px solid var(--color-border);
      }
      .avatar {
        width: 32px;
        height: 32px;
        background: var(--color-text);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
      }

      /* Content Area */
      .content-area {
        flex: 1;
        padding: 32px;
        overflow-y: auto;
      }

      /* Utilidades CRM Globales */
      .crm-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
      }

      .crm-title {
        font-family: Georgia, serif;
        font-size: 28px;
        font-weight: 400;
        margin: 0 0 24px 0;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
      }
      .badge-success {
        background: var(--color-success-bg);
        color: var(--color-success);
      }
      .badge-danger {
        background: var(--color-danger-light);
        color: var(--color-danger);
      }
      .badge-neutral {
        background: #e5e5e5;
        color: #555;
      }

      .btn-primary {
        background: var(--color-text);
        color: white;
        border: none;
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .btn-primary:hover {
        background: var(--color-danger);
      }
      /* Notification Bell & Dropdown */
      .notif-wrapper {
        position: relative;
      }
      .notif-bell {
        position: relative;
      }
      .notif-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        background: var(--color-danger);
        color: white;
        font-size: 10px;
        font-weight: 800;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        pointer-events: none;
        animation: notifPulse 2s ease-in-out infinite;
      }
      @keyframes notifPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.15); }
      }

      .notif-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 380px;
        max-height: 460px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        box-shadow: 0 12px 36px rgba(0,0,0,0.12);
        z-index: 1000;
        overflow: hidden;
      }
      .notif-dropdown.open {
        display: block;
        animation: dropdownFadeIn 0.2s ease;
      }
      @keyframes dropdownFadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .notif-dropdown-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid var(--color-border);
      }
      .notif-dropdown-header strong {
        font-size: 15px;
      }
      .notif-mark-all {
        background: none;
        border: none;
        font-size: 12px;
        color: #0066cc;
        cursor: pointer;
        font-weight: 600;
      }
      .notif-mark-all:hover {
        text-decoration: underline;
      }

      .notif-dropdown-body {
        max-height: 380px;
        overflow-y: auto;
      }

      .notif-item {
        display: flex;
        gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--color-border);
        transition: background 0.15s;
        position: relative;
      }
      .notif-item:last-child {
        border-bottom: none;
      }
      .notif-item:hover {
        background: var(--color-bg);
      }
      .notif-item-icon {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 2px;
      }
      .notif-alerta .notif-item-icon {
        background: var(--color-danger-light);
      }
      .notif-auto .notif-item-icon {
        background: var(--color-success-bg);
      }
      .notif-item-content {
        flex: 1;
        min-width: 0;
      }
      .notif-item-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
        color: var(--color-text);
      }
      .notif-item-msg {
        font-size: 12px;
        color: var(--color-text-muted);
        line-height: 1.4;
        margin-bottom: 6px;
      }
      .notif-item-time {
        font-size: 11px;
        color: #a3a3a3;
      }
      .notif-action-btn {
        display: inline-block;
        margin-top: 8px;
        padding: 4px 10px;
        background: var(--color-text);
        color: white;
        font-size: 11px;
        font-weight: 700;
        border-radius: 4px;
        text-decoration: none;
        text-transform: uppercase;
      }
      .notif-action-btn:hover {
        background: var(--color-danger);
      }
      .notif-dismiss {
        position: absolute;
        top: 12px;
        right: 12px;
        background: none;
        border: none;
        font-size: 16px;
        cursor: pointer;
        color: #a3a3a3;
        line-height: 1;
        padding: 2px;
      }
      .notif-dismiss:hover {
        color: var(--color-text);
      }
      .notif-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        color: #a3a3a3;
      }
      .notif-empty p {
        margin: 12px 0 0;
        font-size: 13px;
      }
    </style>

    <script is:inline>
      // Toggle notification dropdown
      document.addEventListener('DOMContentLoaded', () => {
        const bellBtn = document.getElementById('notifBellBtn');
        const dropdown = document.getElementById('notifDropdown');
        const wrapper = document.getElementById('notifWrapper');

        if (bellBtn && dropdown) {
          bellBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('open');
            // Trigger stock check when opening
            if (dropdown.classList.contains('open')) {
              fetch('/api/check-stock').catch(() => {});
            }
          });

          // Close on outside click
          document.addEventListener('click', (e) => {
            if (wrapper && !wrapper.contains(e.target)) {
              dropdown.classList.remove('open');
            }
          });
        }

        // Mark individual notification as read
        document.querySelectorAll('.notif-dismiss').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const id = btn.getAttribute('data-notif-id');
            await fetch('/api/notificaciones', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'marcar_leida', id }),
            });
            const item = btn.closest('.notif-item');
            if (item) item.remove();
            updateBadge();
          });
        });

        // Mark all as read
        const markAllBtn = document.getElementById('markAllReadBtn');
        if (markAllBtn) {
          markAllBtn.addEventListener('click', async () => {
            await fetch('/api/notificaciones', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'marcar_todas' }),
            });
            const body = document.getElementById('notifDropdownBody');
            if (body) {
              body.innerHTML = '<div class="notif-empty"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#a3a3a3" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg><p>No hay notificaciones</p></div>';
            }
            updateBadge();
            if (markAllBtn) markAllBtn.style.display = 'none';
          });
        }

        function updateBadge() {
          const badge = document.getElementById('notifBadge');
          const remaining = document.querySelectorAll('.notif-item').length;
          if (badge) {
            if (remaining > 0) {
              badge.textContent = remaining.toString();
            } else {
              badge.remove();
            }
          }
        }
      });
    </script>
  </body>
</html>
