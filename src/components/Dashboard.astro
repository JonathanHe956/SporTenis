  .dialog-visual.product-padel :global(i)::after { background: repeating-linear-gradient(45deg, transparent 0 8px, #b4c293 9px 11px); border: 3px solid #f7d21c; border-radius: inherit; content: ''; height: auto; inset: 14px; transform: none; width: auto; }
