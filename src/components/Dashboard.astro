  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1100px) { .product-grid { grid-template-columns: repeat(2, 1fr); } .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) {
    .main-nav { display: none; } .mobile-cats { display: flex; } .topbar { justify-content: space-between; }
    .hero { grid-template-columns: 1fr; } .hero-art { min-height: 300px; } .hero-copy { padding-bottom: 50px; }
    .benefits { gap: 22px 0; grid-template-columns: repeat(2, 1fr); } .benefits > div:nth-child(2) { border: 0; } .benefits > div:nth-child(3) { padding-left: 0; }
  }
  @media (max-width: 700px) {
    .product-dialog { border-radius: 18px 18px 0 0; grid-template-columns: 1fr; margin: auto 0 0; max-height: 92vh; max-width: 100%; overflow-y: auto; width: 100%; }
