  .qty-stepper input { background: #fff; border: 0; border-left: 1.5px solid #d8d3c3; border-right: 1.5px solid #d8d3c3; font-family: var(--font-ui); font-size: 14px; font-weight: 700; outline: 0; text-align: center; width: 56px; -moz-appearance: textfield; }
  .qty-stepper input::-webkit-inner-spin-button, .qty-stepper input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  .add-button { background: #171717; border: 0; color: #fffdf3; cursor: pointer; justify-content: space-between; margin-top: 14px; padding: 17px 20px; }
  .add-button::before { background: #d93e2e; }
  .add-button:disabled { cursor: wait; }
  .btn-icon { display: grid; height: 20px; place-items: center; position: relative; width: 20px; }
  .btn-icon > span { grid-area: 1 / 1; transition: opacity .2s, transform .35s var(--ease-spring); }
  .btn-spinner { animation: spin .7s linear infinite; border: 2px solid rgba(255,253,243,.35); border-radius: 50%; border-top-color: #fffdf3; height: 16px; opacity: 0; width: 16px; }
  .btn-check { color: #f7d21c; font-size: 16px; opacity: 0; transform: scale(.4); }
