  @keyframes sheet-in { from { transform: translateY(100%); } to { transform: none; } }
  @keyframes sheet-out { to { transform: translateY(100%); } }
  @media (max-width: 600px) {
    .announcement-track li { font-size: 10px; letter-spacing: .3px; padding: 0 12px; text-align: center; }
    .topbar { gap: 12px; min-height: 62px; padding: 0 16px; } .topbar.is-scrolled { min-height: 56px; }
