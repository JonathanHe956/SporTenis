  @media (hover: none) { .quick-view { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .storefront *, .storefront *::before, .storefront *::after, .product-dialog, .product-dialog *, .product-dialog::backdrop {
      animation-delay: 0s !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important;
    }
    .product-img { opacity: 1; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Barra de avisos rotativa ─────────────────────────────
  const announcementItems = Array.from(document.querySelectorAll<HTMLElement>('#announcementTrack li'));
  if (announcementItems.length > 1 && !reduceMotion) {
    let current = 0;
    window.setInterval(() => {
      const prev = announcementItems[current];
      current = (current + 1) % announcementItems.length;
      const next = announcementItems[current];
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      next.classList.remove('is-leaving');
      next.classList.add('is-active');
      window.setTimeout(() => prev.classList.remove('is-leaving'), 520);
    }, 4500);
  }

  // ── Header compacto y botón "volver arriba" al hacer scroll ─
  const topbar = document.getElementById('topbar');
  const backToTop = document.getElementById('backToTop');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      topbar?.classList.toggle('is-scrolled', y > 40);
      backToTop?.classList.toggle('is-visible', y > 700);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));

  // ── Parallax suave de la pelota del hero ─────────────────
  const heroArt = document.getElementById('heroArt');
  if (heroArt && !reduceMotion && window.matchMedia('(hover: hover)').matches) {
    heroArt.addEventListener('pointermove', (e: PointerEvent) => {
      const rect = heroArt.getBoundingClientRect();
      heroArt.style.setProperty('--px', (((e.clientX - rect.left) / rect.width) * 2 - 1).toFixed(3));
      heroArt.style.setProperty('--py', (((e.clientY - rect.top) / rect.height) * 2 - 1).toFixed(3));
    });
    heroArt.addEventListener('pointerleave', () => {
      heroArt.style.setProperty('--px', '0');
      heroArt.style.setProperty('--py', '0');
    });
  }

  // ── Contadores animados del hero ─────────────────────────
  document.querySelectorAll<HTMLElement>('.hero-stats [data-count]').forEach((el) => {
    const target = Number(el.dataset.count) || 0;
    if (reduceMotion || target === 0) return;
    const duration = 1400;
    el.textContent = '0';
    window.setTimeout(() => {
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(target * eased));
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, 800);
  });

  // ── Imágenes de producto: aparecen al terminar de cargar ──
  document.querySelectorAll<HTMLImageElement>('.product-img').forEach((img) => {
    const done = () => img.classList.add('is-loaded');
    if (img.complete) done();
    else {
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    }
  });

  // ── Ordenar productos ────────────────────────────────────
  const productGrid = document.getElementById('productGrid');
  const sortSelect = document.getElementById('sortProducts') as HTMLSelectElement | null;
  sortSelect?.addEventListener('change', () => {
    if (!productGrid) return;
    const cards = Array.from(productGrid.querySelectorAll<HTMLElement>('.product-card'));
    const by = sortSelect.value;
    cards.sort((a, b) => {
      if (by === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
      if (by === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
      if (by === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'es');
      return Number(a.dataset.index) - Number(b.dataset.index);
    });
    cards.forEach((card, i) => {
      card.classList.add('is-visible');
      card.classList.remove('is-sorted');
      card.style.setProperty('--reveal-delay', `${Math.min(i, 8) * 50}ms`);
      productGrid.appendChild(card);
      void card.offsetWidth;
      card.classList.add('is-sorted');
    });
  });
</script>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cartCount = document.querySelector('[data-cart-count]') as HTMLElement | null;
  const productDialog = document.getElementById('productDialog') as HTMLDialogElement | null;
  const dialogType = document.getElementById('dialogType') as HTMLElement | null;
  const dialogTitle = document.getElementById('dialogTitle') as HTMLElement | null;
  const dialogPrice = document.getElementById('dialogPrice') as HTMLElement | null;
  const dialogDescription = document.getElementById('dialogDescription') as HTMLElement | null;
  const productOption = document.getElementById('productOption') as HTMLSelectElement | null;
  const dialogVisual = document.getElementById('dialogVisual') as HTMLElement | null;
  const dialogFeedback = document.getElementById('dialogFeedback') as HTMLElement | null;
  const productQuantity = document.getElementById('productQuantity') as HTMLInputElement | null;
  const closeBtn = document.querySelector('.dialog-close') as HTMLButtonElement | null;
  const addToCartBtn = document.getElementById('addToCart') as HTMLButtonElement | null;
  const addToCartLabel = document.getElementById('addToCartLabel') as HTMLElement | null;
  const viewCartLink = document.getElementById('viewCartLink') as HTMLAnchorElement | null;
  const qtyDec = document.getElementById('qtyDec') as HTMLButtonElement | null;
  const qtyInc = document.getElementById('qtyInc') as HTMLButtonElement | null;

  let selectedProduct = '';
  let selectedProductId = 0;
  let successTimer = 0;

  const resetAddButton = () => {
    window.clearTimeout(successTimer);
    addToCartBtn?.classList.remove('is-loading', 'is-success');
    if (addToCartLabel) addToCartLabel.textContent = 'Añadir al carrito';
  };

  const openProductDialog = (button: HTMLButtonElement) => {
    selectedProduct = button.dataset.product || '';
    selectedProductId = Number(button.dataset.productId || 0);

    if (dialogType) dialogType.textContent = button.dataset.type || '';
    if (dialogTitle) dialogTitle.textContent = selectedProduct;
    if (dialogPrice) dialogPrice.textContent = button.dataset.price ? `${button.dataset.price} MXN` : '';
    if (dialogDescription) {
      dialogDescription.textContent = button.dataset.description || '';
      dialogDescription.hidden = !button.dataset.description;
    }

    if (productOption) {
      const options = (button.dataset.options || '')
        .split('|')
        .filter(Boolean)
        .map((option) => new Option(option, option));
      productOption.replaceChildren(...options);
      productOption.selectedIndex = 0;
    }

    if (dialogVisual) {
      dialogVisual.className = `dialog-visual ${button.dataset.theme || ''}`;
      dialogVisual.replaceChildren();
      if (button.dataset.badge) {
        const badge = document.createElement('span');
        badge.className = 'product-badge';
        badge.textContent = button.dataset.badge;
        dialogVisual.appendChild(badge);
      }
      if (button.dataset.image) {
        const img = document.createElement('img');
        img.src = button.dataset.image;
        img.alt = selectedProduct;
        // Si la imagen no carga, se muestra la ilustración del tema
        img.addEventListener('error', () => img.replaceWith(document.createElement('i')), { once: true });
        dialogVisual.appendChild(img);
      } else {
        dialogVisual.appendChild(document.createElement('i'));
      }
    }

    if (dialogFeedback) dialogFeedback.textContent = '';
    if (viewCartLink) viewCartLink.hidden = true;
    if (productQuantity) productQuantity.value = '1';
    resetAddButton();

    // Si se abre desde el panel de favoritos, el panel se cierra primero
    (window as any).closeFavDrawer?.(true);
    productDialog?.classList.remove('is-closing');
    if (!productDialog?.open) {
      productDialog?.showModal();
    }

    // Track event: view product
    if (typeof (window as any).trackEvent === 'function') {
      (window as any).trackEvent('ver_producto', { producto: selectedProduct, precio: button.dataset.price });
    }
  };

  // Cierre con animación de salida
  const closeProductDialog = () => {
    if (!productDialog?.open || productDialog.classList.contains('is-closing')) return;
    if (prefersReducedMotion) {
      productDialog.close();
      return;
    }
    productDialog.classList.add('is-closing');
    window.setTimeout(() => {
      productDialog.classList.remove('is-closing');
      productDialog.close();
    }, 220);
  };

  document.querySelectorAll<HTMLButtonElement>('.detail-button').forEach((button) => {
    button.addEventListener('click', () => openProductDialog(button));
  });

  // Toda la imagen de la tarjeta (y "Vista rápida") abre el detalle; el corazón no
  document.querySelectorAll<HTMLElement>('.product-visual').forEach((visual) => {
    visual.addEventListener('click', (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('.favorite-btn')) return;
      const detail = visual.closest('.product-card')?.querySelector<HTMLButtonElement>('.detail-button');
      if (detail) openProductDialog(detail);
    });
  });

  // "Ver producto" desde el panel de favoritos (componente FavoritesDrawer)
  document.addEventListener('favorites:view', (e: Event) => {
    const button = (e as CustomEvent).detail?.button as HTMLButtonElement | undefined;
    if (!button) return;
    e.preventDefault();
    openProductDialog(button);
  });

  // Desde otras páginas el panel manda a /?ver=ID: se abre ese producto al cargar
  const verId = new URLSearchParams(window.location.search).get('ver');
  if (verId) {
    const target = document.querySelector<HTMLButtonElement>(`.detail-button[data-product-id="${CSS.escape(verId)}"]`);
    if (target) openProductDialog(target);
    const url = new URL(window.location.href);
    url.searchParams.delete('ver');
    history.replaceState(null, '', url.pathname + url.search + url.hash);
  }

  closeBtn?.addEventListener('click', closeProductDialog);
  productDialog?.addEventListener('cancel', (e: Event) => {
    e.preventDefault();
    closeProductDialog();
  });
  // Click en el fondo oscuro cierra el detalle
  productDialog?.addEventListener('click', (e: MouseEvent) => {
    if (e.target === productDialog) closeProductDialog();
  });

  const stepQuantity = (delta: number) => {
    if (!productQuantity) return;
    const next = Math.max(1, Math.floor(Number(productQuantity.value || 1)) + delta);
    productQuantity.value = String(next);
  };
  qtyDec?.addEventListener('click', () => stepQuantity(-1));
  qtyInc?.addEventListener('click', () => stepQuantity(1));

  const bumpCart = (units: number) => {
    if (!cartCount) return;
    cartCount.textContent = String(units);
    cartCount.dataset.count = String(units);
    cartCount.classList.remove('bump');
    void cartCount.offsetWidth;
    cartCount.classList.add('bump');
  };

  // Guarda el producto en el carrito del cliente (tabla DetalleCarritos) vía /api/carrito
  addToCartBtn?.addEventListener('click', async () => {
    const qty = Math.max(1, Math.floor(Number(productQuantity?.value || 1)));
    const setFeedback = (text: string) => {
      if (dialogFeedback) dialogFeedback.textContent = text;
    };

    if (!selectedProductId) {
      setFeedback('No se pudo identificar el producto.');
      return;
    }

    resetAddButton();
    addToCartBtn.disabled = true;
    addToCartBtn.classList.add('is-loading');
    if (addToCartLabel) addToCartLabel.textContent = 'Agregando…';
    setFeedback('');

    try {
      const res = await fetch('/api/carrito', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ action: 'add', productId: selectedProductId, cantidad: qty }),
      });
      const data = await res.json();

      if (res.status === 401) {
        resetAddButton();
        setFeedback('Inicia sesión para agregar productos al carrito.');
        return;
      }
      if (!res.ok || !data.ok) {
        resetAddButton();
        setFeedback(data.error || 'No se pudo agregar al carrito.');
        return;
      }

      bumpCart(Number(data.resumen?.unidades ?? 0));
      addToCartBtn.classList.remove('is-loading');
      addToCartBtn.classList.add('is-success');
      if (addToCartLabel) addToCartLabel.textContent = '¡Añadido!';
      successTimer = window.setTimeout(resetAddButton, 2200);
      setFeedback(`${selectedProduct} se añadió al carrito.`);
      // Acceso directo al carrito después de agregar
      if (viewCartLink) {
        viewCartLink.hidden = false;
        viewCartLink.focus();
      }

      // Track event: add to cart
      if (typeof (window as any).trackEvent === 'function') {
        (window as any).trackEvent('agregar_carrito', { producto: selectedProduct, cantidad: qty });
      }
    } catch {
      resetAddButton();
      setFeedback('No se pudo agregar al carrito. Revisa tu conexión.');
    } finally {
      addToCartBtn.disabled = false;
    }
  });
</script>

<div id="auth-data" data-user-id={user?.id || 'guest'} data-logged-in={isLoggedIn} data-favorite-ids={favoriteProductIds.join(',')} style="display: none;"></div>

<script>
  function trackEvent(accion: string, detalles: any = {}) {
    fetch('/api/track', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ accion, detalles })
    }).catch(console.error);
  }

  const favButtons = document.querySelectorAll<HTMLButtonElement>('.favorite-btn');
  const authData = document.getElementById('auth-data');
  const isLoggedIn = authData?.getAttribute('data-logged-in') === 'true';
  const favoriteIds = new Set(
    (authData?.getAttribute('data-favorite-ids') || '')
      .split(',')
      .filter(Boolean)
      .map(Number)
  );

  const paintFavorite = (btn: HTMLButtonElement, active: boolean, name: string) => {
    btn.classList.toggle('is-active', active);
    btn.setAttribute('aria-pressed', String(active));
    btn.setAttribute('aria-label', active ? `Quitar ${name} de favoritos` : `Añadir ${name} a favoritos`);
  };

  // El panel de favoritos (FavoritesDrawer, en el Layout) y las tarjetas se sincronizan con este evento
  document.addEventListener('favorites:change', (event: Event) => {
    const { productId, active } = (event as CustomEvent).detail as { productId: number; active: boolean };
    if (active) favoriteIds.add(productId);
    else favoriteIds.delete(productId);
    document.querySelectorAll<HTMLButtonElement>(`.favorite-btn[data-product-id="${productId}"]`).forEach((btn) => {
      paintFavorite(btn, active, btn.dataset.productName || '');
    });
  });

  favButtons.forEach(btn => {
    const productId = Number(btn.getAttribute('data-product-id'));
    const productName = btn.dataset.productName || '';

    if (favoriteIds.has(productId)) paintFavorite(btn, true, productName);

    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (!isLoggedIn) {
        window.location.href = '/login';
        return;
      }

      btn.disabled = true;
      try {
        const response = await fetch('/api/favoritos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'No se pudo actualizar el favorito.');
        const favorite = Boolean(result.favorite);

        btn.classList.remove('pop');
        void btn.offsetWidth;
        btn.classList.add('pop');

        // Los datos del detalle sirven para dibujar el producto en el panel sin recargar
        const detail = btn.closest('.product-card')?.querySelector<HTMLElement>('.detail-button');
        document.dispatchEvent(new CustomEvent('favorites:change', {
          detail: { productId, active: favorite, product: detail ? { ...detail.dataset } : undefined },
        }));
        trackEvent(favorite ? 'favorito_agregado' : 'favorito_removido', { producto: productName });
      } catch (error) {
        console.error(error);
      } finally {
        btn.disabled = false;
      }
    });
  });

  // Inject trackEvent into global window object for other scripts to use
  (window as any).trackEvent = trackEvent;
</script>
