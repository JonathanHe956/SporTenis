---
// Etiqueta de estado de un pedido con los colores de la tienda
interface Props {
  estado: string;
  size?: 'sm' | 'lg';
}

const { estado, size = 'sm' } = Astro.props;

const tonos: Record<string, string> = {
  Procesando: 'tone-processing',
  Confirmada: 'tone-confirmed',
  Entregada: 'tone-delivered',
  Cancelada: 'tone-cancelled',
};
---

<span class:list={['estado', tonos[estado] ?? 'tone-default', `size-${size}`]}>
  <span class="dot" aria-hidden="true"></span>{estado}
</span>

<style>
  .estado {
    align-items: center; border-radius: 999px; display: inline-flex; font-family: var(--font-ui); font-weight: 800;
    gap: 7px; letter-spacing: .5px; line-height: 1; text-transform: uppercase; white-space: nowrap;
  }
  .size-sm { font-size: 10px; padding: 6px 11px; }
  .size-lg { font-size: 12px; padding: 9px 15px; }
  .dot { background: currentColor; border-radius: 50%; height: 7px; width: 7px; }
  .tone-processing { background: #fff1c2; color: #8a5a00; }
  .tone-processing .dot { animation: blink 1.6s ease-in-out infinite; }
  .tone-confirmed { background: #e3def3; color: #4c3d8f; }
  .tone-delivered { background: #d7e1c3; color: #3f5d22; }
  .tone-cancelled { background: #fde4df; color: #b4271a; }
  .tone-default { background: #ece7da; color: #57534e; }
  @keyframes blink { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .tone-processing .dot { animation: none; } }
</style>
