---
// Paso 1 de "¿Olvidaste tu contraseña?": el cliente escribe su correo y le mandamos un enlace.
import AuthShell from '../components/AuthShell.astro';
import { MINUTOS_ENLACE, RecuperacionError, solicitarRecuperacion } from '../lib/recuperacionPassword';

if (Astro.locals.user) return Astro.redirect('/cuenta');

let errorMsg = '';
let enviado = false;
let correo = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  correo = form.get('correo')?.toString().trim() ?? '';
  try {
    await solicitarRecuperacion(correo);
    enviado = true;
  } catch (error) {
    if (error instanceof RecuperacionError) errorMsg = error.message;
    else {
      console.error('Error al solicitar la recuperación de contraseña:', error);
      errorMsg = 'No pudimos procesar tu solicitud. Intenta de nuevo en unos minutos.';
    }
  }
}
---

<AuthShell title="Recuperar contraseña | SporTenis">
  <p class="eyebrow"><span></span> Recuperar acceso</p>
  <h1>¿Olvidaste tu <em>contraseña</em>?</h1>

  {enviado ? (
    <>
      <div class="ok-banner" role="status">
        Si <strong>{correo}</strong> tiene una cuenta en SporTenis, te enviamos un enlace para elegir una nueva contraseña.
        Revisa tu bandeja de entrada y la carpeta de spam. El enlace vence en {MINUTOS_ENLACE} minutos.
      </div>
      <p class="login-link">¿No te llegó? <a href="/olvide-password">Pedir otro enlace</a></p>
    </>
  ) : (
    <>
      <p class="subtitle">Escribe el correo con el que te registraste y te mandaremos un enlace para restablecerla.</p>
      <form method="POST" class="auth-form">
        {errorMsg && <div class="error-banner">{errorMsg}</div>}
        <div class="field-group">
          <label for="correo">Correo electrónico</label>
          <input type="email" id="correo" name="correo" value={correo} placeholder="tu@email.com" autocomplete="email" maxlength="255" required />
        </div>
        <button type="submit" class="primary-button">Enviar enlace <span>↗</span></button>
      </form>
      <p class="login-link">¿Ya la recordaste? <a href="/login">Inicia sesión</a></p>
    </>
  )}
</AuthShell>
