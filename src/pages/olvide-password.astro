---
// Paso 1 de "¿Olvidaste tu contraseña?": el cliente escribe su correo y le mandamos un código de 6 dígitos.
import AuthShell from '../components/AuthShell.astro';
import { RecuperacionError, solicitarRecuperacion } from '../lib/recuperacionPassword';

if (Astro.locals.user) return Astro.redirect('/cuenta');

let errorMsg = '';
let correo = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  correo = form.get('correo')?.toString().trim() ?? '';
  try {
    await solicitarRecuperacion(Astro.cookies, correo);
    return Astro.redirect('/restablecer-password');
  } catch (error) {
    if (error instanceof RecuperacionError) errorMsg = error.message;
    else {
      console.error('Error al solicitar la recuperación de contraseña:', error);
      errorMsg = 'No pudimos procesar tu solicitud. Intenta de nuevo en unos minutos.';
    }
  }
}
---

<AuthShell title="Recuperar contraseña | SporTenis">
  <p class="eyebrow"><span></span> Recuperar acceso · Paso 1 de 2</p>
  <h1>¿Olvidaste tu <em>contraseña</em>?</h1>
  <p class="subtitle">Escribe el correo con el que te registraste y te mandaremos un código de 6 dígitos para restablecerla.</p>
  <form method="POST" class="auth-form" id="formCorreo">
    {errorMsg && <div class="error-banner" role="alert">{errorMsg}</div>}
    <div class="field-group">
      <label for="correo">Correo electrónico</label>
      <input type="email" id="correo" name="correo" value={correo} placeholder="tu@email.com" autocomplete="email" maxlength="255" required autofocus />
    </div>
    <button type="submit" class="primary-button" id="btnEnviar">Enviar código <span>↗</span></button>
  </form>
  <p class="login-link">¿Ya la recordaste? <a href="/login">Inicia sesión</a></p>
</AuthShell>

<script>
  // Enviar el correo tarda unos segundos: se evita un segundo código por doble clic
  document.getElementById('formCorreo')?.addEventListener('submit', () => {
    const btn = document.getElementById('btnEnviar') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = 'Enviando código...'; }
  });
</script>
