---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import {
  Ventas, DetalleVentas, Clientes, Usuarios,
  MetodosPago, Productos, Modelos, Marcas,
} from '../../db/schema';
import { eq, desc, sql } from 'drizzle-orm';

const session = Astro.cookies.get('sportenis_session')?.value;
if (!session) return Astro.redirect('/login');
const sessionUserId = Number(session);

// Manejo de Registro de Venta (POST)
let errorMsg = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const action = form.get('action')?.toString() || 'create_venta';

    if (action === 'create_venta') {
      const id_cliente     = Number(form.get('id_cliente'));
      const id_metodo_pago = Number(form.get('id_metodo_pago'));
      const envio          = Math.max(0, parseFloat(form.get('envio')?.toString() || '0') || 0);
      const cupon          = form.get('cupon_descuento')?.toString().trim() || null;
      
      const productoIds    = form.getAll('producto_id[]').map(Number);
      const cantidades     = form.getAll('cantidad[]').map(Number);
      const precios        = form.getAll('precio_unitario[]').map(v => parseFloat(v.toString()) || 0);

      if (!id_cliente || !id_metodo_pago || productoIds.length === 0) {
        errorMsg = 'Debes seleccionar cliente, método de pago y al menos un producto.';
      } else {
        const itemsAProcesar: { id_producto: number; cantidad: number; precio: number }[] = [];
        for (let i = 0; i < productoIds.length; i++) {
          const pid = productoIds[i];
          const qty = cantidades[i];
          const prc = precios[i];
          if (pid && qty > 0) {
            itemsAProcesar.push({ id_producto: pid, cantidad: qty, precio: prc });
          }
        }

        if (itemsAProcesar.length === 0) {
          errorMsg = 'Debes ingresar al menos un artículo con cantidad válida.';
        } else {
          // Validar stock antes de guardar
          let stockError = '';
          for (const item of itemsAProcesar) {
            const pCheck = await db.select({ stock: Productos.stock, sku: Productos.sku }).from(Productos).where(eq(Productos.id, item.id_producto));
            if (!pCheck[0]) {
              stockError = `El producto ID ${item.id_producto} no existe en el catálogo.`;
              break;
            }
            if (pCheck[0].stock < item.cantidad) {
              stockError = `Stock insuficiente para SKU ${pCheck[0].sku}. Disponible: ${pCheck[0].stock}, Solicitado: ${item.cantidad}.`;
              break;
            }
          }

          if (stockError) {
            errorMsg = stockError;
          } else {
            // Calcular subtotal
            let subtotal = 0;
            for (const item of itemsAProcesar) {
              subtotal += item.cantidad * item.precio;
            }
            const total = subtotal + envio;

            // Iniciar transacción para garantizar persistencia y descuento de stock
            const nuevaVentaId = await db.transaction(async (tx) => {
              const [resVenta] = await tx.insert(Ventas).values({
                id_cliente,
                id_usuario: sessionUserId || null,
                id_metodo_pago,
                fecha_venta: new Date(),
                subtotal: subtotal.toFixed(2),
                envio: envio.toFixed(2),
                total: total.toFixed(2),
                cupon_descuento: cupon,
              });

              const ventaId = Number(resVenta.insertId);

              for (const item of itemsAProcesar) {
                await tx.insert(DetalleVentas).values({
                  id_venta: ventaId,
                  id_producto: item.id_producto,
                  cantidad: item.cantidad,
                  precio_unitario: item.precio.toFixed(2),
                  subtotal: (item.cantidad * item.precio).toFixed(2),
                });

                // Descontar inventario
                await tx.update(Productos)
                  .set({ stock: sql`GREATEST(0, ${Productos.stock} - ${item.cantidad})` })
                  .where(eq(Productos.id, item.id_producto));
              }

              return ventaId;
            });

            return Astro.redirect(`/scm/ventas?detalle=${nuevaVentaId}&ok=1`);
          }
        }
      }
    }
  } catch (e: any) {
    console.error('Error al registrar venta:', e);
    errorMsg = e?.message || 'Error inesperado al registrar la venta.';
  }
}

// Filtros y Parámetros
const qParam          = Astro.url.searchParams.get('q')      || '';
const fromParam       = Astro.url.searchParams.get('from')   || '';
const toParam         = Astro.url.searchParams.get('to')     || '';
const metodoPagoParam = Astro.url.searchParams.get('metodo') || '';
const okParam         = Astro.url.searchParams.get('ok')     || '';
const detalleId       = Astro.url.searchParams.get('detalle');

if (okParam === '1') {
  successMsg = '¡Venta registrada y guardada exitosamente en el sistema!';
}

// Catálogos
const clientesList = await db
  .select({ id: Clientes.id, nombre: Clientes.nombre, correo: Clientes.correo, empresa: Clientes.empresa })
  .from(Clientes)
  .orderBy(Clientes.nombre);

const metodosPagoList = await db.select().from(MetodosPago);

const productosList = await db
  .select({
    id: Productos.id,
    sku: Productos.sku,
    talla_cm: Productos.talla_cm,
    color: Productos.color,
    precio_venta: Productos.precio_venta,
    stock: Productos.stock,
    modelo: Modelos.nombre,
    marca: Marcas.nombre,
  })
  .from(Productos)
  .leftJoin(Modelos, eq(Productos.id_modelo, Modelos.id))
  .leftJoin(Marcas,  eq(Modelos.id_marca, Marcas.id))
  .orderBy(Modelos.nombre);

// Listado de Ventas
const ventasList = await db
  .select({
    id: Ventas.id,
    fecha_venta: Ventas.fecha_venta,
    subtotal: Ventas.subtotal,
    envio: Ventas.envio,
    total: Ventas.total,
    cupon_descuento: Ventas.cupon_descuento,
    cliente_nombre: Clientes.nombre,
    cliente_correo: Clientes.correo,
    cliente_empresa: Clientes.empresa,
    vendedor: Usuarios.nombre,
    metodo_pago: MetodosPago.nombre,
    id_metodo_pago: Ventas.id_metodo_pago,
  })
  .from(Ventas)
  .leftJoin(Clientes,    eq(Ventas.id_cliente,    Clientes.id))
  .leftJoin(Usuarios,    eq(Ventas.id_usuario,    Usuarios.id))
  .leftJoin(MetodosPago, eq(Ventas.id_metodo_pago, MetodosPago.id))
  .orderBy(desc(Ventas.fecha_venta));

// Filtrado de datos
let ventasFiltradas = ventasList.map(v => ({
  ...v,
  total: Number(v.total) || 0,
  subtotal: Number(v.subtotal) || 0,
  envio: Number(v.envio) || 0,
}));

if (qParam) {
  const t = qParam.toLowerCase();
  ventasFiltradas = ventasFiltradas.filter(v =>
    (v.id?.toString() || '').includes(t) ||
    (v.cliente_nombre?.toLowerCase() || '').includes(t) ||
    (v.cliente_correo?.toLowerCase() || '').includes(t) ||
    (v.cliente_empresa?.toLowerCase() || '').includes(t) ||
    (v.metodo_pago?.toLowerCase() || '').includes(t) ||
    (v.vendedor?.toLowerCase() || '').includes(t)
  );
}

if (fromParam) {
  const fd = new Date(fromParam + 'T00:00:00');
  ventasFiltradas = ventasFiltradas.filter(v => v.fecha_venta && new Date(v.fecha_venta) >= fd);
}

if (toParam) {
  const td = new Date(toParam + 'T23:59:59');
  ventasFiltradas = ventasFiltradas.filter(v => v.fecha_venta && new Date(v.fecha_venta) <= td);
}

if (metodoPagoParam) {
  ventasFiltradas = ventasFiltradas.filter(v => v.metodo_pago === metodoPagoParam || String(v.id_metodo_pago) === metodoPagoParam);
}

// Estadísticas
const totalVentas   = ventasList.length;
const totalIngresos = ventasList.reduce((s, v) => s + Number(v.total), 0);
const promedioVenta = totalVentas > 0 ? (totalIngresos / totalVentas) : 0;

const now = new Date();
const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
const ingresosMes = ventasList
  .filter(v => v.fecha_venta && new Date(v.fecha_venta) >= startOfMonth)
  .reduce((s, v) => s + Number(v.total), 0);

// Formateadores
const fmt = (n: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(n);
const fmtDate = (d: Date | null) => d ? new Date(d).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' }) : '---';
const fmtTime = (d: Date | null) => d ? new Date(d).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) : '';

// Detalle de Venta
let detalleVenta: any = null;
let detalleItems: any[] = [];

if (detalleId) {
  const vid = Number(detalleId);
  const vRow = ventasList.find(v => v.id === vid);
  if (vRow) {
    detalleVenta = {
      ...vRow,
      total: Number(vRow.total) || 0,
      subtotal: Number(vRow.subtotal) || 0,
      envio: Number(vRow.envio) || 0,
    };
    detalleItems = await db
      .select({
        id: DetalleVentas.id,
        cantidad: DetalleVentas.cantidad,
        precio_unitario: DetalleVentas.precio_unitario,
        subtotal: DetalleVentas.subtotal,
        sku: Productos.sku,
        talla_cm: Productos.talla_cm,
        color: Productos.color,
        modelo: Modelos.nombre,
        marca: Marcas.nombre,
      })
      .from(DetalleVentas)
      .leftJoin(Productos, eq(DetalleVentas.id_producto, Productos.id))
      .leftJoin(Modelos,   eq(Productos.id_modelo, Modelos.id))
      .leftJoin(Marcas,    eq(Modelos.id_marca, Marcas.id))
      .where(eq(DetalleVentas.id_venta, vid));
  }
}

// Lista limpia de productos
const productosJSON = JSON.stringify(
  productosList.map(p => ({
    id: p.id,
    label: `${p.marca || ''} ${p.modelo || 'Producto'} (SKU: ${p.sku}) | Talla: ${p.talla_cm || 'N/A'} | ${p.color || ''}`,
    precio: Number(p.precio_venta) || 0,
    stock: p.stock || 0,
  }))
);

const backParams = new URLSearchParams();
if (qParam) backParams.set('q', qParam);
if (fromParam) backParams.set('from', fromParam);
if (toParam) backParams.set('to', toParam);
if (metodoPagoParam) backParams.set('metodo', metodoPagoParam);
const backHref = '/scm/ventas' + (backParams.toString() ? '?' + backParams.toString() : '');
---

<CrmLayout title="Ventas" activePath="/scm/ventas">
  <style>
    .ventas-wrap {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .top-actions-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 4px;
    }

    .crm-title {
      font-family: Georgia, serif;
      font-size: 28px;
      font-weight: 400;
      margin: 0 0 4px 0;
      color: var(--color-text);
    }

    .page-subtitle {
      margin: 0;
      font-size: 13px;
      color: var(--color-text-muted);
    }

    /* ── Tarjetas KPI ── */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 4px;
    }

    .kpi-box {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      padding: 18px 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 4px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .kpi-val {
      font-size: 28px;
      font-weight: 900;
      line-height: 1.1;
      color: var(--color-text);
      margin-bottom: 2px;
    }

    .kpi-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--color-text-muted);
    }

    .val-success { color: var(--color-success); }
    .val-blue    { color: #2563eb; }
    .val-warning { color: #d97706; }

    /* ── Contenedor de la Tabla ── */
    .table-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .filters-bar {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .input-search-text {
      flex: 1;
      min-width: 250px;
      padding: 9px 14px;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      font-family: inherit;
      font-size: 13px;
      background: #ffffff;
      color: var(--color-text);
      outline: none;
    }

    .input-search-text:focus {
      border-color: var(--color-text);
    }

    .date-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--color-text-muted);
      font-weight: 600;
    }

    .date-picker, .select-method {
      padding: 8px 12px;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      background: #ffffff;
      color: var(--color-text);
      font-family: inherit;
      font-size: 13px;
      outline: none;
    }

    .date-picker:focus, .select-method:focus {
      border-color: var(--color-text);
    }

    .btn-filter-action {
      background: transparent;
      border: 1px solid var(--color-border);
      color: var(--color-text);
      padding: 8px 16px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-filter-action:hover {
      background: var(--color-bg);
      border-color: var(--color-text);
    }

    .link-clear {
      color: var(--color-danger);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      text-decoration: none;
      padding: 8px 10px;
    }

    .link-clear:hover {
      text-decoration: underline;
    }

    /* ── Estilos de Tabla ── */
    .table-overflow {
      overflow-x: auto;
      margin: 0 -24px;
    }

    .ventas-data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .ventas-data-table th {
      text-align: left;
      padding: 12px 24px;
      border-bottom: 2px solid var(--color-border);
      color: var(--color-text-muted);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 11px;
      letter-spacing: 0.04em;
      background: #ffffff;
    }

    .ventas-data-table td {
      padding: 14px 24px;
      border-bottom: 1px solid var(--color-border);
      vertical-align: middle;
      color: var(--color-text);
    }

    .ventas-data-table tbody tr:hover {
      background: var(--color-bg);
    }

    .col-right  { text-align: right; }
    .col-center { text-align: center; }

    .tag-folio {
      display: inline-block;
      background: #171717;
      color: #ffffff;
      font-family: monospace;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
    }

    .time-hint {
      display: block;
      font-size: 11px;
      color: var(--color-text-muted);
    }

    .client-title {
      font-weight: 700;
      color: var(--color-text);
    }

    .client-desc {
      font-size: 11px;
      color: var(--color-text-muted);
    }

    .method-pill {
      display: inline-block;
      padding: 3px 8px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
      color: #334155;
    }

    .seller-text {
      font-size: 12px;
      color: var(--color-text-muted);
    }

    .amount-display {
      font-size: 14px;
      font-weight: 800;
      color: var(--color-text);
    }

    .shipping-hint {
      font-size: 11px;
      color: var(--color-text-muted);
    }

    .btn-view-details {
      display: inline-block;
      background: #ffffff;
      border: 1px solid var(--color-border);
      color: var(--color-text);
      padding: 5px 12px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-view-details:hover {
      background: var(--color-bg);
      border-color: var(--color-text);
    }

    .empty-state-cell {
      text-align: center;
      padding: 48px 24px !important;
      color: var(--color-text-muted);
    }

    .empty-state-cell p {
      margin: 0 0 16px 0;
      font-size: 14px;
    }

    .table-meta-footer {
      padding-top: 16px;
      font-size: 12px;
      color: var(--color-text-muted);
    }

    /* ── Alertas ── */
    .notification-alert {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 18px;
      border-radius: 8px;
      font-size: 13px;
    }

    .notif-success {
      background: var(--color-success-bg);
      border: 1px solid #bbf7d0;
      color: var(--color-success);
    }

    .notif-danger {
      background: var(--color-danger-light);
      border: 1px solid #fecaca;
      color: var(--color-danger);
    }

    .btn-dismiss-alert {
      background: none;
      border: none;
      font-size: 18px;
      cursor: pointer;
      color: inherit;
      line-height: 1;
    }

    /* ── Modales (.crm-modal) ── */
    .crm-modal {
      border: none;
      border-radius: 12px;
      padding: 0;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      background: #ffffff;
    }

    .crm-modal::backdrop {
      background: rgba(0, 0, 0, 0.5);
    }

    .crm-modal.modal-large {
      max-width: 740px;
    }

    .modal-box-inner {
      padding: 24px;
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 14px;
    }

    .modal-head h2 {
      margin: 0 0 4px 0;
      font-size: 20px;
      color: var(--color-text);
      font-weight: 700;
    }

    .modal-head p {
      margin: 0;
      font-size: 13px;
      color: var(--color-text-muted);
    }

    .btn-dismiss-modal {
      background: none;
      border: none;
      font-size: 26px;
      cursor: pointer;
      color: var(--color-text-muted);
      text-decoration: none;
      line-height: 1;
    }

    .btn-dismiss-modal:hover {
      color: var(--color-text);
    }

    .grid-fields-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 14px;
    }

    .field-wrap {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-wrap label {
      font-size: 12px;
      font-weight: 700;
      color: var(--color-text);
    }

    .field-wrap select,
    .field-wrap input {
      width: 100%;
      padding: 9px 12px;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      font-family: inherit;
      font-size: 13px;
      background: #ffffff;
      color: var(--color-text);
      outline: none;
      box-sizing: border-box;
    }

    .field-wrap select:focus,
    .field-wrap input:focus {
      border-color: var(--color-text);
    }

    /* ── Sección de Artículos ── */
    .order-items-box {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 14px;
      margin-top: 10px;
    }

    .order-items-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .order-items-head label {
      font-size: 12px;
      font-weight: 700;
      color: var(--color-text);
    }

    .btn-add-item-row {
      background: #ffffff;
      border: 1px solid var(--color-border);
      color: var(--color-text);
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 4px;
      cursor: pointer;
    }

    .btn-add-item-row:hover {
      background: var(--color-text);
      color: #ffffff;
    }

    .item-select-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .item-select-table th {
      text-align: left;
      font-size: 11px;
      color: var(--color-text-muted);
      font-weight: 700;
      padding: 6px 8px;
      border-bottom: 1px solid var(--color-border);
    }

    .item-select-table td {
      padding: 8px;
      vertical-align: middle;
    }

    .stock-tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      background: #ffffff;
      border: 1px solid var(--color-border);
    }

    .stock-tag.low-inventory {
      background: #fee2e2;
      border-color: #fca5a5;
      color: #b91c1c;
    }

    .btn-delete-row {
      background: none;
      border: 1px solid #fecaca;
      color: var(--color-danger);
      font-size: 16px;
      width: 24px;
      height: 24px;
      border-radius: 4px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    .btn-delete-row:hover {
      background: #fee2e2;
    }

    /* ── Resumen de Pago ── */
    .totals-summary-strip {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 12px 16px;
      margin-top: 14px;
    }

    .totals-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 4px 0;
      font-size: 13px;
      color: var(--color-text-muted);
    }

    .totals-row strong {
      color: var(--color-text);
    }

    .final-total-row {
      border-top: 1px solid var(--color-border);
      margin-top: 6px;
      padding-top: 8px;
      font-size: 15px;
      color: var(--color-text);
    }

    .modal-actions-footer {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid var(--color-border);
    }

    /* ── Detalle Grid ── */
    .detail-cards-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 14px;
    }

    .detail-card-panel {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 12px 16px;
    }

    .detail-card-panel h4 {
      margin: 0 0 8px 0;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--color-text-muted);
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 4px;
    }

    .detail-card-panel p {
      margin: 4px 0;
      font-size: 13px;
    }

    @media (max-width: 768px) {
      .kpi-row {
        grid-template-columns: 1fr 1fr;
      }
      .grid-fields-2, .detail-cards-2 {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="ventas-wrap">
    
    <!-- Alertas -->
    {successMsg && (
      <div class="notification-alert notif-success">
        <span>✓ {successMsg}</span>
        <button type="button" class="btn-dismiss-alert" onclick="this.parentElement.remove()">×</button>
      </div>
    )}

    {errorMsg && (
      <div class="notification-alert notif-danger">
        <span>⚠️ {errorMsg}</span>
        <button type="button" class="btn-dismiss-alert" onclick="this.parentElement.remove()">×</button>
      </div>
    )}

    <!-- Encabezado y Acción -->
    <div class="top-actions-bar">
      <div>
        <h1 class="crm-title">Historial de Ventas</h1>
        <p class="page-subtitle">Consulta de pedidos completados, facturación y registro de ventas directas</p>
      </div>
      <button
        type="button"
        class="btn-primary"
        onclick="document.getElementById('modalCreateVenta').showModal()"
      >
        + Registrar Venta
      </button>
    </div>

    <!-- Fila de Tarjetas KPI -->
    <div class="kpi-row">
      <div class="kpi-box">
        <div class="kpi-val">{totalVentas}</div>
        <div class="kpi-title">Total de Ventas</div>
      </div>
      <div class="kpi-box">
        <div class="kpi-val val-success">{fmt(totalIngresos)}</div>
        <div class="kpi-title">Ingresos Totales</div>
      </div>
      <div class="kpi-box">
        <div class="kpi-val val-blue">{fmt(ingresosMes)}</div>
        <div class="kpi-title">Ingresos este Mes</div>
      </div>
      <div class="kpi-box">
        <div class="kpi-val val-warning">{fmt(promedioVenta)}</div>
        <div class="kpi-title">Ticket Promedio</div>
      </div>
    </div>

    <!-- Tarjeta Principal con Filtros y Tabla -->
    <div class="table-card">
      <form method="GET" action="/scm/ventas" class="filters-bar">
        <input
          type="text"
          name="q"
          value={qParam}
          placeholder="Buscar por cliente, folio, correo, empresa..."
          class="input-search-text"
        />

        <div class="date-wrap">
          <span>Desde:</span>
          <input type="date" name="from" value={fromParam} class="date-picker" />
        </div>

        <div class="date-wrap">
          <span>Hasta:</span>
          <input type="date" name="to" value={toParam} class="date-picker" />
        </div>

        <select name="metodo" class="select-method">
          <option value="">Todos los métodos de pago</option>
          {metodosPagoList.map(m => (
            <option value={m.nombre} selected={metodoPagoParam === m.nombre || metodoPagoParam === String(m.id)}>
              {m.nombre}
            </option>
          ))}
        </select>

        <button type="submit" class="btn-filter-action">Filtrar</button>

        {(qParam || fromParam || toParam || metodoPagoParam) && (
          <a href="/scm/ventas" class="link-clear">Limpiar</a>
        )}
      </form>

      <!-- Tabla de Ventas -->
      <div class="table-overflow">
        <table class="ventas-data-table">
          <thead>
            <tr>
              <th>Folio</th>
              <th>Fecha y Hora</th>
              <th>Cliente</th>
              <th>Método de Pago</th>
              <th>Atendido por</th>
              <th class="col-right">Total</th>
              <th class="col-center">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {ventasFiltradas.map(v => (
              <tr>
                <td>
                  <span class="tag-folio">#{String(v.id).padStart(5, '0')}</span>
                </td>
                <td>
                  <strong>{fmtDate(v.fecha_venta)}</strong>
                  <span class="time-hint">{fmtTime(v.fecha_venta)}</span>
                </td>
                <td>
                  <div class="client-title">{v.cliente_nombre || 'Cliente General'}</div>
                  <div class="client-desc">{v.cliente_correo || v.cliente_empresa || '---'}</div>
                </td>
                <td>
                  <span class="method-pill">{v.metodo_pago || 'General'}</span>
                </td>
                <td>
                  <span class="seller-text">{v.vendedor || 'Sistema / Online'}</span>
                </td>
                <td class="col-right">
                  <div class="amount-display">{fmt(v.total)}</div>
                  {v.envio > 0 && <div class="shipping-hint">+{fmt(v.envio)} envío</div>}
                </td>
                <td class="col-center">
                  <a
                    href={`/scm/ventas?detalle=${v.id}${qParam ? '&q=' + encodeURIComponent(qParam) : ''}${fromParam ? '&from=' + fromParam : ''}${toParam ? '&to=' + toParam : ''}${metodoPagoParam ? '&metodo=' + encodeURIComponent(metodoPagoParam) : ''}`}
                    class="btn-view-details"
                  >
                    Ver detalle
                  </a>
                </td>
              </tr>
            ))}

            {ventasFiltradas.length === 0 && (
              <tr>
                <td colspan="7" class="empty-state-cell">
                  <p>No se encontraron ventas registradas con los filtros actuales.</p>
                  <button
                    type="button"
                    class="btn-primary"
                    onclick="document.getElementById('modalCreateVenta').showModal()"
                  >
                    + Registrar Venta
                  </button>
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div class="table-meta-footer">
        <span>Mostrando {ventasFiltradas.length} de {ventasList.length} ventas</span>
      </div>
    </div>

    <!-- MODAL: REGISTRAR NUEVA VENTA (dialog nativo con clase crm-modal) -->
    <dialog id="modalCreateVenta" class="crm-modal modal-large">
      <div class="modal-box-inner">
        <div class="modal-head">
          <div>
            <h2>Registrar Nueva Venta</h2>
            <p>Captura los datos del pedido. Se descontará el inventario y se guardará el registro.</p>
          </div>
          <button type="button" class="btn-dismiss-modal" onclick="document.getElementById('modalCreateVenta').close()">×</button>
        </div>

        <form method="POST" action="/scm/ventas" id="formVenta">
          <input type="hidden" name="action" value="create_venta" />

          <div class="grid-fields-2">
            <div class="field-wrap">
              <label>Cliente *</label>
              <select name="id_cliente" required>
                <option value="">-- Seleccionar cliente --</option>
                {clientesList.map(c => (
                  <option value={c.id}>
                    {c.nombre} {c.empresa ? `(${c.empresa})` : ''} - {c.correo}
                  </option>
                ))}
              </select>
            </div>

            <div class="field-wrap">
              <label>Método de Pago *</label>
              <select name="id_metodo_pago" required>
                <option value="">-- Seleccionar método --</option>
                {metodosPagoList.map(m => (
                  <option value={m.id}>{m.nombre}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="grid-fields-2">
            <div class="field-wrap">
              <label>Costo de Envío ($ MXN)</label>
              <input type="number" step="0.01" min="0" id="inputEnvio" name="envio" value="0.00" />
            </div>

            <div class="field-wrap">
              <label>Cupón de Descuento (Opcional)</label>
              <input type="text" name="cupon_descuento" placeholder="Ej. DESCUENTO10" />
            </div>
          </div>

          <!-- Tabla de Artículos Dinámica -->
          <div class="order-items-box">
            <div class="order-items-head">
              <label>Artículos a Vender *</label>
              <button type="button" class="btn-add-item-row" id="btnAddLine">+ Agregar Producto</button>
            </div>

            <table class="item-select-table">
              <thead>
                <tr>
                  <th style="width: 50%;">Producto</th>
                  <th style="width: 15%; text-align: center;">Stock</th>
                  <th style="width: 15%; text-align: right;">Precio</th>
                  <th style="width: 12%; text-align: center;">Cant.</th>
                  <th style="width: 8%;"></th>
                </tr>
              </thead>
              <tbody id="itemsBody">
                <!-- Se llena automáticamente con JS -->
              </tbody>
            </table>
          </div>

          <!-- Resumen de Costos -->
          <div class="totals-summary-strip">
            <div class="totals-row">
              <span>Subtotal artículos:</span>
              <strong id="displaySubtotal">$0.00</strong>
            </div>
            <div class="totals-row">
              <span>Costo de envío:</span>
              <span id="displayEnvio">$0.00</span>
            </div>
            <div class="totals-row final-total-row">
              <span>Total a cobrar:</span>
              <strong id="displayTotal" class="val-success">$0.00</strong>
            </div>
          </div>

          <div class="modal-actions-footer">
            <button type="button" class="btn-outline" onclick="document.getElementById('modalCreateVenta').close()">Cancelar</button>
            <button type="submit" class="btn-primary">Guardar y Registrar Venta</button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- MODAL: DETALLE DE VENTA (dialog nativo) -->
    {detalleVenta && (
      <dialog id="modalDetailVenta" class="crm-modal modal-large" open>
        <div class="modal-box-inner">
          <div class="modal-head">
            <div>
              <h2>Detalle de Venta #{String(detalleVenta.id).padStart(5, '0')}</h2>
              <p>Fecha: {fmtDate(detalleVenta.fecha_venta)} a las {fmtTime(detalleVenta.fecha_venta)}</p>
            </div>
            <a href={backHref} class="btn-dismiss-modal">×</a>
          </div>

          <div class="detail-cards-2">
            <div class="detail-card-panel">
              <h4>Cliente</h4>
              <p><strong>Nombre:</strong> {detalleVenta.cliente_nombre || 'Cliente General'}</p>
              <p><strong>Correo:</strong> {detalleVenta.cliente_correo || '---'}</p>
              {detalleVenta.cliente_empresa && (
                <p><strong>Empresa:</strong> {detalleVenta.cliente_empresa}</p>
              )}
            </div>

            <div class="detail-card-panel">
              <h4>Pago y Registro</h4>
              <p><strong>Método:</strong> <span class="method-pill">{detalleVenta.metodo_pago || 'General'}</span></p>
              <p><strong>Atendido por:</strong> {detalleVenta.vendedor || 'Sistema / Online'}</p>
              {detalleVenta.cupon_descuento && (
                <p><strong>Cupón:</strong> <strong>{detalleVenta.cupon_descuento}</strong></p>
              )}
            </div>
          </div>

          <h4 style="margin: 18px 0 8px; font-size: 13px; text-transform: uppercase; color: var(--color-text-muted);">
            Artículos Comprados ({detalleItems.length})
          </h4>

          <div class="table-overflow">
            <table class="ventas-data-table">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th>SKU</th>
                  <th>Talla</th>
                  <th>Color</th>
                  <th class="col-center">Cant.</th>
                  <th class="col-right">Precio Unit.</th>
                  <th class="col-right">Subtotal</th>
                </tr>
              </thead>
              <tbody>
                {detalleItems.map(item => (
                  <tr>
                    <td><strong>{item.marca ? `${item.marca} ` : ''}{item.modelo || 'Calzado'}</strong></td>
                    <td><code>{item.sku || '---'}</code></td>
                    <td>{item.talla_cm ? `${item.talla_cm} cm` : '---'}</td>
                    <td>{item.color || '---'}</td>
                    <td class="col-center"><strong>{item.cantidad}</strong></td>
                    <td class="col-right">{fmt(Number(item.precio_unitario))}</td>
                    <td class="col-right val-success"><strong>{fmt(Number(item.subtotal))}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="totals-summary-strip" style="margin-top: 16px;">
            <div class="totals-row">
              <span>Subtotal artículos:</span>
              <strong>{fmt(detalleVenta.subtotal)}</strong>
            </div>
            <div class="totals-row">
              <span>Envío:</span>
              <span>{fmt(detalleVenta.envio)}</span>
            </div>
            <div class="totals-row final-total-row">
              <span>Total pagado:</span>
              <strong class="val-success" style="font-size: 18px;">{fmt(detalleVenta.total)}</strong>
            </div>
          </div>

          <div class="modal-actions-footer">
            <button type="button" class="btn-outline" onclick="window.print()">🖨️ Imprimir</button>
            <a href={backHref} class="btn-primary" style="text-decoration: none;">Cerrar</a>
          </div>
        </div>
      </dialog>
    )}

  </div>
</CrmLayout>

<script is:inline define:vars={{ productosCatalog: JSON.parse(productosJSON) }}>
  const itemsBody = document.getElementById('itemsBody');
  const btnAddLine = document.getElementById('btnAddLine');
  const inputEnvio = document.getElementById('inputEnvio');
  const displaySubtotal = document.getElementById('displaySubtotal');
  const displayEnvio = document.getElementById('displayEnvio');
  const displayTotal = document.getElementById('displayTotal');

  function renderOptions() {
    let html = '<option value="">-- Seleccionar calzado / producto --</option>';
    productosCatalog.forEach(p => {
      html += `<option value="${p.id}" data-precio="${p.precio}" data-stock="${p.stock}">
        ${p.label} (Stock: ${p.stock})
      </option>`;
    });
    return html;
  }

  function addRow() {
    if (!itemsBody) return;
    const tr = document.createElement('tr');
    tr.className = 'item-row';
    tr.innerHTML = `
      <td>
        <select name="producto_id[]" required class="prod-select" style="width: 100%; padding: 8px; border: 1px solid var(--color-border); border-radius: 4px; font-family: inherit; font-size: 13px;">
          ${renderOptions()}
        </select>
        <input type="hidden" name="precio_unitario[]" class="prod-price-input" value="0" />
      </td>
      <td style="text-align: center;">
        <span class="stock-tag">--</span>
      </td>
      <td style="text-align: right;">
        <span class="price-val" style="font-weight: 700;">$0.00</span>
      </td>
      <td style="text-align: center;">
        <input
          type="number"
          name="cantidad[]"
          min="1"
          value="1"
          required
          class="qty-input"
          style="width: 60px; text-align: center; padding: 6px; border: 1px solid var(--color-border); border-radius: 4px;"
        />
      </td>
      <td style="text-align: center;">
        <button type="button" class="btn-delete-row" title="Quitar">×</button>
      </td>
    `;

    const sel = tr.querySelector('.prod-select');
    const qty = tr.querySelector('.qty-input');
    const removeBtn = tr.querySelector('.btn-delete-row');
    const stockTag = tr.querySelector('.stock-tag');
    const priceVal = tr.querySelector('.price-val');
    const priceInput = tr.querySelector('.prod-price-input');

    sel.addEventListener('change', () => {
      const opt = sel.selectedOptions[0];
      if (opt && opt.value) {
        const precio = parseFloat(opt.getAttribute('data-precio') || '0');
        const stock = parseInt(opt.getAttribute('data-stock') || '0', 10);
        priceInput.value = precio.toFixed(2);
        priceVal.textContent = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(precio);
        
        stockTag.textContent = stock;
        if (stock <= 3) {
          stockTag.className = 'stock-tag low-inventory';
        } else {
          stockTag.className = 'stock-tag';
        }
        qty.max = stock > 0 ? stock : 1;
      } else {
        priceInput.value = '0';
        priceVal.textContent = '$0.00';
        stockTag.textContent = '--';
        stockTag.className = 'stock-tag';
      }
      calcTotals();
    });

    qty.addEventListener('input', calcTotals);

    removeBtn.addEventListener('click', () => {
      if (itemsBody.children.length > 1) {
        tr.remove();
        calcTotals();
      } else {
        alert('Debe haber al menos un producto en la venta.');
      }
    });

    itemsBody.appendChild(tr);
    calcTotals();
  }

  function calcTotals() {
    let subtotal = 0;
    const rows = document.querySelectorAll('.item-row');
    rows.forEach(r => {
      const sel = r.querySelector('.prod-select');
      const qtyInput = r.querySelector('.qty-input');
      const opt = sel?.selectedOptions[0];
      if (opt && opt.value) {
        const precio = parseFloat(opt.getAttribute('data-precio') || '0');
        const qty = parseInt(qtyInput?.value || '0', 10);
        subtotal += precio * qty;
      }
    });

    const envio = Math.max(0, parseFloat(inputEnvio?.value || '0') || 0);
    const total = subtotal + envio;

    const fmtMoney = (n) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(n);

    if (displaySubtotal) displaySubtotal.textContent = fmtMoney(subtotal);
    if (displayEnvio) displayEnvio.textContent = fmtMoney(envio);
    if (displayTotal) displayTotal.textContent = fmtMoney(total);
  }

  if (btnAddLine) btnAddLine.addEventListener('click', addRow);
  if (inputEnvio) inputEnvio.addEventListener('input', calcTotals);

  if (itemsBody && itemsBody.children.length === 0) {
    addRow();
  }
</script>
