---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Modelos, Marcas, Categorias, Productos, Proveedores, Notificaciones, PedidosCompra } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import { procesarLogisticaStock } from '../../lib/stockLogistics';
import fs from 'node:fs/promises';
import path from 'node:path';

// El middleware ya limita /scm a administrador y logística
const sessionUser = Astro.locals.user;
if (!sessionUser) return Astro.redirect('/login');

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'create_producto') {
    const nombre = formData.get('nombre') as string;
    const descripcion = formData.get('descripcion') as string;
    const id_categoria = formData.get('id_categoria') && Number(formData.get('id_categoria')) > 0 ? Number(formData.get('id_categoria')) : null;
    const id_proveedor = formData.get('id_proveedor') && Number(formData.get('id_proveedor')) > 0 ? Number(formData.get('id_proveedor')) : null;
    const id_marca = formData.get('id_marca') && Number(formData.get('id_marca')) > 0 ? Number(formData.get('id_marca')) : null;
    const stock = Number(formData.get('stock')) || 0;
    const stock_minimo = Number(formData.get('stock_minimo')) || 0;
    const estrategia_logistica = ((formData.get('estrategia_logistica') as string) || 'PUSH').toUpperCase();
    const costo = (formData.get('costo') as string) || '0.00';
    const color = (formData.get('color') as string) || '';
    const theme_class = (formData.get('theme_class') as string) || '';
    const precio_venta = (formData.get('precio_venta') as string) || '0.00';
    const precio_base = '0.00';
    
    let imagen_url = null;
    const imagenFile = formData.get('imagen_archivo') as File;
    if (imagenFile && imagenFile.size > 0) {
      const buf = Buffer.from(await imagenFile.arrayBuffer());
      const fileName = `${Date.now()}-${imagenFile.name}`;
      const filePath = path.join(process.cwd(), 'public', 'img', 'productos', fileName);
      await fs.mkdir(path.dirname(filePath), { recursive: true });
      await fs.writeFile(filePath, buf);
      imagen_url = `/img/productos/${fileName}`;
    }
    
    // Create Modelo
    const [modeloResult] = await db.insert(Modelos).values({
      id_marca, id_categoria, nombre, descripcion, precio_base, imagen_url
    });
    
    const id_modelo = modeloResult.insertId;
    const sku = `SCM-${Date.now()}`;
    const estado = 'Activo';

    // Create Producto
    const [productoResult] = await db.insert(Productos).values({
      id_modelo, id_proveedor, sku, stock, stock_minimo, estrategia_logistica, costo, precio_venta, estado, color, theme_class
    });
    
    const newProductId = productoResult.insertId;

    // PUSH repone automáticamente; PULL genera una alerta para pedido manual.
    await procesarLogisticaStock({ id_producto: newProductId, id_usuario: sessionUser.id });
    
    return Astro.redirect(Astro.url.pathname);
  } else if (action === 'update_producto') {
    const id = Number(formData.get('id'));
    const nombre = formData.get('nombre') as string;
    const descripcion = formData.get('descripcion') as string;
    const id_categoria = formData.get('id_categoria') && Number(formData.get('id_categoria')) > 0 ? Number(formData.get('id_categoria')) : null;
    const id_proveedor = formData.get('id_proveedor') && Number(formData.get('id_proveedor')) > 0 ? Number(formData.get('id_proveedor')) : null;
    const id_marca = formData.get('id_marca') && Number(formData.get('id_marca')) > 0 ? Number(formData.get('id_marca')) : null;
    const stock = Number(formData.get('stock')) || 0;
    const stock_minimo = Number(formData.get('stock_minimo')) || 0;
    const estrategia_logistica = ((formData.get('estrategia_logistica') as string) || 'PUSH').toUpperCase();
    const costo = (formData.get('costo') as string) || '0.00';
    const precio_venta = (formData.get('precio_venta') as string) || '0.00';
    const color = (formData.get('color') as string) || '';
    const theme_class = (formData.get('theme_class') as string) || '';

    let imagen_url = undefined;
    const imagenFile = formData.get('imagen_archivo') as File;
    if (imagenFile && imagenFile.size > 0) {
      const buf = Buffer.from(await imagenFile.arrayBuffer());
      const fileName = `${Date.now()}-${imagenFile.name}`;
      const filePath = path.join(process.cwd(), 'public', 'img', 'productos', fileName);
      await fs.mkdir(path.dirname(filePath), { recursive: true });
      await fs.writeFile(filePath, buf);
      imagen_url = `/img/productos/${fileName}`;
    }

    const producto = await db.select().from(Productos).where(eq(Productos.id, id));
    if (producto.length > 0) {
      const id_modelo = producto[0].id_modelo;
      await db.update(Modelos).set({ id_marca, id_categoria, nombre, descripcion, ...(imagen_url ? { imagen_url } : {}) }).where(eq(Modelos.id, id_modelo));
      await db.update(Productos).set({ id_proveedor, stock, stock_minimo, estrategia_logistica, costo, precio_venta, color, theme_class }).where(eq(Productos.id, id));

      // PUSH repone automáticamente; PULL genera una alerta para pedido manual.
      await procesarLogisticaStock({ id_producto: id, id_usuario: sessionUser.id });
    }
    return Astro.redirect(Astro.url.pathname);
  } else if (action === 'create_marca') {
    const nombre = formData.get('nombre') as string;
    await db.insert(Marcas).values({ nombre });
    return Astro.redirect(Astro.url.pathname);
  } else if (action === 'create_categoria') {
    const nombre = formData.get('nombre') as string;
    await db.insert(Categorias).values({ nombre });
    return Astro.redirect(Astro.url.pathname);
  } else if (action === 'delete_producto') {
    const id = Number(formData.get('id'));
    const producto = await db.select().from(Productos).where(eq(Productos.id, id));
    if (producto.length > 0) {
      const id_modelo = producto[0].id_modelo;
      await db.delete(Productos).where(eq(Productos.id, id));
      await db.delete(Modelos).where(eq(Modelos.id, id_modelo));
    }
    return Astro.redirect(Astro.url.pathname);
  }
}

// Procesar productos bajo mínimo: reabastecimiento PUSH automático o alerta PULL manual.
await procesarLogisticaStock({ id_usuario: sessionUser.id });

const categoriasList = await db.select().from(Categorias);
const proveedoresList = await db.select().from(Proveedores);
const marcasList = await db.select().from(Marcas);

// Fetch unified products for SCM
const productosList = await db
  .select({
    id: Productos.id,
    id_categoria: Modelos.id_categoria,
    id_proveedor: Productos.id_proveedor,
    id_marca: Modelos.id_marca,
    nombre: Modelos.nombre,
    descripcion: Modelos.descripcion,
    marca: Marcas.nombre,
    categoria: Categorias.nombre,
    proveedor: Proveedores.nombre,
    stock: Productos.stock,
    stock_minimo: Productos.stock_minimo,
    estrategia: Productos.estrategia_logistica,
    costo: Productos.costo,
    precio_venta: Productos.precio_venta,
    color: Productos.color,
    theme_class: Productos.theme_class,
    imagen_url: Modelos.imagen_url,
  })
  .from(Productos)
  .leftJoin(Modelos, eq(Productos.id_modelo, Modelos.id))
  .leftJoin(Categorias, eq(Modelos.id_categoria, Categorias.id))
  .leftJoin(Proveedores, eq(Productos.id_proveedor, Proveedores.id))
  .leftJoin(Marcas, eq(Modelos.id_marca, Marcas.id));


const q = Astro.url.searchParams.get('q');
let productosFiltrados = productosList;

if (q) {
  const searchTerm = q.toLowerCase();
  productosFiltrados = productosFiltrados.filter((item: any) => 
    (item.nombre && item.nombre.toLowerCase().includes(searchTerm)) || (item.marca && item.marca.toLowerCase().includes(searchTerm)) || (item.categoria && item.categoria.toLowerCase().includes(searchTerm)) || (item.proveedor && item.proveedor.toLowerCase().includes(searchTerm))
  );
}
---

<CrmLayout title="Productos SCM" activePath="/scm/productos">
  <div class="header-actions">
    <h1 class="crm-title">Catálogo SCM</h1>
    <div style="display: flex; gap: 10px;">
      <button class="btn-primary" onclick="document.getElementById('modalCreateMarca').showModal()">+ Nueva Marca</button>
      <button class="btn-primary" onclick="document.getElementById('modalCreateCategoria').showModal()">+ Nueva Categoría</button>
      <button class="btn-primary" onclick="document.getElementById('modalCreateProducto').showModal()">+ Nuevo Producto</button>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-number">{productosList.length}</div>
      <div class="stat-label">Total Productos</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-auto">{marcasList.length}</div>
      <div class="stat-label">Marcas Registradas</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-warning">{categoriasList.length}</div>
      <div class="stat-label">Categorías</div>
    </div>
  </div>

  <div class="crm-card">
          <!-- Buscador local funcional -->
      <form method="GET" style="margin: 0; flex: 1; max-width: 400px; display: flex; position: relative; margin-bottom: 24px;" id="searchForm">
        <input type="search" name="q" value={q || ""} placeholder="Buscar..." class="search-input" style="width: 100%; padding-right: 40px;" />
        <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-text-muted);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Marca</th>
            <th>Categoría</th>
            <th>Proveedor</th>
            <th>Color / Estilo</th>
            <th>Stock Actual</th>
            <th>Estrategia</th>
            <th>Precio / Costo</th>
            <th class="text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {productosFiltrados.map(producto => (
            <tr>
              <td><strong>{producto.nombre}</strong></td>
              <td>{producto.marca || 'N/A'}</td>
              <td>{producto.categoria || 'N/A'}</td>
              <td>{producto.proveedor || 'N/A'}</td>
              <td>
                {producto.color || 'N/A'}<br/>
                <small style="color: #666;">{producto.theme_class || 'N/A'}</small>
              </td>
              <td>
                <span class={`badge ${producto.stock > (producto.stock_minimo || 0) ? 'badge-success' : 'badge-danger'}`}>
                  {producto.stock}
                </span>
                <span style="font-size: 11px; color: #a3a3a3; display: block; margin-top: 4px;">Min: {producto.stock_minimo || 0}</span>
              </td>
              <td><span class={`badge ${producto.estrategia === 'PULL' ? 'badge-pull' : 'badge-push'}`}>{producto.estrategia === 'PULL' ? 'PULL (Manual)' : 'PUSH (Auto)'}</span></td>
              <td>
                Venta: ${producto.precio_venta}<br/>
                <small style="color:#666;">Costo: ${producto.costo}</small>
              </td>
              <td class="text-right" style="white-space: nowrap;">
                <button 
                  class="action-btn" 
                  title="Editar" 
                  onclick={`openEditProducto(${producto.id}, '${producto.nombre}', \`${producto.descripcion || ''}\`, ${producto.id_categoria || 'null'}, ${producto.id_proveedor || 'null'}, ${producto.id_marca || 'null'}, ${producto.stock}, ${producto.stock_minimo || 0}, '${producto.estrategia || 'PUSH'}', '${producto.costo}', '${producto.precio_venta}', '${producto.color || ''}', '${producto.theme_class || ''}')`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                <form method="POST" style="display:inline;" data-confirm="¿Eliminar este producto permanentemente?" data-confirm-title="Eliminar producto" data-confirm-accept="Eliminar">
                  <input type="hidden" name="action" value="delete_producto" />
                  <input type="hidden" name="id" value={producto.id} />
                  <button type="submit" class="action-btn text-danger" title="Eliminar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
              </td>
            </tr>
          ))}
          {productosFiltrados.length === 0 && (
            <tr>
              <td colspan="7" style="text-align: center; color: var(--color-text-muted);">No hay productos registrados.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal: Crear Producto SCM (como en la imagen) -->
  <dialog id="modalCreateProducto" class="crm-modal scm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Nuevo producto</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalCreateProducto').close()">×</button>
      </div>
      <form method="POST" class="scm-form" enctype="multipart/form-data">
        <input type="hidden" name="action" value="create_producto" />
        
        <div class="form-row">
          <label>Nombre</label>
          <input type="text" name="nombre" placeholder="Nombre del producto" required />
        </div>
        
        <div class="form-row">
          <label>Descripción</label>
          <textarea name="descripcion" placeholder="Descripción..." rows="3"></textarea>
        </div>

        <div class="form-row">
          <label>Color</label>
          <input type="text" name="color" placeholder="Ej. Rojo / Negro" />
        </div>

        <div class="form-row">
          <label>Imagen del producto</label>
          <input type="file" name="imagen_archivo" accept="image/*" />
        </div>

        <div class="form-row">
          <label>Estilo visual (Si no hay imagen)</label>
          <div class="select-wrapper">
            <select name="theme_class">
              <option value="">(Ninguno)</option>
              <option value="product-padel">Pádel (Pelota/Raqueta)</option>
              <option value="product-shoe">Tenis (Zapato)</option>
              <option value="product-shirt">Ropa (Camiseta)</option>
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Marca</label>
          <div class="select-wrapper">
            <select name="id_marca" required>
              <option value="" disabled selected>Selecciona una marca</option>
              {marcasList.map(m => <option value={m.id}>{m.nombre}</option>)}
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Categoria</label>
          <div class="select-wrapper">
            <select name="id_categoria" required>
              <option value="" disabled selected>Selecciona una categoría</option>
              {categoriasList.map(c => <option value={c.id}>{c.nombre}</option>)}
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Proveedor</label>
          <div class="select-wrapper">
            <select name="id_proveedor" required>
              <option value="" disabled selected>Selecciona un proveedor</option>
              {proveedoresList.map(p => <option value={p.id}>{p.nombre}</option>)}
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Stock actual</label>
          <input type="number" name="stock" value="0" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
        </div>
        
        <div class="form-row">
          <label>Stock minimo</label>
          <input type="number" name="stock_minimo" value="0" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
        </div>
        
        <div class="form-row">
          <label>Estrategia logistica</label>
          <div class="select-wrapper">
            <select name="estrategia_logistica" required>
              <option value="PUSH" selected>PUSH (Automático)</option>
              <option value="PULL">PULL (Manual)</option>
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Costo unitario</label>
          <input type="number" step="0.001" name="costo" value="0.000" required oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" />
        </div>

        <div class="form-row">
          <label>Precio de venta</label>
          <input type="number" step="0.001" name="precio_venta" value="0.000" required oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" />
        </div>
        
        <div class="modal-footer" style="justify-content: center; gap: 16px; margin-top: 32px;">
          <button type="button" class="btn-cancel" onclick="document.getElementById('modalCreateProducto').close()">Cancelar</button>
          <button type="submit" class="btn-save">Guardar</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal: Editar Producto SCM -->
  <dialog id="modalEditProducto" class="crm-modal scm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar producto</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalEditProducto').close()">×</button>
      </div>
      <form method="POST" class="scm-form" enctype="multipart/form-data">
        <input type="hidden" name="action" value="update_producto" />
        <input type="hidden" name="id" id="edit_producto_id" />
        
        <div class="form-row">
          <label>Nombre</label>
          <input type="text" name="nombre" id="edit_producto_nombre" required />
        </div>
        
        <div class="form-row">
          <label>Descripción</label>
          <textarea name="descripcion" id="edit_producto_descripcion" rows="3"></textarea>
        </div>

        <div class="form-row">
          <label>Color</label>
          <input type="text" name="color" id="edit_producto_color" placeholder="Ej. Rojo / Negro" />
        </div>

        <div class="form-row">
          <label>Nueva imagen</label>
          <input type="file" name="imagen_archivo" accept="image/*" />
        </div>

        <div class="form-row">
          <label>Estilo visual (Si no hay imagen)</label>
          <div class="select-wrapper">
            <select name="theme_class" id="edit_producto_theme">
              <option value="">(Ninguno)</option>
              <option value="product-padel">Pádel (Pelota/Raqueta)</option>
              <option value="product-shoe">Tenis (Zapato)</option>
              <option value="product-shirt">Ropa (Camiseta)</option>
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Marca</label>
          <div class="select-wrapper">
            <select name="id_marca" id="edit_producto_marca" required>
              {marcasList.map(m => <option value={m.id}>{m.nombre}</option>)}
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Categoria</label>
          <div class="select-wrapper">
            <select name="id_categoria" id="edit_producto_categoria" required>
              {categoriasList.map(c => <option value={c.id}>{c.nombre}</option>)}
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Proveedor</label>
          <div class="select-wrapper">
            <select name="id_proveedor" id="edit_producto_proveedor" required>
              {proveedoresList.map(p => <option value={p.id}>{p.nombre}</option>)}
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Stock actual</label>
          <input type="number" name="stock" id="edit_producto_stock" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
        </div>
        
        <div class="form-row">
          <label>Stock minimo</label>
          <input type="number" name="stock_minimo" id="edit_producto_stock_minimo" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
        </div>
        
        <div class="form-row">
          <label>Estrategia logistica</label>
          <div class="select-wrapper">
            <select name="estrategia_logistica" id="edit_producto_estrategia" required>
              <option value="PUSH">PUSH (Automático)</option>
              <option value="PULL">PULL (Manual)</option>
            </select>
          </div>
        </div>
        
        <div class="form-row">
          <label>Costo unitario</label>
          <input type="number" step="0.001" name="costo" id="edit_producto_costo" required oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" />
        </div>

        <div class="form-row">
          <label>Precio de venta</label>
          <input type="number" step="0.001" name="precio_venta" id="edit_producto_precio" required oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" />
        </div>
        
        <div class="modal-footer" style="justify-content: center; gap: 16px; margin-top: 32px;">
          <button type="button" class="btn-cancel" onclick="document.getElementById('modalEditProducto').close()">Cancelar</button>
          <button type="submit" class="btn-save">Actualizar</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal: Crear Categoría SCM -->
  <dialog id="modalCreateCategoria" class="crm-modal scm-modal" style="max-width: 400px;">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Nueva Categoría</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalCreateCategoria').close()">×</button>
      </div>
      <form method="POST" class="scm-form">
        <input type="hidden" name="action" value="create_categoria" />
        <div class="form-row" style="flex-direction: column;">
          <label style="width: 100%;">Nombre de la categoría *</label>
          <input type="text" name="nombre" required placeholder="Ej. Raquetas" style="margin-top: 8px;" />
        </div>
        <div class="modal-footer" style="justify-content: flex-end; gap: 12px; margin-top: 24px;">
          <button type="button" class="btn-cancel" onclick="document.getElementById('modalCreateCategoria').close()">Cancelar</button>
          <button type="submit" class="btn-save">Guardar Categoría</button>
        </div>
