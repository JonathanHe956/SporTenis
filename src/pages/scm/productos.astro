<script is:inline>
  function openEditProducto(id, nombre, descripcion, id_categoria, id_proveedor, id_marca, stock, stock_minimo, estrategia, costo, precio_venta, color, theme_class) {
    document.getElementById('edit_producto_id').value = id;
    document.getElementById('edit_producto_nombre').value = nombre;
    document.getElementById('edit_producto_descripcion').value = descripcion;
    if (id_marca) document.getElementById('edit_producto_marca').value = id_marca;
    if (id_categoria) document.getElementById('edit_producto_categoria').value = id_categoria;
    if (id_proveedor) document.getElementById('edit_producto_proveedor').value = id_proveedor;
    document.getElementById('edit_producto_stock').value = stock;
    document.getElementById('edit_producto_stock_minimo').value = stock_minimo;
    document.getElementById('edit_producto_estrategia').value = estrategia;
    document.getElementById('edit_producto_costo').value = costo;
    document.getElementById('edit_producto_precio').value = precio_venta;
    document.getElementById('edit_producto_color').value = color || '';
    document.getElementById('edit_producto_theme').value = theme_class || '';
    document.getElementById('modalEditProducto').showModal();
  }
</script>

