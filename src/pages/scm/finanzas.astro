---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Ventas, DetalleVentas, Productos } from '../../db/schema';
import { eq } from 'drizzle-orm';

const ventas = await db.select({
  id: Ventas.id,
  total: Ventas.total,
  subtotal: Ventas.subtotal,
  fecha_venta: Ventas.fecha_venta,
}).from(Ventas);

const detalles = await db.select({
  cantidad: DetalleVentas.cantidad,
  costo: Productos.costo,
}).from(DetalleVentas)
  .leftJoin(Productos, eq(DetalleVentas.id_producto, Productos.id));

const ingresosTotales = ventas.reduce((sum, venta) => sum + (Number(venta.total) || 0), 0);
const ventasProductos = ventas.reduce((sum, venta) => sum + (Number(venta.subtotal) || 0), 0);
const costoVendido = detalles.reduce((sum, detalle) => {
  return sum + detalle.cantidad * (Number(detalle.costo) || 0);
}, 0);
const ganancia = ventasProductos - costoVendido;
const margen = ventasProductos > 0 ? (ganancia / ventasProductos) * 100 : 0;
const unidadesVendidas = detalles.reduce((sum, detalle) => sum + detalle.cantidad, 0);

const fmt = (value: number) => new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
}).format(value);
const fmtPercent = (value: number) => `${value.toFixed(1)}%`;
---

<CrmLayout title="Finanzas" activePath="/scm/finanzas">
  <div class="finance-header">
    <div>
      <h1 class="crm-title">Finanzas básicas</h1>
      <p class="page-subtitle">Rentabilidad calculada a partir de las ventas y el costo actual de cada producto.</p>
    </div>
    <a class="back-link" href="/crm/ventas">Ver ventas</a>
  </div>

  <section class="finance-grid" aria-label="Resumen financiero">
    <article class="finance-card revenue-card">
      <span class="card-label">Ingresos totales (ventas)</span>
      <strong>{fmt(ingresosTotales)}</strong>
      <small>{ventas.length} venta{ventas.length === 1 ? '' : 's'} registradas</small>
    </article>
    <article class="finance-card cost-card">
      <span class="card-label">Costo de lo vendido</span>
      <strong>{fmt(costoVendido)}</strong>
      <small>{unidadesVendidas} unidad{unidadesVendidas === 1 ? '' : 'es'} vendida{unidadesVendidas === 1 ? '' : 's'}</small>
    </article>
    <article class="finance-card profit-card">
      <span class="card-label">Ganancia bruta</span>
      <strong>{fmt(ganancia)}</strong>
      <small>Ventas de productos menos costo</small>
    </article>
  </section>

  <section class="finance-detail">
    <div class="detail-heading">
      <div>
        <h2>Resultado de operación</h2>
        <p>El margen se calcula sobre el subtotal de productos, sin incluir el envío.</p>
      </div>
      <span class="margin-badge">Margen {fmtPercent(margen)}</span>
    </div>

    <div class="comparison-row">
      <div class="comparison-item">
        <span>Ventas de productos</span>
        <strong>{fmt(ventasProductos)}</strong>
      </div>
      <div class="comparison-sign">-</div>
      <div class="comparison-item">
        <span>Costo de lo vendido</span>
        <strong>{fmt(costoVendido)}</strong>
      </div>
      <div class="comparison-sign">=</div>
      <div class="comparison-item result-item">
        <span>Ganancia bruta</span>
        <strong>{fmt(ganancia)}</strong>
      </div>
    </div>

    <p class="finance-note">Los ingresos totales incluyen el envío cobrado en cada venta. La ganancia bruta compara únicamente el subtotal de productos contra su costo.</p>
  </section>
</CrmLayout>

<style>
  .finance-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .crm-title { margin: 0 0 5px; font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: var(--color-text); }
  .page-subtitle { margin: 0; color: var(--color-text-muted); font-size: 13px; }
  .back-link { color: var(--color-text); font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .back-link:hover { text-decoration: underline; }
  .finance-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 24px; }
  .finance-card, .finance-detail { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; }
  .finance-card { display: flex; flex-direction: column; gap: 9px; padding: 22px; border-top: 4px solid var(--accent); }
  .revenue-card { --accent: #2563eb; }
  .cost-card { --accent: #d97706; }
  .profit-card { --accent: #16a34a; }
  .card-label { color: var(--color-text-muted); font-size: 13px; font-weight: 700; }
  .finance-card strong { color: var(--color-text); font-size: 28px; line-height: 1.1; }
  .finance-card small { color: var(--color-text-muted); font-size: 12px; }
  .finance-detail { padding: 26px; }
  .detail-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .detail-heading h2 { margin: 0 0 6px; font-size: 18px; }
  .detail-heading p, .finance-note { margin: 0; color: var(--color-text-muted); font-size: 12px; }
  .margin-badge { padding: 8px 12px; border-radius: 999px; background: rgba(22, 163, 74, .12); color: #15803d; font-size: 13px; font-weight: 800; white-space: nowrap; }
  .comparison-row { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 18px; padding: 22px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .comparison-item { display: flex; flex-direction: column; gap: 8px; }
  .comparison-item span { color: var(--color-text-muted); font-size: 12px; }
  .comparison-item strong { font-size: 20px; }
  .result-item strong { color: #15803d; }
  .comparison-sign { color: var(--color-text-muted); font-size: 24px; }
  .finance-note { margin-top: 18px; }
  @media (max-width: 760px) {
    .finance-header, .detail-heading { flex-direction: column; }
    .finance-grid { grid-template-columns: 1fr; }
    .comparison-row { grid-template-columns: 1fr; gap: 12px; }
    .comparison-sign { display: none; }
  }
</style>
