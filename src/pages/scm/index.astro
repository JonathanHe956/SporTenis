---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Productos, Proveedores, Modelos, PedidosCompra, MovimientosInventario } from '../../db/schema';
import { eq } from 'drizzle-orm';

// 1. Fetch complete product data including logistics strategy
const todosLosProductos = await db
  .select({
    id: Productos.id,
    sku: Productos.sku,
    nombre: Modelos.nombre,
    imagen_url: Modelos.imagen_url,
    stock: Productos.stock,
    stock_minimo: Productos.stock_minimo,
    costo: Productos.costo,
    precio_venta: Productos.precio_venta,
    estrategia_logistica: Productos.estrategia_logistica,
    id_proveedor: Productos.id_proveedor,
    proveedor_nombre: Proveedores.nombre,
  })
  .from(Productos)
  .leftJoin(Modelos, eq(Productos.id_modelo, Modelos.id))
  .leftJoin(Proveedores, eq(Productos.id_proveedor, Proveedores.id));

const todosLosProveedores = await db.select().from(Proveedores);

// 2. Fetch supply chain orders and movements for auto-assessment
let totalPedidos = 0;
let pedidosAutomaticos = 0;
try {
  const pedidos = await db.select({ id: PedidosCompra.id, tipo: PedidosCompra.tipo }).from(PedidosCompra);
  totalPedidos = pedidos.length;
  pedidosAutomaticos = pedidos.filter(p => p.tipo === 'AUTOMATICO').length;
} catch (e) {
  // Table empty or fallback
}

let totalMovimientos = 0;
try {
  const movs = await db.select({ id: MovimientosInventario.id }).from(MovimientosInventario);
  totalMovimientos = movs.length;
} catch (e) {
  // Table empty or fallback
}

// 3. Compute baseline metrics
const totalProveedores = todosLosProveedores.length;
const totalProductos = todosLosProductos.length;

let inventarioTotal = 0;
let valorInventario = 0;
const productosBajoStock: any[] = [];

// Push vs Pull breakdown
let pushCount = 0;
let pullCount = 0;
let pushStock = 0;
let pullStock = 0;
let pushValor = 0;
let pullValor = 0;
const pushProductos: any[] = [];
const pullProductos: any[] = [];

for (const p of todosLosProductos) {
  const stock = Number(p.stock || 0);
  const costo = Number(p.costo || 0);
  const valor = stock * costo;
  const estrategia = (p.estrategia_logistica || 'PUSH').toUpperCase();

  inventarioTotal += stock;
  valorInventario += valor;

  if (stock <= Number(p.stock_minimo || 0)) {
    productosBajoStock.push(p);
  }

  if (estrategia === 'PULL') {
    pullCount++;
    pullStock += stock;
    pullValor += valor;
    pullProductos.push({ ...p, stock, costo, valor, estrategia: 'PULL' });
  } else {
    pushCount++;
    pushStock += stock;
    pushValor += valor;
    pushProductos.push({ ...p, stock, costo, valor, estrategia: 'PUSH' });
  }
}

const totalEstrategias = pushCount + pullCount;
const pushPct = totalEstrategias > 0 ? Math.round((pushCount / totalEstrategias) * 100) : 50;
const pullPct = 100 - pushPct;

const totalStockEstrategias = pushStock + pullStock;
const pushStockPct = totalStockEstrategias > 0 ? Math.round((pushStock / totalStockEstrategias) * 100) : 50;
const pullStockPct = 100 - pushStockPct;

// Currency Formatter
const formatter = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  maximumFractionDigits: 2,
});

// 4. Auto-detection state for SCM Maturity Checklist
const autoDetection = {
  c1: totalProveedores > 0,
  c2: totalPedidos > 0,
  c3: todosLosProductos.some(p => p.id_proveedor != null),
  c4: todosLosProductos.some(p => Number(p.stock_minimo) > 0),
  c5: pushCount > 0 && pullCount > 0,
  c6: true, // Alertas activas en dashboard
  c7: totalMovimientos > 0,
  c8: false, // Auditoría periódica (manual)
  c9: valorInventario > 0,
  c10: totalPedidos > 0,
  c11: pedidosAutomaticos > 0 || pullCount > 0,
  c12: totalPedidos > 0,
  c13: true, // Reportes de rotación activos
  c14: false, // Plan contingencia (manual)
  c15: true, // Sincronización Ventas-SCM activa
};
---

<CrmLayout title="Inicio SCM" activePath="/scm">
  <!-- Header con acciones y badges de estado -->
  <div class="scm-header-bar">
    <div>
      <div class="header-badges">
        <span class="badge-tag live-tag"><span class="pulse-dot"></span> SCM Activo</span>
        <span class="badge-tag">SporTenis Supply Chain</span>
      </div>
      <h1 class="crm-title">Resumen de Cadena de Suministros</h1>
      <p class="scm-subtitle">Control integral de inventarios, flujo de abastecimiento y madurez operativa</p>
    </div>
    <div class="header-action-buttons">
      <a href="/scm/pedidos" class="btn-scm-action secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
        Órdenes de Compra
      </a>
      <a href="/scm/productos" class="btn-scm-action primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Gestionar Productos
      </a>
    </div>
  </div>

  <!-- Métricas principales -->
  <div class="metrics-grid">
    <div class="crm-card metric-card">
      <div class="metric-top">
        <h3>Total de Proveedores</h3>
        <span class="metric-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
        </span>
      </div>
      <div class="metric-value">{totalProveedores}</div>
      <p class="metric-desc">Directorio de socios comerciales activos</p>
    </div>
    
    <div class="crm-card metric-card">
      <div class="metric-top">
        <h3>Total de Productos</h3>
        <span class="metric-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 16V8l-8-4-8 4v8l8 4 8-4Z"/><polyline points="4 8 12 12 20 8"/><polyline points="12 12 12 20"/></svg>
        </span>
      </div>
      <div class="metric-value">{totalProductos}</div>
      <p class="metric-desc">Referencias y modelos en catálogo</p>
    </div>

    <div class="crm-card metric-card">
      <div class="metric-top">
        <h3>Inventario Físico</h3>
        <span class="metric-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </span>
      </div>
      <div class="metric-value text-success">{inventarioTotal}</div>
      <p class="metric-desc">Pares y unidades totales disponibles</p>
    </div>

    <div class="crm-card metric-card">
      <div class="metric-top">
        <h3>Valor del Inventario</h3>
        <span class="metric-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
      </div>
      <div class="metric-value currency-value">{formatter.format(valorInventario)}</div>
      <p class="metric-desc">Capital total inmovilizado a costo</p>
    </div>
  </div>

  <!-- Widgets Secundarios: Alertas y Salud -->
  <div class="dashboard-widgets">
    <!-- Widget: Alertas de Stock -->
    <div class="crm-card widget-card">
      <div class="widget-header-flex">
        <h3>Alertas de Stock Crítico</h3>
        <span class={`status-pill ${productosBajoStock.length > 0 ? 'status-danger' : 'status-success'}`}>
          {productosBajoStock.length} alertas
        </span>
      </div>
      <div class="risk-list">
        {productosBajoStock.length > 0 ? (
          productosBajoStock.slice(0, 5).map(p => (
            <a href="/scm/productos" class="risk-item">
              <div>
                <strong>{p.nombre}</strong>
                <p>Stock actual: {p.stock} (Mínimo: {p.stock_minimo}) &bull; <span class="tag-strategy">{p.estrategia_logistica || 'PUSH'}</span></p>
              </div>
              <span class="text-danger risk-badge">Reabastecer</span>
            </a>
          ))
        ) : (
          <div class="healthy-state">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <p>Todos los productos cumplen con su nivel de stock de seguridad.</p>
          </div>
        )}
      </div>
      {productosBajoStock.length > 5 && (
        <a href="/scm/productos" class="view-all">Ver los {productosBajoStock.length} productos bajo stock &rarr;</a>
      )}
    </div>

    <!-- Widget: Salud del Inventario -->
    <div class="crm-card widget-card">
      <div class="widget-header-flex">
        <h3>Salud del Inventario</h3>
        <span class="status-pill status-info">
          {totalProductos > 0 ? Math.round(((totalProductos - productosBajoStock.length) / totalProductos) * 100) : 100}% Saludable
        </span>
      </div>
      <div class="chart-container">
        <div class="health-bar-row">
          <div class="health-label">
            <span class="indicator-dot green"></span>
            <strong>Productos con Stock Saludable</strong>
            <span class="health-val">{totalProductos - productosBajoStock.length} de {totalProductos}</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill fill-green" style={`width: ${totalProductos > 0 ? ((totalProductos - productosBajoStock.length) / totalProductos) * 100 : 0}%;`}></div>
          </div>
        </div>
        
        <div class="health-bar-row">
          <div class="health-label">
            <span class="indicator-dot red"></span>
            <strong>Productos en Riesgo / Quiebre</strong>
            <span class="health-val">{productosBajoStock.length} de {totalProductos}</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill fill-red" style={`width: ${totalProductos > 0 ? (productosBajoStock.length / totalProductos) * 100 : 0}%;`}></div>
          </div>
        </div>

        <div class="health-footer-stats">
          <div class="footer-stat">
            <span>Rotación estimada</span>
            <strong>Media-Alta</strong>
          </div>
          <div class="footer-stat">
            <span>Riesgo de quiebre</span>
            <strong class={productosBajoStock.length > 3 ? 'text-danger' : 'text-success'}>
              {productosBajoStock.length > 3 ? 'Atención Requerida' : 'Bajo Control'}
            </strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- WIDGET COMPARATIVO: PUSH vs PULL                                      -->
  <!-- ===================================================================== -->
  <section class="crm-card scm-feature-section" id="widget-push-pull">
    <div class="feature-header">
      <div class="feature-title-group">
        <span class="feature-badge">Estrategia Logística</span>
        <h2>Widget Comparativo: Modelo Push vs Pull</h2>
        <p>Análisis de reabastecimiento, asignación en catálogo de SporTenis y simulador interactivo de políticas de inventario.</p>
      </div>
      
      <!-- Mini resumen en vivo -->
      <div class="push-pull-summary-pill">
        <div class="pill-col push-col">
          <span class="pill-dot push-dot"></span>
          <span class="pill-name">PUSH (Empuje):</span>
          <strong>{pushPct}%</strong> ({pushCount} prod &bull; {formatter.format(pushValor)})
        </div>
        <div class="pill-divider"></div>
        <div class="pill-col pull-col">
          <span class="pill-dot pull-dot"></span>
          <span class="pill-name">PULL (Arrastre):</span>
          <strong>{pullPct}%</strong> ({pullCount} prod &bull; {formatter.format(pullValor)})
        </div>
      </div>
    </div>

    <!-- Barra de distribución en vivo -->
    <div class="distribution-track" title={`Catálogo: ${pushPct}% Push / ${pullPct}% Pull`}>
      <div class="track-segment segment-push" style={`width: ${pushPct}%;`}>
        <span>PUSH: {pushPct}% ({pushStock} uds &bull; {pushStockPct}%)</span>
      </div>
      <div class="track-segment segment-pull" style={`width: ${pullPct}%;`}>
        <span>PULL: {pullPct}% ({pullStock} uds &bull; {pullStockPct}%)</span>
      </div>
    </div>

    <!-- Pestañas del Widget -->
    <div class="feature-tabs" role="tablist">
      <button class="feature-tab active" type="button" data-pp-tab="tab-matriz">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Matriz Comparativa & Flujo
      </button>
      <button class="feature-tab" type="button" data-pp-tab="tab-simulador">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
        Simulador Estratégico (Trade-off)
      </button>
      <button class="feature-tab" type="button" data-pp-tab="tab-catalogo">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Productos SporTenis por Estrategia ({totalProductos})
      </button>
    </div>

    <!-- Pestaña 1: Matriz Comparativa y Flujo Operativo -->
    <div class="pp-panel active" id="tab-matriz">
      <div class="push-pull-grid">
        <!-- Tarjeta PUSH -->
        <div class="strategy-card push-card">
          <div class="strategy-badge-header">
            <span class="tag-push">ESTRATEGIA PUSH</span>
            <span class="strategy-alias">Make-to-Stock (Empuje por Pronóstico)</span>
          </div>

          <p class="strategy-summary">
            El flujo de abastecimiento se activa de forma anticipada con base en proyecciones y previsiones de ventas. Los productos se compran por lotes y se almacenan esperando la compra del cliente.
          </p>

          <!-- Diagrama de Flujo PUSH -->
          <div class="flow-diagram">
            <div class="flow-step">
              <span class="step-num">1</span>
              <span class="step-text">Pronóstico de demanda</span>
            </div>
            <div class="flow-arrow">&rarr;</div>
            <div class="flow-step">
              <span class="step-num">2</span>
              <span class="step-text">Compra por lote masivo</span>
            </div>
            <div class="flow-arrow">&rarr;</div>
            <div class="flow-step">
              <span class="step-num">3</span>
              <span class="step-text">Almacén central</span>
            </div>
            <div class="flow-arrow">&rarr;</div>
            <div class="flow-step highlight">
              <span class="step-num">4</span>
              <span class="step-text">Stock en tienda</span>
            </div>
          </div>

          <div class="strategy-specs-table">
            <div class="spec-row">
              <span class="spec-label">Disparador:</span>
              <span class="spec-val">Pronósticos de venta a mediano plazo y temporadas</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Nivel de Stock:</span>
              <span class="spec-val text-warning">Alto (Colchón de seguridad permanente)</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Lead Time al Cliente:</span>
              <span class="spec-val text-success">Inmediato (Disponibilidad en estante)</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Ventajas:</span>
              <span class="spec-val">Economías de escala en fletes y compras al mayoreo</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Riesgos:</span>
              <span class="spec-val text-danger">Obsolescencia, costo de almacenaje y descuentos forzados</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Aplicación SporTenis:</span>
              <span class="spec-val">Zapatillas básicas blancas, calzado escolar y modelos de alta demanda constante</span>
            </div>
            <div class="spec-row highlight-row">
              <span class="spec-label">En Sistema SporTenis:</span>
              <span class="spec-val">Órdenes manuales programadas en <code>/scm/pedidos</code></span>
            </div>
          </div>
        </div>

        <!-- Tarjeta PULL -->
        <div class="strategy-card pull-card">
          <div class="strategy-badge-header">
            <span class="tag-pull">ESTRATEGIA PULL</span>
            <span class="strategy-alias">Make-to-Order / JIT (Arrastre por Demanda Real)</span>
          </div>

          <p class="strategy-summary">
            El reabastecimiento solo se dispara cuando ocurre una venta o cuando las existencias descienden al stock mínimo. La mercancía fluye ágilmente en lotes pequeños Just-In-Time.
          </p>

          <!-- Diagrama de Flujo PULL -->
          <div class="flow-diagram">
            <div class="flow-step highlight">
              <span class="step-num">1</span>
              <span class="step-text">Venta o stock mínimo</span>
            </div>
            <div class="flow-arrow">&rarr;</div>
            <div class="flow-step">
              <span class="step-num">2</span>
              <span class="step-text">Disparo automático / Kanban</span>
            </div>
            <div class="flow-arrow">&rarr;</div>
            <div class="flow-step">
              <span class="step-num">3</span>
              <span class="step-text">Pedido ágil a proveedor</span>
            </div>
            <div class="flow-arrow">&rarr;</div>
            <div class="flow-step">
              <span class="step-num">4</span>
              <span class="step-text">Recepción Justo a Tiempo</span>
            </div>
          </div>

          <div class="strategy-specs-table">
            <div class="spec-row">
              <span class="spec-label">Disparador:</span>
              <span class="spec-val">Demanda real del cliente o agotamiento de stock mínimo</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Nivel de Stock:</span>
              <span class="spec-val text-success">Mínimo / Magro (Inventario Lean)</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Lead Time al Cliente:</span>
              <span class="spec-val">Sujeto al tiempo de entrega rápido del proveedor</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Ventajas:</span>
              <span class="spec-val">Cero sobrestock, menor capital inmovilizado, alta flexibilidad</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Riesgos:</span>
              <span class="spec-val text-danger">Quiebre si el proveedor falla o ante picos imprevistos</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Aplicación SporTenis:</span>
              <span class="spec-val">Ediciones limitadas, tallas extremas y modelos premium de pádel/running</span>
            </div>
            <div class="spec-row highlight-row">
              <span class="spec-label">En Sistema SporTenis:</span>
              <span class="spec-val">Pedidos automáticos instantáneos (<code>tipo: AUTOMATICO</code>)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Estrategia Híbrida Banner -->
      <div class="hybrid-banner">
        <div class="hybrid-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </div>
        <div>
          <h4>Estrategia Óptima SporTenis: Cadena Híbrida Push-Pull con Punto de Desacople</h4>
          <p>La mejor práctica para nuestra tienda deportiva es operar los <strong>modelos clásicos y siluetas base bajo PUSH</strong> (garantizando disponibilidad inmediata con economías de escala), y las <strong>colecciones de temporada, colores especiales y tallas de baja rotación bajo PULL</strong> (minimizando el riesgo de remate o saldo muerto).</p>
        </div>
      </div>
    </div>

    <!-- Pestaña 2: Simulador Estratégico (Trade-off) -->
    <div class="pp-panel" id="tab-simulador">
      <div class="simulator-wrapper">
        <div class="simulator-controls">
          <div class="simulator-header-box">
            <h3>Simulador de Equilibrio Push-Pull</h3>
            <p>Ajusta el porcentaje de catálogo operado bajo cada estrategia para simular el impacto en costos de posesión, riesgo de desabasto y agilidad.</p>
          </div>

          <!-- Slider Interactivo -->
          <div class="slider-container">
            <div class="slider-labels">
              <span class="label-push"><strong id="sim-push-val">65%</strong> PUSH (Empuje)</span>
              <span class="label-center">Punto de Desacople</span>
              <span class="label-pull"><strong id="sim-pull-val">35%</strong> PULL (Arrastre)</span>
            </div>
            <input type="range" min="0" max="100" value="65" class="pp-slider" id="pushPullSlider" />
            <div class="slider-ticks">
              <span>0% Push (100% Pull)</span>
              <span>50% / 50%</span>
              <span>100% Push (0% Pull)</span>
            </div>
          </div>

          <!-- Medidores reactivos de impacto -->
          <div class="impact-grid">
            <div class="impact-card">
              <div class="impact-title">
                <span>Costo de Almacenamiento & Capital</span>
                <strong id="sim-costo-tag">Medio-Alto</strong>
              </div>
              <div class="meter-track">
                <div class="meter-bar" id="sim-meter-costo" style="width: 65%;"></div>
              </div>
              <p class="impact-caption" id="sim-costo-desc">Requiere bodega amplia para absorber pedidos en volumen.</p>
