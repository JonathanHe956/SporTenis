<script>
  // =========================================================================
  // LOGICA DEL CLIENTE: WIDGET PUSH VS PULL Y CHECKLIST INTERACTIVO
  // =========================================================================
  document.addEventListener('DOMContentLoaded', () => {
    // -----------------------------------------------------------------------
    // 1. TABS DEL WIDGET PUSH VS PULL
    // -----------------------------------------------------------------------
    const ppTabs = document.querySelectorAll<HTMLButtonElement>('[data-pp-tab]');
    const ppPanels = document.querySelectorAll<HTMLElement>('.pp-panel');

    ppTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-pp-tab');
        ppTabs.forEach(t => t.classList.remove('active'));
        ppPanels.forEach(p => p.classList.remove('active'));

        tab.classList.add('active');
        const targetPanel = document.getElementById(targetId || '');
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // -----------------------------------------------------------------------
    // 2. SIMULADOR ESTRATÉGICO PUSH VS PULL
    // -----------------------------------------------------------------------
    const slider = document.getElementById('pushPullSlider') as HTMLInputElement | null;
    const simPushVal = document.getElementById('sim-push-val');
    const simPullVal = document.getElementById('sim-pull-val');
    const simMeterCosto = document.getElementById('sim-meter-costo');
    const simMeterQuiebre = document.getElementById('sim-meter-quiebre');
    const simMeterAgilidad = document.getElementById('sim-meter-agilidad');
    const simCostoTag = document.getElementById('sim-costo-tag');
    const simQuiebreTag = document.getElementById('sim-quiebre-tag');
    const simAgilidadTag = document.getElementById('sim-agilidad-tag');
    const simCostoDesc = document.getElementById('sim-costo-desc');
    const simQuiebreDesc = document.getElementById('sim-quiebre-desc');
    const simAgilidadDesc = document.getElementById('sim-agilidad-desc');
    const simDiagTitle = document.getElementById('sim-diag-title');
    const simDiagText = document.getElementById('sim-diag-text');
    const simDiagIcon = document.getElementById('sim-diag-icon');

    function updateSimulator(pushVal: number) {
      const pullVal = 100 - pushVal;
      if (simPushVal) simPushVal.textContent = `${pushVal}%`;
      if (simPullVal) simPullVal.textContent = `${pullVal}%`;

      // Costo de almacenamiento: Proporcional a Push
      const costoScore = Math.round(15 + (pushVal * 0.75));
      if (simMeterCosto) simMeterCosto.style.width = `${costoScore}%`;
      if (simCostoTag) {
        simCostoTag.textContent = pushVal > 75 ? 'Muy Alto' : pushVal > 50 ? 'Medio-Alto' : pushVal > 25 ? 'Moderado' : 'Mínimo';
        simCostoTag.style.color = pushVal > 70 ? 'var(--color-danger)' : 'inherit';
      }
      if (simCostoDesc) {
        simCostoDesc.textContent = pushVal > 70
          ? 'Alto riesgo de capital congelado y costos de almacenaje prolongado.'
          : pushVal < 30
          ? 'Costo de tenencia muy bajo; almacén central casi libre de stock excedente.'
          : 'Costo de almacenamiento bajo balance controlado.';
      }

      // Riesgo de quiebre (Stockout): Proporcional a Pull si no hay proveedores hiperrápidos
      const quiebreScore = Math.round(10 + (pullVal * 0.8));
      if (simMeterQuiebre) simMeterQuiebre.style.width = `${quiebreScore}%`;
      if (simQuiebreTag) {
        simQuiebreTag.textContent = pullVal > 70 ? 'Muy Crítico' : pullVal > 45 ? 'Moderado' : 'Bajo Control';
        simQuiebreTag.style.color = pullVal > 60 ? 'var(--color-danger)' : 'var(--color-success)';
      }
      if (simQuiebreDesc) {
        simQuiebreDesc.textContent = pullVal > 60
          ? 'Peligro de pérdida de ventas ante retrasos de proveedores o picos de temporada.'
          : 'Colchón de seguridad adecuado para modelos de alta demanda.';
      }

      // Agilidad: Proporcional a Pull
      const agilidadScore = Math.round(20 + (pullVal * 0.75));
      if (simMeterAgilidad) simMeterAgilidad.style.width = `${agilidadScore}%`;
      if (simAgilidadTag) {
        simAgilidadTag.textContent = pullVal > 65 ? 'Sobresaliente' : pullVal > 40 ? 'Buena' : 'Rígida';
      }
      if (simAgilidadDesc) {
        simAgilidadDesc.textContent = pullVal > 50
          ? 'Alta adaptabilidad a lanzamientos de calzado de temporada y modas cambiantes.'
          : 'Cadena con mayor inercia; cambios de modelos requieren agotar inventario previo.';
      }

      // Diagnóstico dinámico
      if (simDiagTitle && simDiagText && simDiagIcon) {
        if (pushVal >= 80) {
          simDiagIcon.textContent = '⚠️';
          simDiagTitle.textContent = 'Enfoque Push Excesivo (Riesgo de Sobreinventario)';
          simDiagText.textContent = 'Operar más del 80% en Push eleva el costo financiero del inventario inmovilizado y expone a SporTenis a rebajas forzadas por cambios de temporada.';
        } else if (pushVal <= 30) {
          simDiagIcon.textContent = '⚡';
          simDiagTitle.textContent = 'Enfoque Pull Agresivo (Alta Vulnerabilidad Logística)';
          simDiagText.textContent = 'Operar con más del 70% en Pull requiere proveedores locales con tiempos de entrega de menos de 48 horas. De lo contrario, se presentarán quiebres en tallas centrales.';
        } else {
          simDiagIcon.textContent = '🎯';
          simDiagTitle.textContent = 'Equilibrio Óptimo para SporTenis (Estrategia Híbrida 60/40)';
          simDiagText.textContent = 'Configuración recomendada: Push para la silueta base y tenis clásicos de rotación segura, y Pull para ediciones especiales, marcas premium o tallas periféricas.';
        }
      }
    }

    if (slider) {
      slider.addEventListener('input', (e) => {
        const val = Number((e.target as HTMLInputElement).value);
        updateSimulator(val);
      });
      // Initial trigger
      updateSimulator(Number(slider.value));
    }

    // -----------------------------------------------------------------------
    // 3. EVALUACIÓN DE NIVEL SCM (CHECKLIST INTERACTIVO)
    // -----------------------------------------------------------------------
    const STORAGE_KEY = 'sportenis_scm_checklist_v2';
    const checkboxes = document.querySelectorAll<HTMLInputElement>('.scm-checkbox');
    const maturityScorePct = document.getElementById('maturityScorePct');
    const maturityCirclePath = document.getElementById('maturityCirclePath');
    const maturityBadge = document.getElementById('maturityBadge');
    const maturityTitle = document.getElementById('maturityTitle');
    const maturityDesc = document.getElementById('maturityDesc');
    const maturityRoadmapText = document.getElementById('maturityRoadmapText');
    const criteriaCounter = document.getElementById('criteriaCounter');
    const toast = document.getElementById('scmToast');

    // Dimension indicators
    const dimBars: Record<string, { bar: HTMLElement | null; text: HTMLElement | null }> = {
      'cat-aprov': {
        bar: document.getElementById('dim-bar-aprov'),
        text: document.getElementById('dim-val-aprov'),
      },
      'cat-plan': {
        bar: document.getElementById('dim-bar-plan'),
        text: document.getElementById('dim-val-plan'),
      },
      'cat-almacen': {
        bar: document.getElementById('dim-bar-almacen'),
        text: document.getElementById('dim-val-almacen'),
      },
      'cat-distrib': {
        bar: document.getElementById('dim-bar-distrib'),
        text: document.getElementById('dim-val-distrib'),
      },
      'cat-mejora': {
        bar: document.getElementById('dim-bar-mejora'),
        text: document.getElementById('dim-val-mejora'),
      },
    };

    // Niveles SCM
    const NIVELES = [
      {
        min: 0,
        max: 25,
        badge: 'NIVEL 1: REACTIVO / BÁSICO',
        color: '#dc2626',
        title: 'Cadena de Suministro Básica & Reactiva',
        desc: 'Procesos informales con compras de emergencia, visibilidad fragmentada y alto riesgo de desabasto.',
        nextStep: 'Estandarizar directorio de proveedores, registrar stocks mínimos y fijar alertas tempranas.',
      },
      {
        min: 26,
        max: 55,
        badge: 'NIVEL 2: ESTANDARIZADO / OPERATIVO',
        color: '#f59e0b',
        title: 'Cadena Estandarizada en Crecimiento',
        desc: 'Parámetros definidos de stock mínimo, gestión formal de compras y control manual de almacén.',
        nextStep: 'Implementar conteos cíclicos, automatizar pedidos de reposición Pull y medir cumplimiento OTIF.',
      },
      {
        min: 56,
        max: 85,
        badge: 'NIVEL 3: INTEGRADO Y COLABORATIVO',
        color: '#2563eb',
        title: 'Cadena Integrada & Sincronizada',
        desc: 'Sincronización activa entre ventas y reabastecimiento, diferenciación Push/Pull y analítica de rotación.',
        nextStep: 'Consolidar convenios de lead time estricto, contingencias de aprovisionamiento y auditorías cíclicas.',
      },
      {
        min: 86,
        max: 100,
        badge: 'NIVEL 4: OPTIMIZADO (CLASE MUNDIAL 4.0)',
        color: '#15803d',
        title: 'Cadena de Suministro Ágil & Predictiva',
        desc: 'Máxima resiliencia, visibilidad en tiempo real, automatización Pull eficiente y cero pérdidas por desabasto.',
        nextStep: 'Mantener mejora continua, incorporar analítica predictiva de demanda y alianzas JIT avanzadas.',
      },
    ];

    function calculateMaturity() {
      let checkedCount = 0;
      const total = checkboxes.length;
      const dimCounts: Record<string, { checked: number; total: number }> = {
        'cat-aprov': { checked: 0, total: 0 },
        'cat-plan': { checked: 0, total: 0 },
        'cat-almacen': { checked: 0, total: 0 },
        'cat-distrib': { checked: 0, total: 0 },
        'cat-mejora': { checked: 0, total: 0 },
      };

      const savedState: Record<string, boolean> = {};

      checkboxes.forEach(cb => {
        const isChecked = cb.checked;
        savedState[cb.id] = isChecked;

        const parentCard = cb.closest<HTMLElement>('.check-item-card');
        const cat = parentCard?.getAttribute('data-cat') || '';

        if (dimCounts[cat]) {
          dimCounts[cat].total++;
          if (isChecked) dimCounts[cat].checked++;
        }

        if (isChecked) checkedCount++;

        // Visual check style on parent card
        if (parentCard) {
          if (isChecked) {
            parentCard.classList.add('checked');
          } else {
            parentCard.classList.remove('checked');
          }
        }
      });

      // Save to localStorage
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(savedState));
      } catch (e) {
        // quota
      }

      const scorePct = total > 0 ? Math.round((checkedCount / total) * 100) : 0;

      // Update Hero display
      if (maturityScorePct) maturityScorePct.textContent = `${scorePct}%`;
      if (maturityCirclePath) maturityCirclePath.setAttribute('stroke-dasharray', `${scorePct}, 100`);
      if (criteriaCounter) criteriaCounter.textContent = `${checkedCount} de ${total} criterios cumplidos`;

      // Determine level
      const currentLevel = NIVELES.find(n => scorePct >= n.min && scorePct <= n.max) || NIVELES[0];

      if (maturityBadge) {
        maturityBadge.textContent = currentLevel.badge;
        maturityBadge.style.backgroundColor = currentLevel.color;
      }
      if (maturityTitle) maturityTitle.textContent = currentLevel.title;
      if (maturityDesc) maturityDesc.textContent = currentLevel.desc;
      if (maturityRoadmapText) maturityRoadmapText.textContent = currentLevel.nextStep;

      // Update dimension bars
      for (const [key, obj] of Object.entries(dimCounts)) {
        const dimInfo = dimBars[key];
        if (dimInfo) {
          const dimPct = obj.total > 0 ? Math.round((obj.checked / obj.total) * 100) : 0;
          if (dimInfo.bar) dimInfo.bar.style.width = `${dimPct}%`;
          if (dimInfo.text) dimInfo.text.textContent = `${obj.checked}/${obj.total}`;
        }
      }
    }

    // Load initial states (localStorage or auto-detection fallback)
    function loadInitialChecklist() {
      let savedData: Record<string, boolean> | null = null;
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) savedData = JSON.parse(raw);
      } catch (e) {}

      checkboxes.forEach(cb => {
        if (savedData && savedData[cb.id] !== undefined) {
          cb.checked = Boolean(savedData[cb.id]);
        } else {
          // Use auto-detection attribute
          cb.checked = cb.getAttribute('data-auto') === 'true';
        }

        cb.addEventListener('change', calculateMaturity);
      });

      calculateMaturity();
    }

    loadInitialChecklist();

    // Reset to auto-detected values
    const btnResetAuto = document.getElementById('btnResetAuto');
    if (btnResetAuto) {
      btnResetAuto.addEventListener('click', () => {
        checkboxes.forEach(cb => {
          cb.checked = cb.getAttribute('data-auto') === 'true';
        });
        calculateMaturity();
        showToast('Restablecido a valores detectados en el sistema');
      });
    }

    // Check all
    const btnCheckAll = document.getElementById('btnCheckAll');
    if (btnCheckAll) {
      btnCheckAll.addEventListener('click', () => {
        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
        checkboxes.forEach(cb => {
          cb.checked = !allChecked;
        });
        calculateMaturity();
        showToast(allChecked ? 'Todos los criterios desmarcados' : 'Todos los criterios marcados');
      });
    }

    // Filter Chips
    const filterChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const checkCards = document.querySelectorAll<HTMLElement>('.check-item-card');

    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');

        const filter = chip.getAttribute('data-filter') || 'all';

        checkCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-cat') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Copy diagnostic report
    const btnCopyReport = document.getElementById('btnCopyReport');
    if (btnCopyReport) {
      btnCopyReport.addEventListener('click', () => {
        const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
        const total = checkboxes.length;
        const score = total > 0 ? Math.round((checkedCount / total) * 100) : 0;
        const badge = maturityBadge?.textContent || 'N/A';
        const title = maturityTitle?.textContent || '';
        const dateStr = new Date().toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });

        const report = `DIAGNÓSTICO DE MADUREZ SCM — SPORTENIS
Fecha: ${dateStr}
Resultado: ${score}% de Madurez (${checkedCount}/${total} criterios cumplidos)
Nivel Alcanzado: ${badge}
Estado: ${title}

Criterios Completados:
${Array.from(checkboxes).map((cb, idx) => {
  const card = cb.closest<HTMLElement>('.check-item-card');
  const title = card?.querySelector('strong')?.textContent || `Criterio ${idx + 1}`;
  return `${cb.checked ? '✅' : '❌'} ${title}`;
}).join('\n')}

Generado desde el Dashboard SCM SporTenis.`;

        navigator.clipboard.writeText(report).then(() => {
          showToast('Informe de madurez copiado al portapapeles');
        }).catch(() => {
          showToast('Error al copiar informe');
        });
      });
    }

    function showToast(msg: string) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('visible');
      setTimeout(() => {
        toast.classList.remove('visible');
      }, 2500);
    }
  });
</script>

