---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Productos, Modelos, Proveedores, Marcas, Categorias, PedidosCompra, MovimientosInventario } from '../../db/schema';
import { eq, desc, or, and, isNull } from 'drizzle-orm';

const session = Astro.cookies.get('sportenis_session')?.value;
if (!session) return Astro.redirect('/login');
const sessionUserId = Number(session);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'create_pedido') {
    const id_producto = Number(formData.get('id_producto'));
    const cantidad = Number(formData.get('cantidad'));
    const tipo = formData.get('tipo')?.toString() || 'Reposición';
    const id_proveedor_form = formData.get('id_proveedor');

    const producto = await db.select().from(Productos).where(eq(Productos.id, id_producto));
    const id_proveedor = id_proveedor_form ? Number(id_proveedor_form) : (producto.length > 0 ? producto[0].id_proveedor : null);
    const stock_anterior = producto.length > 0 ? producto[0].stock : 0;

    await db.insert(PedidosCompra).values({
      id_producto,
      id_proveedor,
      cantidad,
      tipo: tipo,
      estado: 'Pendiente',
      fecha_creacion: new Date(),
      // stock_anterior,
      // stock_posterior: null,
    });

    return Astro.redirect(Astro.url.pathname);
  }

  if (action === 'completar_pedido') {
    const id = Number(formData.get('id'));

    const pedido = await db.select().from(PedidosCompra).where(eq(PedidosCompra.id, id));
    if (pedido.length > 0) {
      const p = pedido[0];

      const producto = await db.select().from(Productos).where(eq(Productos.id, p.id_producto));
      if (producto.length > 0) {
        const newStock = producto[0].stock + p.cantidad;
        await db.update(Productos).set({ stock: newStock }).where(eq(Productos.id, p.id_producto));

        // Registrar el movimiento automáticamente
        try {
          await db.insert(MovimientosInventario).values({
            id_producto: p.id_producto,
            tipo: 'Entrada',
            cantidad: p.cantidad,
            motivo: 'Pedido',
            fecha: new Date(),
            id_usuario: sessionUserId,
          });
        } catch (e) {
          console.error("Error al registrar movimiento:", e);
        }

        await db.update(PedidosCompra).set({
          estado: 'Completado',
          fecha_completado: new Date(),
          // stock_anterior: p.stock_anterior ?? producto[0].stock,
          // stock_posterior: newStock,
        }).where(eq(PedidosCompra.id, id));
      } else {
        await db.update(PedidosCompra).set({
          estado: 'Completado',
          fecha_completado: new Date(),
        }).where(eq(PedidosCompra.id, id));
      }
    }

    return Astro.redirect(Astro.url.pathname);
  }

  if (action === 'cancelar_pedido') {
    const id = Number(formData.get('id'));
    await db.update(PedidosCompra).set({ estado: 'Cancelado' }).where(eq(PedidosCompra.id, id));
    return Astro.redirect(Astro.url.pathname);
  }

  if (action === 'update_stock') {
    const id = Number(formData.get('id'));
    const operacion = formData.get('operacion');
    const cantidad = Number(formData.get('cantidad') || 1);
    const motivo = formData.get('motivo') || 'Ajuste Manual';

    const producto = await db.select().from(Productos).where(eq(Productos.id, id));
    if (producto.length > 0) {
      let newStock = producto[0].stock;
      if (operacion === 'add') {
        newStock += cantidad;
        await db.insert(MovimientosInventario).values({
          id_producto: id,
          tipo: 'Entrada',
          cantidad: cantidad,
          motivo: motivo,
          fecha: new Date(),
          id_usuario: sessionUserId,
        });
      }
      if (operacion === 'sub' && newStock >= cantidad) {
        newStock -= cantidad;
        await db.insert(MovimientosInventario).values({
          id_producto: id,
          tipo: 'Salida',
          cantidad: cantidad,
          motivo: motivo,
          fecha: new Date(),
          id_usuario: sessionUserId,
        });
      }

      await db.update(Productos).set({ stock: newStock }).where(eq(Productos.id, id));
    }
    return Astro.redirect(Astro.url.pathname);
  }
}



const productosList = await db
  .select({
    id: Productos.id,
    sku: Productos.sku,
    talla_cm: Productos.talla_cm,
    color: Productos.color,
    stock: Productos.stock,
    stock_minimo: Productos.stock_minimo,
    estrategia_logistica: Productos.estrategia_logistica,
    nombre: Modelos.nombre,
    imagen_url: Modelos.imagen_url,
    marca: Marcas.nombre,
    categoria: Categorias.nombre,
    proveedor: Proveedores.nombre,
  })
  .from(Productos)
  .leftJoin(Modelos, eq(Productos.id_modelo, Modelos.id))
  .leftJoin(Marcas, eq(Modelos.id_marca, Marcas.id))
  .leftJoin(Categorias, eq(Modelos.id_categoria, Categorias.id))
  .leftJoin(Proveedores, eq(Productos.id_proveedor, Proveedores.id));

const pedidosRaw = await db.select().from(PedidosCompra).orderBy(desc(PedidosCompra.fecha_creacion));
const movimientosRaw = await db.select().from(MovimientosInventario).orderBy(desc(MovimientosInventario.fecha));
const proveedoresList = await db.select().from(Proveedores);

const productosAgrupados = productosList.map(prod => {
  const pedidos = pedidosRaw.filter(p => p.id_producto === prod.id);
  const movimientos = movimientosRaw.filter(m => m.id_producto === prod.id);
  const pendientes = pedidos.filter(p => p.estado === 'Pendiente');
  const cantidadPendiente = pendientes.reduce((sum, p) => sum + p.cantidad, 0);

  return {
    ...prod,
    pedidos,
    movimientos,
    pendientes,
    cantidadPendiente,
    total_pedidos: pedidos.length
  };
});

const q = Astro.url.searchParams.get('q');
let productosFiltrados = productosAgrupados;

if (q) {
  const searchTerm = q.toLowerCase();
  productosFiltrados = productosFiltrados.filter(item =>
    (item.nombre && item.nombre.toLowerCase().includes(searchTerm)) ||
    (item.proveedor && item.proveedor.toLowerCase().includes(searchTerm)) ||
    (item.sku && item.sku.toLowerCase().includes(searchTerm))
  );
}
---

<CrmLayout title="Inventario y Pedidos" activePath="/scm/pedidos">
  <div class="header-actions">
    <div>
      <h1 class="crm-title">Inventario y Pedidos (Altas/Bajas)</h1>
      <p class="subtitle">Agrupado por producto para ver su historial de movimientos y pedidos activos</p>
    </div>
    <div style="display: flex; gap: 10px;">
      
    </div>
  </div>

  <div class="crm-card">
    <form method="GET" style="margin: 0; flex: 1; max-width: 400px; display: flex; position: relative; margin-bottom: 24px;" id="searchForm">
      <input type="search" name="q" value={q || ""} placeholder="Buscar por producto, proveedor o SKU..." class="search-input" style="width: 100%; padding-right: 40px;" />
      <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-text-muted);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>
    
    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>Producto</th>
            <th>Proveedor</th>
            <th>Stock Actual</th>
            <th>Pedidos en Curso</th>
            <th>Estrategia</th>
            <th style="text-align: center;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {productosFiltrados.map(prod => (
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 12px;">
                  {prod.imagen_url ? (
                    <img src={prod.imagen_url} alt="img" style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover;" />
                  ) : (
                    <div style="width: 40px; height: 40px; border-radius: 8px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 18px;">👟</div>
                  )}
                  <div>
                    <strong style="display: block;">{prod.nombre}</strong>
                    <span style="font-size: 11px; color: #64748b;">SKU: {prod.sku || 'N/A'} | {prod.talla_cm}cm | {prod.color}</span>
                  </div>
                </div>
              </td>
              <td>{prod.proveedor || 'Sin asignar'}</td>
              <td>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <form method="POST" style="margin:0; display:inline;">
                    <input type="hidden" name="action" value="update_stock" />
                    <input type="hidden" name="id" value={prod.id} />
                    <input type="hidden" name="operacion" value="sub" />
                    <button type="submit" disabled={prod.stock <= 0} style={`background:#f1f5f9; border:1px solid #cbd5e1; width:28px; height:28px; border-radius:6px; cursor:${prod.stock <= 0 ? 'not-allowed' : 'pointer'}; font-weight:bold; display:flex; align-items:center; justify-content:center; opacity:${prod.stock <= 0 ? 0.5 : 1}; color:#334155;`}>-</button>
                  </form>
                  
                  <span class={`badge ${prod.stock > prod.stock_minimo ? 'badge-success' : 'badge-danger'}`} style="font-size: 14px; min-width: 44px; text-align: center; justify-content: center;">
                    {prod.stock}
                  </span>
                  
                  <form method="POST" style="margin:0; display:inline;">
                    <input type="hidden" name="action" value="update_stock" />
                    <input type="hidden" name="id" value={prod.id} />
                    <input type="hidden" name="operacion" value="add" />
                    <button type="submit" style="background:#f1f5f9; border:1px solid #cbd5e1; width:28px; height:28px; border-radius:6px; cursor:pointer; font-weight:bold; display:flex; align-items:center; justify-content:center; color:#334155;">+</button>
                  </form>
                  
                  <span style="font-size: 11px; color: #94a3b8; margin-left: 4px;">(Min: {prod.stock_minimo})</span>
                </div>
              </td>
              <td>
                {prod.cantidadPendiente > 0 ? (
                  <span class="badge badge-warning" title={`${prod.pendientes.length} pedidos pendientes`}>
                    + {prod.cantidadPendiente} uds en camino
                  </span>
                ) : (
                  <span style="color: #94a3b8; font-size: 12px;">Sin pedidos activos</span>
                )}
              </td>
              <td>
                <span class={`badge ${prod.estrategia_logistica === 'PULL' ? 'badge-pull' : 'badge-push'}`}>
                  {prod.estrategia_logistica === 'PULL' ? 'PULL (Manual)' : 'PUSH (Auto)'}
                </span>
              </td>
              <td style="text-align: center;">
                <button 
                  type="button" 
                  class="action-btn" 
                  title="Ajuste de Stock (Entrada/Salida)"
                  data-prod-id={prod.id}
                  data-prod-nombre={prod.nombre}
                  onclick="openAjusteStockModal(this)"
                  style="background: #334155; padding: 6px 12px; border-radius: 6px; color: white; font-size: 12px; font-weight: 600; margin-right: 8px; border: none;"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px; margin-top: -2px;"><path d="M12 20v-8m0 0V4m0 8h8m-8 0H4"/></svg>
                  Ajuste Bulk
                </button>
                <button 
                  type="button" 
                  class="action-btn" 
                  title="Nuevo Pedido"
                  data-prod-id={prod.id}
                  data-prod-nombre={prod.nombre}
                  onclick="openCreatePedidoModal(this)"
                  style="background: #0f766e; padding: 6px 12px; border-radius: 6px; color: white; font-size: 12px; font-weight: 600; margin-right: 8px; border: none;"
                >
                  + Nuevo Pedido
                </button>
                <button 
                  type="button" 
                  class="action-btn action-view" 
                  title="Ver Pedidos de Compra"
                  data-prod={JSON.stringify(prod)}
                  onclick="openHistorialModal(this)"
                  style="background: #f1f5f9; padding: 6px 12px; border-radius: 6px; color: #334155; font-size: 12px; font-weight: 600;"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px; margin-top: -2px;"><path d="M12 20v-8m0 0V4m0 8h8m-8 0H4"/></svg>
                  Pedidos de Compra
                </button>
              </td>
            </tr>
          ))}
          {productosFiltrados.length === 0 && (
            <tr><td colspan="6" style="text-align: center; padding: 40px; color: #94a3b8;">No se encontraron productos.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal: Crear Pedido Manual -->
  <dialog id="modalCreatePedido" class="crm-modal scm-modal">
    <div class="modal-content" style="padding: 32px 40px; border-radius: 16px;">
      <div class="modal-header" style="margin-bottom: 24px;">
        <h2 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0;">Nuevo pedido</h2>
      </div>
      <form method="POST" class="scm-form">
        <input type="hidden" name="action" value="create_pedido" />
        <input type="hidden" name="id_producto" id="createPedidoProdId" value="" />
        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Producto</label>
          <div style="flex: 1; padding: 8px 12px; background: #f1f5f9; border-radius: 6px; color: #334155; font-weight: 600; border: 1px solid #e2e8f0; display: flex; align-items: center;" id="createPedidoProdNombre">
          </div>
        </div>
        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Cantidad</label>
          <input type="number" name="cantidad" min="1" value="1" required style="border-radius: 6px; border-color: #d1d5db; color: #4b5563; padding: 8px; width: 100%; box-sizing: border-box;" />
        </div>
        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Tipo</label>
          <div class="select-wrapper">
            <select name="tipo" required style="border-radius: 6px; border-color: #d1d5db; color: #4b5563; width: 100%; padding: 8px;">
              <option value="Reposición">Reposición</option>
              <option value="Especial">Especial</option>
            </select>
          </div>
        </div>
        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Proveedor</label>
          <div class="select-wrapper">
            <select name="id_proveedor" required style="border-radius: 6px; border-color: #d1d5db; color: #4b5563; width: 100%; padding: 8px;">
              <option value="" disabled selected>Selecciona un proveedor</option>
              {proveedoresList.map(prov => (
                <option value={prov.id}>{prov.nombre}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px;">
          <button type="button" class="btn-cancel" onclick="document.getElementById('modalCreatePedido').close()" style="border: 1px solid #d1d5db; color: #111827; background: white; padding: 10px 24px; border-radius: 6px; font-weight: 500; cursor: pointer;">Cancelar</button>
          <button type="submit" class="btn-save" style="background: #006655; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 500; cursor: pointer;">Guardar Pedido</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal: Historial y Movimientos del Producto -->
  <dialog id="modalHistorial" class="crm-modal scm-modal modal-detail-wide">
    <div class="modal-content" style="padding: 32px;">
      <div class="modal-header">
        <h2 style="margin: 0; font-size: 20px;">Altas, Bajas y Pedidos: <span id="histProdNombre" style="color:#0f172a;"></span></h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalHistorial').close()">×</button>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px;">
        <!-- Columna Izquierda: Pedidos Activos e Historial de Compras -->
        <div>
          <h3 style="font-size: 16px; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">Historial de Pedidos de Compra</h3>
          <div id="histPedidosList" style="max-height: 400px; overflow-y: auto; padding-right: 8px;">
            <!-- Renderizado vía JS -->
          </div>
        </div>

        <!-- Columna Derecha: Movimientos (Altas y Bajas Físicas) -->
        <div>
          <h3 style="font-size: 16px; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">Altas y Bajas (Movimientos Físicos)</h3>
          <div id="histMovimientosList" style="max-height: 400px; overflow-y: auto; padding-right: 8px;">
            <!-- Renderizado vía JS -->
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Modal: Ajuste de Stock Bulk -->
  <dialog id="modalAjusteStock" class="crm-modal scm-modal">
    <div class="modal-content" style="padding: 32px 40px; border-radius: 16px;">
      <div class="modal-header" style="margin-bottom: 24px;">
        <h2 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0;">Ajuste Manual Bulk</h2>
      </div>
      <form method="POST" class="scm-form">
        <input type="hidden" name="action" value="update_stock" />
        <input type="hidden" name="id" id="ajusteStockProdId" value="" />
        
        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Producto</label>
          <div style="flex: 1; padding: 8px 12px; background: #f1f5f9; border-radius: 6px; color: #334155; font-weight: 600; border: 1px solid #e2e8f0; display: flex; align-items: center;" id="ajusteStockProdNombre">
          </div>
        </div>

        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Operación</label>
          <div class="select-wrapper">
            <select name="operacion" required style="border-radius: 6px; border-color: #d1d5db; color: #4b5563; width: 100%; padding: 8px;">
              <option value="add">Entrada de stock (+)</option>
              <option value="sub">Salida de stock (-)</option>
            </select>
          </div>
        </div>

        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Cantidad</label>
          <input type="number" name="cantidad" min="1" value="1" required style="border-radius: 6px; border-color: #d1d5db; color: #4b5563; padding: 8px; width: 100%; box-sizing: border-box;" />
        </div>

        <div class="form-row" style="margin-bottom: 20px;">
          <label style="width: 100px; font-size: 14px; font-weight: 500; color: #4b5563;">Motivo</label>
          <input type="text" name="motivo" placeholder="Ej. Inventario inicial, merma, regalo..." required style="border-radius: 6px; border-color: #d1d5db; color: #4b5563; padding: 8px; width: 100%; box-sizing: border-box;" />
        </div>

        <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px;">
          <button type="button" class="btn-cancel" onclick="document.getElementById('modalAjusteStock').close()" style="border: 1px solid #d1d5db; color: #111827; background: white; padding: 10px 24px; border-radius: 6px; font-weight: 500; cursor: pointer;">Cancelar</button>
          <button type="submit" class="btn-save" style="background: #334155; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 500; cursor: pointer;">Guardar Ajuste</button>
        </div>
      </form>
    </div>
  </dialog>

</CrmLayout>

<script is:inline>
  window.openCreatePedidoModal = function(button) {
    const prodId = button.getAttribute('data-prod-id');
    const prodNombre = button.getAttribute('data-prod-nombre');
    document.getElementById('createPedidoProdId').value = prodId;
    document.getElementById('createPedidoProdNombre').textContent = prodNombre;
    document.getElementById('modalCreatePedido').showModal();
  };

  window.openHistorialModal = function(button) {
    const data = JSON.parse(button.getAttribute('data-prod') || '{}');
    const modal = document.getElementById('modalHistorial');
    if (!modal) return;

    document.getElementById('histProdNombre').textContent = data.nombre;

    // Renderizar Pedidos
    const pList = document.getElementById('histPedidosList');
    pList.innerHTML = '';
    if (data.pedidos && data.pedidos.length > 0) {
      data.pedidos.forEach(p => {
        const isPendiente = p.estado === 'Pendiente';
        pList.innerHTML += `
          <div style="background: ${isPendiente ? '#fffbeb' : '#f8fafc'}; border: 1px solid ${isPendiente ? '#fef3c7' : '#e2e8f0'}; border-radius: 8px; padding: 12px; margin-bottom: 12px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
              <strong>#${p.id} - ${p.cantidad} uds</strong>
              <span class="badge ${isPendiente ? 'badge-warning' : (p.estado === 'Cancelado' ? 'badge-danger' : 'badge-success')}">${p.estado}</span>
            </div>
            <div style="font-size: 12px; color: #64748b; margin-bottom: 8px;">
              Tipo: ${p.tipo} <br/>
              Fecha: ${new Date(p.fecha_creacion).toLocaleDateString()}
            </div>
            ${isPendiente ? `
              <div style="display: flex; gap: 8px; margin-top: 10px;">
                <form method="POST" style="margin:0;" onsubmit="return confirm('¿Completar pedido y registrar ALTA de stock?');">
                  <input type="hidden" name="action" value="completar_pedido" />
                  <input type="hidden" name="id" value="${p.id}" />
                  <button type="submit" style="background:#15803d; color:white; border:none; padding:4px 8px; border-radius:4px; font-size:12px; cursor:pointer;">Marcar Completado (Alta)</button>
                </form>
                <form method="POST" style="margin:0;" onsubmit="return confirm('¿Cancelar pedido?');">
                  <input type="hidden" name="action" value="cancelar_pedido" />
                  <input type="hidden" name="id" value="${p.id}" />
                  <button type="submit" style="background:#dc2626; color:white; border:none; padding:4px 8px; border-radius:4px; font-size:12px; cursor:pointer;">Cancelar</button>
                </form>
              </div>
            ` : ''}
          </div>
        `;
      });
    } else {
      pList.innerHTML = '<p style="color:#94a3b8; font-size:13px;">No hay pedidos registrados.</p>';
    }

    // Renderizar Movimientos (Altas y Bajas)
    const mList = document.getElementById('histMovimientosList');
    mList.innerHTML = '';
    if (data.movimientos && data.movimientos.length > 0) {
      data.movimientos.forEach(m => {
        const isEntrada = m.tipo === 'Entrada';
        mList.innerHTML += `
          <div style="display: flex; align-items: flex-start; gap: 12px; padding: 12px; border-bottom: 1px solid #f1f5f9;">
            <div style="background: ${isEntrada ? '#dcfce7' : '#fee2e2'}; color: ${isEntrada ? '#166534' : '#991b1b'}; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              ${isEntrada ? '↑' : '↓'}
            </div>
            <div>
              <div style="font-size: 14px; font-weight: 600; color: #1e293b;">
                ${isEntrada ? 'ALTA' : 'BAJA'} de ${m.cantidad} uds
              </div>
              <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                ${m.motivo}
              </div>
              <div style="font-size: 11px; color: #94a3b8; margin-top: 4px;">
                ${new Date(m.fecha).toLocaleString()}
              </div>
            </div>
          </div>
        `;
      });
    } else {
      mList.innerHTML = '<p style="color:#94a3b8; font-size:13px;">No hay movimientos físicos registrados.</p>';
    }

    modal.showModal();
  };

  window.openAjusteStockModal = function(button) {
    const prodId = button.getAttribute('data-prod-id');
    const prodNombre = button.getAttribute('data-prod-nombre');
    document.getElementById('ajusteStockProdId').value = prodId;
    document.getElementById('ajusteStockProdNombre').textContent = prodNombre;
    document.getElementById('modalAjusteStock').showModal();
  };
</script>

