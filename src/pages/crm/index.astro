---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db/db';
import { Clientes, Interacciones } from '../../db/schema';

// Obtener datos reales de la DB
const todosLosClientes = await db.select().from(Clientes);
const todosLosActivos = todosLosClientes.filter(c => c.estado.toLowerCase() === 'activo');

const totalClientes = todosLosClientes.length;
const totalActivos = todosLosActivos.length;
const porcentajeActivos = totalClientes > 0 ? Math.round((totalActivos / totalClientes) * 100) : 0;
const totalInactivos = totalClientes - totalActivos;
const porcentajeInactivos = totalClientes > 0 ? 100 - porcentajeActivos : 0;

const interacciones = await db.select().from(Interacciones);

const now = new Date();
const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

const interaccionesMes = interacciones.filter(i => new Date(i.fecha_hora) >= thirtyDaysAgo).length;

const lastInteractions = new Map<number, Date>();
for (const i of interacciones) {
  const d = new Date(i.fecha_hora);
  const existing = lastInteractions.get(i.id_cliente);
  if (!existing || d > existing) {
    lastInteractions.set(i.id_cliente, d);
  }
}

const clientesEnRiesgoList = todosLosClientes.map(c => {
  const lastInt = lastInteractions.get(c.id);
  const daysSince = lastInt ? Math.floor((now.getTime() - lastInt.getTime()) / (1000 * 60 * 60 * 24)) : Infinity;
  return { ...c, daysSince };
}).filter(c => c.daysSince >= 30).sort((a, b) => b.daysSince - a.daysSince);

const sinInteraccion = clientesEnRiesgoList.length;
---

<AdminLayout title="Dashboard" activePath="/crm">
  <h1 class="crm-title">Resumen CRM</h1>

  <div class="metrics-grid">
    <div class="crm-card metric-card">
      <h3>Total de clientes</h3>
      <div class="metric-value">{totalClientes}</div>
      <p class="metric-desc">Todos los clientes registrados</p>
    </div>
    
    <div class="crm-card metric-card">
      <h3>Clientes activos</h3>
      <div class="metric-value text-success">{totalActivos}</div>
      <p class="metric-desc">{porcentajeActivos}% del total</p>
    </div>

    <div class="crm-card metric-card">
      <h3>Interacciones (este mes)</h3>
      <div class="metric-value">{interaccionesMes}</div>
      <p class="metric-desc text-success">+12% vs mes anterior</p>
    </div>

    <div class="crm-card metric-card">
      <h3>Clientes sin interacción</h3>
      <div class="metric-value text-danger">{sinInteraccion}</div>
      <p class="metric-desc">Últimos 30 días</p>
    </div>
  </div>

  <div class="dashboard-widgets">
    <!-- Widget: Gráfico (Simulado con CSS) -->
    <div class="crm-card widget-card">
      <h3>Clientes activos vs inactivos</h3>
      <div class="chart-container">
        <div class="donut-chart" style={`--active: ${porcentajeActivos}%; --inactive: ${porcentajeInactivos}%;`}></div>
        <div class="chart-legend">
          <div class="legend-item">
            <span class="dot bg-success"></span> Activos <strong>{totalActivos} ({porcentajeActivos}%)</strong>
          </div>
          <div class="legend-item">
            <span class="dot bg-danger"></span> Inactivos <strong>{totalInactivos} ({porcentajeInactivos}%)</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Widget: Clientes en riesgo -->
    <div class="crm-card widget-card">
      <h3>Clientes en riesgo</h3>
      <div class="risk-list">
        {clientesEnRiesgoList.length > 0 ? clientesEnRiesgoList.slice(0, 3).map(c => (
          <a href={`/crm/clientes/${c.id}`} class="risk-item">
            <div>
              <strong>{c.nombre}</strong>
              <p>{c.daysSince === Infinity ? 'Sin interacciones registradas' : `Sin interacción por ${c.daysSince} días`}</p>
            </div>
            <span>›</span>
          </a>
        )) : <p style="color: var(--color-text-muted); font-size: 13px;">No hay clientes en riesgo.</p>}
      </div>
      <a href="/crm/clientes" class="view-all">Ver todos</a>
    </div>
  </div>

  <!-- Acceso rápido: Ventas -->
  <div class="ventas-banner">
    <div class="ventas-banner-left">
      <div class="ventas-banner-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </div>
      <div>
        <div class="ventas-banner-title">Historial de Ventas</div>
        <div class="ventas-banner-sub">Consulta todas las transacciones, filtra por fecha y método de pago</div>
      </div>
    </div>
    <a href="/crm/ventas" class="ventas-banner-btn">
      Ver ventas
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
  </div>

</AdminLayout>

<style>
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin-bottom: 24px;
  }
  .metric-card {
    padding: 24px;
  }
  .metric-card h3 {
    margin: 0 0 12px 0;
    font-size: 14px;
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .metric-value {
    font-size: 42px;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 8px;
  }
  .metric-desc {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .text-success { color: var(--color-success); }
  .text-danger { color: var(--color-danger); }

  .dashboard-widgets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .widget-card h3 {
    margin: 0 0 24px 0;
    font-size: 16px;
  }

  /* Donut Chart CSS */
  .chart-container {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .donut-chart {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: conic-gradient(
      var(--color-success) 0% var(--active),
      var(--color-danger) var(--active) 100%
    );
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .donut-chart::after {
    content: '';
    width: 90px;
    height: 90px;
    background: var(--color-surface);
    border-radius: 50%;
  }
  .chart-legend {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text-muted);
  }
  .legend-item strong {
    color: var(--color-text);
    margin-left: 8px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .bg-success { background: var(--color-success); }
  .bg-danger { background: var(--color-danger); }

  /* Risk List */
  .risk-list {
    display: flex;
    flex-direction: column;
  }
  .risk-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }
  .risk-item:hover { background: var(--color-bg); margin: 0 -16px; padding: 16px; border-radius: 8px; border-bottom-color: transparent; }
  .risk-item strong { font-size: 14px; display: block; margin-bottom: 4px; }
  .risk-item p { margin: 0; font-size: 12px; color: var(--color-text-muted); }
  .risk-item span { font-size: 20px; color: var(--color-border); font-family: monospace; }
  
  .view-all {
    display: block;
    text-align: right;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }
  .view-all:hover { text-decoration: underline; }

  /* ── Ventas quick-access banner ── */
  .ventas-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    padding: 20px 28px;
    background: linear-gradient(135deg, rgba(139,92,246,.18) 0%, rgba(99,102,241,.12) 100%);
    border: 1px solid rgba(139,92,246,.35);
    border-radius: 14px;
    flex-wrap: wrap;
  }
  .ventas-banner-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .ventas-banner-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 6px 20px rgba(139,92,246,.35);
  }
  .ventas-banner-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 3px;
  }
  .ventas-banner-sub {
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .ventas-banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: transform .18s, box-shadow .18s;
    box-shadow: 0 4px 16px rgba(139,92,246,.4);
    white-space: nowrap;
  }
  .ventas-banner-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(139,92,246,.55);
  }
</style>
