---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Usuarios, Roles, Interacciones } from '../../db/schema';
import { eq } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'create') {
    await db.insert(Usuarios).values({
      nombre: formData.get('nombre') as string,
      correo: formData.get('correo') as string,
      password_hash: 'hashedpassword', // Dummy default para la demo
      id_rol: Number(formData.get('rol_id')),
      estado: formData.get('estado') as string,
      fecha_creacion: new Date()
    });
  } else if (action === 'update') {
    const id = Number(formData.get('id'));
    await db.update(Usuarios)
      .set({
        nombre: formData.get('nombre') as string,
        correo: formData.get('correo') as string,
        id_rol: Number(formData.get('rol_id')),
        estado: formData.get('estado') as string,
      })
      .where(eq(Usuarios.id, id));
  } else if (action === 'delete') {
    const id = Number(formData.get('id'));
    // En un caso real habría que reasignar interacciones o usar borrado lógico. Aquí borramos interacciones para demo.
    await db.delete(Interacciones).where(eq(Interacciones.id_usuario, id));
    await db.delete(Usuarios).where(eq(Usuarios.id, id));
  }
  
  return Astro.redirect(Astro.url.pathname);
}

const roles = await db.select().from(Roles);

const usuariosList = await db
  .select({
    id: Usuarios.id,
    nombre: Usuarios.nombre,
    correo: Usuarios.correo,
    estado: Usuarios.estado,
    fecha: Usuarios.fecha_creacion,
    id_rol: Usuarios.id_rol,
    rol: Roles.nombre
  })
  .from(Usuarios)
  .leftJoin(Roles, eq(Usuarios.id_rol, Roles.id));
---

<CrmLayout title="Usuarios" activePath="/crm/usuarios">
  <div class="header-actions">
    <h1 class="crm-title">Directorio de Equipo</h1>
    <button class="btn-primary" onclick="document.getElementById('modalCreate').showModal()">+ Nuevo usuario</button>
  </div>

  <div class="crm-card">
    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Correo Electrónico</th>
            <th>Rol</th>
            <th>Estado</th>
            <th>Fecha Creación</th>
            <th class="text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {usuariosList.map(usr => (
            <tr>
              <td><strong>{usr.nombre}</strong></td>
              <td>{usr.correo}</td>
              <td><span class="badge badge-neutral">{usr.rol}</span></td>
              <td>
                <span style={`color: ${usr.estado === 'activo' ? 'var(--color-success)' : 'var(--color-danger)'}; font-weight: 700;`}>
                  {usr.estado.toUpperCase()}
                </span>
              </td>
              <td>{usr.fecha.toLocaleDateString()}</td>
              <td class="text-right" style="white-space: nowrap;">
                <button 
                  class="action-btn" 
                  title="Editar" 
                  onclick={`openEditModal(${usr.id}, '${usr.nombre}', '${usr.correo}', ${usr.id_rol}, '${usr.estado}')`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                
                <form method="POST" style="display:inline;" onsubmit="return confirm('¿Eliminar este usuario? Esto borrará sus interacciones asociadas.');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={usr.id} />
                  <button type="submit" class="action-btn text-danger" title="Eliminar" disabled={usr.id === 1}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal: Crear Usuario -->
  <dialog id="modalCreate" class="crm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Nuevo Usuario</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalCreate').close()">×</button>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="create" />
        
        <div class="form-group">
          <label>Nombre Completo *</label>
          <input type="text" name="nombre" required placeholder="Ej. Ana Vendedora" />
        </div>

        <div class="form-group">
          <label>Correo Electrónico *</label>
          <input type="email" name="correo" required placeholder="correo@sportenis.com" />
        </div>

        <div class="form-group">
          <label>Rol en el Sistema *</label>
          <select name="rol_id" required>
            {roles.map(r => <option value={r.id}>{r.nombre}</option>)}
          </select>
        </div>

        <div class="form-group">
          <label>Estado de la cuenta *</label>
          <select name="estado" required>
            <option value="activo">Activo</option>
            <option value="inactivo">Inactivo / Suspendido</option>
          </select>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-outline" onclick="document.getElementById('modalCreate').close()">Cancelar</button>
          <button type="submit" class="btn-primary">Registrar Usuario</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal: Editar Usuario -->
  <dialog id="modalEdit" class="crm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Usuario</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalEdit').close()">×</button>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="id" id="edit_id" value="" />
        
        <div class="form-group">
          <label>Nombre Completo *</label>
          <input type="text" name="nombre" id="edit_nombre" required />
        </div>

        <div class="form-group">
          <label>Correo Electrónico *</label>
          <input type="email" name="correo" id="edit_correo" required />
        </div>

        <div class="form-group">
          <label>Rol en el Sistema *</label>
          <select name="rol_id" id="edit_rol" required>
            {roles.map(r => <option value={r.id}>{r.nombre}</option>)}
          </select>
        </div>

        <div class="form-group">
          <label>Estado de la cuenta *</label>
          <select name="estado" id="edit_estado" required>
            <option value="activo">Activo</option>
            <option value="inactivo">Inactivo / Suspendido</option>
          </select>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-outline" onclick="document.getElementById('modalEdit').close()">Cancelar</button>
          <button type="submit" class="btn-primary">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </dialog>
</CrmLayout>

<script is:inline>
  function openEditModal(id, nombre, correo, rolId, estado) {
    document.getElementById('edit_id').value = id;
    document.getElementById('edit_nombre').value = nombre;
    document.getElementById('edit_correo').value = correo;
    document.getElementById('edit_rol').value = rolId;
    document.getElementById('edit_estado').value = estado;
    document.getElementById('modalEdit').showModal();
  }
</script>

<style>
  .header-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .crm-title { margin-bottom: 0; }
  
  .table-responsive {
    overflow-x: auto;
    margin: 0 -24px;
  }
  .crm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .crm-table th {
    text-align: left;
    padding: 12px 24px;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .crm-table td {
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .crm-table tbody tr:hover { background: var(--color-bg); }
  
  .text-right { text-align: right; }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    opacity: 0.6;
    margin-left: 8px;
    color: inherit;
  }
  .action-btn:disabled { opacity: 0.2; cursor: not-allowed; }
  .action-btn:not(:disabled):hover { opacity: 1; color: var(--color-text); }
  .action-btn.text-danger:not(:disabled):hover { color: var(--color-danger); }

  /* Modals */
  .crm-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    width: 100%;
    max-width: 500px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }
  .crm-modal::backdrop { background: rgba(0,0,0,0.5); }
  .modal-content { padding: 24px; }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .modal-header h2 { margin: 0; font-size: 20px; }
  .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--color-text-muted); }
  
  .form-group { margin-bottom: 16px; text-align: left; }
  .form-group label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 8px; }
  .form-group select, .form-group input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
  }
  
  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 6px;
    cursor: pointer;
  }
  .btn-outline:hover { background: var(--color-bg); }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
  }
</style>
