---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db/db';
import { Interacciones, Clientes, TiposInteraccion, Usuarios, ActividadTienda } from '../../db/schema';
import { eq, desc, and } from 'drizzle-orm';

const session = Astro.cookies.get('sportenis_session');
const currentUserId = session ? Number(session.value) : 0;

const actividadTienda = await db
  .select({
    id: ActividadTienda.id,
    fecha: ActividadTienda.fecha_hora,
    cliente: Usuarios.nombre, // Using Usuarios name if logged in
    clienteId: ActividadTienda.id_usuario,
    tipo: ActividadTienda.accion,
    descripcion: ActividadTienda.detalles,
    usuario: ActividadTienda.session_id, // We show session_id for guests
    esActividad: true
  })
  .from(ActividadTienda)
  .leftJoin(Usuarios, eq(ActividadTienda.id_usuario, Usuarios.id))
  .orderBy(desc(ActividadTienda.fecha_hora));

const todasLasInteracciones = actividadTienda;

// Formatear tipo de actividad
function formatAccion(accion: string) {
  const map: Record<string, string> = {
    'ver_producto': 'Vio Producto',
    'agregar_carrito': 'Agregó a Carrito',
    'favorito_agregado': 'Agregó a Favorito',
    'favorito_removido': 'Quitó de Favorito'
  };
  return map[accion] || accion;
}

const q = Astro.url.searchParams.get('q');
let interaccionesFiltradas = todasLasInteracciones;

if (q) {
  const searchTerm = q.toLowerCase();
  interaccionesFiltradas = interaccionesFiltradas.filter((item) => 
    (item.cliente && item.cliente.toLowerCase().includes(searchTerm)) || (item.notas && item.notas.toLowerCase().includes(searchTerm)) || (item.tipo && item.tipo.toLowerCase().includes(searchTerm))
  );
}
---

<AdminLayout title="Interacciones Globales" activePath="/crm/interacciones">
  <div class="header-actions">
    <h1 class="crm-title">Bitácora Global de Interacciones y Actividad</h1>
  </div>

  <div class="crm-card">
          <!-- Buscador local funcional -->
      <form method="GET" style="margin: 0; flex: 1; max-width: 400px; display: flex; position: relative; margin-bottom: 24px;" id="searchForm">
        <input type="search" name="q" value={q || ""} placeholder="Buscar..." class="search-input" style="width: 100%; padding-right: 40px;" />
        <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-text-muted);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Agente / Sesión</th>
            <th>Cliente / Usuario</th>
            <th>Tipo / Acción</th>
            <th>Descripción / Detalles</th>
          </tr>
        </thead>
        <tbody>
          {interaccionesFiltradas.map(act => (
            <tr>
              <td style="white-space: nowrap">{act.fecha.toLocaleString()}</td>
              <td>
                {act.esActividad ? (
                  <span title="ID de Sesión (Invitado)" style="color: var(--color-text-muted)">{act.usuario ? act.usuario : 'N/A'}</span>
                ) : (
                  <strong>{act.usuario}</strong>
                )}
              </td>
              <td>
                {act.esActividad ? (
                  act.cliente ? <span class="cliente-link">{act.cliente}</span> : <em>Invitado</em>
                ) : (
                  <a href={`/crm/clientes/${act.clienteId}`} class="cliente-link">{act.cliente}</a>
                )}
              </td>
              <td>
                <span class={act.esActividad ? "badge badge-info" : "badge badge-neutral"}>
                  {act.esActividad ? formatAccion(act.tipo) : act.tipo}
                </span>
              </td>
              <td>
                {act.esActividad && act.descripcion ? (
                  <pre style="margin:0; font-family:inherit; font-size:12px; color: var(--color-text-muted)">{
                    (() => {
                      try { return JSON.stringify(JSON.parse(act.descripcion), null, 2); } 
                      catch(e) { return act.descripcion; }
                    })()
                  }</pre>
                ) : (
                  act.descripcion
                )}
              </td>
            </tr>
          ))}
          {interaccionesFiltradas.length === 0 && (
            <tr>
              <td colspan="5" class="text-center" style="padding: 32px; color: var(--color-text-muted)">
                No hay interacciones ni actividad registrada.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="pagination">
      <span>Mostrando {todasLasInteracciones.length} registros en total</span>
    </div>
  </div>
</AdminLayout>

<style>
  .badge-info {
    background: #e0f2fe;
    color: #0369a1;
  }
  .badge-neutral {
    background: #f1f5f9;
    color: #475569;
  }
  .header-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .crm-title { margin-bottom: 0; }
  
  .date-filter-form { margin: 0; }
  
  .date-filter {
    display: flex;
    align-items: center;
    padding: 6px 12px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    gap: 8px;
  }
  .date-filter input[type="date"] {
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 13px;
    background: transparent;
    cursor: pointer;
    color: var(--color-text);
  }
  .filter-btn {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    transition: background 0.2s;
  }
  .filter-btn:hover { background: var(--color-text); color: white; border-color: var(--color-text); }

  .table-responsive {
    overflow-x: auto;
    margin: 0 -24px;
  }
  .crm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .crm-table th {
    text-align: left;
    padding: 12px 24px;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .crm-table td {
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .crm-table tbody tr:hover { background: var(--color-bg); }
  
  .cliente-link { color: var(--color-text); font-weight: 700; text-decoration: none; }
  .cliente-link:hover { text-decoration: underline; color: var(--color-danger); }
  
  .text-center { text-align: center; }
  
  .pagination {
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .search-input {
    flex: 1;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: inherit;
  }
</style>
