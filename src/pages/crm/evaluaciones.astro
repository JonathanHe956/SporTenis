---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Evaluaciones, Clientes, Usuarios } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

const todasLasEvaluaciones = await db
  .select({
    id: Evaluaciones.id,
    fecha: Evaluaciones.fecha_evaluacion,
    calificacion: Evaluaciones.calificacion,
    comentarios: Evaluaciones.comentarios,
    cliente: Clientes.nombre,
    clienteId: Clientes.id,
    usuario: Usuarios.nombre
  })
  .from(Evaluaciones)
  .leftJoin(Clientes, eq(Evaluaciones.id_cliente, Clientes.id))
  .leftJoin(Usuarios, eq(Evaluaciones.id_usuario, Usuarios.id))
  .orderBy(desc(Evaluaciones.fecha_evaluacion));

// Calcular promedio NPS básico (1 al 5)
const total = todasLasEvaluaciones.length;
const suma = todasLasEvaluaciones.reduce((acc, ev) => acc + (ev.calificacion || 0), 0);
const promedio = total > 0 ? (suma / total).toFixed(1) : '5.0';

// Contar estrellas para la UI
const counts = [0, 0, 0, 0, 0]; // Index 0 = 1 estrella, etc.
todasLasEvaluaciones.forEach(ev => {
  if (ev.calificacion >= 1 && ev.calificacion <= 5) {
    counts[ev.calificacion - 1]++;
  }
});

const q = Astro.url.searchParams.get('q');
const ratingFiltro = Astro.url.searchParams.get('rating');
let evaluacionesFiltradas = todasLasEvaluaciones;

if (ratingFiltro && ratingFiltro !== 'todos') {
  evaluacionesFiltradas = evaluacionesFiltradas.filter(e => e.calificacion === Number(ratingFiltro));
}

if (q) {
  const searchTerm = q.toLowerCase();
  evaluacionesFiltradas = evaluacionesFiltradas.filter(ev => 
    (ev.cliente && ev.cliente.toLowerCase().includes(searchTerm)) ||
    (ev.comentarios && ev.comentarios.toLowerCase().includes(searchTerm)) ||
    (ev.usuario && ev.usuario.toLowerCase().includes(searchTerm))
  );
}

function getScoreBadgeClass(score: number) {
  if (score >= 4) return 'badge-success';
  if (score === 3) return 'badge-warning';
  return 'badge-danger';
}
---

<CrmLayout title="Evaluaciones de Clientes" activePath="/crm/evaluaciones">
  <div class="header-actions">
    <div>
      <h1 class="crm-title">Evaluaciones y Satisfacción CSAT</h1>
      <p class="subtitle">Medición continua de satisfacción, feedback directo y experiencia de compra.</p>
    </div>
  </div>

  <!-- KPI y Stats Row estilo SCM -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-number stat-warning" style="display: flex; align-items: baseline; justify-content: center; gap: 4px;">
        {promedio}
        <span style="font-size: 16px; color: var(--color-text-muted); font-weight: 700;">/ 5.0</span>
      </div>
      <div class="stat-label">Promedio de Satisfacción</div>
    </div>

    <div class="stat-card">
      <div class="stat-number">{total}</div>
      <div class="stat-label">Total de Evaluaciones</div>
    </div>

    <div class="stat-card">
      <div class="stat-number stat-success">{counts[4] + counts[3]}</div>
      <div class="stat-label">Clientes Satisfechos (4-5 ★)</div>
    </div>

    <div class="stat-card">
      <div class="stat-number stat-danger">{counts[0] + counts[1]}</div>
      <div class="stat-label">Detractores (1-2 ★)</div>
    </div>
  </div>

  <!-- Desglose Gráfico de Estrellas -->
  <div class="crm-card" style="margin-bottom: 24px; padding: 20px 24px;">
    <h3 style="margin: 0 0 16px 0; font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.04em;">
      Distribución de Calificaciones
    </h3>
    <div class="stars-breakdown">
      {[5, 4, 3, 2, 1].map(stars => {
        const count = counts[stars - 1];
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        return (
          <div class="breakdown-row">
            <span class="star-label">{stars} ★</span>
            <div class="progress-track">
              <div 
                class={`progress-fill ${stars >= 4 ? 'fill-green' : stars === 3 ? 'fill-yellow' : 'fill-red'}`} 
                style={`width: ${pct}%;`}
              ></div>
            </div>
            <span class="breakdown-count">{count} ({pct}%)</span>
          </div>
        );
      })}
    </div>
  </div>

  <div class="crm-card">
    <div class="filters">
      <!-- Buscador -->
      <form method="GET" style="margin: 0; flex: 1; max-width: 420px; display: flex; position: relative;" id="searchForm">
        {ratingFiltro && <input type="hidden" name="rating" value={ratingFiltro} />}
        <input type="search" name="q" value={q || ""} placeholder="Buscar por cliente, comentario o agente..." class="search-input" style="width: 100%; padding-right: 40px;" />
        <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-text-muted);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>

      <!-- Filtro por Calificación -->
      <form method="GET" style="margin: 0;" id="ratingFilterForm">
        {q && <input type="hidden" name="q" value={q} />}
        <select name="rating" class="filter-select" onchange="document.getElementById('ratingFilterForm').submit()">
          <option value="todos" selected={!ratingFiltro || ratingFiltro === 'todos'}>Filtrar: Todas las estrellas</option>
          <option value="5" selected={ratingFiltro === '5'}>5 estrellas</option>
          <option value="4" selected={ratingFiltro === '4'}>4 estrellas</option>
          <option value="3" selected={ratingFiltro === '3'}>3 estrellas</option>
          <option value="2" selected={ratingFiltro === '2'}>2 estrellas</option>
          <option value="1" selected={ratingFiltro === '1'}>1 estrella</option>
        </select>
      </form>
    </div>

    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Calificación</th>
            <th>Comentarios y Feedback</th>
            <th>Atendido Por</th>
          </tr>
        </thead>
        <tbody>
          {evaluacionesFiltradas.map(ev => (
            <tr>
              <td style="white-space: nowrap; font-size: 12px; color: var(--color-text-muted);">
                {new Date(ev.fecha).toLocaleDateString()}
              </td>
              <td>
                <a href={`/crm/clientes/${ev.clienteId}`} class="cliente-link">
                  <strong>{ev.cliente}</strong>
                </a>
              </td>
              <td>
                <span class={`badge ${getScoreBadgeClass(ev.calificacion)}`}>
                  {ev.calificacion} ★
                </span>
              </td>
              <td>
                {ev.comentarios ? (
                  <span style="line-height: 1.4;">"{ev.comentarios}"</span>
                ) : (
                  <em style="color: var(--color-text-muted)">Sin comentarios adicionales</em>
                )}
              </td>
              <td>
                <span class="user-pill">{ev.usuario || 'Atención General'}</span>
              </td>
            </tr>
          ))}
          {evaluacionesFiltradas.length === 0 && (
            <tr>
              <td colspan="5" class="text-center" style="padding: 36px; color: var(--color-text-muted)">
                {q ? `No se encontraron evaluaciones que coincidan con "${q}".` : 'No hay evaluaciones registradas en el sistema todavía.'}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="pagination">
      <span>Mostrando {evaluacionesFiltradas.length} de {total} evaluaciones</span>
    </div>
  </div>
</CrmLayout>

<style>
  .header-actions { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .crm-title { margin-bottom: 4px; }
  .subtitle { margin: 0; font-size: 13px; color: var(--color-text-muted); }

  /* Stats Row estilo SCM */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  @media (max-width: 800px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
  }
  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
  }
  .stat-number {
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-warning { color: #d97706; }
  .stat-success { color: var(--color-success); }
  .stat-danger { color: var(--color-danger); }
  .stat-label {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Stars breakdown */
  .stars-breakdown {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .breakdown-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .star-label {
    width: 32px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text);
  }
  .progress-track {
    flex: 1;
    height: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    border-radius: 4px;
  }
  .fill-green { background: var(--color-success); }
  .fill-yellow { background: #d97706; }
  .fill-red { background: var(--color-danger); }
  .breakdown-count {
    width: 70px;
    text-align: right;
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Filtros y Buscador */
  .filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .search-input {
    padding: 9px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    background: var(--color-surface);
    color: var(--color-text);
  }
  .search-input:focus { border-color: var(--color-text); }
  .filter-select {
    padding: 9px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    background: var(--color-surface);
    color: var(--color-text);
    outline: none;
    cursor: pointer;
  }

  /* Tablas SCM */
  .table-responsive { overflow-x: auto; margin: 0 -24px; }
  .crm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .crm-table th { text-align: left; padding: 12px 24px; border-bottom: 2px solid var(--color-border); color: var(--color-text-muted); font-weight: 700; }
  .crm-table td { padding: 14px 24px; border-bottom: 1px solid var(--color-border); }
  .crm-table tbody tr:hover { background: var(--color-bg); }
  .text-center { text-align: center; }

  .cliente-link {
    color: var(--color-text);
    text-decoration: none;
  }
  .cliente-link:hover { color: #0284c7; text-decoration: underline; }

  /* Badges estilo SCM */
  .badge-warning { background: #fef3c7; color: #92400e; }
  .user-pill {
    background: #f1f5f9;
    color: #475569;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 12px;
  }

  .pagination {
    margin-top: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
  }
</style>
