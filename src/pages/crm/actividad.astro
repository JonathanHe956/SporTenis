---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db/db';
import { Interacciones, Clientes, TiposInteraccion } from '../../db/schema';
import { eq, desc, and, gte, lte } from 'drizzle-orm';

const session = Astro.cookies.get('sportenis_session');
const usuarioActualId = session ? Number(session.value) : 0;

let queryConditions = [eq(Interacciones.id_usuario, usuarioActualId)];

const actividades = await db
  .select({
    fecha: Interacciones.fecha_hora,
    cliente: Clientes.nombre,
    clienteId: Clientes.id,
    tipo: TiposInteraccion.nombre,
    descripcion: Interacciones.descripcion
  })
  .from(Interacciones)
  .leftJoin(Clientes, eq(Interacciones.id_cliente, Clientes.id))
  .leftJoin(TiposInteraccion, eq(Interacciones.id_tipo_interaccion, TiposInteraccion.id))
  .where(and(...queryConditions))
  .orderBy(desc(Interacciones.fecha_hora));
---

<AdminLayout title="Mi Actividad" activePath="/crm/actividad">
  <div class="header-actions">
    <h1 class="crm-title">Mi Actividad</h1>
  </div>

  <div class="crm-card">
    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Tipo</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          {actividades.map(act => (
            <tr>
              <td style="white-space: nowrap">{act.fecha.toLocaleString()}</td>
              <td><a href={`/crm/clientes/${act.clienteId}`} class="cliente-link">{act.cliente}</a></td>
              <td><span class="badge badge-neutral">{act.tipo}</span></td>
              <td>{act.descripcion}</td>
            </tr>
          ))}
          {actividades.length === 0 && (
            <tr>
              <td colspan="4" class="text-center" style="padding: 32px; color: var(--color-text-muted)">
                No tienes actividad registrada.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="pagination" style="margin-top: 16px; display: flex; justify-content: space-between; color: var(--color-text-muted); font-size: 13px;">
      <span>Mostrando {actividades.length} actividades encontradas</span>
    </div>
  </div>
</AdminLayout>

<style>
  .header-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .crm-title { margin-bottom: 0; }
  
  .date-filter-form {
    margin: 0;
  }
  
  .date-filter {
    display: flex;
    align-items: center;
    padding: 6px 12px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    gap: 8px;
  }
  .date-filter input[type="date"] {
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 13px;
    background: transparent;
    cursor: pointer;
    color: var(--color-text);
  }
  .filter-btn {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    transition: background 0.2s;
  }
  .filter-btn:hover { background: var(--color-text); color: white; border-color: var(--color-text); }

  .table-responsive {
    overflow-x: auto;
    margin: 0 -24px;
  }
  .crm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .crm-table th {
    text-align: left;
    padding: 12px 24px;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .crm-table td {
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .crm-table tbody tr:hover { background: var(--color-bg); }
  
  .cliente-link { color: var(--color-text); font-weight: 700; text-decoration: none; }
  .cliente-link:hover { text-decoration: underline; color: var(--color-danger); }
  
  .text-center { text-align: center; }
</style>
