---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Interacciones, Clientes, TiposInteraccion } from '../../db/schema';
import { eq, desc, and } from 'drizzle-orm';

const usuarioActualId = Astro.locals.user?.id ?? 0;

let queryConditions = [eq(Interacciones.id_usuario, usuarioActualId)];

const actividades = await db
  .select({
    id: Interacciones.id,
    fecha: Interacciones.fecha_hora,
    cliente: Clientes.nombre,
    clienteId: Clientes.id,
    tipo: TiposInteraccion.nombre,
    descripcion: Interacciones.descripcion
  })
  .from(Interacciones)
  .leftJoin(Clientes, eq(Interacciones.id_cliente, Clientes.id))
  .leftJoin(TiposInteraccion, eq(Interacciones.id_tipo_interaccion, TiposInteraccion.id))
  .where(and(...queryConditions))
  .orderBy(desc(Interacciones.fecha_hora));

const q = Astro.url.searchParams.get('q');
const tipoFiltro = Astro.url.searchParams.get('tipo');
let actividadesFiltradas = actividades;

if (tipoFiltro && tipoFiltro !== 'todos') {
  actividadesFiltradas = actividadesFiltradas.filter(a => (a.tipo || '').toLowerCase() === tipoFiltro.toLowerCase());
}

if (q) {
  const searchTerm = q.toLowerCase();
  actividadesFiltradas = actividadesFiltradas.filter((item) => 
    (item.cliente && item.cliente.toLowerCase().includes(searchTerm)) || 
    (item.descripcion && item.descripcion.toLowerCase().includes(searchTerm)) ||
    (item.tipo && item.tipo.toLowerCase().includes(searchTerm))
  );
}

// Métricas de actividad
const totalActividades = actividades.length;
const clientesUnicos = new Set(actividades.map(a => a.clienteId).filter(Boolean)).size;
const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
const actividadesMes = actividades.filter(a => new Date(a.fecha) >= thirtyDaysAgo).length;

const tiposSet = Array.from(new Set(actividades.map(a => a.tipo).filter(Boolean)));
---

<CrmLayout title="Mi Actividad" activePath="/crm/actividad">
  <div class="header-actions">
    <div>
      <h1 class="crm-title">Mi Bitácora de Actividad</h1>
      <p class="subtitle">Historial de gestiones, llamadas, seguimientos y acuerdos alcanzados con clientes.</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/crm/clientes" class="btn-primary">
        + NUEVO CONTACTO
      </a>
    </div>
  </div>

  <!-- Stats Row estilo SCM -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-number">{totalActividades}</div>
      <div class="stat-label">Gestiones Realizadas</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-success">{clientesUnicos}</div>
      <div class="stat-label">Clientes Atendidos</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-warning">{actividadesMes}</div>
      <div class="stat-label">Últimos 30 Días</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-auto">{tiposSet.length}</div>
      <div class="stat-label">Canales Utilizados</div>
    </div>
  </div>

  <div class="crm-card">
    <div class="filters">
      <!-- Buscador -->
      <form method="GET" style="margin: 0; flex: 1; max-width: 420px; display: flex; position: relative;" id="searchForm">
        {tipoFiltro && <input type="hidden" name="tipo" value={tipoFiltro} />}
        <input type="search" name="q" value={q || ""} placeholder="Buscar por cliente o detalles..." class="search-input" style="width: 100%; padding-right: 40px;" />
        <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-text-muted);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>

      <!-- Filtro por Tipo -->
      <form method="GET" style="margin: 0;" id="tipoFilterForm">
        {q && <input type="hidden" name="q" value={q} />}
        <select name="tipo" class="filter-select" onchange="document.getElementById('tipoFilterForm').submit()">
          <option value="todos" selected={!tipoFiltro || tipoFiltro === 'todos'}>Canal: Todos</option>
          {tiposSet.map(t => (
            <option value={t} selected={tipoFiltro === t}>{t}</option>
          ))}
        </select>
      </form>
    </div>

    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>Fecha y Hora</th>
            <th>Cliente Contactado</th>
            <th>Canal / Tipo</th>
            <th>Descripción del Seguimiento</th>
            <th class="text-center">Ficha</th>
          </tr>
        </thead>
        <tbody>
          {actividadesFiltradas.map(act => (
            <tr>
              <td style="white-space: nowrap; font-size: 12px; color: var(--color-text-muted);">
                {new Date(act.fecha).toLocaleString()}
              </td>
              <td>
                <a href={`/crm/clientes/${act.clienteId}`} class="cliente-link">
                  <strong>{act.cliente}</strong>
                </a>
              </td>
              <td>
                <span class="badge badge-neutral">{act.tipo}</span>
              </td>
              <td>
                <span style="line-height: 1.4;">{act.descripcion || '-'}</span>
              </td>
              <td class="text-center">
                <a href={`/crm/clientes/${act.clienteId}`} class="action-btn action-view" title="Ver ficha del cliente">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </a>
              </td>
            </tr>
          ))}
          {actividadesFiltradas.length === 0 && (
            <tr>
              <td colspan="5" class="text-center" style="padding: 36px; color: var(--color-text-muted)">
                {q ? `No se encontraron actividades que coincidan con "${q}".` : 'Aún no tienes actividades registradas en tu bitácora.'}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="pagination">
      <span>Mostrando {actividadesFiltradas.length} de {totalActividades} actividades</span>
    </div>
  </div>
</CrmLayout>

<style>
  .header-actions { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .crm-title { margin-bottom: 4px; }
  .subtitle { margin: 0; font-size: 13px; color: var(--color-text-muted); }

  /* Stats Row estilo SCM */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  @media (max-width: 800px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
  }
  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
  }
  .stat-number {
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-warning { color: #d97706; }
  .stat-success { color: var(--color-success); }
  .stat-auto { color: #2563eb; }
  .stat-label {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Filtros y Buscador */
  .filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .search-input {
    padding: 9px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    background: var(--color-surface);
    color: var(--color-text);
  }
  .search-input:focus { border-color: var(--color-text); }
  .filter-select {
    padding: 9px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    background: var(--color-surface);
    color: var(--color-text);
    outline: none;
    cursor: pointer;
  }

  /* Tablas SCM */
  .table-responsive { overflow-x: auto; margin: 0 -24px; }
  .crm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .crm-table th { text-align: left; padding: 12px 24px; border-bottom: 2px solid var(--color-border); color: var(--color-text-muted); font-weight: 700; }
  .crm-table td { padding: 14px 24px; border-bottom: 1px solid var(--color-border); }
  .crm-table tbody tr:hover { background: var(--color-bg); }
  .text-center { text-align: center; }

  .cliente-link {
    color: var(--color-text);
    text-decoration: none;
  }
  .cliente-link:hover { color: #0284c7; text-decoration: underline; }

  /* Badges estilo SCM */
  .badge-neutral { background: #f1f5f9; color: #475569; }

  .action-btn { 
    background: none; 
    border: none; 
    cursor: pointer; 
    font-size: 16px; 
    opacity: 0.65; 
    color: inherit; 
    transition: all 0.2s ease; 
    padding: 4px; 
    border-radius: 4px; 
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .action-btn:hover { opacity: 1; transform: scale(1.1); }
  .action-view { color: #0284c7; }
  .action-view:hover { color: #0369a1 !important; background: #e0f2fe; }

  .pagination {
    margin-top: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
  }
</style>
