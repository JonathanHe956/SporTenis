---
import CrmLayout from '../../../layouts/CrmLayout.astro';
import { db } from '../../../db/db';
import { Clientes, EtapasCrm, Interacciones } from '../../../db/schema';
import { eq, like, or } from 'drizzle-orm';

// Manejo de peticiones POST (CRUD)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'create') {
    await db.insert(Clientes).values({
      nombre: formData.get('nombre') as string,
      empresa: formData.get('empresa') as string,
      correo: formData.get('correo') as string,
      telefono: formData.get('telefono') as string,
      id_etapa_crm: Number(formData.get('etapa_id')),
      estado: 'Activo',
      fecha_registro: new Date()
    });
  } else if (action === 'update') {
    const id = Number(formData.get('id'));
    await db.update(Clientes)
      .set({
        nombre: formData.get('nombre') as string,
        empresa: formData.get('empresa') as string,
        correo: formData.get('correo') as string,
        telefono: formData.get('telefono') as string,
        id_etapa_crm: Number(formData.get('etapa_id')),
      })
      .where(eq(Clientes.id, id));
  } else if (action === 'delete') {
    const id = Number(formData.get('id'));
    // Eliminar interacciones relacionadas primero para evitar error de Foreign Key
    await db.delete(Interacciones).where(eq(Interacciones.id_cliente, id));
    // Eliminar cliente
    await db.delete(Clientes).where(eq(Clientes.id, id));
  }
  
  return Astro.redirect(Astro.url.pathname);
}

// Obtener datos para la vista
const etapas = await db.select().from(EtapasCrm);

// Join de Clientes con EtapasCrm
const clientes = await db
  .select({
    id: Clientes.id,
    nombre: Clientes.nombre,
    empresa: Clientes.empresa,
    correo: Clientes.correo,
    telefono: Clientes.telefono,
    estado: Clientes.estado,
    id_etapa: Clientes.id_etapa_crm,
    etapa: EtapasCrm.nombre
  })
  .from(Clientes)
  .leftJoin(EtapasCrm, eq(Clientes.id_etapa_crm, EtapasCrm.id));

const q = Astro.url.searchParams.get('q');
const estadoFiltro = Astro.url.searchParams.get('estado');
let clientesFiltrados = clientes;

if (q) {
  const searchTerm = q.toLowerCase();
  clientesFiltrados = clientesFiltrados.filter(c => 
    c.nombre.toLowerCase().includes(searchTerm) || 
    c.correo.toLowerCase().includes(searchTerm) || 
    (c.empresa && c.empresa.toLowerCase().includes(searchTerm))
  );
}

if (estadoFiltro && estadoFiltro !== 'todos') {
  clientesFiltrados = clientesFiltrados.filter(c => c.estado.toLowerCase() === estadoFiltro.toLowerCase());
}

const totalClientes = clientes.length;
const totalActivos = clientes.filter(c => (c.estado || '').toLowerCase() === 'activo').length;
const totalProspectos = clientes.filter(c => (c.etapa || '').toLowerCase() === 'prospecto').length;
const totalInactivos = totalClientes - totalActivos;

function getStageBadge(stage: string | null) {
  switch (stage) {
    case 'Activo': return 'badge-success';
    case 'Prospecto': return 'badge-warning';
    case 'Frecuente': return 'badge-pull';
    case 'Inactivo': return 'badge-danger';
    default: return 'badge-neutral';
  }
}
---

<CrmLayout title="Clientes" activePath="/crm/clientes">
  <div class="header-actions">
    <div>
      <h1 class="crm-title">Directorio de Clientes</h1>
      <p class="subtitle">Gestión centralizada de cuentas, etapas del embudo comercial y contactos.</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <button class="btn-primary" onclick="document.getElementById('modalCreate').showModal()">
        + NUEVO CLIENTE
      </button>
    </div>
  </div>

  <!-- Stats Row estilo SCM -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-number">{totalClientes}</div>
      <div class="stat-label">Total Clientes</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-success">{totalActivos}</div>
      <div class="stat-label">Clientes Activos</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-warning">{totalProspectos}</div>
      <div class="stat-label">Prospectos</div>
    </div>
    <div class="stat-card">
      <div class="stat-number stat-danger">{totalInactivos}</div>
      <div class="stat-label">Inactivos</div>
    </div>
  </div>

  <div class="crm-card">
    <div class="filters">
      <!-- Buscador local funcional -->
      <form method="GET" style="margin: 0; flex: 1; max-width: 420px; display: flex; position: relative;" id="searchForm">
        {estadoFiltro && <input type="hidden" name="estado" value={estadoFiltro} />}
        <input type="search" name="q" value={q || ''} placeholder="Buscar por nombre, correo o empresa..." class="search-input" style="width: 100%; padding-right: 40px;" />
        <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-text-muted);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>

      <!-- Filtro por estado -->
      <form method="GET" style="margin: 0;" id="statusFilterForm">
        {q && <input type="hidden" name="q" value={q} />}
        <select name="estado" class="filter-select" onchange="document.getElementById('statusFilterForm').submit()">
          <option value="todos" selected={!estadoFiltro || estadoFiltro === 'todos'}>Estado: Todos</option>
          <option value="activo" selected={estadoFiltro === 'activo'}>Activos</option>
          <option value="inactivo" selected={estadoFiltro === 'inactivo'}>Inactivos</option>
        </select>
      </form>
    </div>

    <div class="table-responsive">
      <table class="crm-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre del Cliente</th>
            <th>Empresa / Club</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Etapa CRM</th>
            <th>Estado</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {clientesFiltrados.map(cliente => (
            <tr>
              <td><span class="id-pill">#{cliente.id}</span></td>
              <td>
                <div class="client-cell">
                  <div class="client-avatar">{(cliente.nombre || 'C').substring(0, 2).toUpperCase()}</div>
                  <strong class="client-name">{cliente.nombre}</strong>
                </div>
              </td>
              <td>{cliente.empresa || <span class="text-muted">-</span>}</td>
              <td>{cliente.correo}</td>
              <td>{cliente.telefono || <span class="text-muted">-</span>}</td>
              <td><span class={`badge ${getStageBadge(cliente.etapa)}`}>{cliente.etapa || '-'}</span></td>
              <td>
                <span class={`badge ${cliente.estado?.toLowerCase() === 'activo' ? 'badge-success' : 'badge-danger'}`}>
                  {cliente.estado}
                </span>
              </td>
              <td class="text-center" style="white-space: nowrap;">
                <a href={`/crm/clientes/${cliente.id}`} class="action-btn action-view" title="Ver ficha y actividad">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </a>
                
                <button 
                  type="button"
                  class="action-btn" 
                  title="Editar cliente" 
                  onclick={`openEditModal(${cliente.id}, '${cliente.nombre}', '${cliente.empresa || ''}', '${cliente.correo}', '${cliente.telefono || ''}', ${cliente.id_etapa || 1})`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                
                <form method="POST" style="display:inline;" data-confirm="¿Estás seguro de eliminar este cliente? Se borrarán sus interacciones asociadas." data-confirm-title="Eliminar cliente" data-confirm-accept="Eliminar">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={cliente.id} />
                  <button type="submit" class="action-btn text-danger" title="Eliminar cliente">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
              </td>
            </tr>
          ))}
          {clientesFiltrados.length === 0 && (
            <tr>
              <td colspan="8" class="text-center" style="padding: 36px; color: var(--color-text-muted)">
                {q ? `No se encontraron clientes que coincidan con "${q}".` : 'No hay clientes registrados en el catálogo.'}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="pagination">
      <span>Mostrando {clientesFiltrados.length} de {totalClientes} clientes</span>
    </div>
  </div>

  <!-- Modal: Crear Cliente (Estilo SCM) -->
  <dialog id="modalCreate" class="scm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Nuevo Cliente</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalCreate').close()">×</button>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="create" />
        
        <div class="form-group">
          <label>Nombre del Cliente *</label>
          <input type="text" name="nombre" class="form-control" required placeholder="Ej. Carlos Alcaraz" />
        </div>

        <div class="form-group">
          <label>Empresa / Club</label>
          <input type="text" name="empresa" class="form-control" placeholder="Ej. Club Valle Verde" />
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label>Correo Electrónico *</label>
            <input type="email" name="correo" class="form-control" required placeholder="correo@ejemplo.com" />
          </div>

          <div class="form-group">
            <label>Teléfono</label>
            <input type="tel" name="telefono" class="form-control" placeholder="555-123-4567" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
          </div>
        </div>

        <div class="form-group">
          <label>Etapa CRM Inicial</label>
          <select name="etapa_id" class="form-control" required>
            {etapas.map(e => <option value={e.id}>{e.nombre}</option>)}
          </select>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="document.getElementById('modalCreate').close()">Cancelar</button>
          <button type="submit" class="btn-save">Guardar Cliente</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal: Editar Cliente (Estilo SCM) -->
  <dialog id="modalEdit" class="scm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Cliente</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalEdit').close()">×</button>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="id" id="edit_id" value="" />
        
        <div class="form-group">
          <label>Nombre del Cliente *</label>
          <input type="text" name="nombre" id="edit_nombre" class="form-control" required />
        </div>

        <div class="form-group">
          <label>Empresa / Club</label>
          <input type="text" name="empresa" id="edit_empresa" class="form-control" />
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label>Correo Electrónico *</label>
            <input type="email" name="correo" id="edit_correo" class="form-control" required />
          </div>

          <div class="form-group">
            <label>Teléfono</label>
            <input type="tel" name="telefono" id="edit_telefono" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
          </div>
        </div>

        <div class="form-group">
          <label>Etapa CRM</label>
          <select name="etapa_id" id="edit_etapa" class="form-control" required>
            {etapas.map(e => <option value={e.id}>{e.nombre}</option>)}
          </select>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="document.getElementById('modalEdit').close()">Cancelar</button>
          <button type="submit" class="btn-save">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </dialog>
</CrmLayout>

<script is:inline>
  function openEditModal(id, nombre, empresa, correo, telefono, etapaId) {
    document.getElementById('edit_id').value = id;
    document.getElementById('edit_nombre').value = nombre;
    document.getElementById('edit_empresa').value = empresa;
    document.getElementById('edit_correo').value = correo;
    document.getElementById('edit_telefono').value = telefono;
    document.getElementById('edit_etapa').value = etapaId;
    
    document.getElementById('modalEdit').showModal();
  }
</script>

<style>
  /* Header y Subtítulos */
  .header-actions { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .crm-title { margin-bottom: 4px; }
  .subtitle { margin: 0; font-size: 13px; color: var(--color-text-muted); }

  /* Stats Row idéntico a SCM */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  @media (max-width: 800px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
  }
  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
  }
  .stat-number {
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-warning { color: #d97706; }
  .stat-success { color: var(--color-success); }
  .stat-danger { color: var(--color-danger); }
  .stat-label {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Filtros y Buscador */
  .filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .search-input {
    padding: 9px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    background: var(--color-surface);
    color: var(--color-text);
  }
  .search-input:focus { border-color: var(--color-text); }
  .filter-select {
    padding: 9px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 13px;
    background: var(--color-surface);
    color: var(--color-text);
    outline: none;
    cursor: pointer;
  }

  /* Tablas SCM */
  .table-responsive { overflow-x: auto; margin: 0 -24px; }
  .crm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .crm-table th { text-align: left; padding: 12px 24px; border-bottom: 2px solid var(--color-border); color: var(--color-text-muted); font-weight: 700; }
  .crm-table td { padding: 14px 24px; border-bottom: 1px solid var(--color-border); }
  .crm-table tbody tr:hover { background: var(--color-bg); }
  .text-center { text-align: center; }
  .text-muted { color: var(--color-text-muted); }

  .id-pill {
    background: #f1f5f9;
    color: #475569;
    padding: 3px 7px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 12px;
    font-weight: 700;
  }

  .client-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .client-avatar {
    width: 28px;
    height: 28px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    color: var(--color-text);
  }
  .client-name { font-size: 13px; }

  /* Badges estilo SCM */
  .badge-pull { background: #dbeafe; color: #1e40af; }
  .badge-warning { background: #fef3c7; color: #92400e; }
  .badge-neutral { background: #f1f5f9; color: #475569; }

  /* Action Buttons estilo SCM */
  .action-btn { 
    background: none; 
    border: none; 
    cursor: pointer; 
    font-size: 16px; 
    opacity: 0.65; 
    margin: 0 3px; 
    color: inherit; 
    transition: all 0.2s ease; 
    vertical-align: middle; 
    padding: 4px; 
    border-radius: 4px; 
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .action-btn:hover { opacity: 1; transform: scale(1.1); }
  .action-view { color: #0284c7; }
  .action-view:hover { color: #0369a1 !important; background: #e0f2fe; }
  .action-btn.text-danger:hover { color: var(--color-danger); background: #fee2e2; }

  .pagination {
    margin-top: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* Modales estilo SCM */
  .scm-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    width: 100%;
    max-width: 520px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
  }
  .scm-modal::backdrop {
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(3px);
  }
  .modal-content {
    padding: 32px;
    background: #ffffff;
    border-radius: 12px;
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .modal-header h2 { margin: 0; font-size: 18px; color: #001632; font-weight: 700; }
  .close-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #64748b;
    font-weight: bold;
    line-height: 1;
  }
  .close-btn:hover { color: #001632; }

  .form-group {
    margin-bottom: 18px;
  }
  .form-group label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .form-control {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 14px;
    outline: none;
    background: #ffffff;
    color: var(--color-text);
  }
  .form-control:focus {
    border-color: var(--color-text);
  }
  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
  }
  .btn-cancel {
    background: #f1f5f9;
    border: 1px solid var(--color-border);
    padding: 9px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 700;
    font-size: 13px;
    color: var(--color-text);
  }
  .btn-cancel:hover { background: #e2e8f0; }
  .btn-save {
    background: #001632;
    color: #ffffff;
    border: none;
    padding: 9px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 700;
    font-size: 13px;
  }
  .btn-save:hover { background: #002b66; }
</style>
