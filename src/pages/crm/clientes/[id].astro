---
import CrmLayout from '../../../layouts/CrmLayout.astro';
import { db, Clientes, Interacciones, EtapasCrm, TiposInteraccion, Usuarios, Evaluaciones, eq, desc } from 'astro:db';

const { id } = Astro.params;
if (!id) return Astro.redirect('/crm/clientes');

// Manejo de POST (Formularios de Interacción, Cambio de Etapa y Edición)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'new_interaction') {
    const tipoId = Number(formData.get('tipo_id'));
    const desc = formData.get('descripcion') as string;
    
    await db.insert(Interacciones).values({
      id_cliente: Number(id),
      id_usuario: 1, // Hardcoded Admin for demo
      id_tipo_interaccion: tipoId,
      descripcion: desc,
      fecha_hora: new Date()
    });
  } else if (action === 'change_stage') {
    const nuevaEtapa = Number(formData.get('etapa_id'));
    await db.update(Clientes)
      .set({ id_etapa_crm: nuevaEtapa })
      .where(eq(Clientes.id, Number(id)));
  } else if (action === 'update_client') {
    await db.update(Clientes)
      .set({
        nombre: formData.get('nombre') as string,
        empresa: formData.get('empresa') as string,
        correo: formData.get('correo') as string,
        telefono: formData.get('telefono') as string,
      })
      .where(eq(Clientes.id, Number(id)));
  }
  
  return Astro.redirect(Astro.url.pathname);
}

// Cargar Datos del Cliente
const clienteData = await db.select().from(Clientes).where(eq(Clientes.id, Number(id)));
if (!clienteData || clienteData.length === 0) return Astro.redirect('/crm/clientes');
const cliente = clienteData[0];

// Cargar Catálogos
const etapas = await db.select().from(EtapasCrm);
const etapaActual = etapas.find(e => e.id === cliente.id_etapa_crm)?.nombre;
const tiposInteraccion = await db.select().from(TiposInteraccion);

// Cargar Interacciones
const historial = await db
  .select({
    id: Interacciones.id,
    descripcion: Interacciones.descripcion,
    fecha: Interacciones.fecha_hora,
    tipo: TiposInteraccion.nombre,
    usuario: Usuarios.nombre
  })
  .from(Interacciones)
  .leftJoin(TiposInteraccion, eq(Interacciones.id_tipo_interaccion, TiposInteraccion.id))
  .leftJoin(Usuarios, eq(Interacciones.id_usuario, Usuarios.id))
  .where(eq(Interacciones.id_cliente, Number(id)))
  .orderBy(desc(Interacciones.fecha_hora));

// Cargar Evaluaciones
const evaluaciones = await db
  .select({
    calificacion: Evaluaciones.calificacion,
    comentarios: Evaluaciones.comentarios,
    fecha: Evaluaciones.fecha_evaluacion,
    usuario: Usuarios.nombre
  })
  .from(Evaluaciones)
  .leftJoin(Usuarios, eq(Evaluaciones.id_usuario, Usuarios.id))
  .where(eq(Evaluaciones.id_cliente, Number(id)))
  .orderBy(desc(Evaluaciones.fecha_evaluacion));

function getStageBadge(stage: string | undefined) {
  switch (stage) {
    case 'Activo': return 'badge-success';
    case 'Prospecto': return 'badge-neutral';
    case 'Frecuente': return 'badge-success';
    case 'Inactivo': return 'badge-danger';
    default: return 'badge-neutral';
  }
}

const initials = cliente.nombre.substring(0, 2).toUpperCase();
---

<CrmLayout title={`Cliente: ${cliente.nombre}`} activePath="/crm/clientes">
  <div class="breadcrumb">
    <a href="/crm/clientes">‹ Volver a clientes</a>
  </div>

  <div class="profile-header">
    <div class="profile-avatar">{initials}</div>
    <div class="profile-info">
      <h1 class="crm-title" style="margin-bottom: 8px;">{cliente.nombre} <span class={`badge ${getStageBadge(etapaActual)}`}>{etapaActual}</span></h1>
      <p>{cliente.empresa || 'Sin empresa'} • Registrado el {cliente.fecha_registro.toLocaleDateString()}</p>
    </div>
    <div class="profile-actions">
      <button class="btn-outline" onclick="document.getElementById('modalEdit').showModal()">Editar cliente</button>
      <button class="btn-primary" onclick="document.getElementById('modalStage').showModal()">Cambiar etapa</button>
    </div>
  </div>

  <div class="crm-card">
    <div class="tabs">
      <button class="tab-btn active" onclick="switchTab('info', this)">Información</button>
      <button class="tab-btn" onclick="switchTab('interacciones', this)">Interacciones</button>
      <button class="tab-btn" onclick="switchTab('evaluaciones', this)">Evaluaciones</button>
    </div>

    <!-- Contenido de Pestaña: Información -->
    <div class="tab-content" id="tab-info" style="display: block;">
      <div class="info-grid">
        <div class="info-item">
          <strong>Nombre completo</strong>
          <p>{cliente.nombre}</p>
        </div>
        <div class="info-item">
          <strong>Correo electrónico</strong>
          <p>{cliente.correo}</p>
        </div>
        <div class="info-item">
          <strong>Teléfono</strong>
          <p>{cliente.telefono || 'No registrado'}</p>
        </div>
        <div class="info-item">
          <strong>Empresa / Club</strong>
          <p>{cliente.empresa || 'No registrado'}</p>
        </div>
        <div class="info-item">
          <strong>Estado de la cuenta</strong>
          <p>{cliente.estado}</p>
        </div>
        <div class="info-item">
          <strong>Fecha de registro</strong>
          <p>{cliente.fecha_registro.toLocaleDateString()}</p>
        </div>
      </div>
    </div>

    <!-- Contenido de Pestaña: Interacciones -->
    <div class="tab-content" id="tab-interacciones" style="display: none;">
      <div class="timeline-header">
        <h3>Historial de interacciones</h3>
        <button class="btn-primary" onclick="document.getElementById('modalInteraction').showModal()">+ Nueva interacción</button>
      </div>

      <div class="timeline">
        {historial.map(item => (
          <div class="timeline-item">
            <div class="timeline-icon" set:html={item.tipo === 'Llamada' ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>' : item.tipo === 'Correo' ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>' : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>'}></div>
            <div class="timeline-content">
              <div class="timeline-meta">
                <strong>{item.tipo}</strong>
                <span>{item.fecha.toLocaleString()}</span>
              </div>
              <p>{item.descripcion}</p>
              <small>Usuario: {item.usuario}</small>
            </div>
          </div>
        ))}
        {historial.length === 0 && <p class="text-muted">No hay interacciones registradas.</p>}
      </div>
    </div>

    <!-- Contenido de Pestaña: Evaluaciones -->
    <div class="tab-content" id="tab-evaluaciones" style="display: none;">
      <div class="timeline-header">
        <h3>Evaluaciones (NPS)</h3>
      </div>
      <div class="timeline">
        {evaluaciones.map(ev => (
          <div class="timeline-item">
            <div class="timeline-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
            <div class="timeline-content">
              <div class="timeline-meta">
                <strong>Calificación: {ev.calificacion} / 5</strong>
                <span>{ev.fecha.toLocaleDateString()}</span>
              </div>
              <p>{ev.comentarios || 'Sin comentarios adicionales.'}</p>
              <small>Registrado por: {ev.usuario}</small>
            </div>
          </div>
        ))}
        {evaluaciones.length === 0 && <p class="text-muted" style="padding: 16px;">Este cliente aún no tiene evaluaciones registradas.</p>}
      </div>
    </div>
  </div>

  <!-- Modal: Registrar Interacción (Pantalla 6) -->
  <dialog id="modalInteraction" class="crm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Nueva Interacción</h2>
        <button class="close-btn" onclick="document.getElementById('modalInteraction').close()">×</button>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="new_interaction" />
        
        <div class="form-group">
          <label>Tipo de interacción</label>
          <select name="tipo_id" required>
            {tiposInteraccion.map(t => <option value={t.id}>{t.nombre}</option>)}
          </select>
        </div>

        <div class="form-group">
          <label>Descripción</label>
          <textarea name="descripcion" rows="4" required placeholder="Detalles de la interacción..."></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-outline" onclick="document.getElementById('modalInteraction').close()">Cancelar</button>
          <button type="submit" class="btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal: Clasificación (Pantalla 7) -->
  <dialog id="modalStage" class="crm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar etapa CRM</h2>
        <button class="close-btn" onclick="document.getElementById('modalStage').close()">×</button>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="change_stage" />
        
        <div class="form-group">
          <label>Cliente</label>
          <input type="text" value={cliente.nombre} disabled />
        </div>

        <div class="form-group">
          <label>Nueva etapa</label>
          <select name="etapa_id" required>
            {etapas.map(e => <option value={e.id} selected={e.id === cliente.id_etapa_crm}>{e.nombre}</option>)}
          </select>
        </div>

        <p class="help-text">Los cambios en la etapa ayudan a dar mejor seguimiento y priorizar a tus clientes.</p>

        <div class="modal-footer">
          <button type="button" class="btn-outline" onclick="document.getElementById('modalStage').close()">Cancelar</button>
          <button type="submit" class="btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal: Editar Cliente -->
  <dialog id="modalEdit" class="crm-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Cliente</h2>
        <button type="button" class="close-btn" onclick="document.getElementById('modalEdit').close()">×</button>
      </div>
      <form method="POST">
        <input type="hidden" name="action" value="update_client" />
        
        <div class="form-group">
          <label>Nombre del Cliente *</label>
          <input type="text" name="nombre" value={cliente.nombre} required />
        </div>

        <div class="form-group">
          <label>Empresa / Club</label>
          <input type="text" name="empresa" value={cliente.empresa || ''} />
        </div>

        <div class="form-group">
          <label>Correo Electrónico *</label>
          <input type="email" name="correo" value={cliente.correo} required />
        </div>

        <div class="form-group">
          <label>Teléfono</label>
          <input type="tel" name="telefono" value={cliente.telefono || ''} />
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-outline" onclick="document.getElementById('modalEdit').close()">Cancelar</button>
          <button type="submit" class="btn-primary">Actualizar cambios</button>
        </div>
      </form>
    </div>
  </dialog>
</CrmLayout>

<script is:inline>
  function switchTab(tabId, btnElement) {
    // Ocultar todos los contenidos de pestaña
    document.querySelectorAll('.tab-content').forEach(el => {
      el.style.display = 'none';
    });
    // Quitar clase active de todos los botones
    document.querySelectorAll('.tab-btn').forEach(el => {
      el.classList.remove('active');
    });
    // Mostrar el contenido seleccionado y marcar botón
    document.getElementById('tab-' + tabId).style.display = 'block';
    btnElement.classList.add('active');
  }
</script>

<style>
  .breadcrumb { margin-bottom: 24px; }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; font-size: 14px; font-weight: 700; }
  .breadcrumb a:hover { color: var(--color-text); }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 32px;
  }
  .profile-avatar {
    width: 80px;
    height: 80px;
    background: #e9c8bd;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 900;
  }
  .profile-info { flex: 1; }
  .profile-info p { margin: 0; color: var(--color-text-muted); font-size: 14px; }

  .profile-actions {
    display: flex;
    gap: 12px;
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 6px;
    cursor: pointer;
  }
  .btn-outline:hover { background: var(--color-bg); }

  /* Tabs */
  .tabs {
    display: flex;
    border-bottom: 1px solid var(--color-border);
    margin: -24px -24px 24px;
    padding: 0 24px;
  }
  .tab-btn {
    background: none;
    border: none;
    padding: 16px 24px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text-muted);
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }
  .tab-btn.active {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }
  
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    padding: 16px;
  }
  .info-item strong {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }
  .info-item p { margin: 0; font-size: 14px; font-weight: 700; }

  /* Timeline */
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .timeline-header h3 { margin: 0; font-size: 18px; }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .timeline-item {
    display: flex;
    gap: 16px;
  }
  .timeline-icon {
    width: 40px;
    height: 40px;
    background: var(--color-bg);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .timeline-content {
    flex: 1;
    background: var(--color-bg);
    padding: 16px;
    border-radius: 8px;
  }
  .timeline-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .timeline-meta span { color: var(--color-text-muted); font-size: 12px; }
  .timeline-content p { margin: 0 0 8px 0; font-size: 14px; line-height: 1.5; }
  .timeline-content small { color: var(--color-text-muted); }

  /* Modals */
  .crm-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    width: 100%;
    max-width: 500px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }
  .crm-modal::backdrop { background: rgba(0,0,0,0.5); }
  .modal-content { padding: 24px; }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .modal-header h2 { margin: 0; font-size: 20px; }
  .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--color-text-muted); }
  
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 8px; }
  .form-group select, .form-group input, .form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
  }
  .form-group input:disabled { background: var(--color-bg); }
  
  .help-text { font-size: 12px; color: var(--color-text-muted); margin-bottom: 24px; padding: 12px; background: #fff3cd; border-radius: 6px; color: #856404; }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
  }
</style>
