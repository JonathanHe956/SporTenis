---
import Layout from '../layouts/Layout.astro';
import { db } from '../db/db';
import { Usuarios, Clientes } from '../db/schema';
import { eq } from 'drizzle-orm';

const sessionId = Astro.cookies.get('sportenis_session')?.value;

if (!sessionId) {
  return Astro.redirect('/login');
}

let showSuccess = false;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const formNombre = data.get('nombre')?.toString() || '';
  const formApellidos = data.get('apellidos')?.toString() || '';
  const formTelefono = data.get('telefono')?.toString() || '';

  const fullName = `${formNombre} ${formApellidos}`.trim();

  await db.update(Usuarios)
    .set({ nombre: fullName })
    .where(eq(Usuarios.id, Number(sessionId)));

  await db.update(Clientes)
    .set({ telefono: formTelefono, nombre: fullName })
    .where(eq(Clientes.id_usuario, Number(sessionId)));

  showSuccess = true;
}

let userData = {
  nombre: '',
  apellidos: '',
  telefono: '',
  correo: ''
};

const user = await db.select().from(Usuarios).where(eq(Usuarios.id, Number(sessionId)));
if (user.length > 0) {
  const nombresSplit = user[0].nombre.split(' ');
  userData.nombre = nombresSplit[0];
  userData.apellidos = nombresSplit.slice(1).join(' ') || '';
  userData.correo = user[0].correo;
  
  const client = await db.select().from(Clientes).where(eq(Clientes.id_usuario, Number(sessionId)));
  if (client.length > 0) {
    userData.telefono = client[0].telefono || '';
  }
}
---

<Layout>
  <div class="cuenta-page">
    <!-- Header -->
    <header class="topbar">
      <a class="brand" href="/" aria-label="SporTenis, inicio">
        <span class="brand-mark">S</span>
        <span>Spor<span>Tenis</span></span>
      </a>
      
      <div class="store-actions">
        <a href="/" class="back-link">← Volver a la tienda</a>
        
        <div class="user-nav">
          <a href="/cuenta" class="nav-icon active" title="Mi Cuenta">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </a>
          <a href="/favoritos" class="nav-icon" title="Mis Favoritos">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </a>
          <a href="/carrito" class="nav-icon" title="Mi Carrito">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </a>
        </div>
      </div>
    </header>

    <main class="cuenta-main">
      <div class="cuenta-card">
        <!-- Panel decorativo izquierdo -->
        <div class="cuenta-card-left">
          <div class="cuenta-deco">
            <div class="deco-avatar">
              <span class="avatar-initial">{userData.nombre.charAt(0)}{userData.apellidos.charAt(0)}</span>
            </div>
            <p class="deco-text">Hola,<br /><strong>{userData.nombre}</strong></p>
            <p class="deco-sub">Administra tus datos personales y preferencias de tu cuenta.</p>
          </div>
        </div>

        <!-- Panel formulario -->
        <div class="cuenta-card-right">
          <h1>Mi Perfil</h1>
          <p class="cuenta-sub">Actualiza tu información personal</p>

          <form id="profileForm" method="POST" novalidate>
            <div id="successBanner" class="success-banner" style={showSuccess ? "" : "display: none;"}>¡Tus datos han sido actualizados exitosamente!</div>

            <!-- Nombre y Apellidos -->
            <div class="form-row">
              <div class="field-group">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" value={userData.nombre} placeholder="Tu nombre" autocomplete="given-name" />
                <span class="field-error" id="error-nombre"></span>
              </div>
              <div class="field-group">
                <label for="apellidos">Apellidos</label>
                <input type="text" id="apellidos" name="apellidos" value={userData.apellidos} placeholder="Tus apellidos" autocomplete="family-name" />
                <span class="field-error" id="error-apellidos"></span>
              </div>
            </div>

            <!-- Teléfono -->
            <div class="field-group">
              <label for="telefono">Número de teléfono</label>
              <input type="tel" id="telefono" name="telefono" value={userData.telefono} placeholder="ej. 5512345678" autocomplete="tel" />
              <span class="field-error" id="error-telefono"></span>
            </div>

            <!-- Correo -->
            <div class="field-group">
              <label for="correo">Correo electrónico</label>
              <input type="email" id="correo" name="correo" value={userData.correo} readonly class="readonly-input" title="El correo no se puede modificar" />
              <span class="field-hint">El correo electrónico no se puede modificar.</span>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-guardar">Guardar cambios <span>✓</span></button>
              <button type="button" class="btn-logout" id="logoutBtn">Cerrar sesión</button>
            </div>
          </form>

          <!-- Zona de peligro -->
          <div class="danger-zone">
            <div class="danger-zone-info">
              <h3>Zona de peligro</h3>
              <p>Eliminar tu cuenta es una acción permanente. Se borrarán todos tus datos, favoritos, direcciones y preferencias.</p>
            </div>
            <button type="button" class="btn-delete-account" id="deleteAccountBtn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
              Borrar mi cuenta
            </button>
          </div>
        </div>
      </div>
    </main>

    <!-- Modal de confirmación para borrar cuenta -->
    <div class="modal-overlay" id="deleteModal">
      <div class="modal-card">
        <div class="modal-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <h2>¿Estás seguro?</h2>
        <p class="modal-desc">Esta acción <strong>no se puede deshacer</strong>. Se eliminarán permanentemente todos tus datos, incluyendo:</p>
        <ul class="modal-list">
          <li>Tu perfil e información personal</li>
          <li>Tus direcciones guardadas</li>
          <li>Tus favoritos y preferencias</li>
          <li>Tu carrito de compras</li>
        </ul>
        <p class="modal-confirm-text">Escribe <strong>ELIMINAR</strong> para confirmar:</p>
        <input type="text" id="confirmInput" class="confirm-input" placeholder="Escribe ELIMINAR" autocomplete="off" />
        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="cancelDeleteBtn">Cancelar</button>
          <button type="button" class="btn-confirm-delete" id="confirmDeleteBtn" disabled>Eliminar mi cuenta</button>
        </div>
        <div class="modal-loading" id="deleteLoading" style="display:none;">
          <div class="spinner"></div>
          <span>Eliminando cuenta...</span>
        </div>
        <div class="modal-error" id="deleteError" style="display:none;">Ocurrió un error al eliminar tu cuenta. Intenta de nuevo.</div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { background: #f6f4ed; color: #171717; font-family: Georgia, 'Times New Roman', serif; margin: 0; }

  .cuenta-page { min-height: 100vh; display: flex; flex-direction: column; }

  .topbar {
    align-items: center;
    background: #f7d21c;
    display: flex;
    justify-content: space-between;
    min-height: 76px;
    padding: 0 clamp(20px, 4vw, 64px);
  }
  .brand {
    align-items: center;
    color: #171717;
    display: flex;
    font-family: Arial, sans-serif;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -1.5px;
    text-decoration: none;
  }
  .brand span span { font-weight: 400; }
  .brand-mark {
    align-items: center;
    border: 3px solid #171717;
    border-radius: 50%;
    display: inline-flex;
    font-size: 15px;
    height: 30px;
    justify-content: center;
    margin-right: 8px;
    width: 30px;
  }
  .back-link {
    color: #171717;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }
  .back-link:hover { text-decoration: underline; }

  .store-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .user-nav {
    display: flex;
    align-items: center;
    gap: 12px;
    border-left: 1px solid #171717;
    padding-left: 24px;
  }
  
  .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #171717;
    border-radius: 50%;
    transition: background-color 0.2s, transform 0.1s;
  }
  .nav-icon:hover {
    background-color: rgba(23, 23, 23, 0.05);
  }
  .nav-icon:active {
    transform: scale(0.95);
  }
  .nav-icon.active {
    background-color: #171717;
    color: #f7d21c;
  }

  .cuenta-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .cuenta-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(23,23,23,0.10);
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    max-width: 860px;
    overflow: hidden;
    width: 100%;
  }

  .cuenta-card-left {
    background: #f7d21c;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 32px;
  }
  .cuenta-deco { position: relative; text-align: center; }
  
  .deco-avatar {
    background: #171717;
    border-radius: 50%;
    height: 110px;
    margin: 0 auto 24px;
    position: relative;
    width: 110px;
    box-shadow: 10px 12px 0 rgba(23,23,23,0.10);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .avatar-initial {
    color: #fffdf3;
    font-family: Arial, sans-serif;
    font-size: 40px;
    font-weight: 900;
    letter-spacing: -2px;
  }

  .deco-text {
    color: #171717;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 400;
    letter-spacing: -1px;
    margin: 0 0 10px;
    line-height: 1.1;
  }
  .deco-text strong { font-style: italic; color: #d93e2e; }
  .deco-sub {
    color: rgba(23,23,23,0.75);
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.6;
    margin: 0;
  }

  .cuenta-card-right { padding: 44px 40px; }
  h1 {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
    letter-spacing: -1.5px;
    margin: 0 0 6px;
  }
  .cuenta-sub {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 13px;
    margin: 0 0 28px;
  }

  form { display: flex; flex-direction: column; gap: 16px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .field-group { display: flex; flex-direction: column; gap: 5px; }

  label {
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .5px;
    text-transform: uppercase;
  }

  input[type="text"],
  input[type="tel"],
  input[type="email"] {
    background: #f6f4ed;
    border: 1.5px solid #d8d3c3;
    border-radius: 8px;
    color: #171717;
    font-family: Arial, sans-serif;
    font-size: 13px;
    outline: none;
    padding: 10px 14px;
    transition: border-color .2s;
    width: 100%;
  }
  input:focus:not(.readonly-input) { border-color: #f7d21c; }
  input.invalid { border-color: #e7442e; }
  input.valid   { border-color: #4caf50; }
  
  .readonly-input {
    background: #e8e4da !important;
    color: #716e67 !important;
    cursor: not-allowed;
    border-color: #d8d3c3 !important;
  }

  .field-error {
    color: #e7442e;
    font-family: Arial, sans-serif;
    font-size: 10px;
    min-height: 14px;
  }
  .field-hint {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 10px;
    margin-top: 2px;
  }

  .success-banner {
    background: #ecfdf5;
    border: 1.5px solid #10b981;
    color: #047857;
    border-radius: 8px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    padding: 12px;
    margin-bottom: 8px;
    text-align: center;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }

  .btn-guardar {
    align-items: center;
    background: #171717;
    border: none;
    border-radius: 8px;
    color: #fffdf3;
    cursor: pointer;
    display: flex;
    font-family: Arial, sans-serif;
    font-size: 13px;
    font-weight: 800;
    gap: 12px;
    justify-content: center;
    letter-spacing: .5px;
    padding: 14px 20px;
    text-transform: uppercase;
    transition: background .2s, transform .1s;
    width: 100%;
  }
  .btn-guardar span { font-size: 16px; color: #f7d21c; }
  .btn-guardar:hover { background: #333; }
  .btn-guardar:active { transform: scale(.98); }

  .btn-logout {
    background: transparent;
    border: 1.5px solid #d8d3c3;
    border-radius: 8px;
    color: #716e67;
    cursor: pointer;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 12px 20px;
    text-transform: uppercase;
    transition: all .2s;
  }
  .btn-logout:hover {
    border-color: #171717;
    color: #171717;
  }

  /* Zona de peligro */
  .danger-zone {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1.5px dashed #e7442e40;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .danger-zone-info h3 {
    color: #e7442e;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .5px;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .danger-zone-info p {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 1.6;
    margin: 0;
    max-width: 300px;
  }
  .btn-delete-account {
    align-items: center;
    background: transparent;
    border: 1.5px solid #e7442e;
    border-radius: 8px;
    color: #e7442e;
    cursor: pointer;
    display: inline-flex;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    gap: 6px;
    letter-spacing: .3px;
    padding: 10px 18px;
    text-transform: uppercase;
    transition: all .2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .btn-delete-account:hover {
    background: #e7442e;
    color: #fff;
  }

  /* Modal */
  .modal-overlay {
    align-items: center;
    background: rgba(23, 23, 23, 0.55);
    backdrop-filter: blur(4px);
    display: none;
    inset: 0;
    justify-content: center;
    position: fixed;
    z-index: 9999;
  }
  .modal-overlay.active {
    display: flex;
    animation: fadeIn .2s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .modal-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 24px 80px rgba(23,23,23,0.25);
    max-width: 420px;
    padding: 36px 32px 28px;
    text-align: center;
    width: 90vw;
    animation: slideUp .25s ease;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .modal-icon {
    color: #e7442e;
    margin-bottom: 16px;
  }
  .modal-card h2 {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -1px;
    margin: 0 0 10px;
  }
  .modal-desc {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.7;
    margin: 0 0 12px;
  }
  .modal-desc strong { color: #e7442e; }
  .modal-list {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 1.9;
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    text-align: left;
    padding-left: 20px;
  }
  .modal-list li::before {
    content: '×';
    color: #e7442e;
    font-weight: 700;
    margin-right: 8px;
  }
  .modal-confirm-text {
    color: #171717;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    margin: 0 0 8px;
    text-align: left;
  }
  .confirm-input {
    background: #f6f4ed;
    border: 1.5px solid #d8d3c3;
    border-radius: 8px;
    color: #171717;
    font-family: Arial, sans-serif;
    font-size: 13px;
    outline: none;
    padding: 10px 14px;
    text-align: center;
    transition: border-color .2s;
    width: 100%;
  }
  .confirm-input:focus {
    border-color: #e7442e;
  }
  .modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .btn-cancel {
    background: transparent;
    border: 1.5px solid #d8d3c3;
    border-radius: 8px;
    color: #716e67;
    cursor: pointer;
    flex: 1;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 12px;
    text-transform: uppercase;
    transition: all .2s;
  }
  .btn-cancel:hover {
    border-color: #171717;
    color: #171717;
  }
  .btn-confirm-delete {
    background: #e7442e;
    border: none;
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    flex: 1;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    padding: 12px;
    text-transform: uppercase;
    transition: all .2s;
  }
  .btn-confirm-delete:disabled {
    background: #d8d3c3;
    color: #a09d96;
    cursor: not-allowed;
  }
  .btn-confirm-delete:not(:disabled):hover {
    background: #c73822;
  }
  .modal-loading {
    align-items: center;
    color: #716e67;
    display: flex;
    font-family: Arial, sans-serif;
    font-size: 12px;
    gap: 10px;
    justify-content: center;
    margin-top: 16px;
  }
  .spinner {
    animation: spin .7s linear infinite;
    border: 2px solid #d8d3c3;
    border-radius: 50%;
    border-top-color: #e7442e;
    height: 18px;
    width: 18px;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .modal-error {
    background: #fef2f2;
    border: 1px solid #e7442e;
    border-radius: 8px;
    color: #e7442e;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
    margin-top: 12px;
    padding: 10px;
  }

  @media (max-width: 680px) {
    .cuenta-card { grid-template-columns: 1fr; }
    .cuenta-card-left { display: none; }
    .cuenta-card-right { padding: 36px 24px; }
    .form-row { grid-template-columns: 1fr; }
    .danger-zone { flex-direction: column; align-items: stretch; text-align: center; }
    .danger-zone-info p { max-width: 100%; }
    .btn-delete-account { justify-content: center; }
  }
</style>

<script>
  function showError(id: string, msg: string): void { const el = document.getElementById(id); if (el) el.textContent = msg; }
  function clearError(id: string): void     { const el = document.getElementById(id); if (el) el.textContent = ''; }
  function setValidity(input: HTMLInputElement, valid: boolean): void {
    input.classList.toggle('valid', valid);
    input.classList.toggle('invalid', !valid);
  }

  const form = document.getElementById('profileForm') as HTMLFormElement | null;
  const successBanner = document.getElementById('successBanner');
  const logoutBtn = document.getElementById('logoutBtn');

  form && form.addEventListener('submit', e => {
    let ok = true;
    if (successBanner) successBanner.style.display = 'none';

    const nombre    = document.getElementById('nombre') as HTMLInputElement;
    const apellidos = document.getElementById('apellidos') as HTMLInputElement;
    const telefono  = document.getElementById('telefono') as HTMLInputElement;

    if (!nombre.value.trim()) {
      showError('error-nombre', 'El nombre es obligatorio.'); setValidity(nombre, false); ok = false;
    } else { clearError('error-nombre'); setValidity(nombre, true); }

    if (!apellidos.value.trim()) {
      showError('error-apellidos', 'Los apellidos son obligatorios.'); setValidity(apellidos, false); ok = false;
    } else { clearError('error-apellidos'); setValidity(apellidos, true); }

    if (!/^\d{10}$/.test(telefono.value.trim())) {
      showError('error-telefono', 'Ingresa un número de 10 dígitos.'); setValidity(telefono, false); ok = false;
    } else { clearError('error-telefono'); setValidity(telefono, true); }

    if (!ok) {
      e.preventDefault();
    } else {
      document.querySelectorAll('input').forEach(i => i.classList.remove('valid', 'invalid'));
    }
  });

  logoutBtn && logoutBtn.addEventListener('click', () => {
    // En una app real esto llamaría al endpoint de logout o limpiaría cookies
    document.cookie = "sportenis_session=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
    window.location.href = '/login';
  });

  // --- Borrar cuenta ---
  const deleteAccountBtn = document.getElementById('deleteAccountBtn');
  const deleteModal = document.getElementById('deleteModal');
  const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
  const confirmDeleteBtn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement | null;
  const confirmInput = document.getElementById('confirmInput') as HTMLInputElement | null;
  const deleteLoading = document.getElementById('deleteLoading');
  const deleteError = document.getElementById('deleteError');

  deleteAccountBtn && deleteAccountBtn.addEventListener('click', () => {
    if (deleteModal) deleteModal.classList.add('active');
    if (confirmInput) { confirmInput.value = ''; confirmInput.focus(); }
    if (confirmDeleteBtn) confirmDeleteBtn.disabled = true;
    if (deleteError) deleteError.style.display = 'none';
  });

  cancelDeleteBtn && cancelDeleteBtn.addEventListener('click', () => {
    if (deleteModal) deleteModal.classList.remove('active');
  });

  // Cerrar modal al hacer clic fuera
  deleteModal && deleteModal.addEventListener('click', (e: Event) => {
    if (e.target === deleteModal) deleteModal.classList.remove('active');
  });

  // Habilitar botón solo si se escribe ELIMINAR
  confirmInput && confirmInput.addEventListener('input', () => {
    if (confirmDeleteBtn) {
      confirmDeleteBtn.disabled = confirmInput.value.trim().toUpperCase() !== 'ELIMINAR';
    }
  });

  // Ejecutar borrado
  confirmDeleteBtn && confirmDeleteBtn.addEventListener('click', async () => {
    if (confirmInput && confirmInput.value.trim().toUpperCase() !== 'ELIMINAR') return;

    // Mostrar loading, ocultar botones
    if (deleteLoading) deleteLoading.style.display = 'flex';
    if (deleteError) deleteError.style.display = 'none';
    if (confirmDeleteBtn) confirmDeleteBtn.disabled = true;
    if (cancelDeleteBtn) (cancelDeleteBtn as HTMLButtonElement).disabled = true;

    try {
      const res = await fetch('/api/delete-account', { method: 'POST' });
      if (res.ok) {
        document.cookie = "sportenis_session=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        window.location.href = '/login';
      } else {
        throw new Error('Error del servidor');
      }
    } catch {
      if (deleteLoading) deleteLoading.style.display = 'none';
      if (deleteError) deleteError.style.display = 'block';
      if (confirmDeleteBtn) confirmDeleteBtn.disabled = false;
      if (cancelDeleteBtn) (cancelDeleteBtn as HTMLButtonElement).disabled = false;
    }
  });
</script>
