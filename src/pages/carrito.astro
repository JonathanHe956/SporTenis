---
// src/pages/carrito.astro
// El carrito se carga en el navegador desde /api/carrito (ver el <script> de abajo).
import Layout from '../layouts/Layout.astro';
import { COSTO_ENVIO, ENVIO_GRATIS_SOBRE } from '../lib/ventas';

const fmt = (n: number) => `$${n.toLocaleString('es-MX')}`;
---

<Layout title="Carrito de Compras | SporTenis">
  <div class="cart-wrapper">
    <header class="topbar">
      <a class="brand" href="/" aria-label="SporTenis, inicio">
        <span class="brand-mark">S</span>
        <span>Spor<span>Tenis</span></span>
      </a>
      <a href="/" class="return-link">← Volver al catálogo</a>
    </header>

    <main class="cart-main">
      <div class="header-section">
        <p class="eyebrow"><span></span> Tu selección</p>
        <h1>Carrito de <em>Compra</em></h1>
      </div>

      <div id="cartNotices" class="cart-notices" role="status" hidden>
        <strong>Actualizamos tu carrito</strong>
        <ul id="cartNoticesList"></ul>
      </div>

      <div class="cart-grid">
        <!-- Listado de Productos -->
        <section class="items-card" aria-label="Productos en el carrito" aria-busy="true" id="itemsCard">
          <div class="table-head">
            <span>Artículo</span>
            <span>Cantidad</span>
            <span class="text-right">Total</span>
            <span class="text-right">Quitar</span>
          </div>

          <p id="loadingMessage" class="loading-state">Cargando tu carrito…</p>

          <div class="items-body" id="itemsList"></div>

          <div class="items-footer" id="itemsFooter" hidden>
            <button
              type="button"
              class="btn-clear"
              id="clearCartBtn"
              data-confirm-click="¿Quitar todos los productos de tu carrito?"
              data-confirm-title="Vaciar carrito"
              data-confirm-accept="Vaciar"
            >
              Vaciar carrito
            </button>
          </div>

          <div id="emptyMessage" class="empty-state" style="display: none;">
            <p id="emptyText">Tu carrito está actualmente vacío.</p>
            <a href="/" id="emptyLink" class="primary-button inline"><span id="emptyLinkText">Explorar artículos</span> <span>↗</span></a>
          </div>
        </section>

        <!-- Resumen de Pago -->
        <aside class="order-summary" aria-label="Resumen del pedido" data-envio-gratis-sobre={ENVIO_GRATIS_SOBRE}>
          <h2>Resumen</h2>

          <div class="summary-line">
            <span>Subtotal (<span id="totalItemsCount">0</span> productos)</span>
            <strong id="subtotalDisplay">$0 MXN</strong>
          </div>

          <div class="summary-line">
            <span>Costo de envío</span>
            <span class="shipping-cost" id="shippingDisplay">—</span>
          </div>

          <p class="shipping-hint" id="shippingHint" hidden></p>
          <p class="shipping-rule">
            Envío de {fmt(COSTO_ENVIO)} si la compra no supera {fmt(ENVIO_GRATIS_SOBRE)}; gratis si la supera.
          </p>

          <div class="promo-input-group">
            <input type="text" id="couponCode" placeholder="Código de descuento" />
            <button type="button" id="applyCoupon">Aplicar</button>
          </div>

          <hr class="summary-separator" />

          <div class="tax-breakdown" aria-label="Desglose de impuestos">
            <div class="summary-line tax-line">
              <span>Importe sin IVA</span>
              <span id="baseDisplay">$0 MXN</span>
            </div>
            <div class="summary-line tax-line">
              <span>IVA (<span id="ivaRateDisplay">16</span>%)</span>
              <span id="ivaDisplay">$0 MXN</span>
            </div>
          </div>

          <div class="summary-line total-line">
            <span>Total estimado</span>
            <strong id="totalDisplay">$0 MXN</strong>
          </div>
          <p class="tax-note">Precios en pesos mexicanos con IVA incluido. El desglose incluye el envío.</p>

          <button type="button" class="primary-button checkout-btn" disabled>
            Proceder al Checkout <span>↗</span>
          </button>

          <div class="badges-list">
            <p>Pago 100% protegido y cifrado</p>
            <p>Devoluciones sin costo por 30 días</p>
          </div>
        </aside>
      </div>
    </main>
  </div>

  <template id="cartRowTemplate">
    <article class="cart-row">
      <div class="product-cell">
        <div class="product-box"><i></i></div>
        <div class="product-meta">
          <span class="cat-tag"></span>
          <h3 class="item-name"></h3>
          <p class="variant"></p>
          <span class="unit-price"></span>
        </div>
      </div>

      <div class="qty-cell">
        <div class="counter-control">
          <button type="button" class="btn-qty dec" aria-label="Disminuir">−</button>
          <input type="number" class="qty-field" min="1" readonly />
          <button type="button" class="btn-qty inc" aria-label="Aumentar">+</button>
        </div>
      </div>

      <div class="total-cell text-right">
        <strong class="item-total-val"></strong>
      </div>

      <div class="remove-cell">
        <button type="button" class="btn-remove" data-confirm-title="Quitar del carrito" data-confirm-accept="Eliminar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
          <span>Eliminar</span>
        </button>
      </div>
    </article>
  </template>
</Layout>

<script>
  // Forma de lo que devuelve /api/carrito (ver src/lib/cart.ts)
  interface CartItem {
    id_producto: number;
    nombre: string;
    categoria: string | null;
    variante: string;
    precio: number;
    cantidad: number;
    stock: number;
    subtotal: number;
  }

  interface CartSummary {
    subtotal: number;
    envio: number;
    total: number;
    unidades: number;
    base_sin_iva: number;
    iva: number;
    tasa_iva: number;
  }

  interface CartResponse {
    ok: boolean;
    items?: CartItem[];
    resumen?: CartSummary;
    avisos?: string[];
    error?: string;
  }

  type CartAction =
    | { action: 'set'; productId: number; cantidad: number }
    | { action: 'remove'; productId: number }
    | { action: 'clear' };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const itemsCard = $('itemsCard');
  const itemsList = $('itemsList');
  const itemsFooter = $('itemsFooter');
  const clearCartBtn = $<HTMLButtonElement>('clearCartBtn');
  const loadingMsg = $('loadingMessage');
  const emptyMsg = $('emptyMessage');
  const emptyText = $('emptyText');
  const emptyLink = $<HTMLAnchorElement>('emptyLink');
  const emptyLinkText = $('emptyLinkText');
  const notices = $('cartNotices');
  const noticesList = $('cartNoticesList');
  const rowTemplate = $<HTMLTemplateElement>('cartRowTemplate');
  const subtotalDisplay = $('subtotalDisplay');
  const shippingDisplay = $('shippingDisplay');
  const shippingHint = $('shippingHint');
  // Umbral de envío gratis (ENVIO_GRATIS_SOBRE en src/lib/ventas.ts), lo pasa el servidor
  const envioGratisSobre = Number(document.querySelector<HTMLElement>('.order-summary')?.dataset.envioGratisSobre || 0);
  const totalDisplay = $('totalDisplay');
  const baseDisplay = $('baseDisplay');
  const ivaDisplay = $('ivaDisplay');
  const ivaRateDisplay = $('ivaRateDisplay');
  const totalItemsCount = $('totalItemsCount');
  const checkoutBtn = document.querySelector<HTMLButtonElement>('.checkout-btn');

  const money = (value: number): string =>
    `$${value.toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;

  const themeFor = (categoria: string | null): string =>
    /p[aá]del/i.test(categoria ?? '') ? 'theme-padel' : 'theme-shoe';

  const setText = (root: ParentNode, selector: string, text: string): void => {
    const el = root.querySelector(selector);
    if (el) el.textContent = text;
  };

  function showToast(message: string, kind: 'success' | 'error' = 'success'): void {
    const toast = document.createElement('div');
    toast.className = 'app-toast';
    toast.dataset.kind = kind;
    toast.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    toast.textContent = message;
    $('appToastRegion')?.appendChild(toast);
    window.setTimeout(() => toast.remove(), 4000);
  }

  // Avisos de productos agotados o con cantidad ajustada (los manda el GET)
  function renderNotices(avisos: string[] = []): void {
    if (!notices || !noticesList) return;
    noticesList.replaceChildren(
      ...avisos.map((aviso) => {
        const li = document.createElement('li');
        li.textContent = aviso;
        return li;
      }),
    );
    notices.hidden = avisos.length === 0;
  }

  function renderSummary(resumen: CartSummary | undefined, hasItems: boolean): void {
    const r = resumen ?? { subtotal: 0, envio: 0, total: 0, unidades: 0, base_sin_iva: 0, iva: 0, tasa_iva: 0.16 };
    // El desglose de IVA viene del servidor (desglosarIva, la misma función que usa la factura)
    const money2 = (n: number) => `$${n.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} MXN`;
    if (baseDisplay) baseDisplay.textContent = money2(r.base_sin_iva);
    if (ivaDisplay) ivaDisplay.textContent = money2(r.iva);
    if (ivaRateDisplay) ivaRateDisplay.textContent = String(Math.round(r.tasa_iva * 100));
    if (subtotalDisplay) subtotalDisplay.textContent = `${money(r.subtotal)} MXN`;
    // El costo de envío lo calcula el servidor con la misma regla que las ventas del ERP (calcularEnvio)
    const cobraEnvio = r.envio > 0;
    if (shippingDisplay) {
      shippingDisplay.textContent = !hasItems ? '—' : cobraEnvio ? `${money(r.envio)} MXN` : 'Gratis';
      shippingDisplay.classList.toggle('badge-free', hasItems && !cobraEnvio);
    }
    if (shippingHint) {
      shippingHint.hidden = !hasItems;
      shippingHint.classList.toggle('is-free', !cobraEnvio);
      shippingHint.textContent = cobraEnvio
        ? `Supera ${money(envioGratisSobre)} para tener envío gratis (llevas ${money(r.subtotal)}).`
        : `Tu compra supera ${money(envioGratisSobre)}: el envío es gratis.`;
    }
    if (totalDisplay) totalDisplay.textContent = `${money(r.total)} MXN`;
    if (totalItemsCount) totalItemsCount.textContent = String(r.unidades);
    if (checkoutBtn) checkoutBtn.disabled = !hasItems;
  }

  function buildRow(item: CartItem): HTMLElement | null {
    const fragment = rowTemplate?.content.cloneNode(true) as DocumentFragment | undefined;
    const row = fragment?.querySelector<HTMLElement>('.cart-row');
    if (!row) return null;

    row.dataset.id = String(item.id_producto);
    row.dataset.qty = String(item.cantidad);
    row.dataset.stock = String(item.stock);

    row.querySelector('.product-box')?.classList.add(themeFor(item.categoria));
    setText(row, '.cat-tag', item.categoria ?? '');
    setText(row, '.item-name', item.nombre);
    setText(row, '.variant', item.variante);
    setText(row, '.unit-price', `${money(item.precio)} c/u`);
    setText(row, '.item-total-val', money(item.subtotal));

    const remove = row.querySelector<HTMLButtonElement>('.btn-remove');
    if (remove) {
      remove.setAttribute('aria-label', `Eliminar ${item.nombre}`);
      remove.dataset.confirmClick = `¿Eliminar ${item.nombre} del carrito?`;
    }

    const qty = row.querySelector<HTMLInputElement>('.qty-field');
    if (qty) {
      qty.value = String(item.cantidad);
      qty.max = String(item.stock);
    }

    const dec = row.querySelector<HTMLButtonElement>('.dec');
    const inc = row.querySelector<HTMLButtonElement>('.inc');
    if (dec) dec.disabled = item.cantidad <= 1;
    if (inc) inc.disabled = item.cantidad >= item.stock;

    return row;
  }

  function renderCart(data: CartResponse): void {
    const items = data.items ?? [];
    if (loadingMsg) loadingMsg.style.display = 'none';

    itemsList?.replaceChildren(...items.map(buildRow).filter((row): row is HTMLElement => row !== null));

    const empty = items.length === 0;
    if (itemsList) itemsList.style.display = empty ? 'none' : '';
    if (itemsFooter) itemsFooter.hidden = empty;
    if (clearCartBtn) clearCartBtn.disabled = false;
    if (emptyMsg) emptyMsg.style.display = empty ? 'flex' : 'none';
    renderSummary(data.resumen, !empty);
  }

  function renderError(message: string, needsLogin = false): void {
    if (loadingMsg) loadingMsg.style.display = 'none';
    itemsList?.replaceChildren();
    if (itemsList) itemsList.style.display = 'none';
    if (itemsFooter) itemsFooter.hidden = true;
    if (emptyMsg) emptyMsg.style.display = 'flex';
    if (emptyText) emptyText.textContent = message;
    if (needsLogin) {
      if (emptyLink) emptyLink.href = '/login';
      if (emptyLinkText) emptyLinkText.textContent = 'Iniciar sesión';
    }
    renderSummary(undefined, false);
  }

  async function loadCart(): Promise<void> {
    itemsCard?.setAttribute('aria-busy', 'true');
    try {
      const res = await fetch('/api/carrito', { headers: { Accept: 'application/json' } });
      const data = (await res.json()) as CartResponse;

      if (!res.ok || !data.ok) {
        renderError(data.error ?? 'No pudimos cargar tu carrito.', res.status === 401);
        return;
      }

      renderNotices(data.avisos);
      renderCart(data);
    } catch {
      renderError('No pudimos cargar tu carrito. Revisa tu conexión e intenta de nuevo.');
    } finally {
      itemsCard?.setAttribute('aria-busy', 'false');
    }
  }

  let busy = false;

  async function updateCart(payload: CartAction): Promise<void> {
    if (busy) return;
    busy = true;
    itemsCard?.setAttribute('aria-busy', 'true');
    itemsList?.querySelectorAll('button').forEach((btn) => (btn.disabled = true));
    if (clearCartBtn) clearCartBtn.disabled = true;

    try {
      const res = await fetch('/api/carrito', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as CartResponse;

      if (!res.ok || !data.ok) {
        showToast(data.error ?? 'No se pudo actualizar el carrito.', 'error');
        // Se vuelve a leer el carrito para que la pantalla coincida con lo guardado (p. ej. si cambió el stock)
        busy = false;
        await loadCart();
        return;
      }

      renderCart(data);
      if (payload.action === 'remove') showToast('Producto eliminado del carrito.');
      if (payload.action === 'clear') showToast('Vaciaste tu carrito.');
    } catch {
      showToast('No se pudo actualizar el carrito. Revisa tu conexión.', 'error');
      busy = false;
      await loadCart();
    } finally {
      busy = false;
      itemsCard?.setAttribute('aria-busy', 'false');
    }
  }

  // Delegación de eventos para + y −
  itemsList?.addEventListener('click', (e: MouseEvent) => {
    const button = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.btn-qty');
    const row = button?.closest<HTMLElement>('.cart-row');
    if (!button || !row || button.disabled) return;

    const productId = Number(row.dataset.id);
    const qty = Number(row.dataset.qty);
    const stock = Number(row.dataset.stock);

    if (button.classList.contains('inc') && qty < stock) {
      updateCart({ action: 'set', productId, cantidad: qty + 1 });
    } else if (button.classList.contains('dec') && qty > 1) {
      updateCart({ action: 'set', productId, cantidad: qty - 1 });
    }
  });

  // "Eliminar" pasa por el diálogo de confirmación del Layout, que emite app-confirmed
  itemsList?.addEventListener('app-confirmed', (e: Event) => {
    const row = (e.target as HTMLElement | null)?.closest<HTMLElement>('.cart-row');
    if (row) updateCart({ action: 'remove', productId: Number(row.dataset.id) });
  });

  // "Vaciar carrito" también pasa por el diálogo de confirmación
  clearCartBtn?.addEventListener('app-confirmed', () => updateCart({ action: 'clear' }));

  // Flujo de compra
  checkoutBtn?.addEventListener('click', () => {
    showToast('Redirigiendo a pasarela de pago segura. ¡Gracias por probar el flujo de compra!');
    window.setTimeout(() => { window.location.href = '/'; }, 1600);
  });

  loadCart();
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { background: #f6f4ed; color: #171717; font-family: Georgia, 'Times New Roman', serif; margin: 0; }

  .cart-wrapper { min-height: 100vh; display: flex; flex-direction: column; }
  
  .topbar {
    align-items: center;
    background: #f7d21c;
    display: flex;
    justify-content: space-between;
    min-height: 76px;
    padding: 0 clamp(20px, 4vw, 64px);
  }

  .brand {
    align-items: center;
    color: #171717;
    display: flex;
    font-family: Arial, sans-serif;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -1.5px;
    text-decoration: none;
  }
  .brand span span { font-weight: 400; }
  .brand-mark {
    align-items: center;
    border: 3px solid #171717;
    border-radius: 50%;
    display: inline-flex;
    font-size: 15px;
    height: 30px;
    justify-content: center;
    margin-right: 8px;
    width: 30px;
  }

  .return-link {
    color: #171717;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }
  .return-link:hover { text-decoration: underline; }

  .cart-main {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    padding: clamp(30px, 4vw, 50px) clamp(20px, 4vw, 64px);
  }

  .eyebrow {
    color: #d93e2e;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 0 0 6px;
    text-transform: uppercase;
  }
  .eyebrow span {
    background: #f7d21c;
    display: inline-block;
    height: 7px;
    margin-right: 8px;
    width: 7px;
  }

  h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    letter-spacing: -2px;
    line-height: 0.95;
    margin: 0 0 32px;
  }
  h1 em { color: #d93e2e; font-style: italic; }

  .cart-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 36px;
    align-items: start;
  }

  .items-card {
    background: #fffdf3;
    border: 2px solid #171717;
    box-shadow: 6px 6px 0 #171717;
    padding: 24px 30px;
  }

  .table-head {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1fr 130px;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    color: #716e67;
    text-transform: uppercase;
    border-bottom: 2px solid #171717;
    padding-bottom: 12px;
  }

  .cart-row {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1fr 130px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px dashed #d8d3c3;
  }
  .cart-row:last-child { border-bottom: none; }

  .product-cell { display: flex; gap: 18px; align-items: center; }
  
  .product-box {
    width: 80px;
    height: 80px;
    border: 1.5px solid #171717;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }
  .theme-padel { background: #d7e1c3; }
  .theme-shoe { background: #e9c8bd; }

  .cat-tag {
    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
    color: #716e67;
    text-transform: uppercase;
  }

  .product-meta h3 { margin: 2px 0; font-size: 16px; font-weight: 400; }
  .variant { margin: 0 0 4px; font-family: Arial, sans-serif; font-size: 11px; color: #555; }
  .unit-price { font-family: Arial, sans-serif; font-size: 12px; font-weight: 700; color: #171717; }
  
  .btn-remove {
    align-items: center;
    background: #fffdf3;
    border: 1.5px solid #d93e2e;
    color: #d93e2e;
    cursor: pointer;
    display: inline-flex;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    gap: 6px;
    padding: 8px 12px;
    text-transform: uppercase;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .btn-remove:hover:not(:disabled) { background: #d93e2e; color: #fffdf3; }
  .remove-cell { display: flex; justify-content: flex-end; }

  .items-footer {
    border-top: 2px solid #171717;
    display: flex;
    justify-content: flex-end;
    padding-top: 16px;
  }
  .items-footer[hidden] { display: none; }
  .btn-clear {
    background: none;
    border: 0;
    color: #716e67;
    cursor: pointer;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 0;
    text-decoration: underline;
    text-transform: uppercase;
  }
  .btn-clear:hover:not(:disabled) { color: #d93e2e; }
  .btn-clear:disabled { opacity: 0.5; cursor: wait; }

  .counter-control {
    display: inline-flex;
    border: 1.5px solid #171717;
    background: #f6f4ed;
  }
  .btn-qty {
    background: transparent;
    border: 0;
    font-family: Arial, sans-serif;
    font-weight: 800;
    padding: 6px 10px;
    cursor: pointer;
  }
  .btn-qty:hover { background: #f7d21c; }
  .qty-field {
    width: 32px;
    border: 0;
    background: transparent;
    text-align: center;
    font-family: Arial, sans-serif;
    font-weight: 700;
    outline: 0;
  }

  .text-right { text-align: right; }
  .item-total-val { font-family: Arial, sans-serif; font-size: 15px; }

  .order-summary {
    background: #fffdf3;
    border: 2px solid #171717;
    box-shadow: 6px 6px 0 #171717;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .order-summary h2 {
    font-size: 20px;
    margin: 0;
    border-bottom: 2px solid #171717;
    padding-bottom: 10px;
  }

  .summary-line {
    display: flex;
    justify-content: space-between;
    font-family: Arial, sans-serif;
    font-size: 13px;
  }
  .tax-breakdown {
    border-left: 3px solid #d8d3c3;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 10px;
  }
  .tax-line { color: #57534e; font-size: 12px; }
  .tax-note {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 10px;
    margin: -8px 0 0;
  }
  .shipping-cost { font-weight: 800; }
  .shipping-cost.badge-free { font-size: 11px; }
  .shipping-hint {
    background: #fff4d6;
