---
// src/pages/carrito.astro
// El carrito se carga en el navegador desde /api/carrito (ver el <script> de abajo).
import Layout from '../layouts/Layout.astro';
import AccountHeader from '../components/AccountHeader.astro';
import { COSTO_ENVIO, ENVIO_GRATIS_DESDE } from '../lib/ventas';
import { ESTADOS_MX } from '../lib/direcciones';
import { mercadoPagoConfigurado } from '../lib/mercadoPago';

// Mercado Pago (Checkout Pro oficial) solo se ofrece si la tienda tiene su access token configurado
const mercadoPagoDisponible = mercadoPagoConfigurado();

const fmt = (n: number) => `$${n.toLocaleString('es-MX')}`;
---

<Layout title="Carrito de Compras | SporTenis">
  <div class="cart-wrapper">
    <AccountHeader backLabel="Volver al catálogo" active="carrito" />

    <main class="cart-main">
      <div class="header-section">
        <p class="eyebrow enter" style="--d: 40ms"><span></span> Tu selección</p>
        <h1 class="enter" style="--d: 120ms">Carrito de <em>Compra</em></h1>
      </div>

      <div id="cartNotices" class="cart-notices" role="status" hidden>
        <strong>Actualizamos tu carrito</strong>
        <ul id="cartNoticesList"></ul>
      </div>

      <div class="cart-grid enter" style="--d: 200ms">
        <!-- Listado de Productos -->
        <section class="items-card" aria-label="Productos en el carrito" aria-busy="true" id="itemsCard">
          <div class="table-head">
            <span>Artículo</span>
            <span>Cantidad</span>
            <span class="text-right">Total</span>
            <span class="text-right">Quitar</span>
          </div>

          <div id="loadingMessage" class="loading-state" role="status" aria-label="Cargando tu carrito…">
            {[0, 1, 2].map(() => (
              <div class="skeleton-row" aria-hidden="true">
                <span class="sk sk-box"></span>
                <span class="sk-lines"><span class="sk sk-line"></span><span class="sk sk-line short"></span></span>
                <span class="sk sk-pill"></span>
              </div>
            ))}
          </div>

          <div class="items-body" id="itemsList"></div>

          <div class="items-footer" id="itemsFooter" hidden>
            <button
              type="button"
              class="btn-clear"
              id="clearCartBtn"
              data-confirm-click="¿Quitar todos los productos de tu carrito?"
              data-confirm-title="Vaciar carrito"
              data-confirm-accept="Vaciar"
            >
              Vaciar carrito
            </button>
          </div>

          <div id="emptyMessage" class="empty-state" style="display: none;">
            <span class="empty-icon" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </span>
            <p id="emptyText">Tu carrito está actualmente vacío.</p>
            <a href="/" id="emptyLink" class="primary-button inline"><span id="emptyLinkText">Explorar artículos</span> <span>↗</span></a>
          </div>
        </section>

        <!-- Resumen de Pago -->
        <aside class="order-summary" aria-label="Resumen del pedido" data-envio-gratis-desde={ENVIO_GRATIS_DESDE}>
          <h2>Resumen</h2>

          <div class="summary-line">
            <span>Subtotal (<span id="totalItemsCount">0</span> productos)</span>
            <strong id="subtotalDisplay">$0 MXN</strong>
          </div>

          <div class="summary-line">
            <span>Costo de envío</span>
            <span class="shipping-cost" id="shippingDisplay">—</span>
          </div>

          <p class="shipping-hint" id="shippingHint" hidden></p>
          <div class="ship-progress" id="shipProgress" hidden aria-hidden="true"><span id="shipProgressBar"></span></div>
          <p class="shipping-rule">
            Envío de {fmt(COSTO_ENVIO)} si la compra es menor a {fmt(ENVIO_GRATIS_DESDE)}; gratis a partir de {fmt(ENVIO_GRATIS_DESDE)}.
          </p>

          <div class="promo-input-group">
            <input type="text" id="couponCode" placeholder="Código de descuento" />
            <button type="button" id="applyCoupon">Aplicar</button>
          </div>

          <hr class="summary-separator" />

          <div class="tax-breakdown" aria-label="Desglose de impuestos">
            <div class="summary-line tax-line">
              <span>Importe sin impuestos</span>
              <span id="baseDisplay">$0 MXN</span>
            </div>
            <!-- Una línea por cada impuesto activo (IVA y los que se configuren en /scm/precios) -->
            <div id="taxLines"></div>
          </div>

          <div class="summary-line total-line">
            <span>Total estimado</span>
            <strong id="totalDisplay">$0 MXN</strong>
          </div>
          <p class="tax-note">Precios en pesos mexicanos con impuestos incluidos. El desglose incluye el envío.</p>

          <!-- Indicador del checkout: primero la dirección, después el pago -->
          <ol class="checkout-steps" id="checkoutSteps" aria-label="Pasos para pagar" hidden>
            <li class="cs-step" data-step="envio"><span class="cs-dot" aria-hidden="true"><span class="cs-num">1</span><span class="cs-done">✓</span></span> Envío</li>
            <li class="cs-line" aria-hidden="true"></li>
            <li class="cs-step" data-step="pago"><span class="cs-dot" aria-hidden="true"><span class="cs-num">2</span><span class="cs-done">✓</span></span> Pago</li>
          </ol>

          <!-- Paso 1: dirección de envío (obligatoria antes de pagar) -->
          <section class="checkout-step" id="stepEnvio" aria-labelledby="stepEnvioTitle" hidden>
            <div class="step-head">
              <h3 class="step-title" id="stepEnvioTitle">¿A dónde lo enviamos?</h3>
              <a class="step-link" href="/cuenta/direcciones">Administrar</a>
            </div>
            <div class="address-list" id="addressList" role="radiogroup" aria-labelledby="stepEnvioTitle"></div>
            <button type="button" class="address-add" id="addAddressBtn">
              <span class="address-add-icon" aria-hidden="true">+</span> Agregar nueva dirección
            </button>

            <form class="address-form" id="addressForm" novalidate hidden>
              <div class="address-form-head">
                <strong>Nueva dirección <span class="req-nota">Campos con <span class="req">*</span> obligatorios</span></strong>
                <button type="button" class="address-form-close" id="cancelAddressBtn" aria-label="Cancelar nueva dirección">×</button>
              </div>
              <div class="form-grid">
                <label class="card-field"><span>Quién recibe <span class="req" aria-hidden="true">*</span></span>
                  <input name="destinatario" maxlength="255" autocomplete="name" required />
                </label>
                <label class="card-field"><span>Teléfono <span class="req" aria-hidden="true">*</span></span>
                  <input name="telefono" inputmode="tel" autocomplete="tel-national" maxlength="14" placeholder="10 dígitos" required />
                </label>
                <label class="card-field"><span>Código postal <span class="req" aria-hidden="true">*</span></span>
                  <input name="cp" inputmode="numeric" autocomplete="postal-code" maxlength="5" placeholder="Ej. 20298" required />
                </label>
                <label class="card-field"><span>Estado <span class="req" aria-hidden="true">*</span></span>
                  <select name="estado" autocomplete="address-level1" required>
                    <option value="">Elige…</option>
                    {ESTADOS_MX.map((estado) => <option value={estado}>{estado}</option>)}
                  </select>
                </label>
                <p class="geo-aviso span-2" data-geo-aviso hidden></p>
                <label class="card-field span-2"><span>Municipio o alcaldía <span class="req" aria-hidden="true">*</span></span>
                  <select name="ciudad" autocomplete="address-level2" required disabled>
                    <option value="">Primero elige el estado</option>
                  </select>
                </label>
                <label class="card-field span-2"><span>Colonia <span class="req" aria-hidden="true">*</span></span>
                  <select name="colonia" autocomplete="address-level3" required disabled>
                    <option value="">Primero escribe tu código postal</option>
                  </select>
                </label>
                <label class="card-field span-2"><span>Calle y número <span class="req" aria-hidden="true">*</span></span>
                  <input name="calle" maxlength="255" autocomplete="address-line1" placeholder="Av. Reforma 123, int. 4" required />
                </label>
                <label class="card-field span-2"><span>Nombre de la dirección <span class="req" aria-hidden="true">*</span></span>
                  <input name="alias" maxlength="100" placeholder="Casa, Oficina…" required />
                </label>
                <label class="card-field span-2"><span>Referencias <span class="optional">(opcional)</span></span>
                  <input name="referencias" maxlength="255" placeholder="Entre calles, color de la casa…" />
                </label>
                <label class="check-field span-2">
                  <input type="checkbox" name="principal" /> Usar como dirección principal
                </label>
              </div>
              <p class="card-error" id="addressError" role="alert" hidden></p>
              <button type="submit" class="save-address">Guardar y usar esta dirección</button>
            </form>

            <button type="button" class="primary-button continue-btn" id="continuePayBtn" disabled>
              Continuar al pago <span aria-hidden="true">→</span>
            </button>
          </section>

          <!-- Paso 2: forma de pago. Las tarjetas son simuladas; Mercado Pago es la pasarela oficial (Checkout Pro) -->
          <section class="checkout-step" id="stepPago" aria-labelledby="stepPagoTitle" hidden>
          <div class="ship-summary">
            <span class="ship-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
            <div class="ship-body">
              <span class="ship-label">Enviar a</span>
              <strong id="shipSummaryAlias"></strong>
              <span id="shipSummaryWho"></span>
              <span id="shipSummaryText"></span>
            </div>
            <button type="button" class="ship-change" id="changeAddressBtn">Cambiar</button>
          </div>
          <h3 class="step-title" id="stepPagoTitle">¿Cómo quieres pagar?</h3>
          <fieldset class="pay-options" id="payOptions">
            <legend class="sr-only">Forma de pago</legend>
            <label class="pay-option">
              <input type="radio" name="formaPago" value="monedero" checked />
              <span class="pay-option-body">
                <strong>Monedero</strong>
                <small>Saldo: <span id="walletBalanceDisplay">—</span></small>
              </span>
            </label>
            <label class="pay-option">
              <input type="radio" name="formaPago" value="tarjeta_credito" />
              <span class="pay-option-body"><strong>Tarjeta de crédito</strong><small>Visa, Mastercard o American Express</small></span>
            </label>
            <label class="pay-option">
              <input type="radio" name="formaPago" value="tarjeta_debito" />
              <span class="pay-option-body"><strong>Tarjeta de débito</strong><small>Visa o Mastercard</small></span>
            </label>
            <label class:list={['pay-option', { 'is-disabled': !mercadoPagoDisponible }]}>
              <input type="radio" name="formaPago" value="mercado_pago" disabled={!mercadoPagoDisponible} />
              <span class="pay-option-body">
                <strong>Mercado Pago</strong>
                <small>{mercadoPagoDisponible ? 'Tarjeta, saldo de Mercado Pago, OXXO y más' : 'No disponible por ahora'}</small>
              </span>
            </label>
          </fieldset>

          <p class="wallet-warning" id="walletWarning" hidden>
            <span id="walletWarningText"></span>
            <a href="/monedero">Recargar monedero ↗</a>
          </p>

          <div class="card-form" id="cardForm" hidden>
            <label class="card-field card-number">Número de tarjeta
              <span class="card-number-wrap">
                <input id="cardNumber" inputmode="numeric" autocomplete="cc-number" maxlength="19" placeholder="1234 5678 9012 3456" />
                <span class="card-brand" id="cardBrand"></span>
              </span>
            </label>
            <label class="card-field">Titular
              <input id="cardName" autocomplete="cc-name" placeholder="Como aparece en la tarjeta" />
            </label>
            <div class="card-row">
              <label class="card-field">Vencimiento
                <input id="cardExpiry" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="MM/AA" />
              </label>
              <label class="card-field">CVV
                <input id="cardCvv" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="123" />
              </label>
            </div>
            <p class="card-error" id="cardError" role="alert" hidden></p>
            <p class="card-note">Pago simulado: no se cobra nada y solo se guardan la marca y los últimos 4 dígitos. Prueba con 4242 4242 4242 4242; la 4000 0000 0000 0002 se rechaza.</p>
          </div>

          <p class="card-note" id="mpNote" hidden>Te llevaremos a la página segura de Mercado Pago para pagar. Al terminar regresarás aquí y verás tu compra.</p>

          <button type="button" class="primary-button checkout-btn" disabled>
            <span id="checkoutLabel">Pagar con monedero</span> <span aria-hidden="true">↗</span>
          </button>
          </section>

          <div class="badges-list">
            <p>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              Pago 100% protegido y cifrado
            </p>
            <p>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
              Devoluciones sin costo por 30 días
            </p>
          </div>
        </aside>
      </div>
    </main>
  </div>


  <!-- Molde de cada dirección en el paso 1; el ícono se elige por el nombre (casa, oficina u otra) -->
  <template id="addressCardTemplate">
    <label class="address-card">
      <input type="radio" name="direccionEnvio" class="address-radio" />
      <span class="address-icon" aria-hidden="true">
        <svg class="ico ico-casa" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>
        <svg class="ico ico-oficina" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1"/><path d="M10 21v-3h4v3"/></svg>
        <svg class="ico ico-otro" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
      </span>
      <span class="address-body">
        <span class="address-title"><strong class="address-alias"></strong><span class="address-badge" hidden>Principal</span></span>
        <span class="address-who"></span>
        <span class="address-line"></span>
        <span class="address-line address-city"></span>
        <span class="address-ref" hidden></span>
      </span>
      <span class="address-check" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
      </span>
    </label>
  </template>

  <template id="cartRowTemplate">
    <article class="cart-row">
      <div class="product-cell">
        <div class="product-box"><i></i><img class="product-photo" alt="" loading="lazy" decoding="async" hidden /></div>
        <div class="product-meta">
          <span class="cat-tag"></span>
          <h3 class="item-name"></h3>
          <p class="variant"></p>
          <span class="unit-price"></span>
          <s class="unit-original" hidden></s>
        </div>
      </div>

      <div class="qty-cell">
        <div class="counter-control">
          <button type="button" class="btn-qty dec" aria-label="Disminuir">−</button>
          <input type="number" class="qty-field" min="1" readonly />
          <button type="button" class="btn-qty inc" aria-label="Aumentar">+</button>
        </div>
      </div>

      <div class="total-cell text-right">
        <strong class="item-total-val"></strong>
      </div>

      <div class="remove-cell">
        <button type="button" class="btn-remove" data-confirm-title="Quitar del carrito" data-confirm-accept="Eliminar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
          <span>Eliminar</span>
        </button>
      </div>
    </article>
  </template>
</Layout>

<script>
  import { conectarSelectorDireccion } from '../scripts/selectorDireccion';
  // Forma de lo que devuelve /api/carrito (ver src/lib/cart.ts)
  interface CartItem {
    id_producto: number;
    nombre: string;
    categoria: string | null;
    variante: string;
    precio: number;
    precio_original?: number | null;
    cantidad: number;
    stock: number;
    subtotal: number;
    imagen?: string | null;
  }

  interface CartSummary {
    subtotal: number;
    envio: number;
    total: number;
    unidades: number;
    base_sin_impuestos: number;
    impuestos: Array<{ nombre: string; porcentaje: number; monto: number }>;
    total_impuestos: number;
  }

  interface CartResponse {
    ok: boolean;
    items?: CartItem[];
    resumen?: CartSummary;
    avisos?: string[];
    error?: string;
    /** Saldo del monedero; null si no se pudo leer (el servidor valida el cobro de todos modos). */
    saldo_monedero?: number | null;
    /** Compra de Mercado Pago que se acaba de confirmar al volver a la tienda. */
    compra_confirmada?: number | null;
  }

  type CartAction =
    | { action: 'set'; productId: number; cantidad: number }
    | { action: 'remove'; productId: number }
    | { action: 'clear' };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const itemsCard = $('itemsCard');
  const itemsList = $('itemsList');
  const itemsFooter = $('itemsFooter');
  const clearCartBtn = $<HTMLButtonElement>('clearCartBtn');
  const loadingMsg = $('loadingMessage');
  const emptyMsg = $('emptyMessage');
  const emptyText = $('emptyText');
  const emptyLink = $<HTMLAnchorElement>('emptyLink');
  const emptyLinkText = $('emptyLinkText');
  const notices = $('cartNotices');
  const noticesList = $('cartNoticesList');
  const rowTemplate = $<HTMLTemplateElement>('cartRowTemplate');
  const subtotalDisplay = $('subtotalDisplay');
  const shippingDisplay = $('shippingDisplay');
  const shippingHint = $('shippingHint');
  const shipProgress = $('shipProgress');
  const shipProgressBar = $('shipProgressBar');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Para animar solo lo que cambia entre un render y otro
  let firstRender = true;
  const previousSubtotals = new Map<number, number>();
  let previousTotal: number | null = null;

  const restartAnimation = (el: Element | null | undefined, className: string): void => {
    if (!el || reduceMotion) return;
    el.classList.remove(className);
    void (el as HTMLElement).offsetWidth;
    el.classList.add(className);
  };
  // Umbral de envío gratis (ENVIO_GRATIS_DESDE en src/lib/ventas.ts), lo pasa el servidor
  const envioGratisDesde = Number(document.querySelector<HTMLElement>('.order-summary')?.dataset.envioGratisDesde || 0);
  const totalDisplay = $('totalDisplay');
  const baseDisplay = $('baseDisplay');
  const taxLines = $('taxLines');
  const totalItemsCount = $('totalItemsCount');
  const checkoutBtn = document.querySelector<HTMLButtonElement>('.checkout-btn');
  const checkoutLabel = $('checkoutLabel');
  const payOptions = $('payOptions');
  const walletBalanceDisplay = $('walletBalanceDisplay');
  const walletWarning = $('walletWarning');
  const walletWarningText = $('walletWarningText');
  const cardForm = $('cardForm');
  const cardNumber = $<HTMLInputElement>('cardNumber');
  const cardName = $<HTMLInputElement>('cardName');
  const cardExpiry = $<HTMLInputElement>('cardExpiry');
  const cardCvv = $<HTMLInputElement>('cardCvv');
  const cardBrand = $('cardBrand');
  const cardError = $('cardError');
  const mpNote = $('mpNote');
  const stepEnvio = $('stepEnvio');
  const stepPago = $('stepPago');
  const addressList = $('addressList');
  const addAddressBtn = $<HTMLButtonElement>('addAddressBtn');
  const addressForm = $<HTMLFormElement>('addressForm');
  const addressError = $('addressError');
  const continuePayBtn = $<HTMLButtonElement>('continuePayBtn');
  const shipSummaryAlias = $('shipSummaryAlias');
  const shipSummaryWho = $('shipSummaryWho');
  const shipSummaryText = $('shipSummaryText');
  const checkoutSteps = $('checkoutSteps');
  const addressCardTemplate = $<HTMLTemplateElement>('addressCardTemplate');
  // Estado → municipios y código postal → colonias, con el catálogo de Correos de México
  const selectorGeo = addressForm ? conectarSelectorDireccion(addressForm) : null;

  interface Direccion {
    id: number;
    alias: string;
    destinatario: string;
    telefono: string;
    calle: string;
    colonia: string;
    ciudad: string;
    estado: string;
    cp: string;
    referencias: string | null;
    principal: boolean;
  }
  let direcciones: Direccion[] = [];
  let direccionesCargadas = false;
  let direccionElegida: number | null = null;
  // Paso del checkout: primero la dirección, después el pago
  let paso: 'envio' | 'pago' = 'envio';

  let saldoMonedero: number | null = null;
  let paying = false;
  // Último total y si hay artículos: deciden si se puede pagar con la forma elegida
  let ultimoTotal = 0;
  let hayArticulos = false;

  type FormaPago = 'monedero' | 'tarjeta_credito' | 'tarjeta_debito' | 'mercado_pago';
  const etiquetasPago: Record<FormaPago, string> = {
    monedero: 'Pagar con monedero',
    tarjeta_credito: 'Pagar con tarjeta de crédito',
    tarjeta_debito: 'Pagar con tarjeta de débito',
    mercado_pago: 'Continuar a Mercado Pago',
  };
  const formaElegida = (): FormaPago =>
    (document.querySelector<HTMLInputElement>('input[name="formaPago"]:checked')?.value as FormaPago) || 'monedero';
  const esTarjeta = (forma: FormaPago) => forma === 'tarjeta_credito' || forma === 'tarjeta_debito';

  const money = (value: number): string =>
    `$${value.toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;

  const themeFor = (categoria: string | null): string =>
    /p[aá]del|raquet/i.test(categoria ?? '') ? 'theme-padel' : 'theme-shoe';

  const setText = (root: ParentNode, selector: string, text: string): void => {
    const el = root.querySelector(selector);
    if (el) el.textContent = text;
  };

  function showToast(message: string, kind: 'success' | 'error' = 'success'): void {
    const toast = document.createElement('div');
    toast.className = 'app-toast';
    toast.dataset.kind = kind;
    toast.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    toast.textContent = message;
    $('appToastRegion')?.appendChild(toast);
    window.setTimeout(() => toast.remove(), 4000);
  }

  // Avisos de productos agotados o con cantidad ajustada (los manda el GET)
  function renderNotices(avisos: string[] = []): void {
    if (!notices || !noticesList) return;
    noticesList.replaceChildren(
      ...avisos.map((aviso) => {
        const li = document.createElement('li');
        li.textContent = aviso;
        return li;
      }),
    );
    notices.hidden = avisos.length === 0;
  }

  function renderSummary(resumen: CartSummary | undefined, hasItems: boolean): void {
    const r = resumen ?? { subtotal: 0, envio: 0, total: 0, unidades: 0, base_sin_impuestos: 0, impuestos: [], total_impuestos: 0 };
    // El desglose viene del servidor (desglosarImpuestos, la misma función que usa la factura)
    const money2 = (n: number) => `$${n.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} MXN`;
    if (baseDisplay) baseDisplay.textContent = money2(r.base_sin_impuestos);
    taxLines?.replaceChildren(...r.impuestos.map((imp) => {
      const line = document.createElement('div');
      line.className = 'summary-line tax-line';
      const label = document.createElement('span');
      label.textContent = `${imp.nombre} (${imp.porcentaje.toLocaleString('es-MX', { maximumFractionDigits: 2 })}%)`;
      const amount = document.createElement('span');
      amount.textContent = money2(imp.monto);
      line.append(label, amount);
      return line;
    }));
    if (subtotalDisplay) subtotalDisplay.textContent = `${money(r.subtotal)} MXN`;
    // El costo de envío lo calcula el servidor con la misma regla que las ventas del ERP (calcularEnvio)
    const cobraEnvio = r.envio > 0;
    if (shippingDisplay) {
      shippingDisplay.textContent = !hasItems ? '—' : cobraEnvio ? `${money(r.envio)} MXN` : 'Gratis';
      shippingDisplay.classList.toggle('badge-free', hasItems && !cobraEnvio);
    }
    if (shippingHint) {
      shippingHint.hidden = !hasItems;
      shippingHint.classList.toggle('is-free', !cobraEnvio);
      shippingHint.textContent = cobraEnvio
        ? `Te faltan ${money(Math.max(0, envioGratisDesde - r.subtotal))} para tener envío gratis (llevas ${money(r.subtotal)}).`
        : `Tu compra alcanza ${money(envioGratisDesde)}: el envío es gratis.`;
    }
    if (shipProgress && shipProgressBar) {
      shipProgress.hidden = !hasItems;
      const pct = envioGratisDesde > 0 ? Math.min(100, (r.subtotal / envioGratisDesde) * 100) : 100;
      shipProgressBar.style.width = `${cobraEnvio ? pct : 100}%`;
      shipProgress.classList.toggle('is-complete', !cobraEnvio);
    }
    if (totalDisplay) totalDisplay.textContent = `${money(r.total)} MXN`;
    if (previousTotal !== null && previousTotal !== r.total) restartAnimation(totalDisplay?.closest('.total-line'), 'flash');
    previousTotal = r.total;
    if (totalItemsCount) totalItemsCount.textContent = String(r.unidades);
    // Contador del ícono del carrito en el header (HeaderActions)
    if (resumen) {
      document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((badge) => {
        badge.textContent = String(r.unidades);
        badge.dataset.count = String(r.unidades);
      });
    }
    ultimoTotal = r.total;
    hayArticulos = hasItems;
    if (walletBalanceDisplay) {
      walletBalanceDisplay.textContent = saldoMonedero === null ? 'No disponible' : money2(saldoMonedero);
    }
    actualizarFormaPago();
  }

  /** Muestra lo que pide la forma de pago elegida y bloquea el pago con monedero si el saldo no alcanza. */
  function actualizarFormaPago(): void {
    const forma = formaElegida();
    const money2 = (n: number) => `$${n.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} MXN`;
    const faltante = forma !== 'monedero' || saldoMonedero === null
      ? 0
      : Math.max(0, Math.round((ultimoTotal - saldoMonedero) * 100) / 100);

    if (checkoutSteps) {
      checkoutSteps.hidden = !hayArticulos;
      checkoutSteps.querySelectorAll<HTMLElement>('.cs-step').forEach((step) => {
        const estado = step.dataset.step === paso ? 'actual' : step.dataset.step === 'envio' ? 'hecho' : 'pendiente';
        step.dataset.estado = estado;
        if (estado === 'actual') step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });
    }
    if (stepEnvio) stepEnvio.hidden = !hayArticulos || paso !== 'envio';
    if (stepPago) stepPago.hidden = !hayArticulos || paso !== 'pago';
    if (continuePayBtn) continuePayBtn.disabled = direccionElegida === null;
    if (walletWarning) walletWarning.hidden = !hayArticulos || faltante === 0;
    if (walletWarningText) walletWarningText.textContent = `Tu saldo no alcanza: te faltan ${money2(faltante)}. Recarga o elige otra forma de pago.`;
    if (cardForm) cardForm.hidden = !hayArticulos || !esTarjeta(forma);
    if (mpNote) mpNote.hidden = !hayArticulos || forma !== 'mercado_pago';
    if (checkoutLabel && !paying) checkoutLabel.textContent = etiquetasPago[forma];
    if (checkoutBtn) checkoutBtn.disabled = !hayArticulos || faltante > 0 || paying || direccionElegida === null;
  }

  // ── Paso 1: dirección de envío ─────────────────────────────────────
  const lineaCalle = (d: Direccion) => `${d.calle}, Col. ${d.colonia}`;
  const lineaCiudad = (d: Direccion) => `${d.ciudad}, ${d.estado} · C.P.\u00a0${d.cp}`;
  const lineaDireccion = (d: Direccion) => `${lineaCalle(d)}, ${lineaCiudad(d)}`;
  const telefonoLegible = (tel: string) => tel.replace(/^(\d{2})(\d{4})(\d{4})$/, '$1 $2 $3');
  // El ícono sale del nombre que el cliente le puso a la dirección
  const tipoDireccion = (alias: string): 'casa' | 'oficina' | 'otro' =>
    /casa|hogar|depa/i.test(alias) ? 'casa' : /oficina|trabajo|negocio|empresa/i.test(alias) ? 'oficina' : 'otro';

  function tarjetaDireccion(d: Direccion): HTMLElement | null {
    const fragment = addressCardTemplate?.content.cloneNode(true) as DocumentFragment | undefined;
    const card = fragment?.querySelector<HTMLElement>('.address-card');
    if (!card) return null;
    card.dataset.tipo = tipoDireccion(d.alias);

    const radio = card.querySelector<HTMLInputElement>('.address-radio');
    if (radio) {
      radio.value = String(d.id);
      radio.checked = d.id === direccionElegida;
      radio.setAttribute('aria-label', `${d.alias}: ${lineaDireccion(d)}`);
      radio.addEventListener('change', () => { direccionElegida = d.id; actualizarFormaPago(); });
    }
    setText(card, '.address-alias', d.alias);
    setText(card, '.address-who', `${d.destinatario} · ${telefonoLegible(d.telefono)}`);
    setText(card, '.address-line', lineaCalle(d));
    setText(card, '.address-city', lineaCiudad(d));
    const badge = card.querySelector<HTMLElement>('.address-badge');
    if (badge) badge.hidden = !d.principal;
    const ref = card.querySelector<HTMLElement>('.address-ref');
    if (ref && d.referencias) {
      ref.textContent = d.referencias;
      ref.hidden = false;
    }
    return card;
  }

  function renderDirecciones(): void {
    if (!addressList) return;
    addressList.replaceChildren(...direcciones.map(tarjetaDireccion).filter((c): c is HTMLElement => c !== null));
    // Sin direcciones se abre directamente el formulario
    const sinDirecciones = direcciones.length === 0;
    if (addressForm && sinDirecciones) addressForm.hidden = false;
    if (addAddressBtn) addAddressBtn.hidden = sinDirecciones || !(addressForm?.hidden ?? true);
    addressList.hidden = sinDirecciones;
    // Sin direcciones el formulario no se puede cerrar: hace falta una para pagar
    const cerrar = $('cancelAddressBtn');
    if (cerrar) cerrar.hidden = sinDirecciones;
    actualizarVistaFormulario();
  }

  /** Con el formulario abierto se oculta "Continuar al pago": primero se guarda o se cancela. */
  function actualizarVistaFormulario(): void {
    const abierto = !(addressForm?.hidden ?? true);
    if (continuePayBtn) continuePayBtn.hidden = abierto;
    if (addAddressBtn && direcciones.length > 0) addAddressBtn.hidden = abierto;
  }

  async function cargarDirecciones(): Promise<void> {
    try {
      const res = await fetch('/api/direcciones', { headers: { Accept: 'application/json' } });
      const data = (await res.json()) as { ok?: boolean; direcciones?: Direccion[] };
      if (!res.ok || !data.ok) return;
      direcciones = data.direcciones ?? [];
      // Se preselecciona la principal (la API la manda primero)
      if (direccionElegida === null || !direcciones.some((d) => d.id === direccionElegida)) {
        direccionElegida = direcciones[0]?.id ?? null;
      }
      direccionesCargadas = true;
      renderDirecciones();
      actualizarFormaPago();
    } catch {
      showToast('No pudimos cargar tus direcciones. Recarga la página.', 'error');
    }
  }

  addAddressBtn?.addEventListener('click', () => {
    if (!addressForm) return;
    addressForm.hidden = false;
    actualizarVistaFormulario();
    addressForm.querySelector<HTMLInputElement>('input[name="alias"]')?.focus();
  });
  $('cancelAddressBtn')?.addEventListener('click', () => {
    if (!addressForm) return;
    addressForm.reset();
    selectorGeo?.limpiar();
    if (addressError) addressError.hidden = true;
    // Sin direcciones guardadas el formulario se queda abierto: es obligatorio para pagar
    if (direcciones.length > 0) addressForm.hidden = true;
    renderDirecciones();
  });
  addressForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!addressForm.reportValidity()) return;
    const datos = Object.fromEntries(new FormData(addressForm).entries());
    const guardar = addressForm.querySelector<HTMLButtonElement>('.save-address');
    if (guardar) guardar.disabled = true;
    if (addressError) addressError.hidden = true;
    try {
      const res = await fetch('/api/direcciones', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ ...datos, principal: datos.principal === 'on' }),
      });
      const data = (await res.json()) as { ok?: boolean; id?: number; direcciones?: Direccion[]; error?: string };
      if (!res.ok || !data.ok || !data.id) throw new Error(data.error || 'No se pudo guardar la dirección.');
      direcciones = data.direcciones ?? [];
      direccionElegida = data.id;
      addressForm.reset();
      selectorGeo?.limpiar();
      addressForm.hidden = true;
      renderDirecciones();
      actualizarFormaPago();
      showToast('Dirección guardada.');
    } catch (error) {
      if (addressError) {
        addressError.textContent = error instanceof Error ? error.message : 'No se pudo guardar la dirección.';
        addressError.hidden = false;
      }
    } finally {
      if (guardar) guardar.disabled = false;
    }
  });

  continuePayBtn?.addEventListener('click', () => {
    const d = direcciones.find((x) => x.id === direccionElegida);
    if (!d) return;
    if (shipSummaryAlias) shipSummaryAlias.textContent = d.alias;
    if (shipSummaryWho) shipSummaryWho.textContent = `${d.destinatario} · ${telefonoLegible(d.telefono)}`;
    if (shipSummaryText) shipSummaryText.textContent = lineaDireccion(d);
    paso = 'pago';
    actualizarFormaPago();
    stepPago?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  $('changeAddressBtn')?.addEventListener('click', () => {
    paso = 'envio';
    actualizarFormaPago();
  });

  function buildRow(item: CartItem): HTMLElement | null {
    const fragment = rowTemplate?.content.cloneNode(true) as DocumentFragment | undefined;
    const row = fragment?.querySelector<HTMLElement>('.cart-row');
    if (!row) return null;

    row.dataset.id = String(item.id_producto);
    row.dataset.qty = String(item.cantidad);
    row.dataset.stock = String(item.stock);

    const box = row.querySelector<HTMLElement>('.product-box');
    box?.classList.add(themeFor(item.categoria));
    // Foto real del producto; si no tiene, se queda la ilustración del tema
    const photo = row.querySelector<HTMLImageElement>('.product-photo');
    if (photo && item.imagen) {
      photo.src = item.imagen;
      photo.alt = item.nombre;
      photo.hidden = false;
      box?.classList.add('has-photo');
      photo.addEventListener('error', () => {
        photo.hidden = true;
        box?.classList.remove('has-photo');
      }, { once: true });
    }
    setText(row, '.cat-tag', item.categoria ?? '');
    setText(row, '.item-name', item.nombre);
    setText(row, '.variant', item.variante);
    setText(row, '.unit-price', `${money(item.precio)} c/u`);
    // Con promoción vigente se muestra también el precio de lista tachado
    const original = row.querySelector<HTMLElement>('.unit-original');
    if (original && item.precio_original) {
      original.textContent = money(item.precio_original);
      original.setAttribute('aria-label', `Antes ${money(item.precio_original)}`);
      original.hidden = false;
    }
    setText(row, '.item-total-val', money(item.subtotal));

    const remove = row.querySelector<HTMLButtonElement>('.btn-remove');
    if (remove) {
      remove.setAttribute('aria-label', `Eliminar ${item.nombre}`);
      remove.dataset.confirmClick = `¿Eliminar ${item.nombre} del carrito?`;
    }

    const qty = row.querySelector<HTMLInputElement>('.qty-field');
    if (qty) {
      qty.value = String(item.cantidad);
      qty.max = String(item.stock);
    }

    const dec = row.querySelector<HTMLButtonElement>('.dec');
    const inc = row.querySelector<HTMLButtonElement>('.inc');
    if (dec) dec.disabled = item.cantidad <= 1;
    if (inc) inc.disabled = item.cantidad >= item.stock;

    return row;
  }

  function renderCart(data: CartResponse): void {
    if (data.saldo_monedero !== undefined) saldoMonedero = data.saldo_monedero;
    const items = data.items ?? [];
    if (loadingMsg) loadingMsg.style.display = 'none';

    const rows = items.map(buildRow).filter((row): row is HTMLElement => row !== null);
    rows.forEach((row, i) => {
      const id = Number(row.dataset.id);
      const item = items.find((it) => it.id_producto === id);
      if (firstRender) {
        // Entrada escalonada solo la primera vez; en cada actualización se resalta lo que cambió
        row.classList.add('row-enter');
        row.style.setProperty('--i', String(i));
      } else if (item && previousSubtotals.has(id) && previousSubtotals.get(id) !== item.subtotal) {
        restartAnimation(row.querySelector('.item-total-val'), 'flash');
        restartAnimation(row.querySelector('.qty-field'), 'flash');
      }
    });
    previousSubtotals.clear();
    items.forEach((it) => previousSubtotals.set(it.id_producto, it.subtotal));
    if (items.length > 0) firstRender = false;
    itemsList?.replaceChildren(...rows);

    const empty = items.length === 0;
    if (itemsList) itemsList.style.display = empty ? 'none' : '';
    if (itemsFooter) itemsFooter.hidden = empty;
    if (clearCartBtn) clearCartBtn.disabled = false;
    if (emptyMsg) emptyMsg.style.display = empty ? 'flex' : 'none';
    renderSummary(data.resumen, !empty);
  }

  function renderError(message: string, needsLogin = false): void {
    if (loadingMsg) loadingMsg.style.display = 'none';
    itemsList?.replaceChildren();
    if (itemsList) itemsList.style.display = 'none';
    if (itemsFooter) itemsFooter.hidden = true;
    if (emptyMsg) emptyMsg.style.display = 'flex';
    if (emptyText) emptyText.textContent = message;
    if (needsLogin) {
      if (emptyLink) emptyLink.href = '/login';
      if (emptyLinkText) emptyLinkText.textContent = 'Iniciar sesión';
    }
    renderSummary(undefined, false);
  }

  async function loadCart(): Promise<void> {
    itemsCard?.setAttribute('aria-busy', 'true');
    try {
      const res = await fetch('/api/carrito', { headers: { Accept: 'application/json' } });
      const data = (await res.json()) as CartResponse;

      if (!res.ok || !data.ok) {
        renderError(data.error ?? 'No pudimos cargar tu carrito.', res.status === 401);
        return;
      }

      if (data.compra_confirmada) {
        showToast('¡Tu pago con Mercado Pago se aprobó! Registramos tu compra.');
        window.setTimeout(() => { window.location.href = `/cuenta/compras/${data.compra_confirmada}`; }, 1400);
      }
      renderNotices(data.avisos);
      renderCart(data);
    } catch {
      renderError('No pudimos cargar tu carrito. Revisa tu conexión e intenta de nuevo.');
    } finally {
      itemsCard?.setAttribute('aria-busy', 'false');
    }
  }

  let busy = false;

  async function updateCart(payload: CartAction): Promise<void> {
    if (busy) return;
    busy = true;
    itemsCard?.setAttribute('aria-busy', 'true');
    itemsList?.querySelectorAll('button').forEach((btn) => (btn.disabled = true));
    if (clearCartBtn) clearCartBtn.disabled = true;

    try {
      const res = await fetch('/api/carrito', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as CartResponse;

      if (!res.ok || !data.ok) {
        showToast(data.error ?? 'No se pudo actualizar el carrito.', 'error');
        // Se vuelve a leer el carrito para que la pantalla coincida con lo guardado (p. ej. si cambió el stock)
        busy = false;
        await loadCart();
        return;
      }

      renderCart(data);
      if (payload.action === 'remove') showToast('Producto eliminado del carrito.');
      if (payload.action === 'clear') showToast('Vaciaste tu carrito.');
    } catch {
      showToast('No se pudo actualizar el carrito. Revisa tu conexión.', 'error');
      busy = false;
      await loadCart();
    } finally {
      busy = false;
      itemsCard?.setAttribute('aria-busy', 'false');
    }
  }

  // Delegación de eventos para + y −
  itemsList?.addEventListener('click', (e: MouseEvent) => {
    const button = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.btn-qty');
    const row = button?.closest<HTMLElement>('.cart-row');
    if (!button || !row || button.disabled) return;

    const productId = Number(row.dataset.id);
    const qty = Number(row.dataset.qty);
    const stock = Number(row.dataset.stock);

    if (button.classList.contains('inc') && qty < stock) {
      updateCart({ action: 'set', productId, cantidad: qty + 1 });
    } else if (button.classList.contains('dec') && qty > 1) {
      updateCart({ action: 'set', productId, cantidad: qty - 1 });
    }
  });

  // "Eliminar" pasa por el diálogo de confirmación del Layout, que emite app-confirmed
  // Las filas salen con animación antes de pedir el cambio al servidor
  const animateOut = (rows: HTMLElement[]): Promise<void> => {
    if (reduceMotion || rows.length === 0) return Promise.resolve();
    rows.forEach((row, i) => {
      row.style.setProperty('--i', String(i));
      row.style.setProperty('--h', `${row.offsetHeight}px`);
      row.classList.add('is-leaving');
    });
    return new Promise((resolve) => window.setTimeout(resolve, 340 + rows.length * 40));
  };

  itemsList?.addEventListener('app-confirmed', async (e: Event) => {
    const row = (e.target as HTMLElement | null)?.closest<HTMLElement>('.cart-row');
    if (!row || busy) return;
    await animateOut([row]);
    updateCart({ action: 'remove', productId: Number(row.dataset.id) });
  });

  // "Vaciar carrito" también pasa por el diálogo de confirmación
  clearCartBtn?.addEventListener('app-confirmed', async () => {
    if (busy) return;
    await animateOut(Array.from(itemsList?.querySelectorAll<HTMLElement>('.cart-row') ?? []));
    updateCart({ action: 'clear' });
  });

  // ── Formas de pago ────────────────────────────────────────────────
  document.querySelectorAll<HTMLInputElement>('input[name="formaPago"]').forEach((radio) =>
    radio.addEventListener('change', () => {
      if (cardError) cardError.hidden = true;
      actualizarFormaPago();
    }));

  const soloDigitos = (valor: string) => valor.replace(/\D/g, '');
  const marcaDe = (numero: string): string => {
    if (/^4/.test(numero)) return 'Visa';
    if (/^(5[1-5]|2[2-7])/.test(numero)) return 'Mastercard';
    if (/^3[47]/.test(numero)) return 'American Express';
    return '';
  };
  // Mismo algoritmo de Luhn que valida el servidor (src/lib/pagos.ts); aquí solo es para avisar antes
  const pasaLuhn = (numero: string): boolean => {
    let suma = 0;
    for (let i = 0; i < numero.length; i++) {
      let d = Number(numero[numero.length - 1 - i]);
      if (i % 2 === 1) { d *= 2; if (d > 9) d -= 9; }
      suma += d;
    }
    return numero.length > 0 && suma % 10 === 0;
  };

  cardNumber?.addEventListener('input', () => {
    const digitos = soloDigitos(cardNumber.value).slice(0, 16);
    cardNumber.value = digitos.replace(/(\d{4})(?=\d)/g, '$1 ');
    if (cardBrand) cardBrand.textContent = marcaDe(digitos);
  });
  cardExpiry?.addEventListener('input', () => {
    const digitos = soloDigitos(cardExpiry.value).slice(0, 4);
    cardExpiry.value = digitos.length > 2 ? `${digitos.slice(0, 2)}/${digitos.slice(2)}` : digitos;
  });
  cardCvv?.addEventListener('input', () => { cardCvv.value = soloDigitos(cardCvv.value).slice(0, 4); });

  const mostrarErrorTarjeta = (mensaje: string, campo?: HTMLInputElement | null): void => {
    if (cardError) { cardError.textContent = mensaje; cardError.hidden = false; }
    campo?.focus();
  };

  /** Datos de la tarjeta si pasan las revisiones básicas; el servidor vuelve a validar todo. */
  function leerTarjeta(): { numero: string; titular: string; vencimiento: string; cvv: string } | null {
    const numero = soloDigitos(cardNumber?.value ?? '');
    const marca = marcaDe(numero);
    if (!marca || numero.length !== (marca === 'American Express' ? 15 : 16) || !pasaLuhn(numero)) {
      mostrarErrorTarjeta('Revisa el número de la tarjeta.', cardNumber);
      return null;
    }
    const titular = cardName?.value.trim() ?? '';
    if (titular.length < 3) { mostrarErrorTarjeta('Escribe el nombre del titular.', cardName); return null; }
    const vencimiento = cardExpiry?.value.trim() ?? '';
    if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(vencimiento)) { mostrarErrorTarjeta('La fecha de vencimiento debe ser MM/AA.', cardExpiry); return null; }
    const cvv = cardCvv?.value.trim() ?? '';
    if (cvv.length !== (marca === 'American Express' ? 4 : 3)) { mostrarErrorTarjeta('Revisa el código de seguridad (CVV).', cardCvv); return null; }
    if (cardError) cardError.hidden = true;
    return { numero, titular, vencimiento, cvv };
  }

  const nombrePago: Record<FormaPago, string> = {
    monedero: 'con tu monedero',
    tarjeta_credito: 'con tu tarjeta de crédito',
    tarjeta_debito: 'con tu tarjeta de débito',
    mercado_pago: 'con Mercado Pago',
  };

  /**
   * Registra la compra con monedero o tarjeta. El servidor autoriza la tarjeta (simulado),
   * registra la venta y, con monedero, cobra el saldo en la misma transacción. Si algo
   * falla no se registra nada. Con una pasarela real la tarjeta se tokenizaría con su SDK y aquí
   * solo viajaría el token, nunca el número.
   */
  async function pagar(forma: FormaPago, extra: Record<string, unknown> = {}): Promise<boolean> {
    if (paying || busy) return false;
    paying = true;
    if (checkoutBtn) checkoutBtn.disabled = true;
    if (checkoutLabel) checkoutLabel.textContent = 'Procesando pago...';

    const terminar = async (): Promise<false> => {
      paying = false;
      await loadCart();
      return false;
    };

    try {
      const res = await fetch('/api/ventas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ pago: forma, id_direccion: direccionElegida, ...extra }),
      });
      const data = (await res.json()) as { success?: boolean; id_venta?: number; total?: number; referencia_pago?: string | null; error?: string };

      if (!res.ok || !data.success || !data.id_venta) {
        if (esTarjeta(forma)) {
          mostrarErrorTarjeta(data.error ?? 'No se pudo completar el pago.');
          if (cardCvv) cardCvv.value = '';
        } else {
          showToast(data.error ?? 'No se pudo completar el pago.', 'error');
        }
        return terminar();
      }

      const detalle = data.referencia_pago ? ` (${data.referencia_pago})` : '';
      showToast(`¡Compra realizada! Pagaste ${money(Number(data.total ?? 0))} MXN ${nombrePago[forma]}${detalle}.`);
      window.setTimeout(() => { window.location.href = `/cuenta/compras/${data.id_venta}`; }, 1400);
      return true;
    } catch {
      showToast('No se pudo completar el pago. Revisa tu conexión e intenta de nuevo.', 'error');
      return terminar();
    }
  }

  /**
   * Mercado Pago oficial (Checkout Pro): el servidor crea la preferencia de pago y aquí solo se
   * redirige a su página. La compra se registra al volver, cuando el servidor confirma el pago con
   * la API de Mercado Pago (/checkout/mercadopago).
   */
  async function irAMercadoPago(): Promise<void> {
    if (paying || busy) return;
    paying = true;
    if (checkoutBtn) checkoutBtn.disabled = true;
    if (checkoutLabel) checkoutLabel.textContent = 'Conectando con Mercado Pago...';
    try {
      const res = await fetch('/api/pagos/mercadopago', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id_direccion: direccionElegida }),
      });
      const data = (await res.json()) as { ok?: boolean; url?: string; error?: string };
      if (!res.ok || !data.ok || !data.url) throw new Error(data.error || 'No se pudo iniciar el pago con Mercado Pago.');
      window.location.href = data.url;
    } catch (error) {
      showToast(error instanceof Error ? error.message : 'No se pudo iniciar el pago con Mercado Pago.', 'error');
      paying = false;
      await loadCart();
    }
  }

  checkoutBtn?.addEventListener('click', () => {
    const forma = formaElegida();
    if (forma === 'mercado_pago') {
      void irAMercadoPago();
      return;
    }
    if (esTarjeta(forma)) {
      const tarjeta = leerTarjeta();
      if (tarjeta) void pagar(forma, { tarjeta });
      return;
    }
    void pagar('monedero');
  });


  // Al regresar con "Atrás" el navegador restaura la página tal cual (con "Conectando con Mercado Pago…"):
  // se reinicia el botón y se vuelve a leer el carrito, que además revisa si el pago ya se aprobó
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    paying = false;
    void loadCart();
  });

  loadCart();
  void cargarDirecciones();
</script>

