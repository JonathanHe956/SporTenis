---
import CrmLayout from '../../layouts/CrmLayout.astro';
import { db } from '../../db/db';
import { Configuraciones, Usuarios, EtapasCrm, TiposInteraccion } from '../../db/schema';
import { eq } from 'drizzle-orm';
const { module } = Astro.params;
if (module !== 'crm' && module !== 'scm') return Astro.redirect('/404');
const activePath = `/${module}/configuracion`;


const session = Astro.cookies.get('sportenis_session')?.value;
if (!session) return Astro.redirect('/login');

const currentUser = await db.select().from(Usuarios).where(eq(Usuarios.id, Number(session)));
if (currentUser.length === 0 || currentUser[0].id_rol !== 1) {
  return Astro.redirect('/scm');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'create_etapa') {
    await db.insert(EtapasCrm).values({ nombre: formData.get('nombre') as string });
  } else if (action === 'delete_etapa') {
    const id = Number(formData.get('id'));
    await db.delete(EtapasCrm).where(eq(EtapasCrm.id, id));
  } else if (action === 'create_tipo') {
    await db.insert(TiposInteraccion).values({ nombre: formData.get('nombre') as string });
  } else if (action === 'save_scm_config') {
    const reorden = formData.get('STOCK_REORDEN_CANTIDAD') as string;
    const existing = await db.select().from(Configuraciones).where(eq(Configuraciones.clave, 'STOCK_REORDEN_CANTIDAD'));
    if (existing.length > 0) {
      await db.update(Configuraciones).set({ valor: reorden }).where(eq(Configuraciones.clave, 'STOCK_REORDEN_CANTIDAD'));
    } else {
      await db.insert(Configuraciones).values({ clave: 'STOCK_REORDEN_CANTIDAD', valor: reorden, descripcion: 'Cantidad a pedir automáticamente cuando el stock es bajo' });
    }
  }
  
  return Astro.redirect(Astro.url.pathname);
}

const etapas = await db.select().from(EtapasCrm);
const tipos = await db.select().from(TiposInteraccion);
const configs = await db.select().from(Configuraciones);
---

<CrmLayout title="Configuración Global" activePath={activePath}>
  <div class="header-actions">
    <h1 class="crm-title">Configuración Global (CRM y SCM)</h1>
  </div>

  <div class="settings-grid">
    <!-- Catálogo de Etapas CRM -->
    <div class="crm-card">
      <div class="card-header">
        <h3>Etapas de Venta (CRM)</h3>
      </div>
      <p class="text-muted" style="margin-bottom: 16px; font-size: 13px;">Define el pipeline por el que pasan tus clientes.</p>
      
      <ul class="catalog-list">
        {etapas.map(e => (
          <li>
            <span>{e.nombre}</span>
            <form method="POST" style="margin: 0;" onsubmit="return confirm('¿Eliminar esta etapa?');">
              <input type="hidden" name="action" value="delete_etapa" />
              <input type="hidden" name="id" value={e.id} />
              <button type="submit" class="action-btn text-danger">×</button>
            </form>
          </li>
        ))}
      </ul>

      <form method="POST" class="add-form">
        <input type="hidden" name="action" value="create_etapa" />
        <input type="text" name="nombre" placeholder="Nueva etapa..." required />
        <button type="submit" class="btn-outline">Añadir</button>
      </form>
    </div>

    <!-- Catálogo de Tipos de Interacción -->
    <div class="crm-card">
      <div class="card-header">
        <h3>Tipos de Interacción (CRM)</h3>
      </div>
      <p class="text-muted" style="margin-bottom: 16px; font-size: 13px;">Canales o motivos por los que contactas a los clientes.</p>
      
      <ul class="catalog-list">
        {tipos.map(t => (
          <li>
            <span>{t.nombre}</span>
            <form method="POST" style="margin: 0;" onsubmit="return confirm('¿Eliminar este tipo de interacción?');">
              <input type="hidden" name="action" value="delete_tipo" />
              <input type="hidden" name="id" value={t.id} />
              <button type="submit" class="action-btn text-danger">×</button>
            </form>
          </li>
        ))}
      </ul>

      <form method="POST" class="add-form">
        <input type="hidden" name="action" value="create_tipo" />
        <input type="text" name="nombre" placeholder="Nuevo tipo..." required />
        <button type="submit" class="btn-outline">Añadir</button>
      </form>
    </div>

    <!-- Configuración SCM -->
    <div class="crm-card" style="grid-column: 1 / -1;">
      <div class="card-header">
        <h3>Logística e Inventario (SCM)</h3>
      </div>
      <p class="text-muted" style="margin-bottom: 24px; font-size: 13px;">Ajusta los parámetros para el reabastecimiento automático de productos con stock bajo.</p>
      
      <form method="POST" style="max-width: 400px;">
        <input type="hidden" name="action" value="save_scm_config" />
        
        <div class="form-group">
          <label>Cantidad de restock automático por defecto</label>
          <div style="display: flex; gap: 12px; align-items: center;">
            <input type="number" name="STOCK_REORDEN_CANTIDAD" value={configs.find(c => c.clave === 'STOCK_REORDEN_CANTIDAD')?.valor || 50} required min="1" />
            <button type="submit" class="btn-primary">Guardar</button>
          </div>
          <p class="text-muted" style="margin-top: 8px; font-size: 12px;">Cantidad que se pedirá al proveedor cuando un producto llegue a su stock mínimo.</p>
        </div>
      </form>
    </div>
  </div>
</CrmLayout>

<style>
  .header-actions {
    margin-bottom: 24px;
  }
  .crm-title { margin-bottom: 0; }
  
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 24px;
  }

  .crm-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .card-header {
    border-bottom: 1px solid var(--color-border);
    margin: -24px -24px 16px;
    padding: 16px 24px;
  }
  .card-header h3 { margin: 0; font-size: 16px; }

  .text-muted { color: var(--color-text-muted); }

  .catalog-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
  }
  .catalog-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    border-bottom: none;
    font-size: 14px;
    font-weight: 700;
  }
  .catalog-list li:first-child { border-radius: 8px 8px 0 0; }
  .catalog-list li:last-child { border-bottom: 1px solid var(--color-border); border-radius: 0 0 8px 8px; }
  
  .action-btn {
    background: none;
    border: none;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.5;
    padding: 0 4px;
  }
  .action-btn:hover { opacity: 1; color: var(--color-danger); }

  .action-btn-small {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    opacity: 0.6;
    margin-left: 8px;
    color: inherit;
  }
  .action-btn-small:hover { opacity: 1; color: var(--color-text); }
  .action-btn-small.text-danger:hover { color: var(--color-danger); }

  .add-form {
    display: flex;
    gap: 8px;
  }
  .add-form input {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
  }
  
  .btn-primary {
    background: var(--color-text);
    color: white;
    border: none;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn-primary:hover { background: var(--color-danger); }
  
  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-text);
    color: var(--color-text);
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 6px;
    cursor: pointer;
  }
  .btn-outline:hover { background: var(--color-text); color: white; }

  .table-responsive {
    overflow-x: auto;
    margin: 0 -24px;
  }
  .crm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .crm-table th {
    text-align: left;
    padding: 12px 24px;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .crm-table td {
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .crm-table tbody tr:hover { background: var(--color-bg); }
  
  .text-right { text-align: right; }

  /* Modals */
  .crm-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    width: 100%;
    max-width: 500px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }
  .crm-modal::backdrop { background: rgba(0,0,0,0.5); }
  .modal-content { padding: 24px; }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .modal-header h2 { margin: 0; font-size: 20px; }
  .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--color-text-muted); }
  
  .form-group { margin-bottom: 16px; text-align: left; }
  .form-group label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 8px; }
  .form-group input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
  }
  
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
  }
</style>
