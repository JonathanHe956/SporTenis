---
import Layout from '../layouts/Layout.astro';
import AccountHeader from '../components/AccountHeader.astro';

if (!Astro.locals.user) {
  return Astro.redirect('/login');
}
---

<Layout title="Mi Monedero | SporTenis">
  <div class="wallet-page">
    <AccountHeader backHref="/" backLabel="Volver a la tienda" active="monedero" />

    <main class="wallet-main">
      <div class="page-heading">
        <p class="eyebrow"><span></span> Tu cuenta SporTenis</p>
        <h1>Tu juego,<br /><em>tu saldo.</em></h1>
        <p class="heading-copy">Administra el saldo de tu monedero y úsalo para seguir jugando.</p>
      </div>

      <div class="wallet-grid">
        <section class="balance-card" aria-labelledby="balance-title">
          <div class="balance-card-top">
            <div class="wallet-symbol" aria-hidden="true">
              <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="15" rx="2"></rect>
                <path d="M3 9h18M16 15h.01"></path>
                <path d="M7 5V3h10v2"></path>
              </svg>
            </div>
            <span class="balance-label">Monedero digital</span>
            <span class="card-status"><i></i> ACTIVO</span>
          </div>
          <div class="balance-content">
            <p id="balance-title">Saldo disponible</p>
            <output id="walletBalance" aria-live="polite" aria-busy="true">Cargando...</output>
          </div>
          <div class="balance-card-bottom">
            <span>SPOR TENIS · MÉXICO</span>
            <span id="walletNumber">•••• &nbsp;••••</span>
          </div>
          <div class="ball-decoration" aria-hidden="true"></div>
        </section>

        <section class="movement-card" aria-labelledby="movement-title">
          <div class="movement-heading">
            <div>
              <p class="eyebrow">Agrega saldo</p>
              <h2 id="movement-title">Recargar monedero</h2>
            </div>
            <span class="movement-mark" aria-hidden="true">↗</span>
          </div>

          <form id="walletForm">
            <label for="amount">Monto a recargar</label>
            <div class="amount-field">
              <span aria-hidden="true">$</span>
              <input
                type="number"
                id="amount"
                name="monto"
                min="0.01"
                step="0.01"
                placeholder="0.00"
                inputmode="decimal"
                required
              />
              <span class="currency">MXN</span>
            </div>
            <p class="amount-hint">Ingresa un monto mayor a $0.00 MXN.</p>
            <button type="submit" class="submit-button" id="submitMovement">
              <span id="submitLabel">Recargar monedero</span><span aria-hidden="true">↗</span>
            </button>
          </form>

          <p class="feedback" id="walletFeedback" role="status" aria-live="polite"></p>
          <p class="demo-note"><strong>Nota:</strong> Tus compras de la tienda se pagan automáticamente con este saldo. Las recargas se aplican directamente; esta versión no procesa pagos externos.</p>
        </section>
      </div>

      <section class="history-card" aria-labelledby="history-title">
        <div class="history-heading">
          <div>
            <p class="eyebrow">Actividad de tu monedero</p>
            <h2 id="history-title">Últimos movimientos</h2>
          </div>
        </div>
        <div class="history-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Movimiento</th>
                <th scope="col">Monto</th>
              </tr>
            </thead>
            <tbody id="movementHistory">
              <tr><td class="history-empty" colspan="3">Cargando movimientos...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <a href="/" class="continue-link">Seguir explorando la tienda <span aria-hidden="true">↗</span></a>
    </main>
  </div>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { background: #f6f4ed; color: #171717; font-family: Georgia, 'Times New Roman', serif; }
  .wallet-page { min-height: 100vh; }
  .continue-link:hover { text-decoration: underline; }
  .wallet-main { margin: 0 auto; max-width: 1120px; padding: 64px 32px 48px; }
  .page-heading { margin-bottom: 32px; }
  .eyebrow { color: #d93e2e; font-family: Arial, sans-serif; font-size: 10px; font-weight: 800; letter-spacing: 1.8px; margin: 0 0 12px; text-transform: uppercase; }
  .eyebrow > span { background: #d93e2e; display: inline-block; height: 7px; margin-right: 8px; width: 7px; }
  h1 { font-size: clamp(42px, 6vw, 68px); font-weight: 400; letter-spacing: -3.5px; line-height: .92; margin: 0; }
  h1 em { color: #d93e2e; }
  .heading-copy { color: #716e67; font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; margin: 14px 0 0; max-width: 380px; }
  .wallet-grid { align-items: stretch; display: grid; gap: 22px; grid-template-columns: 1fr 1fr; }
  .balance-card { background: #171717; border-radius: 4px; color: #fffdf3; display: flex; flex-direction: column; justify-content: space-between; min-height: 330px; overflow: hidden; padding: 25px 28px 20px; position: relative; }
  .balance-card-top, .balance-card-bottom { align-items: center; display: flex; position: relative; z-index: 1; }
  .balance-card-top { gap: 12px; }
  .wallet-symbol { align-items: center; background: #f7d21c; border-radius: 50%; color: #171717; display: flex; height: 42px; justify-content: center; width: 42px; }
  .balance-label { font-family: Arial, sans-serif; font-size: 12px; font-weight: 700; }
  .card-status { align-items: center; background: #ffffff16; border-radius: 20px; display: inline-flex; font-family: Arial, sans-serif; font-size: 8px; gap: 6px; letter-spacing: .8px; margin-left: auto; padding: 7px 9px; }
  .card-status i { background: #d8ee32; border-radius: 50%; height: 6px; width: 6px; }
  .balance-content { position: relative; z-index: 1; }
  .balance-content p { color: #ffffffa6; font-family: Arial, sans-serif; font-size: 11px; margin: 0 0 9px; }
  #walletBalance { display: block; font-size: clamp(34px, 5vw, 52px); letter-spacing: -2px; min-height: 58px; overflow-wrap: anywhere; }
  .balance-card-bottom { border-top: 1px solid #ffffff30; color: #ffffff9e; font-family: Arial, sans-serif; font-size: 8px; font-weight: 700; letter-spacing: 1.4px; padding-top: 15px; }
  .ball-decoration { border: 1px solid #f7d21c80; border-radius: 50%; height: 240px; position: absolute; right: -72px; top: 72px; transform: rotate(-25deg); width: 168px; }
  .ball-decoration::before, .ball-decoration::after { border: 4px solid #f7d21c; border-radius: 50%; content: ''; height: 100%; left: -12px; position: absolute; top: 0; transform: rotate(25deg); width: 56%; }
  .ball-decoration::after { left: auto; right: -12px; }
  .movement-card { background: #fff; border: 1px solid #e8e3d8; border-radius: 4px; padding: 25px 28px 20px; }
  .movement-heading { align-items: flex-start; display: flex; justify-content: space-between; margin-bottom: 21px; }
  .movement-heading .eyebrow { font-size: 8px; margin-bottom: 7px; }
  h2 { font-size: 25px; font-weight: 400; letter-spacing: -1px; margin: 0; }
  .movement-mark { align-items: center; background: #f7d21c; border-radius: 50%; display: flex; font-family: Arial, sans-serif; font-size: 19px; height: 35px; justify-content: center; width: 35px; }
  form { display: flex; flex-direction: column; }
  label { font-family: Arial, sans-serif; font-size: 10px; font-weight: 800; margin-bottom: 8px; text-transform: uppercase; }
  .amount-field { align-items: center; border: 1px solid #d8d3c3; display: flex; min-height: 57px; padding: 0 14px; }
  .amount-field:focus-within { border-color: #171717; outline: 2px solid #f7d21c; }
  .amount-field > span:first-child { font-size: 22px; margin-right: 8px; }
  .amount-field input { background: transparent; border: 0; color: #171717; font-family: Georgia, 'Times New Roman', serif; font-size: 24px; min-width: 0; outline: 0; width: 100%; }
  .amount-field input::-webkit-inner-spin-button, .amount-field input::-webkit-outer-spin-button { appearance: none; margin: 0; }
  .amount-field input[type=number] { appearance: textfield; }
  .currency { color: #716e67; font-family: Arial, sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
  .amount-hint { color: #716e67; font-family: Arial, sans-serif; font-size: 10px; margin: 7px 0 16px; }
  .submit-button { align-items: center; background: #f7d21c; border: 0; color: #171717; cursor: pointer; display: flex; font-family: Arial, sans-serif; font-size: 10px; font-weight: 900; justify-content: space-between; min-height: 47px; padding: 0 16px; text-transform: uppercase; transition: background .15s, transform .15s; }
  .submit-button:hover:not(:disabled) { background: #edc319; transform: translateY(-1px); }
  .submit-button:disabled { cursor: wait; opacity: .7; }
  .submit-button span:last-child { font-size: 17px; }
  .feedback { display: none; font-family: Arial, sans-serif; font-size: 11px; line-height: 1.5; margin: 12px 0 0; }
  .feedback[data-kind="success"], .feedback[data-kind="error"] { display: block; }
  .feedback[data-kind="success"] { color: #16703b; }
  .feedback[data-kind="error"] { color: #c62828; }
  .demo-note { border-top: 1px solid #e8e3d8; color: #716e67; font-family: Arial, sans-serif; font-size: 9px; line-height: 1.5; margin: 14px 0 0; padding-top: 12px; }
  .demo-note strong { color: #171717; }
  .history-card { background: #fffdf7; border: 1px solid #e8e3d8; margin-top: 30px; padding: 25px 28px; }
  .history-heading { align-items: center; display: flex; justify-content: space-between; margin-bottom: 18px; }
  .history-heading .eyebrow { margin-bottom: 7px; }
  .history-table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; min-width: 440px; text-align: left; width: 100%; }
  th { color: #716e67; font-family: Arial, sans-serif; font-size: 9px; letter-spacing: 1px; padding: 0 12px 12px; text-transform: uppercase; }
  td { border-top: 1px solid #e8e3d8; font-family: Arial, sans-serif; font-size: 12px; padding: 14px 12px; }
  td:last-child { font-weight: 700; text-align: right; }
  th:last-child { text-align: right; }
  .history-type { align-items: center; display: inline-flex; gap: 8px; }
  .history-type::before { border-radius: 50%; content: ''; height: 7px; width: 7px; }
  .history-type[data-type="Recarga"]::before { background: #25834b; }
  .history-type[data-type="Descuento"]::before { background: #d93e2e; }
  .history-type[data-type="Reembolso"]::before { background: #2563eb; }
  .history-empty { color: #716e67; padding: 20px 12px; text-align: center !important; }
  .continue-link { color: #171717; display: inline-flex; font-family: Arial, sans-serif; font-size: 10px; font-weight: 800; gap: 8px; margin-top: 25px; text-decoration: none; text-transform: uppercase; }
  .continue-link span { font-size: 16px; }
  @media (max-width: 720px) {
    .wallet-main { padding: 42px 20px 36px; }
    .wallet-grid { grid-template-columns: 1fr; }
    .balance-card { min-height: 270px; }
  }
  @media (max-width: 480px) {
    .wallet-main { padding: 34px 16px; }
    .balance-card { min-height: 245px; padding: 20px; }
    .movement-card { padding: 21px 18px 17px; }
    .ball-decoration { right: -95px; }
  }
</style>

<script>
  const balanceOutput = document.getElementById('walletBalance');
  const movementHistory = document.getElementById('movementHistory');
  const feedback = document.getElementById('walletFeedback');
  const amountInput = document.getElementById('amount') as HTMLInputElement | null;
  const submitButton = document.getElementById('submitMovement') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submitLabel');
  const walletForm = document.getElementById('walletForm') as HTMLFormElement | null;

  const formatMoney = (amount: number): string =>
    new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(amount);

  type Movimiento = { tipo: 'Recarga' | 'Descuento' | 'Reembolso'; monto: string | number; fecha: string; id_venta?: number | null };

  // Un descuento es el pago de una compra; un reembolso, su devolución al cancelarla
  const etiquetaMovimiento = (m: Movimiento): string => {
    if (m.tipo === 'Descuento') return m.id_venta ? `Compra #${m.id_venta}` : 'Compra';
    if (m.tipo === 'Reembolso') return m.id_venta ? `Reembolso compra #${m.id_venta}` : 'Reembolso';
    return 'Recarga';
  };

  const renderHistory = (movimientos: Movimiento[]): void => {
    if (!movementHistory) return;
    movementHistory.replaceChildren();

    if (movimientos.length === 0) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 3;
      cell.className = 'history-empty';
      cell.textContent = 'Aún no tienes movimientos.';
      row.append(cell);
      movementHistory.append(row);
      return;
    }

    movimientos.forEach((movimiento) => {
      const row = document.createElement('tr');
      const dateCell = document.createElement('td');
      const typeCell = document.createElement('td');
      const amountCell = document.createElement('td');
      const typeLabel = document.createElement('span');
      const date = new Date(movimiento.fecha);

      dateCell.textContent = Number.isNaN(date.getTime())
        ? 'Fecha no disponible'
        : new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
      typeLabel.className = 'history-type';
      typeLabel.dataset.type = movimiento.tipo;
      typeLabel.textContent = etiquetaMovimiento(movimiento);
      typeCell.append(typeLabel);
      // Las compras restan saldo; recargas y reembolsos lo suman
      amountCell.textContent = `${movimiento.tipo === 'Descuento' ? '−' : '+'}${formatMoney(Number(movimiento.monto))}`;
      row.append(dateCell, typeCell, amountCell);
      movementHistory.append(row);
    });
  };

  const showFeedback = (message: string, kind: 'success' | 'error'): void => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.dataset.kind = kind;
  };

  const loadBalance = async (): Promise<void> => {
    try {
      const response = await fetch('/api/monedero');
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'No se pudo consultar el saldo.');
      if (balanceOutput) {
        balanceOutput.textContent = formatMoney(Number(result.saldo));
        balanceOutput.setAttribute('aria-busy', 'false');
      }
      renderHistory(result.movimientos ?? []);
    } catch (error) {
      if (balanceOutput) {
        balanceOutput.textContent = 'No disponible';
        balanceOutput.setAttribute('aria-busy', 'false');
      }
      showFeedback(error instanceof Error ? error.message : 'No se pudo consultar el saldo.', 'error');
    }
  };

  walletForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!amountInput || !submitButton) return;

    const monto = Number(amountInput.value);
    if (!Number.isFinite(monto) || monto <= 0) {
      showFeedback('Ingresa un monto mayor a $0.00 MXN.', 'error');
      amountInput.focus();
      return;
    }

    submitButton.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Procesando...';
    if (feedback) {
      feedback.textContent = '';
      delete feedback.dataset.kind;
    }

    try {
      const response = await fetch('/api/monedero', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'recargar', monto }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'No se pudo completar el movimiento.');

      if (balanceOutput) balanceOutput.textContent = formatMoney(Number(result.saldo));
      void loadBalance();
      showFeedback('Recarga aplicada correctamente.', 'success');
      amountInput.value = '';
    } catch (error) {
      showFeedback(error instanceof Error ? error.message : 'No se pudo completar el movimiento.', 'error');
    } finally {
      submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Recargar monedero';
    }
  });

  void loadBalance();
</script>
