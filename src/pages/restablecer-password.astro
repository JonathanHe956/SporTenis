---
// Paso 2 de "¿Olvidaste tu contraseña?": el cliente escribe el código de 6 dígitos que le llegó por
// correo y elige su nueva contraseña.
import AuthShell from '../components/AuthShell.astro';
import {
  MINUTOS_CODIGO,
  RecuperacionError,
  estadoRecuperacion,
  reenviarCodigo,
  restablecerPassword,
} from '../lib/recuperacionPassword';
import { enmascararCorreo } from '../lib/verificacionCorreo';

if (Astro.locals.user) return Astro.redirect('/cuenta');

let errorMsg = '';
let okMsg = '';
let listo = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    if (form.get('action') === 'reenviar') {
      await reenviarCodigo(Astro.cookies);
      okMsg = 'Te enviamos un código nuevo. El anterior ya no sirve.';
    } else {
      await restablecerPassword(
        Astro.cookies,
        form.get('codigo')?.toString() ?? '',
        form.get('password')?.toString() ?? '',
        form.get('confirmPassword')?.toString() ?? '',
      );
      listo = true;
    }
  } catch (error) {
    if (error instanceof RecuperacionError) errorMsg = error.message;
    else {
      console.error('Error al restablecer la contraseña:', error);
      errorMsg = 'No pudimos cambiar tu contraseña. Intenta de nuevo en unos minutos.';
    }
  }
}

const estado = listo ? null : await estadoRecuperacion(Astro.cookies);
// Sin solicitud en este navegador (expiró o abrió la página directo): de vuelta al paso 1
if (!listo && !estado && !errorMsg) return Astro.redirect('/olvide-password');
---

<AuthShell title="Nueva contraseña | SporTenis">
  <p class="eyebrow"><span></span> Recuperar acceso · Paso 2 de 2</p>
  <h1>Nueva <em>contraseña</em></h1>

  {listo ? (
    <>
      <div class="ok-banner" role="status">Listo, tu contraseña se cambió. Por seguridad cerramos tu sesión en todos tus dispositivos.</div>
      <a href="/login" class="primary-button" style="margin-top:18px">Iniciar sesión <span>↗</span></a>
    </>
  ) : !estado ? (
    <>
      <div class="error-banner" role="alert">{errorMsg}</div>
      <p class="login-link"><a href="/olvide-password">Pedir un código nuevo</a></p>
    </>
  ) : (
    <>
      <p class="subtitle">
        Si <strong>{enmascararCorreo(estado.correo)}</strong> tiene una cuenta en SporTenis, le enviamos un código de 6 dígitos.
        Vence en {MINUTOS_CODIGO} minutos; si no lo ves, revisa tu carpeta de spam.
      </p>

      <form method="POST" class="auth-form" id="formRestablecer">
        {okMsg && <div class="ok-banner" role="status">{okMsg}</div>}
        {errorMsg && <div class="error-banner" role="alert">{errorMsg}</div>}
        {estado.vencido && !errorMsg && <div class="error-banner" role="alert">El código venció. Pide uno nuevo abajo.</div>}
        <input type="hidden" name="action" value="restablecer" />
        <div class="field-group">
          <label for="codigo">Código de 6 dígitos</label>
          <input
            type="text"
            id="codigo"
            name="codigo"
            class="code-input"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            maxlength="6"
            placeholder="000000"
            required
            autofocus
          />
        </div>
        <div class="field-group">
          <label for="password">Nueva contraseña</label>
          <div class="input-password">
            <input type="password" id="password" name="password" placeholder="Crea tu nueva contraseña" autocomplete="new-password" maxlength="200" required />
            <button type="button" class="eye-btn" id="togglePassword" aria-label="Mostrar contraseña">
              <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
          <div class="password-rules" aria-live="polite">
            <span id="rule-upper" class="rule">✗ Al menos 1 mayúscula</span>
            <span id="rule-number" class="rule">✗ Al menos 1 número</span>
            <span id="rule-special" class="rule">✗ Al menos 1 carácter especial</span>
            <span id="rule-length" class="rule">✗ Mínimo 8 caracteres</span>
          </div>
          <span class="field-error" id="error-password"></span>
        </div>
        <div class="field-group">
          <label for="confirmPassword">Confirmar contraseña</label>
          <div class="input-password">
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repite tu contraseña" autocomplete="new-password" maxlength="200" required />
            <button type="button" class="eye-btn" id="toggleConfirm" aria-label="Mostrar contraseña">
              <svg id="eyeIconConfirm" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
          <span class="field-error" id="error-confirm"></span>
        </div>
        <button type="submit" class="primary-button" id="btnGuardar">Guardar contraseña <span>↗</span></button>
      </form>

      <form method="POST" class="resend-form" id="formReenviar">
        <input type="hidden" name="action" value="reenviar" />
        <span>¿No te llegó?</span>
        <button
          type="submit"
          id="btnReenviar"
          class="link-button"
          data-espera={estado.segundosParaReenviar}
          disabled={estado.segundosParaReenviar > 0}
        >
          {estado.segundosParaReenviar > 0 ? `Reenviar en ${estado.segundosParaReenviar} s` : 'Reenviar código'}
        </button>
      </form>

      <p class="login-link">¿Correo equivocado? <a href="/olvide-password">Escribir otro correo</a></p>
    </>
  )}
</AuthShell>

<style>
  .code-input {
    font-family: 'Courier New', monospace !important;
    font-size: 30px !important;
    font-weight: 700;
    letter-spacing: 12px;
    padding: 14px !important;
    text-align: center;
  }
  .code-input::placeholder { color: #d8d3c3; }
  .resend-form {
    align-items: center;
    color: #716e67;
    display: flex;
    font-family: Arial, sans-serif;
    font-size: 12px;
    gap: 6px;
    justify-content: center;
    margin: 18px 0 0;
  }
  .link-button {
    background: none;
    border: 0;
    color: #d93e2e;
    cursor: pointer;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 0;
  }
  .link-button:hover:not(:disabled) { text-decoration: underline; }
  .link-button:disabled { color: #b0a99a; cursor: default; }
  .primary-button:disabled { opacity: 0.6; cursor: wait; }

  /* Contraseña: mismo diseño que el registro (ojo, requisitos y errores por campo) */
  .input-password { position: relative; }
  .input-password input { padding-right: 42px !important; width: 100%; }
  .field-group input.invalid { border-color: #e7442e !important; background: #fff7f7 !important; }
  .field-group input.valid { border-color: #4caf50 !important; background: #f5fff6 !important; }
  .eye-btn {
    align-items: center;
    background: none;
    border: none;
    color: #716e67;
    cursor: pointer;
    display: flex;
    height: 36px;
    justify-content: center;
    padding: 0;
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
  }
  .eye-btn svg { height: 18px; width: 18px; }
  .eye-btn:hover { color: #d93e2e; }
  .password-rules { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 2px; }
  .rule { color: #b0a99a; font-family: Arial, sans-serif; font-size: 10px; transition: color 0.2s ease; }
  .rule.ok { color: #2e7d32; }
  .field-error { color: #e7442e; font-family: Arial, sans-serif; font-size: 10px; min-height: 14px; }
  @media (max-width: 680px) {
    .code-input { font-size: 26px !important; letter-spacing: 8px; }
  }
</style>

<script>
  // Solo dígitos (también al pegar "123 456"); con los 6 completos pasa a la contraseña
  const codigo = document.getElementById('codigo') as HTMLInputElement | null;
  codigo?.addEventListener('input', () => {
    codigo.value = codigo.value.replace(/\D/g, '').slice(0, 6);
    if (codigo.value.length === 6) document.getElementById('password')?.focus();
  });

  // ── Contraseña: igual que en el registro ─────────────────────
  const EYE_OPEN = `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
  const EYE_SHUT = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>`;
  const getInput = (id: string) => document.getElementById(id) as HTMLInputElement | null;

  function makeEyeToggle(buttonId: string, inputId: string, iconId: string) {
    const button = document.getElementById(buttonId);
    const input = getInput(inputId);
    const icon = document.getElementById(iconId);
    if (!button || !input) return;
    let visible = false;
    button.addEventListener('click', () => {
      visible = !visible;
      input.type = visible ? 'text' : 'password';
      if (icon) icon.innerHTML = visible ? EYE_SHUT : EYE_OPEN;
      button.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });
  }
  makeEyeToggle('togglePassword', 'password', 'eyeIcon');
  makeEyeToggle('toggleConfirm', 'confirmPassword', 'eyeIconConfirm');

  const reglas = [
    { el: document.getElementById('rule-upper'), test: (v: string) => /[A-Z]/.test(v), label: 'Al menos 1 mayúscula' },
    { el: document.getElementById('rule-number'), test: (v: string) => /[0-9]/.test(v), label: 'Al menos 1 número' },
    { el: document.getElementById('rule-special'), test: (v: string) => /[^A-Za-z0-9]/.test(v), label: 'Al menos 1 carácter especial' },
    { el: document.getElementById('rule-length'), test: (v: string) => v.length >= 8, label: 'Mínimo 8 caracteres' },
  ];
  const passwordValida = (v: string) => reglas.every((r) => r.test(v));

  const mostrarError = (id: string, msg: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = msg;
  };
  const marcar = (input: HTMLInputElement | null, valido: boolean) => {
    if (!input) return;
    input.classList.toggle('valid', valido);
    input.classList.toggle('invalid', !valido);
    input.setAttribute('aria-invalid', String(!valido));
  };

  const password = getInput('password');
  const confirmacion = getInput('confirmPassword');

  password?.addEventListener('input', () => {
    for (const regla of reglas) {
      const ok = regla.test(password.value);
      if (regla.el) {
        regla.el.textContent = `${ok ? '✓' : '✗'} ${regla.label}`;
        regla.el.classList.toggle('ok', ok);
      }
    }
    if (passwordValida(password.value)) { mostrarError('error-password', ''); marcar(password, true); }
    // Si ya escribió la confirmación, se revisa de nuevo al cambiar la contraseña
    if (confirmacion?.value) confirmacion.dispatchEvent(new Event('input'));
  });

  confirmacion?.addEventListener('input', () => {
    if (!confirmacion.value) return;
    const coincide = confirmacion.value === (password?.value ?? '');
    mostrarError('error-confirm', coincide ? '' : 'Las contraseñas no coinciden.');
    marcar(confirmacion, coincide);
  });

  document.getElementById('formRestablecer')?.addEventListener('submit', (event) => {
    const pwd = password?.value ?? '';
    let valido = true;

    if (!passwordValida(pwd)) {
      mostrarError('error-password', 'La contraseña debe tener 8+ caracteres, mayúscula, número y símbolo.');
      marcar(password, false);
      valido = false;
    }
    if (!confirmacion?.value || confirmacion.value !== pwd) {
      mostrarError('error-confirm', 'Las contraseñas no coinciden.');
      marcar(confirmacion, false);
      valido = false;
    }
    if (!valido) {
      event.preventDefault();
      return;
    }

    const btn = document.getElementById('btnGuardar') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = 'Guardando...'; }
  });

  // Cuenta regresiva para poder pedir otro código
  const reenviar = document.getElementById('btnReenviar') as HTMLButtonElement | null;
  let espera = Number(reenviar?.dataset.espera ?? 0);
  if (reenviar && espera > 0) {
    const timer = setInterval(() => {
      espera -= 1;
      if (espera <= 0) {
        clearInterval(timer);
        reenviar.disabled = false;
        reenviar.textContent = 'Reenviar código';
      } else {
        reenviar.textContent = `Reenviar en ${espera} s`;
      }
    }, 1000);
  }
  document.getElementById('formReenviar')?.addEventListener('submit', () => {
    if (reenviar) { reenviar.disabled = true; reenviar.textContent = 'Enviando...'; }
  });
</script>
