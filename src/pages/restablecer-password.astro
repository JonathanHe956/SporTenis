---
// Paso 2 de "¿Olvidaste tu contraseña?": el cliente abre el enlace del correo y elige una nueva.
import AuthShell from '../components/AuthShell.astro';
import { RecuperacionError, enlaceEsValido, restablecerPassword } from '../lib/recuperacionPassword';

const token = Astro.url.searchParams.get('token') ?? '';
let errorMsg = '';
let listo = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    await restablecerPassword(
      form.get('token')?.toString() ?? '',
      form.get('password')?.toString() ?? '',
      form.get('confirmPassword')?.toString() ?? '',
    );
    listo = true;
  } catch (error) {
    if (error instanceof RecuperacionError) errorMsg = error.message;
    else {
      console.error('Error al restablecer la contraseña:', error);
      errorMsg = 'No pudimos cambiar tu contraseña. Intenta de nuevo en unos minutos.';
    }
  }
}

const vigente = listo || (await enlaceEsValido(token));
---

<AuthShell title="Nueva contraseña | SporTenis">
  <p class="eyebrow"><span></span> Recuperar acceso</p>
  <h1>Nueva <em>contraseña</em></h1>

  {listo ? (
    <>
      <div class="ok-banner" role="status">Listo, tu contraseña se cambió. Por seguridad cerramos tu sesión en todos tus dispositivos.</div>
      <a href="/login" class="primary-button" style="margin-top:18px">Iniciar sesión <span>↗</span></a>
    </>
  ) : !vigente ? (
    <>
      <div class="error-banner">Este enlace no es válido, ya se usó o venció.</div>
      <p class="login-link"><a href="/olvide-password">Pedir un enlace nuevo</a></p>
    </>
  ) : (
    <>
      <p class="subtitle">Elige una contraseña que no hayas usado antes en SporTenis.</p>
      <form method="POST" class="auth-form" action={`/restablecer-password?token=${encodeURIComponent(token)}`}>
        {errorMsg && <div class="error-banner">{errorMsg}</div>}
        <input type="hidden" name="token" value={token} />
        <div class="field-group">
          <label for="password">Nueva contraseña</label>
          <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="new-password" minlength="8" maxlength="200" required />
          <p class="hint">Mínimo 8 caracteres, con una mayúscula, un número y un símbolo.</p>
        </div>
        <div class="field-group">
          <label for="confirmPassword">Confirma la contraseña</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" autocomplete="new-password" minlength="8" maxlength="200" required />
        </div>
        <button type="submit" class="primary-button">Guardar contraseña <span>↗</span></button>
      </form>
    </>
  )}
</AuthShell>
