---
// Detalle de un pedido del cliente. Solo lectura: no hay acciones que modifiquen la compra.
import Layout from '../../../layouts/Layout.astro';
import AccountHeader from '../../../components/AccountHeader.astro';
import EstadoPedido from '../../../components/EstadoPedido.astro';
import { findClientId } from '../../../lib/clientes';
import { getDetalleCompra, PASOS_PEDIDO, pasoActual } from '../../../lib/compras';

const sessionUser = Astro.locals.user;
if (!sessionUser) {
  return Astro.redirect('/login');
}

const clientId = await findClientId(sessionUser.id);
const compra = clientId !== null ? await getDetalleCompra(clientId, Number(Astro.params.id)) : null;

// Pedido inexistente o de otro cliente: se regresa al historial
if (!compra) {
  return Astro.redirect('/cuenta/compras');
}

const titulo = compra.factura?.folio ?? `Pedido #${compra.id}`;
const cancelada = compra.estado === 'Cancelada';
const paso = pasoActual(compra.estado);
const unidades = compra.articulos.reduce((total, a) => total + a.cantidad, 0);

const etiquetasPaso: Record<string, string> = {
  Procesando: 'Pedido recibido',
  Confirmada: 'Confirmado',
  Entregada: 'Entregado',
};

const ultimaFecha = (estado: string): Date | null => {
  const eventos = compra.historial.filter((h) => h.estado === estado);
  return eventos.length ? eventos[eventos.length - 1].fecha : null;
};

const pasos = PASOS_PEDIDO.map((estado, i) => ({
  estado,
  etiqueta: etiquetasPaso[estado],
  hecho: !cancelada && paso >= i,
  actual: !cancelada && paso === i,
  fecha:
    estado === 'Procesando'
      ? compra.fecha
      : estado === 'Entregada'
        ? compra.fechaEntrega ?? ultimaFecha(estado)
        : ultimaFecha(estado),
}));
const progreso = cancelada || paso < 0 ? 0 : paso / (PASOS_PEDIDO.length - 1);
const fechaCancelacion = ultimaFecha('Cancelada');

const estadoPago: Record<string, { label: string; tone: string }> = {
  Conciliado: { label: 'Pagado', tone: 'ok' },
  'Con diferencia': { label: 'En revisión', tone: 'warn' },
  Reembolsado: { label: 'Reembolsado', tone: 'info' },
};
const pago = compra.pago ? { ...compra.pago, ...(estadoPago[compra.pago.estado] ?? { label: compra.pago.estado, tone: 'info' }) } : null;

const iconoMetodo = (metodo: string): string => {
  if (/tarjeta/i.test(metodo)) return '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/>';
  if (/transfer/i.test(metodo)) return '<path d="M3 21h18"/><path d="M3 10h18"/><path d="m12 3 9 7H3z"/><path d="M5 10v11M19 10v11M9 10v11M15 10v11"/>';
  if (/mercado pago/i.test(metodo)) return '<circle cx="12" cy="12" r="9"/><path d="M7.5 12.5c1.5-1.5 3-1.5 4.5 0s3 1.5 4.5 0"/>';
  if (/monedero/i.test(metodo)) return '<rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 9h18M16 15h.01"/>';
  return '<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/>';
};

const fmtFecha = (fecha: Date) =>
  new Intl.DateTimeFormat('es-MX', { day: '2-digit', month: 'long', year: 'numeric' }).format(new Date(fecha));
const fmtFechaHora = (fecha: Date) =>
  new Intl.DateTimeFormat('es-MX', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(fecha));
const fmtCorta = (fecha: Date) => new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long' }).format(new Date(fecha));
const money = (n: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(n);
---

<Layout title={`${titulo} | Mis compras | SporTenis`}>
  <div class="detalle-page">
    <AccountHeader backHref="/cuenta/compras" backLabel="Mis compras" active="compras" />

    <main class="detalle-main">
      <nav class="breadcrumb enter no-print" aria-label="Ruta de navegación">
        <a href="/cuenta">Mi cuenta</a><span aria-hidden="true">/</span>
        <a href="/cuenta/compras">Mis compras</a><span aria-hidden="true">/</span>
        <span>{titulo}</span>
      </nav>

      <section class="detalle-head enter" style="--d: 60ms">
        <div>
          <p class="eyebrow"><span></span> Detalle del pedido</p>
          <h1>{titulo}</h1>
          <p class="head-meta">Realizado el {fmtFecha(compra.fecha)} · {unidades} {unidades === 1 ? 'artículo' : 'artículos'}</p>
          <p class="head-meta">Cliente: <strong>{sessionUser.nombre}</strong></p>
        </div>
        <div class="head-side">
          <EstadoPedido estado={compra.estado} size="lg" />
          <button type="button" class="print-button no-print" id="btnImprimir">
            <span class="print-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9V3h12v6"/>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                <path class="print-paper" d="M6 14h12v7H6z"/>
              </svg>
            </span>
            <span class="print-text">
              <strong>Imprimir ticket</strong>
              <small>o guárdalo como PDF</small>
            </span>
            <span class="print-arrow" aria-hidden="true">↗</span>
          </button>
        </div>
      </section>

      <!-- Seguimiento -->
      {cancelada ? (
        <section class="cancel-banner enter" style="--d: 120ms" aria-label="Estado del pedido">
          <span class="cancel-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          </span>
          <div>
            <strong>Este pedido fue cancelado{fechaCancelacion ? ` el ${fmtFecha(fechaCancelacion)}` : ''}.</strong>
            <p>{pago?.estado === 'Reembolsado' ? 'El pago se reembolsó al mismo método con el que pagaste.' : 'No se realizó ningún cargo adicional por este pedido.'}</p>
          </div>
        </section>
      ) : paso >= 0 && (
        <section class="tracker card enter" style={`--d: 120ms; --progress: ${progreso}`} aria-label="Seguimiento del pedido">
          <h2 class="card-title">Seguimiento</h2>
          <ol class="steps">
            {pasos.map((p) => (
              <li class:list={['step', { done: p.hecho, current: p.actual }]} aria-current={p.actual ? 'step' : undefined}>
                <span class="step-dot" aria-hidden="true">{p.hecho ? '✓' : ''}</span>
                <span class="step-label">{p.etiqueta}</span>
                <span class="step-date">{p.hecho && p.fecha ? fmtCorta(p.fecha) : p.hecho ? '' : 'Pendiente'}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <div class="detalle-grid">
        <div class="main-col">
        <!-- Artículos -->
        <section class="card items enter" style="--d: 180ms" aria-labelledby="itemsTitle">
          <h2 class="card-title" id="itemsTitle">Artículos <span>({unidades})</span></h2>
          <ul class="item-list">
            {compra.articulos.map((a, i) => (
              <li class="item" style={`--i: ${Math.min(i, 8)}`}>
                <span class={`item-thumb ${a.tema ?? ''}`}>
                  {a.imagen ? <img src={a.imagen} alt={a.nombre} loading="lazy" decoding="async" /> : <i aria-hidden="true"></i>}
                </span>
                <div class="item-info">
                  {a.categoria && <p class="item-cat">{a.categoria}</p>}
                  <h3>{a.nombre}</h3>
                  <p class="item-variant">{a.variante} · <span class="item-sku">SKU {a.sku}</span></p>
                  <p class="item-qty">{a.cantidad} × {money(a.precioUnitario)}</p>
                </div>
                <strong class="item-total">{money(a.subtotal)}</strong>
              </li>
            ))}
          </ul>
        </section>

        <!-- Historial: compacto, al lado de Pago y Factura -->
        {compra.historial.length > 0 && (
          <section class="card history enter" style="--d: 260ms" aria-labelledby="histTitle">
            <h2 class="card-title" id="histTitle">Historial del pedido</h2>
            <ol class="timeline">
              {compra.historial.slice().reverse().map((h) => (
                <li>
                  <span class="tl-dot" aria-hidden="true"></span>
                  <strong>{etiquetasPaso[h.estado] ?? h.estado}</strong>
                  <span class="tl-date">{fmtFechaHora(h.fecha)}</span>
                </li>
              ))}
            </ol>
          </section>
        )}
        </div>

        <aside class="side">
          <!-- Resumen -->
          <section class="card enter" style="--d: 240ms" aria-labelledby="sumTitle">
            <h2 class="card-title" id="sumTitle">Resumen</h2>
            <dl class="summary">
              <div><dt>Subtotal</dt><dd>{money(compra.subtotal)}</dd></div>
              <div><dt>Envío</dt><dd class:list={{ free: compra.envio === 0 }}>{compra.envio === 0 ? 'Gratis' : money(compra.envio)}</dd></div>
              {compra.cupon && <div><dt>Cupón</dt><dd class="coupon">{compra.cupon}</dd></div>}
              <div class="tax"><dt>Importe sin impuestos</dt><dd>{money(compra.baseSinImpuestos)}</dd></div>
              {compra.impuestos.map((imp) => (
                <div class="tax"><dt>{imp.nombre} ({imp.porcentaje.toLocaleString('es-MX', { maximumFractionDigits: 2 })}%)</dt><dd>{money(imp.monto)}</dd></div>
              ))}
              <div class="total"><dt>Total</dt><dd>{money(compra.total)}</dd></div>
            </dl>
          </section>

          <!-- Envío: copia de la dirección elegida al comprar -->
          {compra.direccionEnvio && (
            <section class="card enter" style="--d: 270ms" aria-labelledby="shipTitle">
              <h2 class="card-title" id="shipTitle">Envío</h2>
              <address class="ship-address">
                {compra.direccionEnvio.split('\n').map((linea, i) => i === 0 ? <strong>{linea}</strong> : <span>{linea}</span>)}
              </address>
            </section>
          )}

          <!-- Pago -->
          <section class="card enter" style="--d: 300ms" aria-labelledby="payTitle">
            <h2 class="card-title" id="payTitle">Pago</h2>
            <div class="pay-method">
              <span class="pay-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconoMetodo(compra.metodoPago)} />
              </span>
              <div>
                <span class="pay-label">Método de pago</span>
                <strong>{compra.metodoPago}</strong>
                {pago?.referencia && <span class="pay-label">{pago.referencia}</span>}
              </div>
            </div>
            {pago ? (
              <dl class="info-list">
                <div><dt>Estado</dt><dd><span class={`pill pill-${pago.tone}`}>{pago.label}</span></dd></div>
                <div><dt>Monto</dt><dd>{money(pago.monto)}</dd></div>
                <div><dt>Fecha de pago</dt><dd>{fmtFechaHora(pago.fecha)}</dd></div>
              </dl>
            ) : (
              <p class="muted">{cancelada ? 'No se registró ningún cobro para este pedido.' : 'El pago se registrará cuando se confirme el pedido.'}</p>
            )}
          </section>

          <!-- Factura -->
          <section class="card enter" style="--d: 360ms" aria-labelledby="invTitle">
            <h2 class="card-title" id="invTitle">Factura</h2>
            {compra.factura ? (
              <dl class="info-list">
                <div><dt>Folio</dt><dd class="mono">{compra.factura.folio}</dd></div>
                <div><dt>Estado</dt><dd><span class:list={['pill', compra.factura.estado === 'Cancelada' ? 'pill-bad' : 'pill-ok']}>{compra.factura.estado}</span></dd></div>
                <div><dt>Emitida</dt><dd>{fmtFecha(compra.factura.fechaEmision)}</dd></div>
                <div class="stacked"><dt>Folio fiscal (UUID)</dt><dd class="mono uuid">{compra.factura.uuid}</dd></div>
              </dl>
            ) : (
              <p class="muted">La factura se emite automáticamente cuando el pedido se confirma.</p>
            )}
          </section>
        </aside>
      </div>

      <div class="detalle-foot enter no-print" style="--d: 460ms">
        <a href="/cuenta/compras" class="back-button"><span aria-hidden="true">←</span> Volver a mis compras</a>
        <p>¿Tienes dudas sobre este pedido? Tienes 30 días para cambios y devoluciones.</p>
      </div>
    </main>
  </div>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { background: #f6f4ed; color: #171717; font-family: Georgia, 'Times New Roman', serif; margin: 0; -webkit-font-smoothing: antialiased; }

  .detalle-page { min-height: 100vh; }
  .detalle-main { margin: 0 auto; max-width: 1120px; padding: clamp(24px, 4vw, 40px) clamp(20px, 4vw, 48px) 80px; }

  .breadcrumb { align-items: center; display: flex; flex-wrap: wrap; font-family: var(--font-ui); font-size: 12px; gap: 8px; margin-bottom: 20px; }
  .breadcrumb a { color: #716e67; text-decoration: none; }
  .breadcrumb a:hover { color: #171717; text-decoration: underline; }
  .breadcrumb span:last-child { font-weight: 700; }

  .detalle-head { align-items: flex-end; display: flex; flex-wrap: wrap; gap: 18px; justify-content: space-between; margin-bottom: 26px; }
  .eyebrow { color: #d93e2e; font-family: var(--font-ui); font-size: 11px; font-weight: 700; letter-spacing: 2px; margin: 0 0 8px; text-transform: uppercase; }
  .eyebrow span { background: #f7d21c; display: inline-block; height: 7px; margin-right: 8px; width: 7px; }
  h1 { font-size: clamp(34px, 5vw, 56px); font-weight: 400; letter-spacing: -2px; line-height: 1; margin: 0 0 10px; }
  .head-meta { color: #57534e; font-family: var(--font-ui); font-size: 14px; margin: 0; }

  .card { background: #fffdf3; border: 2px solid #171717; box-shadow: 6px 6px 0 #171717; padding: 22px 24px; }
  .card-title { border-bottom: 2px solid #171717; font-size: 20px; font-weight: 400; letter-spacing: -.4px; margin: 0 0 16px; padding-bottom: 10px; }
  .card-title span { color: #716e67; font-family: var(--font-ui); font-size: 13px; }

  /* ── Seguimiento ────────────────────────────────────────── */
  .tracker { margin-bottom: 26px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; margin: 0; padding: 6px 0 0; position: relative; }
  .steps::before, .steps::after { content: ''; height: 4px; left: calc(100% / 6); position: absolute; top: 22px; }
  .steps::before { background: #e8e4da; right: calc(100% / 6); }
  .steps::after {
    animation: track-fill 1.1s var(--ease-out) .5s backwards; background: #171717; transform-origin: left;
    width: calc((100% - 100% / 3) * var(--progress));
  }
  @keyframes track-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .step { align-items: center; display: flex; flex-direction: column; gap: 6px; position: relative; text-align: center; z-index: 1; }
  .step-dot {
    align-items: center; background: #fffdf3; border: 3px solid #d8d3c3; border-radius: 50%; color: #f7d21c; display: flex; font-family: var(--font-ui);
    font-size: 15px; font-weight: 900; height: 36px; justify-content: center; transition: background .3s, border-color .3s; width: 36px;
  }
  .step.done .step-dot { animation: dot-pop .5s var(--ease-spring) backwards; background: #171717; border-color: #171717; }
  .step:nth-child(1) .step-dot { animation-delay: .5s; }
  .step:nth-child(2) .step-dot { animation-delay: .9s; }
  .step:nth-child(3) .step-dot { animation-delay: 1.3s; }
  .step.current .step-dot { box-shadow: 0 0 0 6px rgba(247,210,28,.55); }
  @keyframes dot-pop { from { transform: scale(.4); } to { transform: scale(1); } }
  .step-label { font-family: var(--font-ui); font-size: 13px; font-weight: 800; }
  .step:not(.done) .step-label { color: #a09d96; }
  .step-date { color: #716e67; font-family: var(--font-ui); font-size: 12px; }

  .cancel-banner {
    align-items: center; background: #fde4df; border: 2px solid #171717; border-left: 8px solid #d93e2e; display: flex; gap: 16px;
    margin-bottom: 26px; padding: 18px 22px;
  }
  .cancel-icon { color: #b4271a; display: flex; flex-shrink: 0; }
  .cancel-banner strong { font-family: var(--font-ui); font-size: 14px; }
  .cancel-banner p { color: #57534e; font-family: var(--font-ui); font-size: 13px; margin: 4px 0 0; }

  /* ── Rejilla ────────────────────────────────────────────── */
  .detalle-grid { align-items: start; display: grid; gap: 26px; grid-template-columns: 1fr 360px; margin-bottom: 26px; }
  .side { display: flex; flex-direction: column; gap: 26px; }

  .item-list { list-style: none; margin: 0; padding: 0; }
  .item {
    align-items: center; animation: rise .5s var(--ease-out) backwards; animation-delay: calc(var(--i, 0) * 70ms + 350ms);
    border-bottom: 1px dashed #d8d3c3; display: grid; gap: 18px; grid-template-columns: 92px 1fr auto; padding: 16px 0;
  }
  .item:first-child { padding-top: 4px; }
  .item:last-child { border-bottom: 0; padding-bottom: 0; }
  .item-thumb {
    align-items: center; background: #fff; border: 1.5px solid #171717; display: flex; height: 92px; justify-content: center; overflow: hidden;
    position: relative; transition: transform .4s var(--ease-out); width: 92px;
  }
  .item:hover .item-thumb { transform: rotate(-3deg) scale(1.04); }
  .item-thumb img { height: 100%; inset: 0; object-fit: contain; padding: 8px; position: absolute; width: 100%; }
  .item-thumb.product-padel:not(:has(img)) { background: #d7e1c3; }
  .item-thumb.product-shoe:not(:has(img)) { background: #e9c8bd; }
  .item-thumb i { background: #d8ee32; border-radius: 50%; display: block; height: 40px; width: 40px; }
  .item-thumb.product-padel i { background: #242424; border-radius: 50% 50% 44% 44%; height: 62px; transform: rotate(28deg); width: 28px; }
  .item-thumb.product-shoe i { background: #fffdf3; border-bottom: 7px solid #d93e2e; border-radius: 45% 55% 18% 20%; height: 32px; transform: rotate(-12deg); width: 64px; }
  .item-cat { color: #716e67; font-family: var(--font-ui); font-size: 10px; font-weight: 700; letter-spacing: .6px; margin: 0 0 4px; text-transform: uppercase; }
  .item-info h3 { font-size: 18px; font-weight: 400; margin: 0 0 4px; }
  .item-variant { color: #57534e; font-family: var(--font-ui); font-size: 12px; margin: 0 0 6px; }
  .item-qty { font-family: var(--font-ui); font-size: 13px; font-weight: 700; margin: 0; }
  .item-total { font-family: var(--font-ui); font-size: 16px; white-space: nowrap; }

  .summary, .info-list { display: flex; flex-direction: column; gap: 10px; margin: 0; }
  .summary div, .info-list div { align-items: center; display: flex; font-family: var(--font-ui); font-size: 13px; gap: 12px; justify-content: space-between; }
  .summary dt, .info-list dt { color: #57534e; }
  .summary dd, .info-list dd { font-weight: 700; margin: 0; text-align: right; }
  .summary .tax { border-left: 3px solid #d8d3c3; font-size: 12px; padding-left: 10px; }
  .summary .tax dd { font-weight: 400; }
  .summary .total { border-top: 2px solid #171717; font-size: 17px; margin-top: 4px; padding-top: 12px; }
  .summary .total dt { color: #171717; font-weight: 800; }
  .free { color: #15803d; text-transform: uppercase; font-size: 11px; }
  .coupon { background: #fff1c2; border: 1px dashed #8a5a00; font-family: 'Courier New', monospace; padding: 2px 8px; }

  .ship-address { display: flex; flex-direction: column; font-family: var(--font-ui); font-size: 13px; font-style: normal; gap: 4px; line-height: 1.45; }
  .ship-address strong { font-size: 14px; }
  .pay-method { align-items: center; background: #f6f4ed; border: 1.5px solid #e8e4da; display: flex; gap: 14px; margin-bottom: 16px; padding: 14px; }
  .pay-icon { align-items: center; background: #f7d21c; border-radius: 50%; display: flex; flex-shrink: 0; height: 44px; justify-content: center; width: 44px; }
  .pay-label { color: #716e67; display: block; font-family: var(--font-ui); font-size: 10px; font-weight: 700; letter-spacing: .8px; margin-bottom: 2px; text-transform: uppercase; }
  .pay-method strong { font-family: var(--font-ui); font-size: 16px; }
  .pill { border-radius: 999px; font-size: 11px; font-weight: 800; padding: 4px 10px; }
  .pill-ok { background: #d7e1c3; color: #3f5d22; }
  .pill-warn { background: #fff1c2; color: #8a5a00; }
  .pill-info { background: #e3def3; color: #4c3d8f; }
  .pill-bad { background: #fde4df; color: #b4271a; }
  .info-list .stacked { align-items: flex-start; flex-direction: column; gap: 6px; }
  .info-list .stacked dd { text-align: left; }
  .mono { font-family: 'Courier New', monospace; }
  .uuid { background: #f6f4ed; border: 1px solid #e8e4da; font-size: 11px; padding: 8px 10px; width: 100%; word-break: break-all; }
  .muted { color: #716e67; font-family: var(--font-ui); font-size: 13px; line-height: 1.5; margin: 0; }

  /* ── Historial ──────────────────────────────────────────── */
  .main-col { display: flex; flex-direction: column; gap: 26px; min-width: 0; }
  .history { padding: 16px 20px; }
  .history .card-title { font-size: 17px; margin-bottom: 10px; padding-bottom: 8px; }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 4px; }
  .timeline li { align-items: center; display: flex; gap: 12px; padding: 5px 0; position: relative; }
  .timeline li:not(:last-child)::before { background: #d8d3c3; content: ''; height: calc(100% - 6px); left: 4px; position: absolute; top: calc(50% + 6px); width: 2px; }
  .tl-dot { background: #171717; border-radius: 50%; flex-shrink: 0; height: 10px; position: relative; width: 10px; z-index: 1; }
  .timeline li:first-child .tl-dot { background: #f7d21c; box-shadow: 0 0 0 2px #171717; }
