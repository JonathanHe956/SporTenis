  .motivo strong { font-size: 12px; }
  .motivo small { color: #716e67; font-size: 11px; font-weight: 400; line-height: 1.35; }
  .motivo:hover .motivo-body { border-color: #171717; }
  .motivo input:checked + .motivo-body { background: #f7d21c; border-color: #171717; box-shadow: 3px 3px 0 #171717; transform: translate(-2px, -2px); }
  .motivo input:checked + .motivo-body small { color: #171717; }
  .motivo input:focus-visible + .motivo-body { outline: 2px solid #171717; outline-offset: 2px; }
  .motivo input:disabled + .motivo-body { background: #f0ece0; border-style: dashed; cursor: not-allowed; }
  .motivo input:disabled + .motivo-body strong { color: #a09d96; }
  .motivo:has(input:disabled) { cursor: not-allowed; }

  .form-error { background: #fff1ef; border-left: 3px solid #d93e2e; color: #9f2a1e; font: 12px var(--font-ui); margin: 0; padding: 8px 10px; }
  .form-error[hidden] { display: none; }
  .form-actions { align-items: center; display: flex; gap: 16px; justify-content: flex-end; }

  .col-title { font-size: 22px; font-weight: 400; margin: 0 0 14px; }
  .col-title span { color: #716e67; font: 13px var(--font-ui); }
  .empty { background: #fffdf3; border: 1.5px dashed #d8d3c3; color: #57534e; font: 14px var(--font-ui); margin: 0 0 16px; padding: 24px; text-align: center; }
  .ticket-list { display: grid; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .ticket-card {
    background: #fffdf3; border: 1.5px solid #171717; color: inherit; display: flex; flex-direction: column; gap: 6px; padding: 14px 16px;
    text-decoration: none; transition: box-shadow .2s var(--ease-out), transform .2s var(--ease-out);
  }
  .ticket-card:hover { box-shadow: 4px 4px 0 #171717; transform: translate(-2px, -2px); }
  .ticket-card.done { border-color: #d8d3c3; }
  .ticket-card strong { font-size: 18px; font-weight: 400; }
  .ticket-top { align-items: center; display: flex; gap: 8px; }
  .ticket-top .pill { margin-left: auto; }
  .ticket-meta { color: #716e67; font: 12px var(--font-ui); }
  .mono { font: 700 12px 'Courier New', monospace; }
  .badge-new { background: #d93e2e; color: #fff; font: 800 10px var(--font-ui); letter-spacing: .4px; padding: 3px 7px; text-transform: uppercase; }
  .pill { border-radius: 999px; font: 800 11px var(--font-ui); padding: 4px 10px; white-space: nowrap; }
  .pill-ok { background: #d7e1c3; color: #3f5d22; }
  .pill-warn { background: #fff1c2; color: #8a5a00; }
  .pill-info { background: #e3def3; color: #4c3d8f; }
  .pill-muted { background: #e8e4da; color: #57534e; }

  .cerrados { margin-top: 22px; }
  .cerrados summary { cursor: pointer; font: 700 13px var(--font-ui); margin-bottom: 12px; }

  @media (max-width: 900px) {
    .sop-layout:has(.ticket-form:not([hidden])) { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .motivos { grid-template-columns: 1fr; }
    .card { padding: 18px; }
  }
</style>

<style is:global>
  /* ══ Chat IA flotante ══
     Global (con prefijo .chat-widget) porque los mensajes se crean desde JS y no llevan el atributo de estilos scoped. */
  .chat-widget {
    --chat-ink: #171717;
    --chat-paper: #fffdf3;
    --chat-bg: #f6f4ed;
    --chat-line: #d8d3c3;
    --chat-muted: #716e67;
    --chat-yellow: #f7d21c;
    --chat-red: #d93e2e;
    align-items: flex-end;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    font-family: var(--font-ui);
    gap: 16px;
    position: fixed;
    right: 24px;
    z-index: 1000;
  }

  /* Botón flotante */
  .chat-widget .chat-toggle {
    align-items: center;
    background: var(--chat-ink);
    border: 2px solid var(--chat-ink);
    border-radius: 999px;
    box-shadow: 4px 4px 0 var(--chat-red);
    color: var(--chat-paper);
    cursor: pointer;
    display: flex;
    font: 400 13px var(--font-ui);
    gap: 10px;
    padding: 6px 18px 6px 6px;
    transition: transform .2s var(--ease-out), box-shadow .2s var(--ease-out);
    white-space: nowrap;
  }
  .chat-widget .chat-toggle:hover { box-shadow: 6px 6px 0 var(--chat-red); transform: translate(-2px, -2px); }
  .chat-widget .chat-toggle:active { box-shadow: 2px 2px 0 var(--chat-red); transform: translate(1px, 1px); }
  .chat-widget .chat-toggle:focus-visible { outline: 3px solid var(--chat-yellow); outline-offset: 3px; }
  .chat-widget .chat-toggle-icon {
    background: var(--chat-yellow);
    border-radius: 50%;
    color: var(--chat-ink);
    display: grid;
    height: 38px;
    place-items: center;
    position: relative;
    width: 38px;
  }
  .chat-widget .chat-toggle-icon::after {
    background: #3fae5a;
    border: 2px solid var(--chat-ink);
    border-radius: 50%;
    content: '';
    height: 11px;
    position: absolute;
    right: -1px;
    top: -1px;
    width: 11px;
  }
  .chat-widget .chat-label strong { font-weight: 700; }
  .chat-widget[data-open="true"] .chat-toggle { display: none; }

  /* Panel */
  .chat-widget .chat-panel {
    background: var(--chat-bg);
    border: 2px solid var(--chat-ink);
    box-shadow: 8px 8px 0 var(--chat-ink);
    display: flex;
    flex-direction: column;
    height: min(640px, calc(100vh - 48px));
    overflow: hidden;
    transform-origin: bottom right;
    width: 400px;
  }
  .chat-widget .chat-panel:not([hidden]) { animation: chat-in .32s var(--ease-out) both; }
  .chat-widget .chat-panel[hidden] { display: none; }
  @keyframes chat-in {
    from { opacity: 0; transform: translateY(16px) scale(.96); }
    to   { opacity: 1; transform: none; }
  }

  /* Encabezado */
  .chat-widget .chat-header {
    align-items: center;
    background: var(--chat-ink);
    border-bottom: 4px solid var(--chat-yellow);
    color: var(--chat-paper);
    display: flex;
    flex-shrink: 0;
    gap: 12px;
    padding: 14px 12px 14px 16px;
  }
  .chat-widget .chat-header-text { flex: 1; min-width: 0; }
  .chat-widget .chat-header-title { font: 400 20px/1.1 Georgia, "Times New Roman", serif; letter-spacing: -.5px; margin: 0 0 3px; }
  .chat-widget .chat-header-title em { color: var(--chat-yellow); }
  .chat-widget .chat-header-sub { align-items: center; color: #b8b3a8; display: flex; font-size: 11px; gap: 6px; margin: 0; }
  .chat-widget .chat-status {
    animation: chat-pulse 2s ease-in-out infinite;
    background: #3fae5a;
    border-radius: 50%;
    display: inline-block;
    height: 7px;
    width: 7px;
  }
  @keyframes chat-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(63, 174, 90, .6); }
    50%      { box-shadow: 0 0 0 4px rgba(63, 174, 90, 0); }
  }
  .chat-widget .chat-icon-btn {
    background: transparent;
    border: 1.5px solid #3a3a3a;
    color: var(--chat-paper);
    cursor: pointer;
    display: grid;
    flex-shrink: 0;
    height: 32px;
    place-items: center;
    transition: background .15s, border-color .15s, color .15s;
    width: 32px;
  }
  .chat-widget .chat-icon-btn:hover { background: var(--chat-yellow); border-color: var(--chat-yellow); color: var(--chat-ink); }
  .chat-widget .chat-icon-btn:focus-visible { outline: 2px solid var(--chat-yellow); outline-offset: 2px; }

  /* Avatares */
  .chat-widget .chat-avatar {
    align-items: center;
    background: var(--chat-yellow);
    border: 1.5px solid var(--chat-ink);
    color: var(--chat-ink);
    display: flex;
    flex-shrink: 0;
    font: 800 10px var(--font-ui);
    height: 28px;
    justify-content: center;
    letter-spacing: .5px;
    width: 28px;
  }
  .chat-widget .chat-avatar--lg { border: 0; height: 40px; width: 40px; }
  .chat-widget .chat-avatar--error { background: #fff1ef; border-color: var(--chat-red); color: var(--chat-red); font-size: 14px; }

  /* Mensajes */
  .chat-widget .chat-messages {
    background-color: var(--chat-bg);
    background-image: radial-gradient(#ddd8c8 1px, transparent 1px);
    background-size: 18px 18px;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px 16px 12px;
  }
  .chat-widget .chat-day { color: var(--chat-muted); font: 700 10px var(--font-ui); letter-spacing: 1.5px; text-align: center; text-transform: uppercase; }
  .chat-widget .chat-day span { background: var(--chat-bg); padding: 2px 10px; }

  .chat-widget .chat-row { align-items: flex-end; animation: chat-msg .28s var(--ease-out) both; display: flex; gap: 8px; }
  .chat-widget .chat-row--user { justify-content: flex-end; }
  @keyframes chat-msg {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: none; }
  }
  .chat-widget .chat-col { display: flex; flex-direction: column; gap: 4px; max-width: 82%; min-width: 0; }
  .chat-widget .chat-row--user .chat-col { align-items: flex-end; }
  .chat-widget .chat-time { color: var(--chat-muted); font-size: 10px; padding: 0 2px; }
  .chat-widget .chat-time:empty { display: none; }

  .chat-widget .chat-bubble {
    font: 13.5px/1.55 var(--font-ui);
    overflow-wrap: anywhere;
    padding: 10px 14px;
  }
  .chat-widget .chat-row > .chat-bubble { max-width: 82%; }
  .chat-widget .chat-bubble p { margin: 0; }
  .chat-widget .chat-bubble p + p,
  .chat-widget .chat-bubble p + :is(ol, ul),
  .chat-widget .chat-bubble :is(ol, ul) + p { margin-top: 8px; }
  .chat-widget .chat-bubble :is(ol, ul) { display: grid; gap: 6px; margin: 0; padding-left: 20px; }
  .chat-widget .chat-bubble li::marker { color: var(--chat-red); font-weight: 700; }
  .chat-widget .chat-bubble strong { font-weight: 700; }
  .chat-widget .chat-bubble code { background: #f0ece0; font: 12px "Courier New", monospace; padding: 1px 4px; }

  .chat-widget .chat-bubble--bot {
    background: #fff;
    border: 1.5px solid var(--chat-ink);
    box-shadow: 3px 3px 0 var(--chat-ink);
    color: var(--chat-ink);
  }
  .chat-widget .chat-bubble--user {
    background: var(--chat-ink);
    border: 1.5px solid var(--chat-ink);
    box-shadow: 3px 3px 0 var(--chat-yellow);
    color: var(--chat-paper);
    white-space: pre-wrap;
  }
  .chat-widget .chat-bubble--error {
    background: #fff1ef;
    border: 1.5px dashed var(--chat-red);
    color: #9f2a1e;
    font-size: 12.5px;
  }

  /* Indicador "escribiendo" */
  .chat-widget .chat-typing { align-items: center; display: flex; gap: 5px; padding: 14px 16px; }
  .chat-widget .chat-typing span {
    animation: chat-bounce 1.2s ease-in-out infinite;
    background: var(--chat-ink);
    border-radius: 50%;
    height: 7px;
    width: 7px;
  }
  .chat-widget .chat-typing span:nth-child(2) { animation-delay: .15s; }
  .chat-widget .chat-typing span:nth-child(3) { animation-delay: .3s; }
  @keyframes chat-bounce {
    0%, 80%, 100% { opacity: .35; transform: translateY(0); }
    40%           { opacity: 1; transform: translateY(-5px); }
  }

  /* Sugerencias */
  .chat-widget .chat-suggestions { display: flex; flex-wrap: wrap; gap: 8px; padding-left: 36px; }
  .chat-widget .chat-suggestions[hidden] { display: none; }
  .chat-widget .chat-chip {
    background: var(--chat-paper);
    border: 1.5px solid var(--chat-ink);
    border-radius: 999px;
    color: var(--chat-ink);
    cursor: pointer;
    font: 600 12px var(--font-ui);
    padding: 7px 12px;
    text-align: left;
    transition: background .15s, transform .2s var(--ease-out), box-shadow .2s var(--ease-out);
  }
  .chat-widget .chat-chip:hover { background: var(--chat-yellow); box-shadow: 2px 2px 0 var(--chat-ink); transform: translate(-1px, -1px); }
  .chat-widget .chat-chip:focus-visible { outline: 2px solid var(--chat-ink); outline-offset: 2px; }

  /* Formulario */
  .chat-widget .chat-form { background: var(--chat-paper); border-top: 2px solid var(--chat-ink); flex-shrink: 0; padding: 12px 14px 10px; }
  .chat-widget .chat-compose {
    align-items: flex-end;
    background: #fff;
    border: 1.5px solid var(--chat-line);
    display: flex;
    gap: 8px;
    padding: 6px 6px 6px 12px;
    transition: border-color .15s, box-shadow .15s;
  }
  .chat-widget .chat-compose:focus-within { border-color: var(--chat-ink); box-shadow: 3px 3px 0 var(--chat-ink); }
  .chat-widget .chat-input {
    background: transparent;
    border: 0;
    color: var(--chat-ink);
    flex: 1;
    font: 14px/1.45 var(--font-ui);
    max-height: 120px;
    min-width: 0;
    outline: none;
    padding: 7px 0;
    resize: none;
  }
  .chat-widget .chat-input::placeholder { color: #a8a294; }
  .chat-widget .chat-send {
    background: var(--chat-yellow);
    border: 1.5px solid var(--chat-ink);
    color: var(--chat-ink);
    cursor: pointer;
    display: grid;
    flex-shrink: 0;
    height: 36px;
    place-items: center;
    transition: background .15s, opacity .15s, transform .15s;
    width: 36px;
  }
  .chat-widget .chat-send:hover:not(:disabled) { background: var(--chat-ink); color: var(--chat-yellow); }
  .chat-widget .chat-send:active:not(:disabled) { transform: scale(.94); }
  .chat-widget .chat-send:disabled { background: #eeeae0; border-color: var(--chat-line); color: #a8a294; cursor: not-allowed; }
  .chat-widget .chat-foot { color: var(--chat-muted); font-size: 11px; line-height: 1.4; margin: 8px 2px 0; text-align: center; }
  .chat-widget .chat-foot-link {
    background: none;
    border: 0;
    color: var(--chat-ink);
    cursor: pointer;
    font: 700 11px var(--font-ui);
    padding: 0;
    text-decoration: underline;
    text-decoration-color: var(--chat-red);
    text-underline-offset: 2px;
  }

  /* Móvil: el chat ocupa la pantalla */
  @media (max-width: 520px) {
    .chat-widget { bottom: 16px; right: 16px; }
    .chat-widget .chat-label { display: none; }
    .chat-widget .chat-toggle { padding: 6px; }
    .chat-widget[data-open="true"] { inset: 0; }
    .chat-widget .chat-panel { border: 0; box-shadow: none; height: 100%; width: 100%; }
    html.chat-abierto { overflow: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-widget .chat-panel:not([hidden]),
    .chat-widget .chat-row,
    .chat-widget .chat-status { animation: none; }
  }
</style>
