---
// Soporte: el cliente levanta tickets (pedido que no llega, cancelación, producto dañado, devolución,
// pago o factura) y ve los que ya tiene. Desde el detalle de un pedido se llega con
// ?pedido={id}&tipo={motivo} para que el formulario abra ya lleno.
import Layout from '../../../layouts/Layout.astro';
import AccountHeader from '../../../components/AccountHeader.astro';
import { findClientId } from '../../../lib/clientes';
import { getComprasCliente } from '../../../lib/compras';
import {
  DIAS_DEVOLUCION,
  MAX_ASUNTO,
  MAX_MENSAJE,
  TIPOS_TICKET,
  esTipoTicket,
  listarTicketsCliente,
  motivoTipoNoPermitido,
  ticketActivo,
} from '../../../lib/soporte';

const sessionUser = Astro.locals.user;
if (!sessionUser) return Astro.redirect('/login');

const clientId = await findClientId(sessionUser.id);
const [compras, tickets] = clientId !== null
  ? await Promise.all([getComprasCliente(clientId), listarTicketsCliente(clientId)])
  : [[], []];

// Por cada pedido (y "sin pedido"), qué motivos se pueden elegir y por qué no los demás
const motivos = (pedido: { estado: string; fechaEntrega: Date | null } | null) =>
  Object.fromEntries(TIPOS_TICKET.map((tipo) => [tipo, motivoTipoNoPermitido(tipo, pedido)]));
const reglas: Record<string, Record<string, string | null>> = {
  '': motivos(null),
  ...Object.fromEntries(compras.map((c) => [String(c.id), motivos(c)])),
};

const pedidoParam = Number(Astro.url.searchParams.get('pedido'));
const pedidoInicial = compras.some((c) => c.id === pedidoParam) ? String(pedidoParam) : '';
const tipoParam = Astro.url.searchParams.get('tipo');
const tipoInicial = esTipoTicket(tipoParam) && reglas[pedidoInicial][tipoParam] === null ? tipoParam : '';
const abrirFormulario = Astro.url.searchParams.has('nuevo') || pedidoInicial !== '' || tipoInicial !== '';

const descripcionTipo: Record<string, string> = {
  'Retraso en la entrega': 'Mi pedido no ha llegado',
  Cancelación: 'Quiero cancelar mi pedido',
  'Producto dañado o incorrecto': 'Llegó dañado o no es lo que pedí',
  'Cambio o devolución': `Quiero cambiarlo o regresarlo (${DIAS_DEVOLUCION} días)`,
  'Pago o factura': 'Cobros, reembolsos o mi factura',
  Otro: 'Cualquier otra duda',
};

const activos = tickets.filter((t) => ticketActivo(t.estado));
const cerrados = tickets.filter((t) => !ticketActivo(t.estado));
const tonoEstado: Record<string, string> = { Abierto: 'warn', 'En proceso': 'info', Resuelto: 'ok', Cerrado: 'muted' };
const respuestasPreestablecidas = [
  {
    pregunta: '¿Cuánto tarda la entrega de mi pedido?',
    respuesta:
      'La mayoría de los pedidos se entregan entre 3 y 7 días hábiles según la zona de envío. Si tu compra ya lleva más tiempo del estimado, puedes abrir un ticket y revisamos el seguimiento con nosotros.',
  },
  {
    pregunta: '¿Puedo cancelar mi pedido si aún no llega?',
    respuesta:
      'Sí. Si tu pedido aún no se entrega o se encuentra en preparación, puedes solicitar la cancelación desde este apartado. En caso de que ya haya sido entregado, te ayudamos con una devolución o cambio según el plazo vigente.',
  },
  {
    pregunta: '¿Qué hago si el producto llegó dañado o equivocado?',
    respuesta:
      'Mándanos una descripción breve del problema y comparte fotos si es posible. Revisamos el caso y te indicamos si aplica cambio, devolución o envío de reemplazo.',
  },
  {
    pregunta: '¿Cómo solicito una devolución o cambio?',
    respuesta:
      'Puedes solicitarla desde el motivo “Cambio o devolución” en este mismo soporte. Recuerda que el producto debe estar en buen estado y la solicitud debe ser dentro del plazo establecido.',
  },
  {
    pregunta: '¿Dónde veo mi factura o información de pago?',
    respuesta:
      'Si tienes dudas sobre un cobro, reembolso o factura, usa el motivo “Pago o factura”. Ahí revisamos el detalle del pedido, el monto y cualquier comprobante relacionado.',
  },
];
const fmtFecha = (fecha: Date) =>
  new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(fecha));
const etiquetaPedido = (c: (typeof compras)[number]) => `${c.folio ?? `Pedido #${c.id}`} · ${fmtFecha(c.fecha)} · ${c.estado}`;
---

<Layout title="Soporte | SporTenis">
  <div class="sop-page">
    <AccountHeader backHref="/cuenta" backLabel="Volver a mi cuenta" active="soporte" />

    <main class="sop-main">
      <section class="page-head">
        <div>
          <nav class="breadcrumb" aria-label="Ruta de navegación">
            <a href="/cuenta">Mi cuenta</a><span aria-hidden="true">/</span><span>Soporte</span>
          </nav>
          <p class="eyebrow"><span></span> Atención al cliente</p>
          <h1>¿En qué te <em>ayudamos?</em></h1>
          <p class="head-sub">Levanta un ticket y te respondemos aquí mismo. Te avisamos con una etiqueta cuando haya una respuesta nueva.</p>
        </div>
        <button type="button" class="primary-btn" id="nuevoTicket" hidden={abrirFormulario}>+ Nuevo ticket</button>
      </section>

      <section class="support-help card" aria-labelledby="respuestasRapidasTitulo">
        <div class="support-help__header">
          <p class="eyebrow support-help__eyebrow"><span></span> Ayuda rápida</p>
          <h2 id="respuestasRapidasTitulo">Respuestas preestablecidas</h2>
        </div>

        <div class="faq-list">
          {respuestasPreestablecidas.map((item) => (
            <details class="faq-item">
              <summary>{item.pregunta}</summary>
              <p>{item.respuesta}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="sop-layout">
        <form class="ticket-form card" id="formTicket" novalidate hidden={!abrirFormulario} data-reglas={JSON.stringify(reglas)}>
          <h2>Nuevo ticket</h2>

          <label class="field">
            <span>Pedido</span>
            <select name="id_venta" id="selPedido">
              <option value="" selected={pedidoInicial === ''}>Sin pedido · duda general</option>
              {compras.map((c) => <option value={c.id} selected={pedidoInicial === String(c.id)}>{etiquetaPedido(c)}</option>)}
            </select>
          </label>

          <fieldset class="field">
            <legend>Motivo <span class="req" aria-hidden="true">*</span></legend>
            <div class="motivos" id="motivos">
              {TIPOS_TICKET.map((tipo) => (
                <label class="motivo">
                  <input type="radio" name="tipo" value={tipo} checked={tipoInicial === tipo} disabled={reglas[pedidoInicial][tipo] !== null} />
                  <span class="motivo-body">
                    <strong>{tipo}</strong>
                    <small data-desc={descripcionTipo[tipo]}>{reglas[pedidoInicial][tipo] ?? descripcionTipo[tipo]}</small>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="field">
            <span>Asunto <span class="muted">(opcional)</span></span>
            <input name="asunto" maxlength={MAX_ASUNTO} placeholder="Ej. Mi pedido lleva 10 días sin moverse" />
          </label>

          <label class="field">
            <span>Cuéntanos qué pasó <span class="req" aria-hidden="true">*</span></span>
            <textarea name="mensaje" rows="5" maxlength={MAX_MENSAJE} minlength="10" required placeholder="Entre más detalles nos des, más rápido lo resolvemos."></textarea>
          </label>

          <p class="form-error" id="errorTicket" role="alert" hidden></p>
          <div class="form-actions">
            <button type="button" class="link-btn" id="cancelarTicket">Cancelar</button>
            <button type="submit" class="primary-btn">Enviar ticket</button>
          </div>
        </form>

        <section class="ticket-col" aria-labelledby="activosTitulo">
          <h2 class="col-title" id="activosTitulo">Abiertos <span>({activos.length})</span></h2>
          {activos.length === 0 && <p class="empty">No tienes tickets abiertos. Si algo salió mal con un pedido, levanta uno.</p>}
          <ul class="ticket-list">
            {activos.map((t) => (
              <li>
                <a class="ticket-card" href={`/cuenta/soporte/${t.id}`}>
                  <span class="ticket-top">
                    <span class="mono">{t.folio}</span>
                    {t.respuestaNueva && <span class="badge-new">Respuesta nueva</span>}
                    <span class={`pill pill-${tonoEstado[t.estado]}`}>{t.estado}</span>
                  </span>
                  <strong>{t.asunto}</strong>
                  <span class="ticket-meta">{t.tipo}{t.pedido ? ` · ${t.pedido}` : ''} · Actualizado el {fmtFecha(t.fechaActualizacion)}</span>
                </a>
              </li>
            ))}
          </ul>

          {cerrados.length > 0 && (
            <details class="cerrados">
              <summary>Resueltos y cerrados ({cerrados.length})</summary>
              <ul class="ticket-list">
                {cerrados.map((t) => (
                  <li>
                    <a class="ticket-card done" href={`/cuenta/soporte/${t.id}`}>
                      <span class="ticket-top">
                        <span class="mono">{t.folio}</span>
                        <span class={`pill pill-${tonoEstado[t.estado]}`}>{t.estado}</span>
                      </span>
                      <strong>{t.asunto}</strong>
                      <span class="ticket-meta">{t.tipo}{t.pedido ? ` · ${t.pedido}` : ''} · {fmtFecha(t.fechaResolucion ?? t.fechaActualizacion)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </section>
      </div>
    </main>
  </div>

    <!-- ══ Chat IA flotante ══ -->
    <div id="chatWidget" class="chat-widget" data-open="false">
      <!-- Panel del chat -->
      <section id="chatPanel" class="chat-panel" role="dialog" aria-labelledby="chatTitulo" hidden>
        <header class="chat-header">
          <span class="chat-avatar chat-avatar--lg" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z"/><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
          </span>
          <div class="chat-header-text">
            <p class="chat-header-title" id="chatTitulo">Asistente <em>SporTenis</em></p>
            <p class="chat-header-sub"><span class="chat-status" aria-hidden="true"></span> En línea · responde al instante</p>
          </div>
          <button type="button" class="chat-icon-btn" id="chatReset" title="Nueva conversación" aria-label="Nueva conversación">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          </button>
          <button type="button" class="chat-icon-btn" id="chatClose" title="Cerrar" aria-label="Cerrar chat">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </header>

        <div id="chatMessages" class="chat-messages" aria-live="polite">
          <div class="chat-day"><span>Hoy</span></div>
          <div class="chat-row chat-row--bot">
            <span class="chat-avatar" aria-hidden="true">ST</span>
            <div class="chat-bubble chat-bubble--bot">
              <p>¡Hola! 👟 Soy el asistente de SporTenis.</p>
              <p>Puedo ayudarte con el <strong>estado de tus pedidos</strong>, envíos, devoluciones y más. ¿En qué te ayudo?</p>
            </div>
          </div>
          <div class="chat-suggestions" id="chatSuggestions">
            <button type="button" class="chat-chip">¿Cuáles son mis pedidos?</button>
            <button type="button" class="chat-chip">¿Dónde está mi último pedido?</button>
            <button type="button" class="chat-chip">¿Cómo hago una devolución?</button>
            <button type="button" class="chat-chip">¿Cuánto tarda el envío?</button>
          </div>
        </div>

        <form id="chatForm" class="chat-form" autocomplete="off">
          <div class="chat-compose">
            <textarea
              id="chatInput"
              class="chat-input"
              rows="1"
              placeholder="Escribe tu pregunta…"
              maxlength="500"
              aria-label="Mensaje para el asistente"
            ></textarea>
            <button type="submit" class="chat-send" aria-label="Enviar mensaje" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
            </button>
          </div>
          <p class="chat-foot">
            La IA puede equivocarse. ¿Necesitas que hagamos algo? <button type="button" class="chat-foot-link" id="chatTicket">Levanta un ticket</button>
          </p>
        </form>
      </section>

      <!-- Botón flotante -->
      <button id="chatToggle" class="chat-toggle" aria-expanded="false" aria-controls="chatPanel">
        <span class="chat-toggle-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </span>
        <span class="chat-label">¿Dudas? <strong>Pregúntale a la IA</strong></span>
      </button>
    </div>

</Layout>

<script>
  const form = document.getElementById('formTicket') as HTMLFormElement | null;
  const reglas: Record<string, Record<string, string | null>> = JSON.parse(form?.dataset.reglas ?? '{}');
  const btnNuevo = document.getElementById('nuevoTicket');
  const selPedido = document.getElementById('selPedido') as HTMLSelectElement | null;
  const errorBox = document.getElementById('errorTicket');

  const mostrarError = (mensaje: string) => {
    if (!errorBox) return;
    errorBox.textContent = mensaje;
    errorBox.hidden = !mensaje;
  };

  // Al cambiar de pedido se habilitan solo los motivos que aplican y se explica por qué no los demás
  const aplicarReglas = () => {
    const reglasPedido = reglas[selPedido?.value ?? ''] ?? reglas[''] ?? {};
    form?.querySelectorAll<HTMLInputElement>('input[name="tipo"]').forEach((radio) => {
      const motivo = reglasPedido[radio.value] ?? null;
      radio.disabled = motivo !== null;
      if (radio.disabled) radio.checked = false;
      const small = radio.closest('.motivo')?.querySelector<HTMLElement>('small');
      if (small) small.textContent = motivo ?? small.dataset.desc ?? '';
    });
  };
  selPedido?.addEventListener('change', aplicarReglas);

  btnNuevo?.addEventListener('click', () => {
    if (!form) return;
    form.hidden = false;
    btnNuevo.hidden = true;
    form.querySelector<HTMLSelectElement>('select')?.focus();
  });
  document.getElementById('cancelarTicket')?.addEventListener('click', () => {
    if (!form) return;
    form.reset();
    aplicarReglas();
    mostrarError('');
    form.hidden = true;
    if (btnNuevo) btnNuevo.hidden = false;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const datos = new FormData(form);
    if (!datos.get('tipo')) return mostrarError('Elige el motivo del ticket.');
    if (String(datos.get('mensaje') ?? '').trim().length < 10) return mostrarError('Cuéntanos qué pasó (al menos 10 caracteres).');
    mostrarError('');

    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (boton) boton.disabled = true;
    try {
      const res = await fetch('/api/tickets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(datos)),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.ok === false) throw new Error(data.error || 'No se pudo enviar el ticket.');
      window.location.href = `/cuenta/soporte/${data.id}?creado=1`;
    } catch (error) {
      mostrarError(error instanceof Error ? error.message : 'No se pudo enviar el ticket.');
      if (boton) boton.disabled = false;
    }
  });
</script>

<script>
  // ── Chat IA ──────────────────────────────────────────────────────────────
  const widget      = document.getElementById('chatWidget') as HTMLDivElement | null;
  const chatToggle  = document.getElementById('chatToggle') as HTMLButtonElement | null;
  const chatPanel   = document.getElementById('chatPanel') as HTMLElement | null;
  const chatForm    = document.getElementById('chatForm') as HTMLFormElement | null;
  const chatInput   = document.getElementById('chatInput') as HTMLTextAreaElement | null;
  const chatMsgs    = document.getElementById('chatMessages') as HTMLDivElement | null;
  const chatSend    = chatForm?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
  const suggestions = document.getElementById('chatSuggestions') as HTMLDivElement | null;

  type ChatRole = 'user' | 'model';
  interface HistoryEntry { role: ChatRole; text: string; time: string }
  const STORAGE_KEY = 'sportenis-chat-soporte';
  let history: HistoryEntry[] = [];
  let loading = false;

  // ── Markdown mínimo y seguro: se escapa todo y luego se aplican **negritas**, *cursivas* y listas
  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  const inline = (s: string) =>
    escapeHtml(s)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*(?!\s)(.+?)\*(?!\*)/g, '$1<em>$2</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>');
  const renderMarkdown = (text: string) => {
    let html = '';
    let list: 'ul' | 'ol' | null = null;
    let para: string[] = [];
    const flushPara = () => { if (para.length) { html += `<p>${para.map(inline).join('<br>')}</p>`; para = []; } };
    const closeList = () => { if (list) { html += `</${list}>`; list = null; } };
    for (const raw of text.replace(/\r/g, '').split('\n')) {
      const line = raw.trim();
      const ol = line.match(/^\d+[.)]\s+(.*)$/);
      const ul = line.match(/^[-*•]\s+(.*)$/);
      const h = line.match(/^#{1,6}\s+(.*)$/);
      if (ol || ul) {
        flushPara();
        const type = ol ? 'ol' : 'ul';
        if (list !== type) { closeList(); html += `<${type}>`; list = type; }
        html += `<li>${inline((ol ?? ul)![1])}</li>`;
      } else if (!line) {
        flushPara(); closeList();
      } else {
        closeList();
        para.push(h ? `**${h[1]}**` : line);
      }
    }
    flushPara(); closeList();
    return html;
  };

  const horaActual = () => new Intl.DateTimeFormat('es-MX', { hour: 'numeric', minute: '2-digit' }).format(new Date());
  const scrollAbajo = (smooth = true) => chatMsgs?.scrollTo({ top: chatMsgs.scrollHeight, behavior: smooth ? 'smooth' : 'auto' });

  const guardar = () => { try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history)); } catch { /* sin almacenamiento */ } };

  const addRow = (text: string, type: 'user' | 'bot' | 'error', time = horaActual()) => {
    if (!chatMsgs) return;
    const row = document.createElement('div');
    row.className = `chat-row chat-row--${type === 'user' ? 'user' : 'bot'}`;
    if (type !== 'user') {
      const avatar = document.createElement('span');
      avatar.className = 'chat-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = type === 'error' ? '!' : 'ST';
      if (type === 'error') avatar.classList.add('chat-avatar--error');
      row.appendChild(avatar);
    }
    const col = document.createElement('div');
    col.className = 'chat-col';
    const bubble = document.createElement('div');
    bubble.className = `chat-bubble chat-bubble--${type}`;
    if (type === 'bot') bubble.innerHTML = renderMarkdown(text);
    else bubble.textContent = text;
    const meta = document.createElement('span');
    meta.className = 'chat-time';
    meta.textContent = time;
    col.append(bubble, meta);
    row.appendChild(col);
    chatMsgs.appendChild(row);
    scrollAbajo();
  };

  const showTyping = (show: boolean) => {
    chatMsgs?.querySelector('.chat-row--typing')?.remove();
    if (!show || !chatMsgs) return;
    const row = document.createElement('div');
    row.className = 'chat-row chat-row--bot chat-row--typing';
    row.innerHTML = '<span class="chat-avatar" aria-hidden="true">ST</span><div class="chat-bubble chat-bubble--bot chat-typing" aria-label="El asistente está escribiendo"><span></span><span></span><span></span></div>';
    chatMsgs.appendChild(row);
    scrollAbajo();
  };

  const actualizarEnviar = () => { if (chatSend) chatSend.disabled = loading || !chatInput?.value.trim(); };
  const autoGrow = () => {
    if (!chatInput) return;
    chatInput.style.height = 'auto';
    chatInput.style.height = `${Math.min(chatInput.scrollHeight, 120)}px`;
  };

  const setLoading = (value: boolean) => {
    loading = value;
    showTyping(value);
    actualizarEnviar();
  };

  const abrir = (open: boolean) => {
    if (!chatPanel || !widget || !chatToggle) return;
    chatPanel.hidden = !open;
    widget.dataset.open = String(open);
    chatToggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('chat-abierto', open);
    if (open) { scrollAbajo(false); chatInput?.focus(); }
    else chatToggle.focus();
  };

  const enviar = async (msg: string) => {
    msg = msg.trim();
    if (!msg || loading) return;
    if (suggestions) suggestions.hidden = true;

    const previo = history.map(({ role, text }) => ({ role, text }));
    const time = horaActual();
    addRow(msg, 'user', time);
    history.push({ role: 'user', text: msg, time });
    guardar();
    if (chatInput) { chatInput.value = ''; autoGrow(); }
    setLoading(true);

    try {
      const res = await fetch('/api/chat-soporte', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg, history: previo }),
      });
      const data = await res.json().catch(() => ({})) as { reply?: string; error?: string };
      setLoading(false);
      if (!res.ok || data.error) {
        addRow(data.error ?? 'Ocurrió un error. Intenta de nuevo.', 'error');
      } else {
        const reply = data.reply ?? '';
        const t = horaActual();
        addRow(reply, 'bot', t);
        history.push({ role: 'model', text: reply, time: t });
        guardar();
      }
    } catch {
      setLoading(false);
      addRow('No se pudo conectar. Revisa tu internet e intenta de nuevo.', 'error');
    } finally {
      chatInput?.focus();
    }
  };

  const reiniciar = () => {
    history = [];
    guardar();
    chatMsgs?.querySelectorAll('.chat-row').forEach((row, i) => { if (i > 0) row.remove(); });
    if (suggestions) suggestions.hidden = false;
    chatInput?.focus();
  };

  // Restaurar la conversación de esta pestaña (sobrevive a recargas)
  try {
    const guardado = JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? '[]');
    if (Array.isArray(guardado) && guardado.length) {
      history = guardado.filter((m) => (m?.role === 'user' || m?.role === 'model') && typeof m.text === 'string');
      history.forEach((m) => addRow(m.text, m.role === 'user' ? 'user' : 'bot', m.time ?? ''));
      if (suggestions && history.length) suggestions.hidden = true;
    }
  } catch { /* sin almacenamiento */ }

  chatToggle?.addEventListener('click', () => abrir(chatPanel?.hidden !== false));
  document.getElementById('chatClose')?.addEventListener('click', () => abrir(false));
  document.getElementById('chatReset')?.addEventListener('click', reiniciar);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && chatPanel && !chatPanel.hidden) abrir(false); });

  suggestions?.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chat-chip');
    if (chip) enviar(chip.textContent ?? '');
  });

  chatInput?.addEventListener('input', () => { autoGrow(); actualizarEnviar(); });
  chatInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      chatForm?.requestSubmit();
    }
  });
  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    enviar(chatInput?.value ?? '');
  });

  // "Levanta un ticket": cierra el chat y abre el formulario de la página
  document.getElementById('chatTicket')?.addEventListener('click', () => {
    abrir(false);
    const nuevo = document.getElementById('nuevoTicket') as HTMLButtonElement | null;
    if (nuevo && !nuevo.hidden) nuevo.click();
    const formTicket = document.getElementById('formTicket');
    formTicket?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
