---
// src/pages/login.astro
import Layout from "../layouts/Layout.astro";
import { db } from "../db/db";
import { Usuarios } from "../db/schema";
import { eq } from "drizzle-orm";
import { getRoleById, homeForRole, isUsuarioActivo } from "../lib/auth";
import { hashPassword, isPasswordHash, verifyPassword } from "../lib/password";
import { cerrarSesion, iniciarSesion } from "../lib/session";

let errorMsg = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  if (formData.get("action") === "logout") {
    await cerrarSesion(Astro.cookies);
    return Astro.redirect("/");
  }

  const email = formData.get("email")?.toString();
  const password = formData.get("password")?.toString();

  if (email && password) {
    const userResult = await db
      .select()
      .from(Usuarios)
      .where(eq(Usuarios.correo, email));
    const user = userResult[0];

    if (user && isUsuarioActivo(user.estado) && (await verifyPassword(password, user.password_hash))) {
      if (!isPasswordHash(user.password_hash)) {
        await db
          .update(Usuarios)
          .set({ password_hash: await hashPassword(password) })
          .where(eq(Usuarios.id, user.id));
      }

      await iniciarSesion(Astro.cookies, user.id);

      return Astro.redirect(homeForRole(await getRoleById(user.id_rol)));
    } else {
      errorMsg = "Correo o contraseña incorrectos.";
    }
  }
} else {
  // Si es GET y ya hay sesión, redirigir
  if (Astro.locals.user) {
    return Astro.redirect(homeForRole(Astro.locals.user.role));
  }
}
---

<Layout>
  <div class="auth-page">
    <header class="topbar">
      <a class="brand" href="/" aria-label="SporTenis, volver al inicio">
        <span class="brand-mark">S</span>
        <span>Spor<span>Tenis</span></span>
      </a>
      <a href="/" class="back-link">← Volver a la tienda</a>
    </header>

    <main class="auth-main">
      <div class="auth-card">
        <div class="card-header">
          <p class="eyebrow"><span></span> Acceso a la Tienda</p>
          <h1>Iniciar <em>Sesión</em></h1>
          <p class="subtitle">
            Ingresa tus datos para ver tus pedidos y beneficios.
          </p>
        </div>

        <form method="POST" class="auth-form">
          {errorMsg && <div class="error-banner">{errorMsg}</div>}

          <div class="field-group">
            <label for="email">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="tu@email.com"
              required
            />
          </div>

          <div class="field-group">
            <label for="password">Contraseña</label>
            <div class="input-password">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
              />
              <button type="button" class="eye-btn" id="togglePassword" aria-label="Mostrar contraseña">
                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            <a href="/olvide-password" class="forgot-link">¿Olvidaste tu contraseña?</a>
          </div>

          <button type="submit" class="primary-button">
            Entrar a mi cuenta <span>↗</span>
          </button>
        </form>

        <p class="login-link">
          No tienes cuenta? <a href="/registro">Regístrate</a>
        </p>
      </div>
    </main>
  </div>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    background: #f6f4ed;
    color: #171717;
    font-family: Georgia, "Times New Roman", serif;
    margin: 0;
  }

  .auth-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    align-items: center;
    background: #f7d21c;
    display: flex;
    justify-content: space-between;
    min-height: 76px;
    padding: 0 clamp(20px, 4vw, 64px);
  }

  .brand {
    align-items: center;
    color: #171717;
    display: flex;
    font-family: Arial, sans-serif;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -1.5px;
    text-decoration: none;
  }
  .brand span span {
    font-weight: 400;
  }
  .brand-mark {
    align-items: center;
    border: 3px solid #171717;
    border-radius: 50%;
    display: inline-flex;
    font-size: 15px;
    height: 30px;
    justify-content: center;
    margin-right: 8px;
    width: 30px;
  }

  .back-link {
    color: #171717;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }
  .back-link:hover {
    text-decoration: underline;
  }

  .auth-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .auth-card {
    background: #fffdf3;
    border: 2px solid #171717;
    box-shadow: 8px 8px 0 rgba(23, 23, 23, 1);
    width: 100%;
    max-width: 440px;
    padding: clamp(30px, 5vw, 45px);
  }

  .eyebrow {
    color: #d93e2e;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 0 0 10px;
    text-transform: uppercase;
  }
  .eyebrow span {
    background: #f7d21c;
    display: inline-block;
    height: 7px;
    margin-right: 8px;
    width: 7px;
  }

  h1 {
    font-size: 42px;
    font-weight: 400;
    letter-spacing: -2px;
    line-height: 0.95;
    margin: 0 0 10px;
  }
  h1 em {
    color: #d93e2e;
    font-style: italic;
  }

  .subtitle {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 12px;
    margin: 0 0 25px;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-group label {
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .field-group input {
    background: #f6f4ed;
    border: 1.5px solid #171717;
    padding: 12px 14px;
    font-family: Arial, sans-serif;
    font-size: 13px;
    outline: none;
  }

  .field-group input:focus {
    background: #fff;
    border-color: #d93e2e;
  }

  /* Botón de ojo para ver la contraseña (mismo diseño que el registro) */
  .input-password { position: relative; }
  .input-password input { padding-right: 42px; width: 100%; box-sizing: border-box; }
  .eye-btn {
    align-items: center;
    background: none;
    border: none;
    color: #716e67;
    cursor: pointer;
    display: flex;
    height: 36px;
    justify-content: center;
    padding: 0;
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
  }
  .eye-btn svg { height: 18px; width: 18px; }
  .eye-btn:hover { color: #d93e2e; }

  .primary-button {
    align-items: center;
    background: #171717;
    border: 0;
    color: #fffdf3;
    cursor: pointer;
    display: inline-flex;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    justify-content: space-between;
    letter-spacing: 0.5px;
    margin-top: 10px;
    padding: 16px 20px;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .primary-button:hover {
    background: #d93e2e;
  }
  .primary-button:active {
    transform: scale(0.99);
  }
  .primary-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .primary-button span {
    font-size: 16px;
  }

  .login-link {
    color: #716e67;
    font-family: Arial, sans-serif;
    font-size: 12px;
    margin: 18px 0 0;
    text-align: center;
  }
  .login-link a {
    color: #d93e2e;
    font-weight: 700;
    text-decoration: none;
  }
  .login-link a:hover {
    text-decoration: underline;
  }

  .forgot-link {
    align-self: flex-end;
    color: #d93e2e;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }
  .forgot-link:hover {
    text-decoration: underline;
  }

  .error-banner {
    background: #fee2e2;
    border: 1.5px solid #ef4444;
    color: #991b1b;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    padding: 10px 12px;
  }

  .mock-credentials {
    margin-top: 25px;
    padding-top: 18px;
    border-top: 1px dashed #d8d3c3;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: #716e67;
  }
  .mock-credentials code {
    background: #ede9dc;
    color: #171717;
    padding: 2px 5px;
  }
</style>

<script>
  // Mostrar u ocultar la contraseña
  const EYE_OPEN = `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
  const EYE_SHUT = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>`;
  const boton = document.getElementById('togglePassword');
  const input = document.getElementById('password') as HTMLInputElement | null;
  const icono = document.getElementById('eyeIcon');
  let visible = false;
  boton?.addEventListener('click', () => {
    if (!input) return;
    visible = !visible;
    input.type = visible ? 'text' : 'password';
    if (icono) icono.innerHTML = visible ? EYE_SHUT : EYE_OPEN;
    boton.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
  });
</script>
